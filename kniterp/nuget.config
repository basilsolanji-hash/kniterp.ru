<?xml version="1.0" encoding="utf-8"?>
<!-- D109: единственный источник пакетов — nuget.org; сопоставление источников запрещает подтянуть пакет с тем же именем откуда-то ещё. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
