@inherits LayoutComponentBase
@inject NavigationManager Navigation

<div class="card">
    <div style="font-weight: 600; font-size: 22px; display: flex; align-items: center; gap: 10px"><KnitErp.Web.Components.Shared.LogoMark Size="40" /><span>knit<span style="color: color-mix(in srgb, var(--accent) 80%, var(--text))">ERP</span></span></div>
    @Body
    @* Язык до входа — ссылками (страницы входа без интерактивности); после входа язык берётся из профиля. *@
    <nav class="lang-links" aria-label="@L("Язык")">
        @foreach (var lang in KnitErp.Domain.Access.UiLanguages.Menu)
        {
            <a href="@($"language/{lang.Code}?returnUrl={Uri.EscapeDataString("/" + Navigation.ToBaseRelativePath(Navigation.Uri))}")" data-enhance-nav="false"
               aria-current="@(lang.Code == CurrentCode ? "true" : null)">@lang.NativeName</a>
        }
    </nav>
</div>
