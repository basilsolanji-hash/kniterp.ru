@inject PersonalToolsService Personal
@inject NavigationManager Navigation
@* Пользователь: аватар, имя, должность; меню — организация, вход и коды, язык, тема, настройка панели, выход.
   На компьютере — внизу меню слева (меню раскрывается вверх), на телефоне — в строке инструментов. *@

    <div class="menu-anchor profile-anchor">
        <button type="button" class="profile" aria-haspopup="menu" aria-expanded="@(_open ? "true" : "false")" @onclick="() => _open = !_open"
                title="@($"{Access.DisplayName} — {L(Access.Subtitle)}")">
            <span class="avatar" aria-hidden="true">@Access.Initials</span>
            @if (!AvatarOnly)
            {
                <span class="profile-text">
                    <span class="profile-name">@Access.DisplayName</span>
                    <span class="profile-sub">@L(Access.Subtitle)</span>
                </span>
            }
            <span class="sr-only">@L("Профиль")</span>
        </button>
        @if (_open)
        {
            <div class="menu @(Up ? "menu-up" : "menu-right")" role="menu" aria-label="@L("Профиль")">
                <div class="menu-info">
                    <b>@Access.DisplayName</b>
                    <span class="muted">@L(Access.Subtitle)</span>
                    <span class="muted">@string.Join(", ", Access.RoleNames.Select(n => L(n))) · @Access.OrganizationName</span>
                </div>
                <a role="menuitem" href="account/organizations" data-enhance-nav="false">@L("Сменить организацию")</a>
                <a role="menuitem" href="security">@L("Вход и резервные коды")</a>
                <div class="menu-caption">@L("Язык")</div>
                <div class="lang-row">
                    @foreach (var lang in KnitErp.Domain.Access.UiLanguages.All)
                    {
                        <button type="button" role="menuitemradio" aria-checked="@(lang.Code == CurrentCode ? "true" : "false")"
                                class="@(lang.Code == CurrentCode ? "chip added" : "chip")" @onclick="() => ChangeLanguageAsync(lang.Code)">@lang.NativeName</button>
                    }
                </div>
                <div class="menu-caption">@L("Тема")</div>
                <div class="lang-row">
                    @foreach (var (themeCode, themeTitle) in Themes)
                    {
                        <button type="button" role="menuitemradio" class="chip" data-theme-choice="@themeCode">@themeTitle</button>
                    }
                </div>
                <div class="menu-caption">@L("Размер интерфейса")</div>
                <div class="lang-row" role="radiogroup" aria-label="@L("Размер интерфейса")">
                    <button type="button" role="menuitemradio" class="chip" data-density-choice="compact">@L("Компактно")</button>
                    <button type="button" role="menuitemradio" class="chip" data-density-choice="normal">@L("Обычно")</button>
                    <button type="button" role="menuitemradio" class="chip" data-density-choice="large">@L("Крупно")</button>
                </div>
                <button type="button" role="menuitem" class="menu-item" @onclick="@(() => Open(QuickBar.SettingsId))">@L("Настроить панель")</button>
                <form method="post" action="account/logout">
                    <AntiforgeryToken />
                    <button type="submit" role="menuitem" class="menu-item">@L("Выйти")</button>
                </form>
            </div>
        }
    </div>
@if (_open)
{
    <div class="menu-backdrop" @onclick="() => _open = false"></div>
}

@code {
    [Parameter, EditorRequired]
    public CurrentAccessDto Access { get; set; } = default!;

    /// <summary>Только аватар (свёрнутое меню, телефон).</summary>
    [Parameter]
    public bool AvatarOnly { get; set; }

    /// <summary>Меню раскрывается вверх — когда профиль внизу экрана.</summary>
    [Parameter]
    public bool Up { get; set; }

    [Parameter]
    public EventCallback<string> OnOpen { get; set; }

    private bool _open;

    /// <summary>Тема переключается в браузере (kniterp.js, data-theme-choice) и запоминается на этом устройстве.</summary>
    private static (string Code, string Title)[] Themes => [("dark", L("Тёмная")), ("light", L("Светлая")), ("auto", L("Как в системе"))];

    private async Task Open(string id)
    {
        _open = false;
        await OnOpen.InvokeAsync(id);
    }

    /// <summary>Язык сохраняется в профиле и ставится в cookie; страница перезагружается уже на новом языке.</summary>
    private async Task ChangeLanguageAsync(string code)
    {
        _open = false;
        await Personal.SetLanguageAsync(code);
        var back = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
        Navigation.NavigateTo($"language/{code}?returnUrl={Uri.EscapeDataString(back)}", forceLoad: true);
    }
}
