@inject PersonalToolsService Personal
@inject NavigationManager Navigation
@* D802 (сессия 5): блок пользователя — в правом краю верхней панели. Кнопка: аватар, имя, должность и стрелка (на телефоне —
   только аватар). Меню: кто вы и где (организация, роли) → профиль и пароль, сессии и устройства, смена организации, панель,
   обучение, поддержка (D807, раздел 0 п. 3) → «Оформление»
   (язык, тема, размер, помощник) → «Выйти», всегда видна внизу; на телефоне меню прокручивается внутри, а не обрезается. *@

    <div class="menu-anchor profile-anchor" @onkeydown="@(e => { if (e.Key == "Escape") { _open = false; } })">
        <button type="button" class="profile" aria-haspopup="menu" aria-expanded="@(_open ? "true" : "false")" @onclick="() => _open = !_open"
                aria-label="@L("Профиль: {0}", Access.DisplayName)">
            <span class="avatar" aria-hidden="true">@Access.Initials</span>
            @if (!AvatarOnly)
            {
                <span class="profile-text" aria-hidden="true">
                    <span class="profile-name">@Access.DisplayName</span>
                    <span class="profile-sub">@L(Access.Subtitle) · @Access.OrganizationName</span>
                </span>
                <span class="caret" aria-hidden="true">▾</span>
            }
        </button>
        @if (_open)
        {
            <div class="menu profile-menu @(Up ? "menu-up" : "menu-right")" role="menu" aria-label="@L("Профиль")">
                <div class="pm-head">
                    <span class="avatar avatar-lg" aria-hidden="true">@Access.Initials</span>
                    <span class="pm-who">
                        <b>@Access.DisplayName</b>
                        <span class="muted">@L(Access.Subtitle)</span>
                        <span class="muted small">@Access.OrganizationName · @string.Join(", ", Access.RoleNames.Select(n => L(n)))</span>
                    </span>
                </div>
                <div class="pm-actions">
                    <a role="menuitem" class="menu-item" href="security#password" @onclick="() => _open = false"><Icon Name="settings" Size="16" /><span>@L("Профиль и пароль")</span></a>
                    <a role="menuitem" class="menu-item" href="security#devices" @onclick="() => _open = false"><Icon Name="links" Size="16" /><span>@L("Сессии и устройства")</span></a>
                    <a role="menuitem" class="menu-item" href="account/organizations" data-enhance-nav="false"><Icon Name="all" Size="16" /><span>@L("Сменить организацию")</span></a>
                    <button type="button" role="menuitem" class="menu-item" @onclick="@(() => Open(QuickBar.SettingsId))"><Icon Name="favorites" Size="16" /><span>@L("Настроить панель")</span></button>
                    <button type="button" role="menuitem" class="menu-item" @onclick="@(() => Open(ToolCatalog.Help))"><Icon Name="help" Size="16" /><span>@L("Обучение")</span></button>
                    <button type="button" role="menuitem" class="menu-item" @onclick="@(() => Open(ToolCatalog.Support))"><Icon Name="support" Size="16" /><span>@L("Поддержка")</span></button>
                </div>
                <div class="menu-caption">@L("Оформление")</div>
                <div class="pm-row">
                    <span class="pm-label">@L("Тема")</span>
                    <span class="segmented" role="radiogroup" aria-label="@L("Тема")">
                        @foreach (var (themeCode, themeTitle) in Themes)
                        {
                            <button type="button" role="menuitemradio" class="chip" data-theme-choice="@themeCode">@themeTitle</button>
                        }
                    </span>
                </div>
                <div class="pm-row">
                    <span class="pm-label">@L("Размер")</span>
                    <span class="segmented" role="radiogroup" aria-label="@L("Размер интерфейса")">
                        <button type="button" role="menuitemradio" class="chip" data-density-choice="compact">@L("Компактно")</button>
                        <button type="button" role="menuitemradio" class="chip" data-density-choice="normal">@L("Обычно")</button>
                        <button type="button" role="menuitemradio" class="chip" data-density-choice="large">@L("Крупно")</button>
                    </span>
                </div>
                <div class="pm-row">
                    <span class="pm-label">@L("Язык")</span>
                    <span class="segmented" role="radiogroup" aria-label="@L("Язык")">
                        @foreach (var lang in KnitErp.Domain.Access.UiLanguages.Menu)
                        {
                            <button type="button" role="menuitemradio" aria-checked="@(lang.Code == CurrentCode ? "true" : "false")"
                                    class="@(lang.Code == CurrentCode ? "chip added" : "chip")" @onclick="() => ChangeLanguageAsync(lang.Code)">@lang.NativeName</button>
                        }
                    </span>
                </div>
                @if (Assistant is not null)
                {
                    @* D116: кто помогает — Ника, Книт или без персонажа; хранится в профиле. *@
                    <div class="pm-row">
                        <span class="pm-label">@L("Помощник")</span>
                        <span class="segmented" role="radiogroup" aria-label="@L("Помощник")">
                            @foreach (var (code, title) in Personas)
                            {
                                <button type="button" role="menuitemradio" aria-checked="@(Assistant.Persona == code ? "true" : "false")"
                                        class="@(Assistant.Persona == code ? "chip added" : "chip")" @onclick="() => Assistant.SetAsync(code)">@title</button>
                            }
                        </span>
                    </div>
                }
                <form method="post" action="account/logout" class="pm-logout">
                    <AntiforgeryToken />
                    <button type="submit" role="menuitem" class="secondary">@L("Выйти")</button>
                </form>
            </div>
        }
    </div>
@if (_open)
{
    <div class="menu-backdrop" @onclick="() => _open = false"></div>
}

@code {
    [CascadingParameter]
    public AssistantChoice? Assistant { get; set; }

    private static IEnumerable<(string Code, string Title)> Personas =>
    [
        (KnitErp.Application.Workspace.AssistantPersonas.Nika, L("Ника")),
        (KnitErp.Application.Workspace.AssistantPersonas.Knit, L("Книт")),
        (KnitErp.Application.Workspace.AssistantPersonas.None, L("Без персонажа")),
    ];

    [Parameter, EditorRequired]
    public CurrentAccessDto Access { get; set; } = default!;

    /// <summary>Только аватар (свёрнутое меню, телефон).</summary>
    [Parameter]
    public bool AvatarOnly { get; set; }

    /// <summary>Меню раскрывается вверх — когда профиль внизу экрана.</summary>
    [Parameter]
    public bool Up { get; set; }

    [Parameter]
    public EventCallback<string> OnOpen { get; set; }

    private bool _open;

    /// <summary>Тема переключается в браузере (kniterp.js, data-theme-choice) и запоминается на этом устройстве.</summary>
    private static (string Code, string Title)[] Themes => [("dark", L("Тёмная")), ("light", L("Светлая")), ("auto", L("Как в системе"))];

    private async Task Open(string id)
    {
        _open = false;
        await OnOpen.InvokeAsync(id);
    }

    /// <summary>Язык сохраняется в профиле и ставится в cookie; страница перезагружается уже на новом языке.</summary>
    private async Task ChangeLanguageAsync(string code)
    {
        _open = false;
        await Personal.SetLanguageAsync(code);
        var back = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
        Navigation.NavigateTo($"language/{code}?returnUrl={Uri.EscapeDataString(back)}", forceLoad: true);
    }
}
