@* Панель быстрого доступа. Полный вид — поиск, все закреплённые инструменты с подписями, «Все инструменты» и блок пользователя
   (D801, D802); компактный (телефон, узкий планшет) — поиск, одна кнопка «Инструменты» с меню и значок профиля. *@

<div class="quickbar @(Compact ? "compact" : "")" @onkeydown="OnKeyDown">
    @if (!Compact)
    {
        @* D801 (сессия 5): без скрытых значков — у каждого инструмента подпись рядом со значком, все закреплённые видны сразу
           (раньше часть пряталась в «Ещё»), «Все инструменты» — кнопка с подписью; поиск — заметной кнопкой с Ctrl+K. *@
        <div class="quick-pinned" role="toolbar" aria-label="@L("Быстрый доступ")">
            <button type="button" class="quick-search @(ActiveTool == ToolCatalog.Search ? "active" : null)" @onclick="@(() => Open(ToolCatalog.Search))"
                    aria-label="@L("Быстрый поиск (Ctrl+K)")">
                <Icon Name="search" /><span class="quick-text">@L("Поиск")</span><kbd aria-hidden="true">Ctrl K</kbd>
            </button>
            @RenderCreate()
            @foreach (var tool in Pinned)
            {
                @RenderTool(tool, asMenuItem: false)
            }
            <div class="menu-anchor">
                <button type="button" class="quick-btn labeled" aria-haspopup="menu" aria-expanded="@Expanded("all")" @onclick="@(() => Toggle("all"))"
                        title="@L("Все инструменты")" aria-label="@L("Все инструменты")">
                    <Icon Name="all" /><span class="quick-text">@L("Все инструменты")</span>
                </button>
                @if (_menu == "all")
                {
                    @RenderAllMenu()
                }
            </div>
        </div>
    }
    else
    {
        @* D806: на телефоне — поиск, «Создать», уведомления; остальное — в одном меню «Ещё». *@
        @RenderTool(ToolCatalog.Find(ToolCatalog.Search)!, asMenuItem: false)
        @RenderCreate()
        @RenderTool(ToolCatalog.Find(ToolCatalog.Notifications)!, asMenuItem: false)
        <div class="menu-anchor">
            <button type="button" class="quick-btn" aria-haspopup="menu" aria-expanded="@Expanded("all")" @onclick="@(() => Toggle("all"))"
                    title="@L("Ещё")" aria-label="@L("Ещё")">
                <Icon Name="all" />
                @if (Badge > 0)
                {
                    <span class="badge" aria-label="@L("Уведомлений: {0}", Badge)">@Badge</span>
                }
            </button>
            @if (_menu == "all")
            {
                @RenderAllMenu()
            }
        </div>
    }

    @if (ShowProfile)
    {
        <ProfileMenu Access="Access" OnOpen="Open" AvatarOnly="Compact" />
    }

    @if (_menu is not null)
    {
        @* Щелчок мимо меню закрывает его. *@
        <div class="menu-backdrop" @onclick="Close"></div>
    }
</div>

@code {
    public const string SettingsId = "settings";

    [Parameter, EditorRequired]
    public CurrentAccessDto Access { get; set; } = default!;

    [Parameter, EditorRequired]
    public PanelSettings Settings { get; set; } = default!;

    [Parameter]
    public bool Compact { get; set; }

    /// <summary>Блок пользователя в правом краю строки инструментов (D802: и на компьютере — раньше был внизу меню слева).</summary>
    [Parameter]
    public bool ShowProfile { get; set; } = true;

    [Parameter]
    public string? ActiveTool { get; set; }

    [Parameter]
    public int Badge { get; set; }

    [Parameter]
    public EventCallback<string> OnOpen { get; set; }

    /// <summary>Открытые отдельные окна инструментов (калькулятор) — их значок подсвечен.</summary>
    [Parameter]
    public IReadOnlyCollection<string> OpenWindows { get; set; } = [];

    private string? _menu;

    /// <summary>Подсказка значка: название и что делает; у поиска — сочетание клавиш.</summary>
    private static string Tip(ToolDefinition tool) =>
        tool.Id == ToolCatalog.Search ? $"{L(tool.Title)} (Ctrl+K)" : $"{L(tool.Title)} — {L(tool.Hint)}";

    /// <summary>Сайт организации показывается, только когда адрес задан в реквизитах организации.</summary>
    private IEnumerable<ToolDefinition> Available =>
        ToolCatalog.All.Where(t => t.Id != ToolCatalog.Site || Access.WebsiteUrl is not null);

    /// <summary>
    /// D806 (раздел 0 ТЗ интерфейса): порядок по умолчанию — уведомления, задачи, календарь, калькулятор, заметки, помощник (после поиска
    /// и «Создать»). Пока пользователь не менял панель (закреплено умолчание), показывается этот набор; свой выбор — как настроил.
    /// </summary>
    private static readonly string[] Recommended =
        [ToolCatalog.Notifications, ToolCatalog.Tasks, ToolCatalog.Calendar, ToolCatalog.Calculator, ToolCatalog.Notes, ToolCatalog.Assistant];

    private bool IsDefault => Settings.Pinned.SequenceEqual(ToolCatalog.DefaultPinned) || Settings.Pinned.SequenceEqual(ToolCatalog.LegacyDefaultPinned);

    private List<ToolDefinition> Pinned =>
        (IsDefault ? Recommended : Settings.Pinned).Select(ToolCatalog.Find).OfType<ToolDefinition>()
            .Where(t => Available.Contains(t) && !ToolCatalog.Fixed.Contains(t.Id)).ToList();

    /// <summary>D806: что можно создать — быстрые действия главной (D108), на которые есть право; сервер проверяет сам.</summary>
    private IEnumerable<KnitErp.Application.Workspace.DashboardAction> Creatable =>
        KnitErp.Application.Workspace.DashboardActions.All.Where(a => a.Href.Contains("new=", StringComparison.Ordinal) && Access.Has(a.Permission));

    private RenderFragment RenderCreate() => __builder =>
    {
        var items = Creatable.ToList();
        if (items.Count == 0)
        {
            return;
        }

        <div class="menu-anchor">
            <button type="button" class="quick-btn labeled quick-create" aria-haspopup="menu" aria-expanded="@Expanded("create")" @onclick="@(() => Toggle("create"))"
                    title="@L("Создать документ или запись")" aria-label="@(Compact ? L("Создать") : null)">
                <span class="plus" aria-hidden="true">+</span>@if (!Compact) { <span class="quick-text">@L("Создать")</span> }
            </button>
            @if (_menu == "create")
            {
                <div class="menu menu-wide" role="menu" aria-label="@L("Создать")">
                    @foreach (var a in items)
                    {
                        <a role="menuitem" class="menu-item" href="@a.Href" @onclick="Close"><Icon Name="@a.Icon" Size="16" /><span class="quick-label">@L(a.Title)</span></a>
                    }
                </div>
            }
        </div>
    };

    private RenderFragment RenderTool(ToolDefinition tool, bool asMenuItem) => __builder =>
    {
        var active = ActiveTool == tool.Id || (tool.Mode == ToolOpenMode.Window && OpenWindows.Contains(tool.Id));
        var css = asMenuItem ? "menu-item" : $"quick-btn{(Compact ? "" : " labeled")}{(active ? " active" : "")}";
        var label = asMenuItem ? null : L(tool.Title); // D806: подпись при наведении и aria-label у каждого значка
        var text = !asMenuItem && !Compact; // D801: подпись видна рядом со значком
        if (tool.Mode == ToolOpenMode.NewTab)
        {
            <a class="@css" href="@Access.WebsiteUrl" target="_blank" rel="noopener noreferrer" title="@Tip(tool)" aria-label="@label" role="@(asMenuItem ? "menuitem" : null)" @onclick="Close">
                <Icon Name="@tool.Id" />@if (asMenuItem) { <span class="quick-label">@L(tool.Title)</span> } else if (text) { <span class="quick-text">@L(tool.Title)</span> }
            </a>
        }
        else
        {
            <button type="button" class="@css" title="@Tip(tool)" aria-label="@label" role="@(asMenuItem ? "menuitem" : null)" aria-pressed="@(asMenuItem ? null : active ? "true" : "false")"
                    @onclick="@(() => Open(tool.Id))">
                <Icon Name="@tool.Id" />@if (asMenuItem) { <span class="quick-label">@L(tool.Title)</span> } else if (text) { <span class="quick-text">@L(tool.Title)</span> }
                @if (tool.Id == ToolCatalog.Notifications && Badge > 0)
                {
                    <span class="badge" aria-label="@L("новых: {0}", Badge)">@Badge</span>
                }
            </button>
        }
    };

    private RenderFragment RenderAllMenu() => __builder =>
    {
        <div class="menu menu-wide menu-right" role="menu" aria-label="@L("Все инструменты")">
            @if (Compact && Pinned.Count > 0)
            {
                <div class="menu-caption">@L("Закреплённые")</div>
                @foreach (var tool in Pinned)
                {
                    @RenderTool(tool, asMenuItem: true)
                }
                <div class="menu-caption">@L("Все инструменты")</div>
            }
            @foreach (var tool in Available.Where(t => (!Compact || !Pinned.Contains(t)) && (!Compact || t.Id != ToolCatalog.Search)))
            {
                @RenderTool(tool, asMenuItem: true)
            }
            @if (Access.WebsiteUrl is null)
            {
                <span class="menu-item disabled" title="@L("Адрес сайта задаёт Владелец в разделе «Организация»")">
                    <Icon Name="@ToolCatalog.Site" /><span class="quick-label">@L("Сайт организации — адрес не задан")</span>
                </span>
            }
            <button type="button" role="menuitem" class="menu-item" @onclick="@(() => Open(SettingsId))">
                <Icon Name="settings" /><span class="quick-label">@L("Настроить панель")</span>
            </button>
        </div>
    };

    private string Expanded(string menu) => _menu == menu ? "true" : "false";

    private void Toggle(string menu) => _menu = _menu == menu ? null : menu;

    private void Close() => _menu = null;

    private async Task Open(string id)
    {
        _menu = null;
        await OnOpen.InvokeAsync(id);
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            _menu = null;
        }
    }
}
