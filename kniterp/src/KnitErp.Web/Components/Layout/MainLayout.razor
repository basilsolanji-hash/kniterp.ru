    private static readonly NavItem[] Items = Groups.SelectMany(g => g.Items).Where(i => !i.Planned).ToArray();

    private readonly HashSet<string> _toggled = [];
    private bool _narrow;

    /// <summary>
    /// Пункт меню текущей страницы — один: точное совпадение с параметрами («Поступления» = stock-documents?kind=1)
    /// важнее общего раздела, длинный адрес — важнее короткого.
    /// </summary>
    private string? Current
    {
        get
        {
            var path = Navigation.ToBaseRelativePath(Navigation.Uri);
            return Items.Where(i => i.Href.Length > 0 && Matches(path, i.Href))
                .OrderByDescending(i => i.Href.Contains('?')).ThenByDescending(i => i.Href.Length)
                .Select(i => i.Href).FirstOrDefault();
        }
    }

    /// <summary>Раздел раскрыт, если в нём текущая страница; щелчок по заголовку меняет это состояние.</summary>
    private bool IsOpen(NavGroup group)
    {
        var current = Current;
        return group.Items.Any(i => i.Href == current) ^ _toggled.Contains(group.Key);
    }

    private static bool Matches(string path, string href)
    {
        var p = path.Split('#')[0];
        var h = href;
        if (h.Contains('?'))
        {
            return p == h || p.StartsWith(h + "&", StringComparison.Ordinal);
        }

        var bare = p.Split('?')[0];
        return bare == h || bare.StartsWith(h + "/", StringComparison.Ordinal);
    }

    private void Toggle(string key)
    {
        if (!_toggled.Remove(key))
        {
            _toggled.Add(key);
        }
    }

    private void ToggleNarrow() => _narrow = !_narrow;

    private bool _menuOpen;
    private PanelSettings? _panel;
    private string? _activeTool;
    private string? _helpArticle;
    private readonly List<string> _opened = [];
    private int _badge;
    private DateTime _badgeAt;
    private DotNetObjectReference<MainLayout>? _self;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        _access = await Access.GetCurrentAccessAsync();
        try
        {
            _panel = await Personal.GetPanelAsync();
        }
        catch (Exception ex) when (UiErrors.IsUserFacing(ex))
        {
            // Панель не должна мешать работе: без настроек показываем панель по умолчанию.
            _panel = new PanelSettings(ToolCatalog.DefaultPinned, ToolCatalog.DefaultVisible);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("kniterp.registerHotkeys", _self);
            }
            catch (JSDisconnectedException)
            {
            }

            // Счётчик уведомлений — после отрисовки страницы, чтобы не задерживать её загрузку.
            await RefreshBadgeAsync();
        }
    }

    /// <summary>Ctrl+K — поиск, Esc — закрыть инструмент (вызывается из браузера).</summary>
    [JSInvokable]
    public Task OnHotkey(string key) => InvokeAsync(async () =>
    {
        if (key == "search")
        {
            await OpenTool(ToolCatalog.Search);
        }
        else if (key == "escape" && _activeTool is not null)
        {
            await CloseTool();
        }

        StateHasChanged();
    });

    private async Task OpenTool(string id) => await OpenTool(id, null);

    private bool _calculatorOpen;

    private IReadOnlyCollection<string> Windows => _calculatorOpen ? [ToolCatalog.Calculator] : [];

    private async Task OpenTool(string id, string? arg)
    {
        _menuOpen = false;
        if (id == ToolCatalog.Calculator)
        {
            // Калькулятор — отдельным окном: повторный щелчок по значку закрывает его.
            _calculatorOpen = !_calculatorOpen;
            StateHasChanged();
            return;
        }

        if (id == ToolCatalog.Help)
        {
            _helpArticle = arg;
        }

        if (!_opened.Contains(id))
        {
            _opened.Add(id);
        }

        _activeTool = id;
        StateHasChanged();
        try
        {
            await JS.InvokeVoidAsync("kniterp.focusDrawer", id == ToolCatalog.Search ? "quick-search-input" : "drawer-title");
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private async Task CloseTool()
    {
        _activeTool = null;
        try
        {
            await JS.InvokeVoidAsync("kniterp.restoreFocus");
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private Task NavigateFromTool(string href)
    {
        _activeTool = null;
        Navigation.NavigateTo(href);
        return Task.CompletedTask;
    }

    private async Task SavePanelAsync(PanelSettings settings) => _panel = await Personal.SavePanelAsync(settings);

    private ToolContext ToolContext()
    {
        var route = Navigation.ToBaseRelativePath(Navigation.Uri);
        return new ToolContext(_access!, route, RouteTitle(route),
            Items.Where(i => i.Href.Length > 0).Select(i => new NavEntry(i.Href, L(i.Label), i.Allowed(_access!))).ToList(),
            (id, arg) => InvokeAsync(() => OpenTool(id, arg)), href => InvokeAsync(() => NavigateFromTool(href)));
    }

    /// <summary>Название текущего раздела — для избранного и поддержки.</summary>
    private static string RouteTitle(string route)
    {
        var path = route.Split('?', '#')[0];
        var item = Items.Where(i => i.Href.Length == 0 ? route.Length == 0 : Matches(route, i.Href))
            .OrderByDescending(i => i.Href.Length).FirstOrDefault();
        return item is null ? path : path.Contains('/') ? $"{item.Label}: {path[(path.IndexOf('/') + 1)..]}" : item.Label;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _menuOpen = false;
        _toggled.Clear();
        _ = InvokeAsync(async () =>
        {
            StateHasChanged();
            if (DateTime.UtcNow - _badgeAt > TimeSpan.FromMinutes(1))
            {
                await RefreshBadgeAsync();
            }
        });
    }

    private async Task RefreshBadgeAsync()
    {
        _badgeAt = DateTime.UtcNow;
        try
        {
            _badge = (await Notifications.ListAsync()).Count;
            StateHasChanged();
        }
        catch (Exception ex) when (UiErrors.IsUserFacing(ex))
        {
            // Счётчик — подсказка; ошибка не мешает работе.
        }
    }

    public async ValueTask DisposeAsync()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        _self?.Dispose();
        await Task.CompletedTask;
    }
}
