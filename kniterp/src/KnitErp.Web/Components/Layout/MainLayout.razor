            new("hr/settings", "Кадры и заработок", a => a.Has(Permissions.OrganizationEdit) || a.Has(Permissions.PayrollCalculate)),
            new("users", "Пользователи", a => a.Has(Permissions.UserView)),
            new("roles", "Роли и права", a => a.Has(Permissions.UserView)),
