@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject KnitErp.Application.Hr.EmployeeAgreementService Agreements
@inject UserAccessService Access
@inject PersonalToolsService Personal
@inject NotificationService Notifications
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject KnitErp.Web.Components.Shared.TabLoadGate LoadGate

<CascadingValue Value="_assistant">
<div class="shell @(_narrow ? "narrow" : "")">
    <nav class="side" aria-label="@L("Разделы")">
        <div class="side-head">
            <a href="" class="logo" title="@L("Главная")"><LogoMark Size="28" /><span class="logo-text">knit<span style="color: color-mix(in srgb, var(--accent) 80%, var(--text))">ERP</span></span></a>
            @if (_access is not null && _panel is not null)
            {
                @* Телефон и узкий планшет: инструменты и профиль — в этой же строке, одной кнопкой. *@
                <div class="side-tools">
                    <QuickBar Access="_access" Settings="_panel" Compact="true" ActiveTool="@_activeTool" Badge="_badge" OnOpen="OpenTool" OpenWindows="Windows" />
                </div>
            }
            @* На телефоне меню свёрнуто в кнопку, чтобы не занимать экран над страницей. *@
            <button type="button" class="secondary menu-toggle" aria-expanded="@(_menuOpen ? "true" : "false")" aria-controls="nav-body"
                    @onclick="() => _menuOpen = !_menuOpen">@(_menuOpen ? L("Закрыть") : L("Меню"))</button>
        </div>
        <div id="nav-body" class="nav-body @(_menuOpen ? "open" : "")">
        @if (_access is not null)
        {
            @* D805: поиск по разделам и документам — первым, с подсказкой сочетания клавиш. *@
            <button type="button" class="nav-search" @onclick="() => OpenTool(ToolCatalog.Search)" title="@L("Быстрый поиск (Ctrl+K)")">
                <Icon Name="search" Size="16" /><span class="nav-text">@L("Найти раздел или документ")</span><kbd class="nav-text" aria-hidden="true">Ctrl K</kbd>
            </button>
            @if (_favorites is { Count: > 0 } favorites)
            {
                @* D805: избранное пользователя (инструмент «Избранное») — сверху меню. *@
                <div class="nav-favorites" aria-label="@L("Избранное")">
                    <span class="nav-section nav-text">@L("Избранное")</span>
                    @foreach (var f in favorites.Take(7))
                    {
                        <a href="@f.Href" class="@(Matches(Navigation.ToBaseRelativePath(Navigation.Uri), f.Href) ? "active" : null)" title="@f.Title">
                            <Icon Name="favorites" Size="14" /><span class="nav-text">@f.Title</span>
                        </a>
                    }
                </div>
            }
            @foreach (var group in Ordered)
            {
                var allowed = group.Items.Where(i => i.Allowed(_access)).ToList();
                if (allowed.Count == 0)
                {
                    continue; // D800: раздел без единого доступного пункта не показывается
                }

                var open = IsOpen(group);
                @if (group.Items.Length == 1)
                {
                    var item = allowed[0];
                    <NavLink class="nav-single" href="@item.Href" Match="@(item.Href == "" ? NavLinkMatch.All : NavLinkMatch.Prefix)" title="@L(group.Title)"
                             style="@($"--sec: var(--sec-{group.Key})")">
                        <Icon Name="@group.Key" Size="16" /><span class="nav-text">@L(group.Title)</span>
                    </NavLink>
                    continue;
                }

                @if (group.Key == "settings")
                {
                    @* D808 (раздел 0, п. 8): «Настройки» — один пункт, ведёт на страницу всех настроек; пункты раздела — плитки на ней. *@
                    var here = Navigation.ToBaseRelativePath(Navigation.Uri) == SettingsHref || allowed.Any(i => i.Href == Current);
                    <a class="nav-single @(here ? "active" : null)" href="@SettingsHref" title="@L(group.Title)" aria-current="@(here ? "page" : null)"
                       style="@($"--sec: var(--sec-{group.Key})")">
                        <Icon Name="@group.Key" Size="16" /><span class="nav-text">@L(group.Title)</span>
                    </a>
                    continue;
                }

                var shown = MenuItems(group, allowed);
                <div class="nav-group @(open ? "open" : "")" style="@($"--sec: var(--sec-{group.Key})")">
                    <button type="button" class="nav-group-head" aria-expanded="@(open ? "true" : "false")" title="@L(group.Title)"
                            @onclick="() => Toggle(group)">
                        <Icon Name="@group.Key" Size="16" /><span class="nav-text">@L(group.Title)</span><span class="caret" aria-hidden="true">▾</span>
                    </button>
                    @if (open)
                    {
                        <div class="nav-items">
                            @foreach (var item in shown)
                            {
                                <a href="@item.Href" class="@(item.Href == Current ? "active" : null)" aria-current="@(item.Href == Current ? "page" : null)">@L(item.Label)</a>
                            }
                            @if (allowed.Count > shown.Count)
                            {
                                var sectionHref = "section/" + group.Key;
                                <a href="@sectionHref" class="nav-all @(Navigation.ToBaseRelativePath(Navigation.Uri) == sectionHref ? "active" : null)">@L("Все в разделе") <span class="muted">@allowed.Count →</span></a>
                            }
                        </div>
                    }
                </div>
            }
            <NavTags Route="@Navigation.ToBaseRelativePath(Navigation.Uri)" Narrow="_narrow" />
            <button type="button" class="nav-collapse" @onclick="ToggleNarrow" title="@(_narrow ? L("Развернуть меню") : L("Свернуть меню"))" aria-label="@(_narrow ? L("Развернуть меню") : L("Свернуть меню"))">@(_narrow ? "»" : "«")</button>
        }
        </div>
        @if (_access is not null)
        {
            <SideFooter Access="_access" Narrow="_narrow" Route="@Navigation.ToBaseRelativePath(Navigation.Uri)" OnOpen="OpenTool" />
        }
    </nav>
    <div class="main-col">
        <SessionEndingBanner />
        @if (_access is not null && _panel is not null)
        {
            <header class="topbar">
                <QuickBar Access="_access" Settings="_panel" ActiveTool="@_activeTool" Badge="_badge" OnOpen="OpenTool" OpenWindows="Windows" />
            </header>
        }
        @* D816 (раздел 0 п. 7): уход со страницы с несохранённой формой — вопрос; ответ «Отмена» оставляет на странице. *@
        <NavigationLock OnBeforeInternalNavigation="ConfirmLeaveAsync" />
        <main class="main">
            @if (_access is null)
            {
                <p class="muted">@L("Загрузка…")</p>
            }
            else
            {
                @* Страница начинает работу после меню: у вкладки один DbContext, параллельных запросов к нему быть не должно.
                   Инструменты панели работают со своим DbContext на каждую операцию и страницу не трогают. *@
                <CascadingValue Value="_access" IsFixed="true">
                    @if (_agreements is { Count: > 0 })
                    {
                        @* D227 (сессия «Сотрудники»): сначала документы перед доступом — потом страницы системы. *@
                        <AgreementsGate Documents="_agreements" Signed="LoadAgreementsAsync" />
                    }
                    else
                    {
                        @Body
                    }
                </CascadingValue>
            }
        </main>
    </div>
    @if (_access is not null)
    {
        @* D805 (раздел 0): на телефоне — нижняя панель: главная, до трёх главных разделов этой роли и «Ещё» (всё меню). *@
        <nav class="bottom-nav" aria-label="@L("Главные разделы")">
            <NavLink href="" Match="NavLinkMatch.All"><Icon Name="home" Size="20" /><span>@L("Главная")</span></NavLink>
            @foreach (var group in BottomGroups())
            {
                <NavLink href="@("section/" + group.Key)"><Icon Name="@group.Key" Size="20" /><span>@L(group.Title)</span></NavLink>
            }
            <button type="button" class="@(_menuOpen ? "active" : null)" aria-expanded="@(_menuOpen ? "true" : "false")" aria-controls="nav-body"
                    @onclick="() => _menuOpen = !_menuOpen"><Icon Name="all" Size="20" /><span>@L("Ещё")</span></button>
        </nav>
    }
    @if (_access is not null && _panel is not null && _opened.Count > 0)
    {
        <ToolDrawer Context="ToolContext()" Settings="_panel" Active="@_activeTool" Opened="_opened" HelpArticleId="@_helpArticle"
                    OnClose="CloseTool" OnBadge="count => _badge = count" OnSaveSettings="SavePanelAsync" />
    }
    @if (_calculatorOpen)
    {
        <CalculatorWindow OnClose="() => _calculatorOpen = false" />
    }
    @if (_access is not null && _assistant.Persona != KnitErp.Application.Workspace.AssistantPersonas.None)
    {
        @* D116: персонаж помощника (Ника или Книт) в углу экрана; кнопка в его панели открывает чат помощника (knit:action → OnHotkey). *@
        <knit-assistant id="knit" animated persona="@_assistant.Persona" texts="@AssistantTexts()"></knit-assistant>
    }
</div>
</CascadingValue>

