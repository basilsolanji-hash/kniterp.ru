    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        // Страница (@Body) показывается, как только задан _access. Поэтому доступ присваивается последним, после всех запросов меню:
        // иначе любая перерисовка (OnAfterRenderAsync, переход) запускала страницу параллельно с меню на общем DbContext вкладки —
        // «A second operation was started on this context», вкладка падала (аудит 13.10, терминал цеха под нагрузкой).
        var access = await Access.GetCurrentAccessAsync();
        await LoadAgreementsAsync();
        try
        {
            _assistant = new AssistantChoice(await Personal.GetAssistantPersonaAsync(), SetPersonaAsync);
        }
        catch (Exception ex) when (UiErrors.IsUserFacing(ex))
        {
            _assistant = new AssistantChoice(KnitErp.Application.Workspace.AssistantPersonas.Nika, SetPersonaAsync);
        }

        try
        {
            _panel = await Personal.GetPanelAsync();
        }
        catch (Exception ex) when (UiErrors.IsUserFacing(ex))
        {
            // Панель не должна мешать работе: без настроек показываем панель по умолчанию.
            _panel = new PanelSettings(ToolCatalog.DefaultPinned, ToolCatalog.DefaultVisible);
        }

        await LoadFavoritesAsync();
        _access = access;
    }

