    /// <summary>Пункты группы в меню: частые, на которые есть право, и текущая страница, если она среди редких.</summary>
    private List<NavItem> MenuItems(NavGroup group, List<NavItem> allowed)
    {
        if (!MainHrefs.TryGetValue(group.Key, out var main))
        {
            return allowed;
        }

        var current = Current;
        return allowed.Where(i => main.Contains(i.Href)).OrderBy(i => Array.IndexOf(main, i.Href))
            .Concat(allowed.Where(i => i.Href == current && !main.Contains(i.Href))).ToList();
    }

    /// <summary>Разделы нижней панели телефона: первые три доступных из главных участков работы.</summary>
    private IEnumerable<NavGroup> BottomGroups() =>
        new[] { "sales", "warehouse", "production", "money", "crm", "purchases", "hr" }
            .Select(k => Groups.Single(g => g.Key == k)).Where(g => g.Items.Any(i => i.Allowed(_access!))).Take(3);

    private static readonly NavItem[] Items = Groups.SelectMany(g => g.Items).Where(i => !i.Planned).ToArray();

    private string? _openKey;
    private IReadOnlyList<KnitErp.Application.Workspace.FavoriteItem>? _favorites;
    private bool _narrow;

    /// <summary>
    /// Пункт меню текущей страницы — один: точное совпадение с параметрами («Поступления» = stock-documents?kind=1)
    /// важнее общего раздела, длинный адрес — важнее короткого.
    /// </summary>
    private string? Current
    {
        get
        {
            var path = Navigation.ToBaseRelativePath(Navigation.Uri);
            return Items.Where(i => i.Href.Length > 0 && Matches(path, i.Href))
                .OrderByDescending(i => i.Href.Contains('?')).ThenByDescending(i => i.Href.Length)
                .Select(i => i.Href).FirstOrDefault();
        }
    }

    /// <summary>Раздел раскрыт, если в нём текущая страница; щелчок по заголовку меняет это состояние.</summary>
    private bool IsOpen(NavGroup group)
    {
        if (_openKey is not null)
        {
            return _openKey == group.Key;
        }

        var current = Current;
        var path = Navigation.ToBaseRelativePath(Navigation.Uri);
        return group.Items.Any(i => i.Href == current) || path == "section/" + group.Key;
    }

    private static bool Matches(string path, string href)
    {
        var p = path.Split('#')[0];
        var h = href;
        if (h.Contains('?'))
        {
            return p == h || p.StartsWith(h + "&", StringComparison.Ordinal);
        }

        var bare = p.Split('?')[0];
        return bare == h || bare.StartsWith(h + "/", StringComparison.Ordinal);
    }

