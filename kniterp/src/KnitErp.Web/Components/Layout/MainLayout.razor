    private DotNetObjectReference<MainLayout>? _self;

    private AssistantChoice _assistant = new(KnitErp.Application.Workspace.AssistantPersonas.Nika, _ => Task.CompletedTask);

    /// <summary>D116: смена персонажа из меню профиля — сохраняется в профиле и сразу меняет персонажа на экране и в чате.</summary>
    private async Task SetPersonaAsync(string persona)
    {
        try
        {
            persona = await Personal.SetAssistantPersonaAsync(persona);
        }
        catch (Exception ex) when (UiErrors.IsUserFacing(ex))
        {
            return;
        }

        _assistant = new AssistantChoice(persona, SetPersonaAsync);
        StateHasChanged();
    }

