            new("catalog/settings?tab=Characteristics", "Характеристики", a => a.Has(Permissions.CatalogView)),
            new("catalog/settings?tab=Fields", "Доп. поля номенклатуры", a => a.Has(Permissions.CatalogView)),
            new("catalog/settings?tab=Catalogs", "Свои справочники", a => a.Has(Permissions.CatalogView)),
            new("sales-settings?section=projects", "Проекты", a => a.Has(Permissions.SalesView)),
