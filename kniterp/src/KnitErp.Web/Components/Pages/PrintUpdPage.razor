@page "/print/upd/{Id:long}"
@layout KnitErp.Web.Components.Layout.PrintLayout
@using KnitErp.Application.Printing
@using KnitErp.Application.Sales
@using KnitErp.Domain.Sales
@inject PrintService Print
@inject SalesDocumentPrintService Extras

@*
    УПД со статусом 1 или 2 и отдельный счёт-фактура по проведённой отгрузке (D68, D71, D1141); лист — UpdSheet.
    Переключатель вверху — другие формы этой отгрузки: ТОРГ-12, транспортная накладная.
*@
<PageTitle>@(_doc is null ? "УПД" : _form == UpdForm.VatInvoice ? $"Счёт-фактура {_doc.Number}" : $"УПД {_doc.Number}") — knitERP</PageTitle>
<style>@@media print { @@page { size: A4 landscape; margin: 7mm; } }</style>

<SalesPrintStyles />
<div class="print-bar">
    <button type="button" data-print>@L("Печать")</button>
    <a href="stock-documents/@Id">@L("← К отгрузке")</a>
    @if (_doc is not null)
    {
        <span class="sx-form-switch" role="group" aria-label="@L("Форма документа")">
            <a href="print/upd/@Id?form=upd1" class="@(_form == UpdForm.Status1 ? "on" : null)">@L("УПД, статус 1")</a>
            <a href="print/upd/@Id?form=upd2" class="@(_form == UpdForm.Status2 ? "on" : null)">@L("УПД, статус 2")</a>
            <a href="print/upd/@Id?form=sf" class="@(_form == UpdForm.VatInvoice ? "on" : null)">@L("Счёт-фактура")</a>
            <a href="print/torg12/@Id">@L("ТОРГ-12")</a>
            <a href="print/ttn/@Id">@L("Транспортная накладная")</a>
        </span>
    }
</div>
@if (_doc is { Warnings.Count: > 0 })
{
    <div class="print-bar" style="display: block">
        <b class="warn">@L("Проверьте перед печатью:")</b>
        <ul style="margin: 4px 0 0 18px; padding: 0">
            @foreach (var w in _doc.Warnings)
            {
                <li class="warn">@w</li>
            }
        </ul>
    </div>
}

@if (_error is not null)
{
    <div class="sheet"><p>@_error</p></div>
}
else if (_doc is null)
{
    <div class="sheet"><p>@L("Загрузка…")</p></div>
}
else
{
    <UpdSheet Doc="_doc" Deco="_deco" Form="_form" />
}

@code {
    [Parameter]
    public long Id { get; set; }

    [SupplyParameterFromQuery(Name = "form")]
    public string? FormQuery { get; set; }

    private UpdPrintDto? _doc;
    private UpdForm _form;
    private SalesPrintDecorations _deco = SalesPrintDecorations.None;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            _doc = await Print.UpdAsync(Id);
            _form = UpdSheet.Parse(FormQuery, _doc);
            _deco = await Extras.DecorationsAsync(SalesMailDocument.Upd, Id); // D1120: печать и подписи по настройкам юрлица
        }
        catch (Exception ex) when (UiErrors.IsUserFacing(ex))
        {
            _error = UiErrors.Message(ex);
        }
    }
}
