@page "/"
@using System.Globalization
@using KnitErp.Application.Finance
@using KnitErp.Domain.Organizations
@using KnitErp.Application.Workspace
@using KnitErp.Web.Components.Shared
@inject DashboardService Dashboard
@inject PersonalToolsService Personal

<PageTitle>@L("Главная") — knitERP</PageTitle>

@*
    Главный экран (D74, D80): приветствие и дата → блоки в порядке пользователя (показатели, деньги на счетах и в кассах,
    что требует внимания, должники, динамика, документы, склад за месяц, справочно). Порядок и видимость блоков — личная
    настройка («Настроить»). Каждый блок — только при правах на его данные; без прав на деньги показатели — операционные.
*@
@if (_denied is not null)
{
    <AccessDenied Message="@_denied" />
}
else if (_data is null)
{
    <p class="muted">@L("Загрузка…")</p>
}
else
{
    var now = TimeZones.ToLocal(DateTime.UtcNow, CurrentAccess.TimeZoneId);
    var f = _data.Finance;
    var sales = _data.Charts.FirstOrDefault(c => c.Href == "reports/customer-balances");
    var receipts = _data.Charts.FirstOrDefault(c => c.Href == "customer-payments");
    var layout = _data.Layout ?? DashboardBlocks.Default;

    <div class="dash-head">
        <div>
            <h1>@Greeting(now.Hour), @CurrentAccess.DisplayName</h1>
            <div class="muted">@_data.OrganizationName · @now.ToString("dddd, d MMMM yyyy", CultureInfo.CurrentCulture)</div>
        </div>
        <div class="dash-tools">
            @if (layout.Shows(DashboardBlocks.Readiness) && _data.ReadinessPercent is { } ready && ready < 100)
            {
                <a class="readiness" href="launch">
                    <span>@L("Готовность к запуску")</span>
                    <span class="bar"><span style="width: @(ready)%"></span></span>
                    <b>@ready%</b>
                </a>
            }
            <span class="muted small" title="@L("Данные главного экрана обновляются раз в минуту")">@L("на {0}", TimeZones.ToLocal(_data.CachedAtUtc, CurrentAccess.TimeZoneId).ToString("HH:mm"))</span>
            <button type="button" class="secondary icon" @onclick="RefreshAsync" disabled="@_busy" title="@L("Обновить")" aria-label="@L("Обновить")">⟳</button>
            <button type="button" class="secondary" @onclick="ToggleSetup" disabled="@_busy" aria-expanded="@(_setup is not null)">@L("Настроить")</button>
        </div>
    </div>

    @if (_message is not null)
    {
        <div class="flash error" role="alert">@_message</div>
    }

    @if (_setup is not null)
    {
        <section class="dash-box dash-setup">
            <h2>@L("Блоки главного экрана")</h2>
            <p class="muted">@L("Отметьте, что показывать, и расставьте стрелками. Настройка — только ваша; скрытые блоки не считаются, экран открывается быстрее.")</p>
            <ul>
                @for (var i = 0; i < _setup.Count; i++)
                {
                    var index = i;
                    var block = _setup[i];
                    <li @key="block.Key">
                        <label class="inline"><input type="checkbox" checked="@block.Visible" @onchange="e => block.Visible = e.Value is true" /> @BlockName(block.Key)</label>
                        @if (block.Key != DashboardBlocks.Readiness)
                        {
                            <span>
                                <button type="button" class="secondary icon" @onclick="() => Move(index, -1)" disabled="@(index == 0)" title="@L("Выше")" aria-label="@L("Выше: {0}", BlockName(block.Key))">↑</button>
                                <button type="button" class="secondary icon" @onclick="() => Move(index, 1)" disabled="@(index >= _setup.Count - 2)" title="@L("Ниже")" aria-label="@L("Ниже: {0}", BlockName(block.Key))">↓</button>
                            </span>
                        }
                    </li>
                }
            </ul>
            <h2 style="margin-top: 14px">@L("Быстрые действия")</h2>
            <p class="muted">@L("Кнопки наверху экрана: отметьте нужные и расставьте стрелками. Показываются только действия, доступные вашей роли.")</p>
            <ul>
                @for (var i = 0; i < _actionSetup!.Count; i++)
                {
                    var index = i;
                    var row = _actionSetup[i];
                    var action = DashboardActions.Find(row.Key)!;
                    <li @key="row.Key">
                        <label class="inline"><input type="checkbox" checked="@row.Visible" @onchange="e => row.Visible = e.Value is true" /> @ActionTitle(action.Key)</label>
                        <span>
                            <button type="button" class="secondary icon" @onclick="() => MoveAction(index, -1)" disabled="@(index == 0)" title="@L("Выше")" aria-label="@L("Выше: {0}", ActionTitle(action.Key))">↑</button>
                            <button type="button" class="secondary icon" @onclick="() => MoveAction(index, 1)" disabled="@(index >= _actionSetup.Count - 1)" title="@L("Ниже")" aria-label="@L("Ниже: {0}", ActionTitle(action.Key))">↓</button>
                        </span>
                    </li>
                }
            </ul>
            <div class="actions">
                <button type="button" @onclick="SaveSetupAsync" disabled="@_busy">@L("Сохранить")</button>
                <button type="button" class="secondary" @onclick="ResetSetupAsync" disabled="@_busy">@L("Как было по умолчанию")</button>
                <button type="button" class="secondary" @onclick="() => _setup = null">@L("Отмена")</button>
            </div>
        </section>
    }

    <div class="dash-blocks">
        @foreach (var block in layout.Visible)
        {
            @switch (block)
            {
                case DashboardBlocks.Actions:
                    @ActionsBlock(layout)
                    break;
                case DashboardBlocks.Kpi:
                    @Kpis(f, sales, receipts)
                    break;
                case DashboardBlocks.Money:
                    @MoneyBlock(f)
                    break;
                case DashboardBlocks.Attention:
                    @AttentionBlock(f, layout.Shows(DashboardBlocks.Debtors) && f is { TopDebtors.Count: > 0 })
                    break;
                case DashboardBlocks.Debtors:
                    @DebtorsBlock(f)
                    break;
                case DashboardBlocks.Charts:
                    @if (_data.Charts.Count > 0)
                    {
                        <section class="wide">
                            <h2 class="section-title">@L("Динамика за 30 дней")</h2>
                            <div class="charts charts-large">
                                @foreach (var c in _data.Charts)
                                {
                                    <LineChart Chart="c" Large="true" />
                                }
                            </div>
                        </section>
                    }
                    break;
                case DashboardBlocks.Recent:
                    @RecentBlock()
                    break;
                case DashboardBlocks.Month:
                    @if (_data.Month is { } m)
                    {
                        <section class="dash-box span-3">
                            <h2>@L("Склад за месяц") <span class="muted">@m.From.ToString("dd.MM") – @m.To.ToString("dd.MM.yyyy")</span></h2>
                            <div class="mini-stats">
                                <a href="stock-documents?kind=1"><b>@m.Receipts</b><span>@L("Поступления")</span></a>
                                <a href="stock-documents?kind=3"><b>@m.Transfers</b><span>@L("Перемещения")</span></a>
                                <a href="stock-documents?kind=2"><b>@m.WriteOffs</b><span>@L("Списания")</span></a>
                                <a href="inventory"><b>@m.Inventories</b><span>@L("Инвентаризации")</span></a>
                            </div>
                        </section>
                    }
                    break;
                case DashboardBlocks.Reference:
                    var reference = _data.Tiles.Where(t => !AttentionHrefs.Contains(t.Href)).ToList();
                    @if (reference.Count > 0)
                    {
                        <section class="dash-box span-3">
                            <h2>@L("Справочно")</h2>
                            <div class="mini-stats">
                                @foreach (var t in reference)
                                {
                                    <a href="@t.Href" title="@L(t.Hint)"><b>@t.Value</b><span>@L(t.Title)</span></a>
                                }
                            </div>
                        </section>
                    }
                    break;
            }
        }
    </div>

    @if (_data.Tiles.Count == 0 && f is null)
    {
        <p class="muted">@L("Для вашей роли показателей пока нет. Разделы, доступные вам, — в меню слева.")</p>
    }
}

@code {
    [CascadingParameter]
    public CurrentAccessDto CurrentAccess { get; set; } = default!;

    /// <summary>Плитки сервиса, которые означают «ждёт действия», — в блок «Требует внимания»; остальные — «Справочно».</summary>
    private static readonly HashSet<string> AttentionHrefs = ["stock-documents?status=1", "inventory", "opening-balances"];

    private DashboardDto? _data;
    private string? _denied;
    private string? _message;
    private bool _busy;
    private List<SetupRow>? _setup;
    private List<SetupRow>? _actionSetup;

    /// <summary>Строка панели «Настроить»: блок и его видимость.</summary>
    private sealed class SetupRow(string key, bool visible)
    {
        public string Key { get; } = key;
        public bool Visible { get; set; } = visible;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _data = await Dashboard.GetAsync();
        }
        catch (AccessDeniedException ex)
        {
            _denied = UiErrors.Message(ex);
        }
    }

    private Task RefreshAsync() => RunAsync(async () => _data = await Dashboard.GetAsync(refresh: true));

    private void ToggleSetup()
    {
        if (_setup is not null)
        {
            _setup = null;
            return;
        }

        var layout = _data?.Layout ?? DashboardBlocks.Default;
        _setup = [.. layout.Order.Select(b => new SetupRow(b, layout.Shows(b))), new SetupRow(DashboardBlocks.Readiness, layout.Shows(DashboardBlocks.Readiness))];
        // Действия: выбранные — в их порядке, затем остальные доступные (снятые).
        var chosen = layout.ActionKeys;
        _actionSetup = [.. chosen.Select(k => new SetupRow(k, true)),
            .. DashboardActions.All.Where(a => !chosen.Contains(a.Key) && CurrentAccess.Has(a.Permission)).Select(a => new SetupRow(a.Key, false))];
    }

    private void MoveAction(int index, int delta)
    {
        var target = index + delta;
        if (_actionSetup is null || target < 0 || target >= _actionSetup.Count)
        {
            return;
        }

        (_actionSetup[index], _actionSetup[target]) = (_actionSetup[target], _actionSetup[index]);
    }

    /// <summary>«Готовность к запуску» всегда последняя строка: она в шапке и не переставляется.</summary>
    private void Move(int index, int delta)
    {
        var target = index + delta;
        if (_setup is null || target < 0 || target >= _setup.Count - 1)
        {
            return;
        }

        (_setup[index], _setup[target]) = (_setup[target], _setup[index]);
    }

    private Task SaveSetupAsync() => RunAsync(async () =>
    {
        var rows = _setup!;
        await Personal.SaveDashboardLayoutAsync(new DashboardLayout(
            rows.Where(r => r.Key != DashboardBlocks.Readiness).Select(r => r.Key).ToList(),
            rows.Where(r => !r.Visible).Select(r => r.Key).ToList(),
            _actionSetup!.Where(r => r.Visible).Select(r => r.Key).ToList()));
        _setup = null;
        _data = await Dashboard.GetAsync();
    });

    private Task ResetSetupAsync() => RunAsync(async () =>
    {
        await Personal.ResetDashboardLayoutAsync();
        _setup = null;
        _data = await Dashboard.GetAsync();
    });

    /// <summary>Одна операция за раз: у вкладки один DbContext.</summary>
    private async Task RunAsync(Func<Task> action)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _message = null;
        try
        {
            await action();
        }
        catch (Exception ex) when (UiErrors.IsUserFacing(ex))
        {
            _message = UiErrors.Message(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Подписи быстрых действий — здесь, чтобы перевод проверялся тестом покрытия.</summary>
    private static string ActionTitle(string key) => key switch
    {
        "sales-order" => L("Новый заказ покупателя"),
        "receipt" => L("Поступление на склад"),
        "shipment" => L("Отгрузка"),
        "money-in" => L("Приход денег"),
        "money-out" => L("Расход денег"),
        "purchase-order" => L("Заказ поставщику"),
        "write-off" => L("Списание"),
        "transfer" => L("Перемещение"),
        "inventory" => L("Инвентаризация"),
        "counterparty" => L("Новый контрагент"),
        "item" => L("Новая позиция"),
        "batch" => L("Партии и ярлыки"),
        "stock" => L("Остатки"),
        _ => DashboardActions.Find(key)?.Title ?? key,
    };

    private static string BlockName(string block) => block switch
    {
        DashboardBlocks.Actions => L("Быстрые действия"),
        DashboardBlocks.Kpi => L("Ключевые показатели"),
        DashboardBlocks.Money => L("Деньги на счетах и в кассах"),
        DashboardBlocks.Attention => L("Требует внимания"),
        DashboardBlocks.Debtors => L("Крупнейшие должники"),
        DashboardBlocks.Charts => L("Динамика за 30 дней"),
        DashboardBlocks.Recent => L("Последние документы"),
        DashboardBlocks.Month => L("Склад за месяц"),
        DashboardBlocks.Reference => L("Справочно"),
        DashboardBlocks.Readiness => L("Готовность к запуску"),
        _ => block,
    };

    /// <summary>D108: настраиваемые кнопки ключевых действий — сразу открывают форму создания.</summary>
    private RenderFragment ActionsBlock(DashboardLayout layout) => __builder =>
    {
        var actions = layout.ActionKeys.Select(DashboardActions.Find).Where(a => a is not null && CurrentAccess.Has(a.Permission)).ToList();
        @if (actions.Count > 0)
        {
            <nav class="quick-actions wide" aria-label="@L("Быстрые действия")">
                @foreach (var a in actions)
                {
                    <a href="@a!.Href" class="quick-action" style="--sec: var(--sec-@a.Icon)">
                        <span class="qa-icon"><Icon Name="@a.Icon" Size="18" /></span>
                        <span>@ActionTitle(a.Key)</span>
                    </a>
                }
            </nav>
        }
    };

    private RenderFragment Kpis(DashboardFinanceDto? f, DashboardChartDto? sales, DashboardChartDto? receipts) => __builder =>
    {
        @if (sales is not null || f is { CustomerDebt: not null } or { SupplierDebt: not null } or { Accounts: not null })
        {
            <div class="kpis wide">
                @if (f?.AccountsTotal is { } money)
                {
                    <KpiTile Label="@L("Деньги на счетах и в кассах")" Value="@Amounts.Format(money)" Href="legal-entities" Accent="--sec-home"
                             Hint="@L("все юрлица, на сегодня")" />
                }
                @if (sales is not null)
                {
                    <KpiTile Label="@L("Продажи за 30 дней")" Value="@Amounts.Format(sales.Total)" Href="reports/sales-by-item" Accent="--sec-sales"
                             Delta="Change(sales)" Points="sales.Points" Hint="@L("отгружено − возвраты, с НДС")" />
                }
                @if (receipts is not null)
                {
                    <KpiTile Label="@L("Поступило денег")" Value="@Amounts.Format(receipts.Total)" Href="customer-payments" Accent="--sec-warehouse"
                             Delta="Change(receipts)" Points="receipts.Points" Hint="@L("оплаты покупателей за 30 дней")" />
                }
                @if (f?.CustomerDebt is { } cd)
                {
                    <KpiTile Label="@L("Нам должны покупатели")" Value="@Amounts.Format(cd)" Href="reports/customer-balances" Accent="--sec-crm"
                             Hint="@(f.OverdueAmount is > 0 ? L("просрочено по счетам: {0}", Amounts.Format(f.OverdueAmount)) : L("просроченных счетов нет"))" />
                }
                @if (f?.SupplierDebt is { } sd)
                {
                    <KpiTile Label="@L("Мы должны поставщикам")" Value="@Amounts.Format(sd)" Href="reports/supplier-balances" Accent="--sec-purchases"
                             Hint="@(f.SupplierToPay is > 0 ? L("к оплате по счетам: {0}", Amounts.Format(f.SupplierToPay)) : L("неоплаченных счетов нет"))" />
                }
            </div>
        }
    };

    /// <summary>
    /// Остатки денег по юрлицам (D80): широкая полоса под показателями (D108) — каждый счёт и касса карточкой, по юрлицам;
    /// минус — красным.
    /// </summary>
    private RenderFragment MoneyBlock(DashboardFinanceDto? f) => __builder =>
    {
        @if (f?.Accounts is { } accounts)
        {
            <section class="dash-box wide money-box">
                <h2>@L("Деньги на счетах и в кассах") <span class="money-total @(f.AccountsTotal < 0 ? "neg" : null)">@Amounts.Format(f.AccountsTotal)</span>
                    <a class="muted small" href="legal-entities">@L("Счета, кассы и начальные остатки")</a></h2>
                @if (accounts.Count == 0)
                {
                    <p class="muted">@L("Счетов и касс пока нет.") <a href="legal-entities">@L("Добавить")</a></p>
                }
                else
                {
                    var entities = accounts.GroupBy(a => a.LegalEntity).ToList();
                    var several = entities.Count(g => g.Key.Length > 0) > 1;
                    @foreach (var g in entities)
                    {
                        @if (several && g.Key.Length > 0)
                        {
                            <div class="money-entity"><span>@g.Key</span><b>@Amounts.Format(g.Sum(a => a.Balance))</b></div>
                        }
                        <div class="money-grid">
                            @foreach (var a in g)
                            {
                                <div class="money-card">
                                    <span class="tag">@(a.Kind == MoneyAccountKind.Cash ? L("касса") : a.Kind is null ? L("без счёта") : L("банк"))</span>
                                    <span class="money-name">@(a.AccountId is null ? L("Оплаты без счёта") : a.Name)</span>
                                    <b class="@(a.Balance < 0 ? "neg" : null)">@Amounts.Format(a.Balance)</b>
                                </div>
                            }
                        </div>
                    }
                }
            </section>
        }
    };

    private RenderFragment AttentionBlock(DashboardFinanceDto? f, bool beside) => __builder =>
    {
        <section class="dash-box @(beside ? "span-8" : "wide")">
            <h2>@L("Требует внимания")</h2>
            <ul class="attention">
                @foreach (var t in _data!.Tiles.Where(t => AttentionHrefs.Contains(t.Href)))
                {
                    @Attention(L(t.Title), t.Value, L(t.Hint), t.Href, null)
                }
                @if (f is not null)
                {
                    @if (f.OverdueShipments is { } ls) { @Attention(L("Просроченные отгрузки"), ls, L("дата отгрузки прошла, отгружено не всё"), "sales-orders?overdue=1", null) }
                    @if (f.OverdueInvoices is { } oi) { @Attention(L("Просроченные счета покупателям"), oi, L("оплата не поступила в срок"), "customer-invoices", f.OverdueAmount) }
                    @if (f.OverdueReceipts is { } lr) { @Attention(L("Просроченные поступления"), lr, L("поставщик не привёз в срок"), "purchase-orders?overdue=1", null) }
                    @if (f.OrdersToShip is { } os) { @Attention(L("Заказы ждут отгрузки"), os, L("подтверждены, отгружены не полностью"), "sales-orders", null) }
                    @if (f.SupplierInvoicesToPay is { } sp) { @Attention(L("Счета поставщиков к оплате"), sp, L("не оплачены полностью"), "supplier-invoices", f.SupplierToPay) }
                    @if (f.ReceiptsWithoutVatInvoice is { } rv) { @Attention(L("Приёмки без счёта-фактуры"), rv, L("зарегистрируйте документ поставщика"), "vat-invoices/received", null) }
                    @if (f.MoneyAlerts is { } ma)
                    {
                        @Attention(L("Просроченные авансовые отчёты"), ma.OverdueAdvances.Count, L("срок отчёта подотчётного лица прошёл"), "accountables",
                            ma.OverdueAdvances.Count > 0 ? ma.OverdueAdvances.Sum(o => o.Amount) : null)
                        @if (ma.CashOverLimit.Count > 0)
                        {
                            @Attention(L("Остаток кассы выше лимита"), ma.CashOverLimit.Count, L("сдайте наличные в банк"), "money", ma.CashOverLimit.Sum(c => c.Balance - c.Limit))
                        }
                    }
                }
            </ul>
        </section>
    };

    private RenderFragment DebtorsBlock(DashboardFinanceDto? f) => __builder =>
    {
        @if (f is { TopDebtors.Count: > 0 })
        {
            <section class="dash-box span-4">
                <h2>@L("Крупнейшие должники")</h2>
                <table class="compact">
                    <tbody>
                        @foreach (var d in f.TopDebtors)
                        {
                            var share = f.CustomerDebt is > 0 ? (int)(d.Debt * 100 / f.CustomerDebt.Value) : 0;
                            <tr>
                                <td>@d.Name<div class="share"><span style="width: @(share)%"></span></div></td>
                                <td class="num"><b>@Amounts.Format(d.Debt)</b><div class="muted">@(share)%</div></td>
                            </tr>
                        }
                    </tbody>
                </table>
                <p class="muted"><a href="reports/customer-balances">@L("Все расчёты с покупателями")</a></p>
            </section>
        }
    };

    private RenderFragment RecentBlock() => __builder =>
    {
        @if (_data!.Recent.Count > 0)
        {
            <section class="dash-box span-6">
                <h2>@L("Последние документы")</h2>
                <table class="compact">
                    <thead><tr><th>@L("Дата")</th><th>@L("Документ")</th><th class="opt">@L("Склад")</th><th>@L("Статус")</th></tr></thead>
                    <tbody>
                        @foreach (var d in _data.Recent)
                        {
                            <tr>
                                <td>@d.Date.ToString("dd.MM.yyyy")</td>
                                <td><a href="@d.Href">@L(d.Kind) @d.Number</a></td>
                                <td>@d.Warehouse</td>
                                <td>@L(d.Status)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>
        }
    };

    private static string Greeting(int hour) => hour switch
    {
        >= 5 and < 12 => L("Доброе утро"),
        >= 12 and < 18 => L("Добрый день"),
        >= 18 and < 23 => L("Добрый вечер"),
        _ => L("Доброй ночи"),
    };

    private static decimal? Change(DashboardChartDto c) =>
        c.PreviousTotal == 0 ? null : Math.Round((c.Total - c.PreviousTotal) / c.PreviousTotal * 100, 0);

    /// <summary>Строка «требует внимания»: есть что делать — жёлтый знак «!» и число; нечего — зелёная галочка.</summary>
    private RenderFragment Attention(string title, int count, string hint, string href, decimal? amount) => __builder =>
    {
        <li class="@(count > 0 ? "todo" : "done")">
            <a href="@href">
                <span class="att-mark" aria-hidden="true">@(count > 0 ? "!" : "✓")</span>
                <span class="att-text"><span>@title</span><span class="muted">@hint</span></span>
                <span class="att-count">@(count > 0 ? count.ToString(CultureInfo.InvariantCulture) : L("нет"))
                    @if (amount is > 0) { <span class="muted">@Amounts.Format(amount)</span> }
                </span>
            </a>
        </li>
    };
}
