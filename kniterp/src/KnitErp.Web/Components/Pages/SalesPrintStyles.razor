@* D1120, D1121: логотип, факсимиле подписей, печать и QR для оплаты на печатных формах продаж (стили только этих элементов). *@
<style>
    .sheet .sx-logo { display: block; max-height: 64px; max-width: 260px; margin: 0 0 8px; }
    .sheet .sx-sign { position: relative; }
    .sheet .sx-sig { position: relative; display: inline-block; min-width: 140px; height: 14px; border-bottom: 1px solid #000; margin: 0 6px; vertical-align: bottom; }
    .sheet .sx-sig img { position: absolute; left: 50%; bottom: -12px; transform: translateX(-50%); max-height: 48px; max-width: 150px; }
    .sheet .sx-stamp { position: absolute; left: 36%; top: -44px; width: 150px; height: 150px; object-fit: contain; opacity: .92; pointer-events: none; }
    .sheet .sx-stamp-upd { position: relative; left: 0; top: 0; width: 130px; height: 130px; display: block; }
    .sheet .sx-qr { float: right; width: 136px; margin: 4px 0 6px 14px; text-align: center; font-size: 9px; }
    .sheet .sx-qr svg { display: block; width: 128px; height: 128px; margin: 0 auto 2px; }
    /* D1141: листы форм по отгрузке, переключатель форм, альбомные листы в комплекте документов. */
    .sheet.upd, .sheet.torg12 { max-width: 1400px; }
    .sheet.upd table.goods th, .sheet.upd table.goods td, .sheet.torg12 table.goods th, .sheet.torg12 table.goods td { font-size: 9px; padding: 2px 3px; }
    .sheet.upd .upd-fields div { font-size: 10.5px; }
    .sheet .sx-right { text-align: right; }
    .sheet .sx-box { display: inline-block; min-width: 90px; border: 1px solid #000; padding: 1px 6px; text-align: center; }
    .sheet h2.sx-ttn { font-size: 12px; margin: 10px 0 4px; font-weight: 700; }
    .sheet .sx-blank { display: inline-block; min-width: 220px; border-bottom: 1px solid #000; height: 12px; }
    .print-bar .sx-form-switch { display: inline-flex; flex-wrap: wrap; gap: 4px; margin-left: 8px; }
    .print-bar .sx-form-switch a { padding: 3px 8px; border: 1px solid #C9C9D0; border-radius: 4px; background: #fff; text-decoration: none; }
    .print-bar .sx-form-switch a.on { background: #1B6F66; border-color: #1B6F66; color: #fff; }
    @@media print { .sheet.upd, .sheet.torg12 { page: land; } .sheet { break-inside: auto; } }
    @@page land { size: A4 landscape; margin: 7mm; }
</style>
