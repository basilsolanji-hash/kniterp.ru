@page "/employees"
@using KnitErp.Application.Structure
@using KnitErp.Domain.Structure
@using KnitErp.Web.Components.Shared
@inject KnitErp.Application.Hr.PersonalDataService PersonalData
@inject EmployeeService Employees
@inject EmployeeExchangeService Exchange
@inject KnitErp.Application.Hr.HrSettingsService HrSettings
@inject KnitErp.Application.Structure.StructureService Structure

<PageTitle>@L("Сотрудники") — knitERP</PageTitle>
<StepUpDialog @ref="_stepUp" />

@if (_denied is not null)
{
    <AccessDenied Message="@_denied" />
}
else if (_list is null)
{
    <p class="muted">@L("Загрузка…")</p>
}
else
{
    <div class="page-head">
        <h1>@(_list.OwnOnly ? L("Моя карточка") : L("Сотрудники"))</h1>
        @if (_list.CanEdit && _mode == Mode.None)
        {
            <button type="button" @onclick="OpenHireAsync" disabled="@_busy">@L("Принять сотрудника")</button>
        }
    </div>

    @if (_list.IsScoped)
    {
        <p class="muted">@L("Вы видите сотрудников своего подразделения и вложенных в него.")</p>
    }

    @if (_flash is not null)
    {
        <div class="@(_flashIsError ? "flash error" : "flash")" role="@(_flashIsError ? "alert" : "status")"><span>@_flash</span><button type="button" class="link" aria-label="@L("Закрыть сообщение")" @onclick="() => _flash = null">×</button></div>
    }

    @if (_mode is Mode.Hire or Mode.Edit)
    {
        <div class="panel">
            <h2>@(_mode == Mode.Hire ? L("Приём сотрудника") : L("Карточка: {0}", _target!.FullName))</h2>
            @if (_options is { Departments.Count: 0 } or { Positions.Count: 0 })
            {
                <p class="muted">@(CurrentAccess.Has(Permissions.DepartmentEdit)
                    ? L("Подразделений или должностей пока нет — добавьте их кнопкой «+ Добавить» под списком.")
                    : L("Подразделений или должностей пока нет — их заводит пользователь с правом «Структура: изменение».") )</p>
            }
            <EditForm Model="_form" OnValidSubmit="SaveAsync" FormName="employee">
                <div class="grid">
                    <label>@L("Табельный номер") <InputText @bind-Value="_form.PersonnelNumber" maxlength="20" required /></label>
                    <label>@L("Дата приёма") <InputDate @bind-Value="_form.HiredOn" disabled="@(_mode == Mode.Edit)" title="@((_mode == Mode.Edit) ? L("Дата приёма меняется кадровым приказом") : null)" /></label>
                    <label>@L("Фамилия") <InputText @bind-Value="_form.LastName" maxlength="100" required /></label>
                    <label>@L("Имя") <InputText @bind-Value="_form.FirstName" maxlength="100" required /></label>
                    <label>@L("Отчество") <InputText @bind-Value="_form.MiddleName" maxlength="100" /></label>
                    @if (_mode == Mode.Edit && _list?.CanEditPersonalData == true) @* D130: дата рождения — ПДн *@
                    {
                        <label>@L("Дата рождения") <InputDate @bind-Value="_form.BirthDate" /></label>
                        <label class="inline"><InputCheckbox @bind-Value="_form.ShareBirthday" /> @L("Сотрудник согласен, чтобы коллеги видели день рождения (без года)")</label>
                    }
                    @* D815: нужного нет в списке — «+ Добавить» здесь же (с правом «Структура: изменение»). *@
                    <LookupSelect Label="@L("Подразделение")" Required="true" EmptyText="@L("— выберите —")"
                                  Options="@((_options?.Departments ?? []).Select(x => new LookupSelect.Option(x.Id, x.Name)).ToList())"
                                  Value="@(_form.DepartmentId == 0 ? null : _form.DepartmentId)" ValueChanged="@(v => _form.DepartmentId = v ?? 0)"
                                  Create="@(CurrentAccess.Has(Permissions.DepartmentEdit) ? name => Structure.CreateDepartmentAsync(name, null) : null)" />
                    @* D815: нужного нет в списке — «+ Добавить» здесь же (с правом «Структура: изменение»). *@
                    <LookupSelect Label="@L("Должность")" Required="true" EmptyText="@L("— выберите —")"
                                  Options="@((_options?.Positions ?? []).Select(x => new LookupSelect.Option(x.Id, x.Name)).ToList())"
                                  Value="@(_form.PositionId == 0 ? null : _form.PositionId)" ValueChanged="@(v => _form.PositionId = v ?? 0)"
                                  Create="@(CurrentAccess.Has(Permissions.DepartmentEdit) ? name => Structure.CreatePositionAsync(name) : null)" />
                </div>
                @if (_formError is not null)
                {
                    <div class="error" role="alert">@_formError</div>
                }
                <div class="actions">
                    <button type="submit" disabled="@_busy">@(_mode == Mode.Hire ? L("Принять") : L("Сохранить"))</button>
                    <button type="button" class="secondary" @onclick="Close" disabled="@_busy">@L("Отмена")</button>
                </div>
            </EditForm>
        </div>
    }

    @if (_mode == Mode.Dismiss)
    {
        <div class="panel">
            <h2>@L("Увольнение:") @_target!.FullName</h2>
            <p class="muted">
                @L("Карточка закрывается для изменений, история сохраняется.")
                @if (_target.UserId is not null)
                {
                    <text>@L("У сотрудника есть учётная запись — доступ к организации будет заблокирован в той же операции.")</text>
                }
            </p>
            <EditForm Model="_form" OnValidSubmit="DismissAsync" FormName="dismiss">
                <div class="grid">
                    <label>@L("Дата увольнения") <InputDate @bind-Value="_form.DismissedOn" required /></label>
                    <label>@L("Причина (обязательна)") <InputText @bind-Value="_form.Reason" maxlength="500" required /></label>
                </div>
                @if (_formError is not null)
                {
                    <div class="error" role="alert">@_formError</div>
                }
                <div class="actions">
                    <button type="submit" disabled="@_busy">@L("Уволить")</button>
                    <button type="button" class="secondary" @onclick="Close" disabled="@_busy">@L("Отмена")</button>
                </div>
            </EditForm>
        </div>
    }

    @if (!_list.OwnOnly)
    {
        <ImportPanel ExportHref="employees.xlsx" TemplateHref="employees-template.xlsx" CanImport="@_list.CanEdit"
                     Hint="@L("Загрузка принимает новых сотрудников и обновляет ФИО, подразделение и должность существующих по табельному номеру.")"
                     ShownColumns="@([0, 1, 2, 4])" Preview="s => Exchange.PreviewAsync(s)" Apply="r => Exchange.ApplyAsync(r)" Applied="ReloadAsync" />

        <form data-autosubmit class="inline-form" @onsubmit="ReloadAsync">
            <label>@L("Поиск") <input @bind="_search" placeholder="@L("Фамилия, имя или табельный номер")" /></label>
            <label class="inline"><input type="checkbox" @bind="_includeDismissed" /> @L("Показать уволенных")</label>
            <button type="submit" class="filter-apply secondary" disabled="@_busy">@L("Найти")</button>
        </form>
    }

    @if (_completeness is { Employees.Count: > 0 } cl)
    {
        @* D226: сводка заполненности личных дел видимых сотрудников. *@
        <div class="panel">
            <h2>@L("Заполненность личных дел: {0} %", (int)cl.Employees.Values.Average(c => c.Percent))</h2>
            <ul class="small">
                @foreach (var item in SummaryItems)
                {
                    var n = cl.Count(item);
                    if (n > 0)
                    {
                        <li>@L(item): @L("не хватает у {0}", n)</li>
                    }
                }
            </ul>
        </div>
    }

    <div class="scroll">
        <table>
            <thead>
                <tr>
                    <th class="opt">@L("Таб. №")</th><th>@L("Сотрудник")</th><th>@L("Подразделение")</th><th class="opt">@L("Должность")</th><th>@L("Статус")</th><th class="opt">@L("Учётная запись")</th>
                    @if (_completeness is not null) { <th class="num opt">@L("Заполнено")</th> }
                    @if (_list.CanEdit)
                    {
                        <th>@L("Действия")</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (_list.Employees.Count == 0)
                {
                    <tr><td colspan="7" class="muted">@(_list.OwnOnly ? L("Карточка сотрудника не привязана к вашей учётной записи.") : L("Сотрудников не найдено."))</td></tr>
                }
                @foreach (var e in _list.Employees)
                {
                    <tr class="@(e.Status == EmploymentStatus.Dismissed ? "archived" : null)">
                        <td>@e.PersonnelNumber</td>
                        <td><a href="employees/@e.Id">@e.FullName</a><div class="muted">@L("с {0}", e.HiredOn.ToString("dd.MM.yyyy"))</div></td>
                        <td>@e.DepartmentName</td>
                        <td>@e.PositionName</td>
                        <td>
                            <span class="tag @StatusClass(e.Status)">@L(e.StatusName)</span>
                            @if (e.DismissedOn is { } d)
                            {
                                <div class="muted">@d.ToString("dd.MM.yyyy")</div>
                            }
                        </td>
                        <td>@(e.UserEmail ?? "—")</td>
                        @if (_completeness is not null)
                        {
                            <td class="num">
                                @if (_completeness.Employees.TryGetValue(e.Id, out var c))
                                {
                                    <span class="@(c.Percent < 100 ? "neg" : "")" title="@string.Join(", ", c.Missing.Select(m => L(m)))">@c.Percent %</span>
                                }
                            </td>
                        }
                        @if (_list.CanEdit)
                        {
                            <td>
                                @if (e.Status != EmploymentStatus.Dismissed)
                                {
                                    <div class="row-actions">
                                        <button type="button" class="secondary" @onclick="() => OpenEditAsync(e)" disabled="@(_busy || _mode != Mode.None)" title="@((_mode != Mode.None) ? L("Сначала сохраните или закройте открытую форму") : null)">@L("Изменить")</button>
                                        @if (!_leaveOnlyByOrder)
                                        {
                                            <button type="button" class="secondary" @onclick="() => ToggleLeaveAsync(e)" disabled="@(_busy || _mode != Mode.None)" title="@((_mode != Mode.None) ? L("Сначала сохраните или закройте открытую форму") : null)">
                                                @(e.Status == EmploymentStatus.OnLeave ? L("Вернуть из отпуска") : L("В отпуск"))
                                            </button>
                                        }
                                        <button type="button" class="secondary" @onclick="() => OpenDismiss(e)" disabled="@(_busy || _mode != Mode.None)" title="@((_mode != Mode.None) ? L("Сначала сохраните или закройте открытую форму") : null)">@L("Уволить")</button>
                                    </div>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private StepUpDialog? _stepUp;

    private enum Mode { None, Hire, Edit, Dismiss }

    [CascadingParameter]
    public CurrentAccessDto CurrentAccess { get; set; } = default!;

    private EmployeeListDto? _list;
    private EmployeeOptionsDto? _options;
    private EmployeeForm _form = new();
    private EmployeeRowDto? _target;
    private Mode _mode;
    private bool _busy;
    private string? _denied;
    private string? _formError;
    private string? _flash;
    private bool _flashIsError;
    private string _search = string.Empty;
    private bool _includeDismissed;
    private bool _leaveOnlyByOrder;
    private KnitErp.Application.Hr.CompletenessListDto? _completeness;

    /// <summary>Что показывать в сводке заполненности (D226) — самое нужное кадрам.</summary>
    private static readonly string[] SummaryItems =
    [
        "Действующее согласие на обработку ПДн", "Скан трудового договора", "Скан паспорта", "Скан регистрации", "Фотография",
        "Паспорт: номер, кем и когда выдан", "СНИЛС", "ИНН", "Телефон", "График работы",
    ];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _list = await Employees.ListAsync(new EmployeeFilter());
            if (_list.CanEdit)
            {
                _leaveOnlyByOrder = (await HrSettings.GetAsync()).Rules.LeaveOnlyByOrder; // D216: отпуск только приказом
            }
            if (!_list.OwnOnly && (CurrentAccess.Has(Permissions.PersonalDataView) || CurrentAccess.Has(Permissions.EmployeeEdit)))
            {
                _completeness = await PersonalData.CompletenessListAsync(); // D226
            }
        }
        catch (AccessDeniedException ex)
        {
            _denied = UiErrors.Message(ex);
        }
    }

    private Task ReloadAsync() => RunAsync(() => Task.CompletedTask);

    private Task OpenHireAsync() => RunAsync(async () =>
    {
        _options = await Employees.GetOptionsAsync();
        _form = new EmployeeForm { HiredOn = Today(), PersonnelNumber = _options.NextPersonnelNumber }; // D225
        _target = null;
        _mode = Mode.Hire;
    });

    private Task OpenEditAsync(EmployeeRowDto e) => RunAsync(async () =>
    {
        _options = await Employees.GetOptionsAsync();
        _form = new EmployeeForm
        {
            PersonnelNumber = e.PersonnelNumber, LastName = e.LastName, FirstName = e.FirstName, MiddleName = e.MiddleName,
            DepartmentId = e.DepartmentId, PositionId = e.PositionId, HiredOn = e.HiredOn, BirthDate = e.BirthDate, ShareBirthday = e.ShareBirthday,
        };
        _target = e;
        _mode = Mode.Edit;
    });

    private void OpenDismiss(EmployeeRowDto e)
    {
        _flash = null;
        _flashIsError = false;
        _formError = null;
        _form = new EmployeeForm { DismissedOn = Today() };
        _target = e;
        _mode = Mode.Dismiss;
    }

    private void Close()
    {
        _mode = Mode.None;
        _target = null;
        _formError = null;
    }

    private Task SaveAsync() => RunAsync(async () =>
    {
        var cmd = new EmployeeCommand(_form.PersonnelNumber, _form.LastName, _form.FirstName, _form.MiddleName,
            _form.DepartmentId, _form.PositionId, _form.HiredOn);
        if (_mode == Mode.Hire)
        {
            await Employees.HireAsync(cmd);
            _flash = L("Сотрудник «{0} {1}» принят.", _form.LastName, _form.FirstName);
        }
        else
        {
            var version = _target!.RowVersion;
            if (_form.BirthDate != _target.BirthDate || _form.ShareBirthday != _target.ShareBirthday)
            {
                version = await Employees.SetBirthdayAsync(_target.Id, _form.BirthDate, _form.ShareBirthday, version);
            }

            await Employees.UpdateAsync(_target.Id, cmd, version);
            _flash = L("Карточка сохранена.");
        }

        Close();
    });

    private Task ToggleLeaveAsync(EmployeeRowDto e) => RunAsync(async () =>
    {
        await Employees.SetOnLeaveAsync(e.Id, e.Status != EmploymentStatus.OnLeave, e.RowVersion);
        _flash = e.Status == EmploymentStatus.OnLeave ? L("Сотрудник «{0}» снова работает.", e.FullName) : L("Сотрудник «{0}» в отпуске.", e.FullName);
    });

    private Task DismissAsync() => RunAsync(async () =>
    {
        var target = _target!;
        await Employees.DismissAsync(target.Id, _form.DismissedOn, _form.Reason, target.RowVersion);
        _flash = target.UserId is null
            ? L("Сотрудник «{0}» уволен.", target.FullName)
            : L("Сотрудник «{0}» уволен, доступ к организации заблокирован.", target.FullName);
        Close();
    });

    /// <summary>Одна операция за раз, затем свежий список: у вкладки один DbContext.</summary>
    private async Task RunAsync(Func<Task> action)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _formError = null;
        _flashIsError = false;
        try
        {
            await (_stepUp?.RunAsync(action) ?? action()); // D123: повторное подтверждение опасных действий
        }
        catch (Exception ex) when (UiErrors.IsUserFacing(ex))
        {
            if (_mode == Mode.None)
            {
                _flash = UiErrors.Message(ex);
                _flashIsError = true;
            }
            else
            {
                _formError = UiErrors.Message(ex);
            }
        }
        finally
        {
            try
            {
                _list = await Employees.ListAsync(new EmployeeFilter(null, _includeDismissed, _search));
                if (_completeness is not null)
                {
                    _completeness = await PersonalData.CompletenessListAsync();
                }
            }
            finally
            {
                _busy = false;
            }
        }
    }

    private DateOnly Today() => DateOnly.FromDateTime(TimeZones.ToLocal(DateTime.UtcNow, CurrentAccess.TimeZoneId));

    private static string StatusClass(EmploymentStatus status) => status switch
    {
        EmploymentStatus.Working => "ok",
        EmploymentStatus.OnLeave => "warn",
        _ => "bad",
    };

    private sealed class EmployeeForm
    {
        public string PersonnelNumber { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string FirstName { get; set; } = string.Empty;
        public string? MiddleName { get; set; }
        public long DepartmentId { get; set; }
        public long PositionId { get; set; }
        public DateOnly HiredOn { get; set; }
        public DateOnly DismissedOn { get; set; }
        public string? Reason { get; set; }
        public DateOnly? BirthDate { get; set; }
        public bool ShareBirthday { get; set; }
    }
}
