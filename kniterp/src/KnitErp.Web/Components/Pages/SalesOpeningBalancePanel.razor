@*
    D1146: вводные остатки расчётов с покупателем — во вкладке «Условия продаж» карточки контрагента. Загружается, когда вкладка уже
    загрузилась (родитель рисует панель после своих данных); сервис вызывается по очереди. Без права «Цены и суммы» панели нет.
*@
@using KnitErp.Application.Sales
@inject SalesService Sales

@if (_data is { } d)
{
    <h3 class="sx-sub-head" style="margin-top: 16px">@L("Вводный остаток расчётов")</h3>
    <p class="sx-lead">@L("Сальдо на дату начала учёта: долг покупателя — со знаком плюс, его аванс — со знаком минус. Учитывается в долге, кредитном контроле, дебиторке и акте сверки.")</p>
    @if (_message is not null)
    {
        <div class="@(_isError ? "flash error" : "flash")" role="@(_isError ? "alert" : "status")"><span>@_message</span></div>
    }

    @if (d.Rows.Count > 0)
    {
        <div class="scroll">
            <table class="sx-table compact">
                <thead><tr><th>@L("Дата")</th><th>@L("Юрлицо")</th><th class="num">@L("Сумма")</th><th>@L("Комментарий")</th><th>@L("Ввёл")</th><th></th></tr></thead>
                <tbody>
                    @foreach (var r in d.Rows)
                    {
                        <tr class="@(r.IsCancelled ? "archived" : null)">
                            <td data-label="@L("Дата")">@r.Date.ToString("dd.MM.yyyy")</td>
                            <td data-label="@L("Юрлицо")">@r.LegalEntity</td>
                            <td data-label="@L("Сумма")" class="num">@Amounts.Format(r.Amount) <span class="sx-sub">@(r.Amount > 0 ? L("долг покупателя") : L("аванс покупателя"))</span></td>
                            <td data-label="@L("Комментарий")">@(r.IsCancelled ? L("аннулирован: {0}", r.CancelReason ?? "") : r.Comment)</td>
                            <td data-label="@L("Ввёл")">@r.CreatedBy</td>
                            <td class="sx-row-actions">
                                @if (d.CanEdit && !r.IsCancelled)
                                {
                                    @if (_cancelId == r.Id)
                                    {
                                        <span class="sx-inline-row">
                                            <input @bind="_reason" placeholder="@L("Причина")" aria-label="@L("Причина аннулирования")" size="18" />
                                            <button type="button" class="secondary" @onclick="() => CancelAsync(r)" disabled="@_busy">@L("Аннулировать")</button>
                                        </span>
                                    }
                                    else
                                    {
                                        <button type="button" class="link" @onclick="() => { _cancelId = r.Id; _reason = null; }">@L("Аннулировать")</button>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (d.CanEdit)
    {
        <form class="sx-form" @onsubmit="AddAsync">
            <label>@L("Дата") <input type="date" @bind="_date" /></label>
            <label>
                @L("Юрлицо")
                <select @bind="_entity">
                    @foreach (var e in d.LegalEntities)
                    {
                        <option value="@e.Id">@e.Name</option>
                    }
                </select>
            </label>
            <label>@L("Сумма") <input @bind="_amount" inputmode="decimal" placeholder="@L("15 000 или −2 000")" /></label>
            <label>@L("Комментарий") <input @bind="_comment" maxlength="500" /></label>
            <div class="sx-actions"><button type="submit" class="secondary" disabled="@_busy">@L("Ввести остаток")</button></div>
        </form>
    }
}

@code {
    [Parameter, EditorRequired]
    public long CounterpartyId { get; set; }

    private CustomerOpeningBalancesDto? _data;
    private DateTime? _date;
    private string _entity = string.Empty;
    private string? _amount;
    private string? _comment;
    private long? _cancelId;
    private string? _reason;
    private bool _busy;
    private string? _message;
    private bool _isError;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            await LoadAsync();
        }
        catch (AccessDeniedException)
        {
            _data = null; // без права «Цены и суммы» — панели нет
        }
    }

    private async Task LoadAsync()
    {
        _data = await Sales.OpeningBalancesAsync(CounterpartyId);
        if (string.IsNullOrEmpty(_entity) && _data.LegalEntities.Count > 0)
        {
            _entity = _data.LegalEntities[0].Id.ToString();
        }
    }

    private Task AddAsync() => RunAsync(async () =>
    {
        if (_date is not { } date)
        {
            throw new BusinessRuleException("sales.opening.date", L("Укажите дату остатка."));
        }

        var text = (_amount ?? "").Replace('−', '-').Trim();
        var negative = text.StartsWith('-');
        if (!Quantities.TryParse(negative ? text[1..] : text, out var value))
        {
            throw new BusinessRuleException("sales.number", L("Укажите число, например 1 220,50."));
        }

        await Sales.AddOpeningBalanceAsync(CounterpartyId, long.Parse(_entity), DateOnly.FromDateTime(date), negative ? -value : value, _comment);
        _amount = null;
        _comment = null;
        _message = L("Вводный остаток сохранён.");
    });

    private Task CancelAsync(CustomerOpeningBalanceDto row) => RunAsync(async () =>
    {
        await Sales.CancelOpeningBalanceAsync(row.Id, _reason, row.RowVersion);
        _cancelId = null;
        _message = L("Вводный остаток аннулирован.");
    });

    private async Task RunAsync(Func<Task> action)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _message = null;
        _isError = false;
        try
        {
            await action();
            await LoadAsync();
        }
        catch (Exception ex) when (UiErrors.IsUserFacing(ex))
        {
            _message = UiErrors.Message(ex);
            _isError = true;
        }
        finally
        {
            _busy = false;
        }
    }
}
