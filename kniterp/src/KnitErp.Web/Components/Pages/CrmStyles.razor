@*
    Стили CRM (D600–D699): канбан сделок, лента этапов, подсказка дубликатов. Компактно по общим правилам (D114) — без фиксированной
    высоты касания; на телефоне 390 px колонки канбана идут одна под другой, без горизонтальной прокрутки страницы.
*@
<style>
    .crm-board { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(220px, 1fr); gap: 10px; overflow-x: auto; padding-bottom: 8px; align-items: start; }
    .crm-col { background: var(--surface-2); border: 1px solid var(--line); border-radius: 10px; padding: 8px; min-height: 120px; }
    .crm-col.drop { outline: 2px dashed var(--accent-line); }
    .crm-col-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 4px 8px; margin-bottom: 6px; }
    .crm-col-sum { font-size: 12px; color: var(--muted); }
    .crm-cards { display: flex; flex-direction: column; gap: 6px; list-style: none; margin: 0; padding: 0; }
    .crm-card { background: var(--surface); border: 1px solid var(--line); border-radius: 8px; padding: 6px 8px; cursor: grab; }
    .crm-card a.crm-title { font-weight: 600; display: block; overflow-wrap: anywhere; }
    .crm-card .crm-meta { font-size: 12px; color: var(--muted); display: flex; flex-wrap: wrap; gap: 2px 8px; }
    .crm-card .crm-move { display: flex; justify-content: space-between; gap: 6px; margin-top: 4px; }
    .crm-card .crm-move button { padding: 0 8px; }
    .crm-more { font-size: 12px; color: var(--muted); margin: 6px 2px 0; }
    .crm-ribbon { display: flex; flex-wrap: wrap; gap: 4px; margin: 8px 0 12px; padding: 0; list-style: none; }
    .crm-ribbon button { font-weight: 400; background: var(--line); color: var(--text); border-radius: 999px; }
    .crm-ribbon button.current { background: var(--accent); color: var(--on-accent, #fff); font-weight: 600; }
    .crm-ribbon button.passed { background: var(--accent-soft-2); }
    .crm-dups { border: 1px solid color-mix(in srgb, var(--warn-text) 45%, transparent); background: var(--warn-bg); border-radius: 8px; padding: 8px 12px; margin: 8px 0; }
    .crm-dups ul { margin: 4px 0 0; padding-left: 18px; }
    .crm-summary { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 6px 16px; margin: 8px 0; }
    .crm-summary div { display: flex; flex-direction: column; gap: 2px; min-width: 0; overflow-wrap: anywhere; }
    .crm-summary span:first-child { font-size: 12px; color: var(--muted); }
    .crm-pager { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin: 8px 0; }
    .crm-tabs { display: flex; gap: 4px; margin: 8px 0; }
    .crm-tabs button { font-weight: 400; background: var(--line); color: var(--text); }
    .crm-tabs button[aria-pressed=true] { background: var(--accent); color: var(--on-accent, #fff); font-weight: 600; }
    @@media (max-width: 599px) {
        .crm-board { grid-auto-flow: row; grid-auto-columns: auto; grid-template-columns: minmax(0, 1fr); overflow-x: visible; }
        .crm-col { min-height: 0; }
        .crm-summary { grid-template-columns: 1fr 1fr; }
    }
</style>
