@*
    Стили CRM (D600–D699): канбан сделок, лента этапов, подсказка дубликатов. Компактно по общим правилам (D114) — без фиксированной
    высоты касания; на телефоне 390 px колонки канбана идут одна под другой, без горизонтальной прокрутки страницы.
*@
<style>
    /* fieldset по умолчанию не уже содержимого (min-width: min-content) — на 390 px форма вылезала за экран. */
    fieldset { min-width: 0; }
    .crm-board { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(220px, 1fr); gap: 10px; overflow-x: auto; padding-bottom: 8px; align-items: start; }
    .crm-col { background: var(--surface-2); border: 1px solid var(--line); border-radius: 10px; padding: 8px; min-height: 120px; }
    .crm-col.drop { outline: 2px dashed var(--accent-line); }
    .crm-col-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 4px 8px; margin-bottom: 6px; }
    .crm-col-sum { font-size: 12px; color: var(--muted); }
    .crm-cards { display: flex; flex-direction: column; gap: 6px; list-style: none; margin: 0; padding: 0; }
    .crm-card { background: var(--surface); border: 1px solid var(--line); border-radius: 8px; padding: 6px 8px; cursor: grab; }
    .crm-card a.crm-title { font-weight: 600; display: block; overflow-wrap: anywhere; }
    .crm-card .crm-meta { font-size: 12px; color: var(--muted); display: flex; flex-wrap: wrap; gap: 2px 8px; }
    .crm-card .crm-move { display: flex; justify-content: space-between; gap: 6px; margin-top: 4px; }
    .crm-card .crm-move button { padding: 0 8px; }
    .crm-more { font-size: 12px; color: var(--muted); margin: 6px 2px 0; }
    .crm-ribbon { display: flex; flex-wrap: wrap; gap: 4px; margin: 8px 0 12px; padding: 0; list-style: none; }
    .crm-ribbon button { font-weight: 400; background: var(--line); color: var(--text); border-radius: 999px; }
    .crm-ribbon button.current { background: var(--accent); color: var(--on-accent, #fff); font-weight: 600; }
    .crm-ribbon button.passed { background: var(--accent-soft-2); }
    .crm-dups { border: 1px solid color-mix(in srgb, var(--warn-text) 45%, transparent); background: var(--warn-bg); border-radius: 8px; padding: 8px 12px; margin: 8px 0; }
    .crm-dups ul { margin: 4px 0 0; padding-left: 18px; }
    .crm-summary { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 6px 16px; margin: 8px 0; }
    .crm-summary div { display: flex; flex-direction: column; gap: 2px; min-width: 0; overflow-wrap: anywhere; }
    .crm-summary span:first-child { font-size: 12px; color: var(--muted); }
    .crm-pager { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin: 8px 0; }
    .crm-tabs { display: flex; gap: 4px; margin: 8px 0; }
    .crm-tabs button { font-weight: 400; background: var(--line); color: var(--text); }
    .crm-tabs button[aria-pressed=true] { background: var(--accent); color: var(--on-accent, #fff); font-weight: 600; }
    .crm-feed { list-style: none; margin: 8px 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
    .crm-feed-item { display: grid; grid-template-columns: 120px 110px minmax(0, 1fr); gap: 4px 10px; padding: 6px 8px; border: 1px solid var(--line); border-radius: 8px; }
    .crm-feed-item.open { border-color: var(--accent-line); }
    .crm-feed-item.overdue { border-color: var(--bad-line); background: var(--bad-bg-2); }
    .crm-feed-when { font-size: 12px; color: var(--muted); }
    .crm-feed-kind { font-size: 12px; color: var(--text-2); }
    .crm-feed-body { min-width: 0; overflow-wrap: anywhere; }
    .crm-feed-text { white-space: pre-wrap; font-size: 13px; margin-top: 2px; }
    .crm-result { max-width: 220px; }
    .crm-kpi { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 8px; margin: 8px 0 16px; }
    .crm-kpi div { border: 1px solid var(--line); border-radius: 10px; padding: 8px 10px; background: var(--surface-2); }
    .crm-kpi b { display: block; font-size: 18px; }
    .crm-kpi span { font-size: 12px; color: var(--muted); }
    .crm-bar { height: 8px; border-radius: 4px; background: var(--line); overflow: hidden; min-width: 60px; }
    .crm-bar > i { display: block; height: 100%; background: var(--accent); }
    .crm-chats { display: grid; grid-template-columns: 300px minmax(0, 1fr); gap: 12px; align-items: start; }
    .crm-chat-list { display: flex; flex-direction: column; gap: 4px; max-height: 70vh; overflow-y: auto; }
    .crm-chat-item { display: flex; flex-direction: column; align-items: flex-start; gap: 2px; text-align: left; background: var(--surface-2); color: var(--text); font-weight: 400; border: 1px solid var(--line); }
    .crm-chat-item.current { border-color: var(--accent); }
    .crm-chat-last { font-size: 13px; color: var(--text-2); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 100%; }
    .crm-chat-view { border: 1px solid var(--line); border-radius: 10px; padding: 8px; min-width: 0; }
    .crm-chat-messages { list-style: none; margin: 8px 0; padding: 0; display: flex; flex-direction: column-reverse; gap: 6px; max-height: 55vh; overflow-y: auto; }
    .crm-chat-messages li { max-width: 80%; padding: 6px 10px; border-radius: 10px; background: var(--surface-2); overflow-wrap: anywhere; }
    .crm-chat-messages li.out { align-self: flex-end; background: var(--accent-soft-2); }
    .crm-chat-text { white-space: pre-wrap; }
    .crm-layout { display: grid; grid-template-columns: minmax(0, 1fr); gap: 8px 20px; margin-top: 4px; }
    .crm-main, .crm-side { min-width: 0; }
    .crm-main > h2, .crm-side h2 { margin: 18px 0 8px; }
    .crm-main > h2:first-child, .crm-side > .panel:first-child h2 { margin-top: 0; }
    .crm-main > .actions, .crm-main > form, .crm-main > .scroll { margin-bottom: 8px; }
    @@media (min-width: 1200px) {
        .crm-layout { grid-template-columns: minmax(0, 1fr) 380px; align-items: start; }
        .crm-side { position: sticky; top: 72px; max-height: calc(100vh - 88px); overflow-y: auto; padding-right: 2px; }
        .crm-side .grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
        .crm-side .grid .wide { grid-column: 1 / -1; }
    }
    .crm-channel { display: inline-block; padding: 0 6px; border-radius: 6px; font-size: 11px; font-weight: 600; color: #fff; background: #6b7280; }
    .crm-channel-telegram { background: #229ed9; }
    .crm-channel-whatsapp { background: #1f9d55; }
    .crm-channel-max { background: #6a4cff; }
    .crm-messengers { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 10px; }
    .crm-messenger { border: 1px solid var(--line); border-radius: 10px; padding: 10px; min-width: 0; display: flex; flex-direction: column; gap: 6px; }
    .crm-messenger form { display: flex; flex-direction: column; gap: 6px; }
    .crm-messenger code { overflow-wrap: anywhere; }
    .crm-chat-reply { display: flex; gap: 8px; align-items: flex-end; }
    .crm-chat-reply textarea { flex: 1 1 auto; min-width: 0; }
    @@media (max-width: 599px) {
        .crm-chats { grid-template-columns: minmax(0, 1fr); }
        .crm-feed-item { grid-template-columns: 1fr; }
        .crm-board { grid-auto-flow: row; grid-auto-columns: auto; grid-template-columns: minmax(0, 1fr); overflow-x: visible; }
        .crm-col { min-height: 0; }
        .crm-summary { grid-template-columns: 1fr 1fr; }
    }
    /* D690–D693: «Мой день» на телефоне — крупные карточки задач, звонок и результат, диктовка, фото к сделке. Высота касания — по общим
       правилам (D114, data-density), здесь не фиксируется; цвета — только переменные темы (светлая и тёмная). */
    .crm-day-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 4px 12px; }
    .crm-day-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); gap: 10px; margin: 6px 0 16px; }
    .crm-day-card { background: var(--surface-2); border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; min-width: 0;
                    display: flex; flex-direction: column; gap: 6px; overflow-wrap: anywhere; }
    .crm-day-card.late { border-color: color-mix(in srgb, var(--warn-text) 45%, var(--line)); }
    .crm-day-card h3 { margin: 0; font-size: 1.15em; font-weight: 600; }
    .crm-day-top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 4px 8px; }
    .crm-day-top .tag { margin-left: 0; }
    .crm-day-client { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
    .crm-day-client > a, .crm-day-client > span:first-child { font-weight: 600; }
    .crm-day-text { white-space: pre-wrap; color: var(--text-2); margin: 0; }
    .crm-day-actions { display: flex; flex-wrap: wrap; gap: 6px; }
    .crm-day-actions > * { flex: 1 1 auto; text-align: center; }
    .crm-day-actions .crm-day-call { flex-basis: 100%; font-size: 1.1em; }
    .crm-day-phone { font-weight: 400; white-space: nowrap; margin-left: 4px; }
    .crm-day-form { display: flex; flex-direction: column; gap: 8px; border-top: 1px solid var(--line); padding-top: 8px; min-width: 0; }
    .crm-day-form label { display: flex; flex-direction: column; gap: 3px; color: var(--text-2); min-width: 0; }
    .crm-day-form label.check { flex-direction: row; align-items: center; }
    .crm-day-form .crm-tabs { flex-wrap: wrap; margin: 0; }
    .crm-day-form .crm-tabs button { flex: 1 1 auto; }
    .crm-day-next { display: flex; flex-direction: column; gap: 6px; }
    .crm-day-next input[type=number] { max-width: 140px; }
    .crm-day-chips { display: flex; flex-wrap: wrap; gap: 6px; }
    .crm-day-chips button { flex: 1 1 auto; width: auto; }
    .crm-day-chips button[aria-pressed=true] { background: var(--accent); color: var(--on-accent); font-weight: 600; }
    .crm-voice { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
    .crm-voice label { display: flex; flex-direction: column; gap: 3px; color: var(--text-2); }
    .crm-voice textarea { width: 100%; box-sizing: border-box; min-width: 0; }
    .crm-voice-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; }
    .crm-voice-on { color: var(--bad-text); }
    .crm-voice-hint { margin: 0; }
    .crm-photos { margin: 12px 0; min-width: 0; }
    .crm-photo-count { margin-left: 6px; font-weight: 400; }
    .crm-photo-add { display: flex; flex-direction: column; gap: 6px; margin: 6px 0; }
    .crm-photo-add label.wide { display: flex; flex-direction: column; gap: 3px; color: var(--text-2); }
    .crm-photo-pick { position: relative; display: inline-flex; align-items: center; justify-content: center; padding: 5px 10px; border-radius: 4px;
                      background: var(--accent); color: var(--on-accent); font-weight: 600; cursor: pointer; }
    .crm-photo-pick.secondary { background: var(--line); color: var(--text); font-weight: 400; }
    .crm-photo-pick.disabled { opacity: .5; cursor: default; }
    .crm-photo-pick:focus-within { outline: 2px solid var(--accent); outline-offset: 2px; }
    .crm-photo-pick input[type=file] { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; min-height: 0; padding: 0; }
    .crm-photo-grid { list-style: none; margin: 6px 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(96px, 1fr)); gap: 8px; }
    .crm-photo-grid li { display: flex; flex-direction: column; gap: 2px; min-width: 0; overflow-wrap: anywhere; }
    .crm-photo-thumb { padding: 0; background: var(--surface-3, var(--line)); border: 1px solid var(--line); border-radius: 8px; overflow: hidden; aspect-ratio: 1 / 1; width: 100%; }
    .crm-photo-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .crm-photo-view { position: fixed; inset: 0; z-index: 90; background: color-mix(in srgb, #000 70%, transparent); display: flex; align-items: center; justify-content: center; padding: 12px; }
    .crm-photo-view-body { background: var(--surface); color: var(--text); border-radius: 10px; padding: 10px; max-width: min(960px, 100%); max-height: 100%; overflow-y: auto;
                           display: flex; flex-direction: column; gap: 6px; min-width: 0; }
    .crm-photo-view-body img { max-width: 100%; max-height: 70vh; max-height: 70dvh; object-fit: contain; border-radius: 6px; align-self: center; }
    @@media (max-width: 599px) {
        .crm-day-head h1 { margin-bottom: 0; }
        .crm-day-list { grid-template-columns: minmax(0, 1fr); }
        .crm-day-card h3 { font-size: 1.2em; }
        .crm-day-actions .crm-day-call { padding-top: 10px; padding-bottom: 10px; }
    }
</style>
