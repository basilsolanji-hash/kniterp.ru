@page "/sales-orders/{Id:long}"
@using KnitErp.Application.Sales
@using KnitErp.Domain.Sales
@using KnitErp.Domain.Warehousing
@using KnitErp.Domain.Common
@inject SalesService Sales
@inject KnitErp.Application.Warehousing.StockBatchService BatchService
@inject KnitErp.Application.Finance.MoneyService Money
@inject SalesStageService StageList
@inject CustomerInvoiceService Invoices
@inject NavigationManager Navigation

<PageTitle>@(_order?.Number ?? L("Заказ покупателя")) — knitERP</PageTitle>

@if (_denied is not null)
{
    <AccessDenied Message="@_denied" />
}
else if (_notFound)
{
    <h1>@L("Заказ не найден")</h1>
    <p><a href="sales-orders">@L("К списку заказов")</a></p>
}
else if (_order is null)
{
    <p class="muted">@L("Загрузка…")</p>
}
else
{
    var draft = _order.Status == SalesOrderStatus.Draft;
    var editable = draft && _order.CanEdit;
    <p><a href="sales-orders">@L("← Заказы покупателей")</a></p>
    <div class="page-head">
        <h1>@L("Заказ покупателя") @_order.Number <span class="tag @SalesOrdersPage.StatusClass(_order.Status)">@L(_order.StatusName)</span>
            <span class="muted" style="font-size: 13px; font-weight: 400">@SalesOrdersPage.ShippedName(_order.Shipped)</span></h1>
        <div class="stage-pick">
            @if (CurrentAccess.Has(Permissions.SalesEdit) && _order.Status != SalesOrderStatus.Cancelled)
            {
                <label>@L("Этап")
                    <select value="@(_order.Stage?.Id.ToString() ?? "")" @onchange="SetStageAsync" disabled="@_busy" class="stage-select stage-@(_order.Stage?.Color ?? "none")">
                        <option value="">@L("без этапа")</option>
                        @foreach (var st in _stages)
                        {
                            <option value="@st.Id">@st.Name</option>
                        }
                    </select>
                </label>
                <a href="sales-order-stages" class="muted" title="@L("Настроить этапы")">⚙</a>
            }
            else
            {
                <StageChip Stage="_order.Stage" />
            }
        </div>
    </div>
    <TagPicker Entity="KnitErp.Domain.Tagging.TaggedEntity.SalesOrder" EntityId="Id" />

    @if (_message is not null)
    {
        <div class="@(_messageIsError ? "flash error" : "flash")" role="@(_messageIsError ? "alert" : "status")">@_message</div>
    }

    @if (_header is not null)
    {
        <div class="panel">
            <form @onsubmit="SaveHeaderAsync">
                <div class="grid">
                    <label>
                        @L("Покупатель")
                        <select @bind="_header.Customer">
                            @foreach (var s in _options!.Customers)
                            {
                                <option value="@s.Id">@s.Name</option>
                            }
                        </select>
                    </label>
                    <label>
                        @L("Склад отгрузки")
                        <select @bind="_header.Warehouse">
                            @foreach (var w in _options.Warehouses)
                            {
                                <option value="@w.Id">@w.Name</option>
                            }
                        </select>
                    </label>
                    @if (_options.LegalEntities is { Count: > 1 } entities)
                    {
                        <label>
                            @L("Юрлицо (продавец)")
                            <select @bind="_header.Entity">
                                @foreach (var le in entities)
                                {
                                    <option value="@le.Id">@le.ShortName</option>
                                }
                                @if (entities.All(le => le.Id != _order.Details?.LegalEntityId))
                                {
                                    <option value="@_order.Details?.LegalEntityId">@_order.Details?.LegalEntity (@L("в архиве"))</option>
                                }
                            </select>
                        </label>
                    }
                    <label>@L("Дата заказа") <input type="date" @bind="_header.Date" /></label>
                    <label>@L("Дата отгрузки") <input type="date" @bind="_header.Expected" /></label>
                    <label>@L("Договор покупателя") <input @bind="_header.Invoice" maxlength="@SalesOrder.InvoiceMaxLength" /></label>
                    <label>@L("Комментарий") <input @bind="_header.Comment" maxlength="@SalesOrder.CommentMaxLength" /></label>
                    <label class="inline"><input type="checkbox" @bind="_header.WithVat" /> @L("Цены включают НДС")</label>
                </div>
                <div class="actions">
                    <button type="submit" disabled="@_busy">@L("Сохранить")</button>
                    <button type="button" class="secondary" @onclick="() => _header = null">@L("Отмена")</button>
                </div>
            </form>
        </div>
    }
    else
    {
        <dl class="facts">
            <dt>@L("Покупатель")</dt><dd>@_order.Customer</dd>
            <dt>@L("Дата")</dt><dd>@_order.OrderDate.ToString("dd.MM.yyyy")@(_order.Details?.OrderTime is { } ot ? $" {ot:HH\\:mm}" : "")@(_order.ShipDate is { } e ? $" · {L("отгрузка")} {e:dd.MM.yyyy}" : "")</dd>
            <dt>@L("Склад отгрузки")</dt><dd>@_order.Warehouse</dd>
            @if (_order.Details is { LegalEntity: not null } sd)
            {
                <dt>@L("Продавец")</dt>
                <dd>@sd.LegalEntity @if (sd.VatExempt) { <span class="tag">@L("без НДС")</span> }</dd>
            }
            @if (_order.Details?.CustomerBalance is { } bal)
            {
                <dt>@L("Баланс покупателя")</dt>
                <dd><a href="reports/customer-balances" class="@(bal > 0 ? "money-debt" : bal < 0 ? "money-advance" : null)">
                    @(bal > 0 ? L("должен нам {0}", Amounts.Format(bal)) : bal < 0 ? L("аванс {0}", Amounts.Format(-bal)) : L("расчёты закрыты"))</a></dd>
            }
            @if (_order.CustomerReference is not null)
            {
                <dt>@L("Договор покупателя")</dt><dd>@_order.CustomerReference</dd>
            }
            @if (_order.CanSeePrices)
            {
                <dt>@L("Цены")</dt><dd>@(_order.PricesIncludeVat ? L("включают НДС") : L("без НДС, НДС сверху"))</dd>
            }
            @if (_order.Comment is not null)
            {
                <dt>@L("Комментарий")</dt><dd>@_order.Comment</dd>
            }
            <dt>@L("Автор")</dt><dd>@_order.CreatedBy, @Local(_order.CreatedAtUtc)</dd>
            @if (_order.ConfirmedBy is not null)
            {
                <dt>@L("Подтвердил")</dt><dd>@_order.ConfirmedBy, @Local(_order.ConfirmedAtUtc!.Value)</dd>
            }
        </dl>
        @if (editable)
        {
            <button type="button" class="secondary" @onclick="EditHeaderAsync" disabled="@_busy">@L("Изменить шапку")</button>
        }
    }

    @if (_order.Details is { } det)
    {
        <h2 style="margin-top: 16px">@L("Детали")</h2>
        @if (_details is not null)
        {
            <div class="panel details-panel">
                <form @onsubmit="SaveDetailsAsync">
                    <div class="grid">
                        <label>@L("Время заказа") <input type="time" @bind="_details.Time" /></label>
                        <label>
                            @L("Проект")
                            <select @bind="_details.Project">
                                <option value="">—</option>
                                @foreach (var p in _detailOptions!.Projects)
                                {
                                    <option value="@p.Id">@p.Name</option>
                                }
                                @if (det.ProjectId is { } pid && _detailOptions.Projects.All(p => p.Id != pid))
                                {
                                    <option value="@pid">@det.Project (@L("в архиве"))</option>
                                }
                            </select>
                        </label>
                        <label>
                            @L("Канал продаж")
                            <select @bind="_details.Channel">
                                <option value="">—</option>
                                @foreach (var c in _detailOptions.Channels)
                                {
                                    <option value="@c.Id">@c.Name</option>
                                }
                                @if (det.ChannelId is { } cid && _detailOptions.Channels.All(c => c.Id != cid))
                                {
                                    <option value="@cid">@det.Channel (@L("в архиве"))</option>
                                }
                            </select>
                        </label>
                        <label>
                            @L("Ответственный")
                            <select @bind="_details.Responsible">
                                <option value="">—</option>
                                @foreach (var u in _detailOptions.Users)
                                {
                                    <option value="@u.Id">@u.Name</option>
                                }
                                @if (det.ResponsibleUserId is { } rid && _detailOptions.Users.All(u => u.Id != rid))
                                {
                                    <option value="@rid">@det.Responsible</option>
                                }
                            </select>
                        </label>
                        @if (_detailOptions.LegalEntities?.FirstOrDefault(le => le.Id == det.LegalEntityId) is { } seller)
                        {
                            <label>
                                @L("Расчётный счёт")
                                <select @bind="_details.Account">
                                    <option value="">@L("основной счёт юрлица")</option>
                                    @foreach (var acc in seller.Accounts)
                                    {
                                        <option value="@acc.Id">@acc.Label</option>
                                    }
                                </select>
                            </label>
                        }
                        <label class="wide">@L("Адрес доставки") <input @bind="_details.Address" maxlength="@SalesOrder.AddressMaxLength" /></label>
                        @foreach (var f in det.CustomFields.Where(f => !f.IsArchived))
                        {
                            var field = f;
                            @switch (field.Type)
                            {
                                case CustomFieldType.Flag:
                                    <label class="inline"><input type="checkbox" checked="@IsFlagSet(field.FieldId)"
                                                                 @onchange="e => SetFlag(field.FieldId, e)" /> @field.Name</label>
                                    break;
                                case CustomFieldType.Date:
                                    <label>@field.Name <input type="date" value="@_details.Values.GetValueOrDefault(field.FieldId)"
                                                              @onchange="e => _details.Values[field.FieldId] = e.Value?.ToString()" /></label>
                                    break;
                                case CustomFieldType.Number:
                                    <label>@field.Name <input inputmode="decimal" value="@_details.Values.GetValueOrDefault(field.FieldId)"
                                                              @onchange="e => _details.Values[field.FieldId] = e.Value?.ToString()" /></label>
                                    break;
                                default:
                                    <label>@field.Name <input maxlength="@CustomFieldDefinition.ValueMaxLength" value="@_details.Values.GetValueOrDefault(field.FieldId)"
                                                              @onchange="e => _details.Values[field.FieldId] = e.Value?.ToString()" /></label>
                                    break;
                            }
                        }
                    </div>
                    <div class="actions">
                        <button type="submit" disabled="@_busy">@L("Сохранить")</button>
                        <button type="button" class="secondary" @onclick="() => _details = null">@L("Отмена")</button>
                        @if (CurrentAccess.Has(Permissions.SalesEdit))
                        {
                            <a href="sales-settings" class="muted">@L("Проекты, каналы и доп. поля")</a>
                        }
                    </div>
                </form>
            </div>
        }
        else
        {
            <dl class="facts">
                <dt>@L("Проект")</dt><dd>@(det.Project ?? "—")</dd>
                <dt>@L("Канал продаж")</dt><dd>@(det.Channel ?? "—")</dd>
                <dt>@L("Ответственный")</dt><dd>@(det.Responsible ?? "—")</dd>
                <dt>@L("Расчётный счёт")</dt><dd>@(det.BankAccount ?? L("не указан — добавьте в «Юрлица и счета»"))</dd>
                <dt>@L("Адрес доставки")</dt><dd>@(det.DeliveryAddress ?? "—")</dd>
                @foreach (var f in det.CustomFields)
                {
                    <dt>@f.Name@(f.IsArchived ? $" ({L("в архиве")})" : "")</dt><dd>@CustomValue(f)</dd>
                }
            </dl>
            @if (CurrentAccess.Has(Permissions.SalesEdit) && _order.Status != SalesOrderStatus.Cancelled)
            {
                <button type="button" class="secondary" @onclick="EditDetailsAsync" disabled="@_busy">@L("Изменить детали")</button>
            }
        }
    }

    <h2 style="margin-top: 16px">@L("Строки ({0})", _order.Lines.Count)</h2>

    @if (editable)
    {
        <form class="inline-form" @onsubmit="SetLineAsync">
            <label>
                @L("Позиция")
                <input list="so-items" @bind="_itemText" @bind:after="SuggestVat" size="36" placeholder="@L("Код или наименование")" />
                <datalist id="so-items">
                    @foreach (var i in _options?.Items ?? [])
                    {
                        <option value="@($"{i.Code} — {i.Name}")">@(i.Article is null ? i.UnitSymbol : $"{i.Article} · {i.UnitSymbol}")</option>
                    }
                </datalist>
            </label>
            <label>@L("Количество") <input @bind="_qtyText" inputmode="decimal" size="8" /></label>
            <label>@(_order.PricesIncludeVat ? L("Цена с НДС") : L("Цена без НДС")) <input @bind="_priceText" inputmode="decimal" size="10" /></label>
            <label>
                @L("НДС")
                <select @bind="_vatText">
                    @foreach (var v in _options?.VatRates ?? [])
                    {
                        <option value="@(v.Percent?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")">@L(v.Name) (@Amounts.Vat(v.Percent))</option>
                    }
                </select>
            </label>
            <label>@L("Скидка, %") <input @bind="_discountText" inputmode="decimal" size="5" placeholder="0" /></label>
            <button type="submit" disabled="@_busy">@L("Добавить или изменить")</button>
        </form>
        @if (_order.Lines.Count > 0)
        {
            <form class="inline-form" @onsubmit="SetOrderDiscountAsync">
                <label>@L("Скидка на весь заказ, %") <input @bind="_orderDiscountText" inputmode="decimal" size="5" placeholder="5" /></label>
                <button type="submit" class="secondary" disabled="@_busy">@L("Применить ко всем строкам")</button>
            </form>
        }
    }

    @if (CurrentAccess.Has(Permissions.SalesEdit) && _order.Status is SalesOrderStatus.Draft or SalesOrderStatus.Confirmed)
    {
        <label class="inline reserve-toggle" title="@L("Товар подтверждённого заказа держится на складе и не считается доступным другим заказам")">
            <input type="checkbox" checked="@_order.Reserve" @onchange="ToggleReserveAsync" disabled="@_busy" /> @L("Резерв")
            <span class="muted">@(_order.Reserve ? (_order.Status == SalesOrderStatus.Confirmed ? L("товар зарезервирован") : L("резерв начнёт действовать после подтверждения")) : "")</span>
        </label>
    }
    else if (_order.Reserve)
    {
        <p class="muted">@L("Резерв")</p>
    }

    <div class="scroll">
        <table>
            <thead>
                <tr>
                    <th>@L("Код")</th><th>@L("Наименование")</th><th class="num">@L("Количество")</th><th>@L("Ед.")</th>
                    @if (_order.CanSeePrices) { <th class="num">@L("Цена")</th><th class="num opt">@L("НДС")</th><th class="num opt">@L("Скидка")</th><th class="num">@L("Сумма")</th> }
                    @if (!draft) { <th class="num">@L("Отгружено")</th><th class="num opt">@L("Возвращено")</th><th class="num">@L("Осталось")</th> }
                    <th class="num opt" title="@L("Остаток на складе заказа")">@L("Остаток")</th>
                    <th class="num" title="@L("Остаток минус резерв других заказов")">@L("Доступно")</th>
                    @if (editable) { <th></th> }
                </tr>
            </thead>
            <tbody>
                @if (_order.Lines.Count == 0)
                {
                    <tr><td colspan="11" class="muted">@L("Строк пока нет.")</td></tr>
                }
                @foreach (var l in _order.Lines)
                {
                    <tr>
                        <td>@l.Code</td>
                        <td>@l.Name</td>
                        <td class="num">@Quantities.Format(l.Quantity)</td>
                        <td>@l.UnitSymbol</td>
                        @if (_order.CanSeePrices)
                        {
                            <td class="num">@(l.Price?.ToString("#,0.00##", System.Globalization.CultureInfo.GetCultureInfo("ru-RU")))</td>
                            <td class="num">@Amounts.Vat(l.VatPercent)</td>
                            <td class="num">@(l.DiscountPercent > 0 ? $"{l.DiscountPercent:0.##}%" : "—")</td>
                            <td class="num">@Amounts.Format(l.Amount)</td>
                        }
                        @if (!draft)
                        {
                            <td class="num">@Quantities.Format(l.Shipped)</td>
                            <td class="num">@Quantities.Format(l.Returned)</td>
                            <td class="num">@(l.Left > 0 ? Quantities.Format(l.Left) : "—")</td>
                        }
                        <td class="num">@Quantities.Format(l.Stock)</td>
                        <td class="num @(l.Short ? "cell-short" : null)" title="@(l.ReservedByOthers > 0 ? L("в резерве других заказов: {0}", Quantities.Format(l.ReservedByOthers)) : null)">@Quantities.Format(l.Available)</td>
                        @if (editable)
                        {
                            <td>
                                <button type="button" class="secondary" @onclick="() => EditLine(l)" disabled="@_busy" aria-label="@L("Изменить: {0}", l.Code)">@L("Изменить")</button>
                                <ConfirmButton Class="secondary" OnConfirm="() => RemoveLineAsync(l)" Disabled="@_busy" AriaLabel="@L("Удалить строку {0}", l.Code)" Question='@L("Удалить?")'>@L("Удалить")</ConfirmButton>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (_order.CanSeePrices)
    {
        <div class="totals">
            <span>@L("Сумма заказа:") <b>@Amounts.Format(_order.Total)</b></span>
            <span>@L("в т. ч. НДС:") @Amounts.Format(_order.VatTotal)</span>
            @if (_order.DiscountTotal is > 0)
            {
                <span>@L("Скидка:") @Amounts.Format(_order.DiscountTotal)</span>
            }
            @if (!draft)
            {
                <span>@L("Отгружено на:") @Amounts.Format(_order.ShippedValue)</span>
                <span>@L("Возвращено на:") @Amounts.Format(_order.ReturnedValue)</span>
                <span>@L("Оплачено:") @Amounts.Format(_order.Paid)</span>
                <span class="@(_order.Debt > 0 ? "bad" : "")">@L("Долг покупателя:") <b>@Amounts.Format(_order.Debt)</b></span>
            }
        </div>
    }

    <div class="actions" style="margin-top: 12px">
        @if (editable)
        {
            <button type="button" @onclick="ConfirmAsync" disabled="@(_busy || _order.Lines.Count == 0)">@L("Подтвердить заказ")</button>
        }
        @if (_order.CanCreateDocuments && _order.Status == SalesOrderStatus.Confirmed && _order.Shipped != ShipmentState.Full)
        {
            <button type="button" @onclick="ShipmentAsync" disabled="@_busy">@L("Оформить отгрузку")</button>
        }
        @if (_order.CanCreateDocuments && _order.Shipped != ShipmentState.None)
        {
            <button type="button" class="secondary" @onclick="ReturnAsync" disabled="@_busy">@L("Оформить возврат")</button>
        }
        @if (_order.CanEdit && _order.Status == SalesOrderStatus.Confirmed)
        {
            <button type="button" class="secondary" @onclick="CloseAsync" disabled="@_busy">@L("Закрыть заказ")</button>
        }
        @if (_order.CanEdit && _order.Status == SalesOrderStatus.Closed)
        {
            <button type="button" class="secondary" @onclick="ReopenAsync" disabled="@_busy">@L("Вернуть в работу")</button>
        }
        @if (_order.CanEdit && _order.Status is SalesOrderStatus.Draft or SalesOrderStatus.Confirmed)
        {
            <ConfirmButton Class="secondary" OnConfirm="CancelAsync" Disabled="@_busy" Question='@L("Отменить заказ?")'>@L("Отменить заказ")</ConfirmButton>
        }
    </div>

    @if (_order.Documents.Count > 0)
    {
        <h2 style="margin-top: 20px">@L("Отгрузки и возвраты")</h2>
        <table class="compact">
            <tbody>
                @foreach (var d in _order.Documents)
                {
                    <tr>
                        <td><a href="stock-documents/@d.Id">@L(d.KindName) @d.Number</a></td>
                        <td>@d.Date.ToString("dd.MM.yyyy")</td>
                        <td><span class="tag @StockDocumentsPage.StatusClass(d.Status)">@L(d.StatusName)</span></td>
                        <td>
                            @if (_order.CanSeePrices && d.Kind == StockOperationKind.Shipment && d.Status == StockDocumentStatus.Posted)
                            {
                                <a href="print/upd/@d.Id" target="_blank" rel="noopener">@L("УПД")</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (_lots is { Rows.Count: > 0 } lots)
    {
        @* D106: какие партии и крашения ушли покупателю. *@
        <h2 style="margin-top: 20px">@L("Партии и крашения покупателю")</h2>
        @foreach (var w in lots.Warnings)
        {
            <div class="flash error" role="alert">@w</div>
        }
        <table class="compact">
            <tbody>
                @foreach (var r in lots.Rows)
                {
                    <tr><td>@r.ItemCode</td><td>@r.BatchLabel</td><td class="num">@Quantities.Format(r.Quantity) @r.UnitSymbol</td></tr>
                }
            </tbody>
        </table>
    }

    @if (_order.CanSeePrices && _order.Status is SalesOrderStatus.Confirmed or SalesOrderStatus.Closed)
    {
        <h2 style="margin-top: 20px">@L("Счёт на оплату")</h2>
        @if (_invoiceId is { } invoiceId)
        {
            <p>
                <a href="customer-invoices/@invoiceId">@L("Счёт выставлен — открыть")</a> ·
                <a href="print/invoice/@invoiceId" target="_blank" rel="noopener">@L("Печать счёта")</a>
            </p>
        }
        else if (_order.CanEdit)
        {
            <form class="inline-form" @onsubmit="IssueInvoiceAsync">
                <label>@L("Оплатить до") <input type="date" @bind="_dueDate" /></label>
                <button type="submit" disabled="@_busy">@L("Выставить счёт")</button>
            </form>
        }
        else
        {
            <p class="muted">@L("Счёт не выставлен.")</p>
        }

        <h2 style="margin-top: 20px">@L("Оплаты")</h2>
        @if (_order.CanEdit)
        {
            <form class="inline-form" @onsubmit="PayAsync">
                <label>@L("Дата") <input type="date" @bind="_payDate" /></label>
                <label>@L("Сумма") <input @bind="_payText" inputmode="decimal" size="12" /></label>
<label>
                    @L("Счёт или касса")
                    <select @bind="_payAccount">
                        <option value="">@L("основной счёт")</option>
                        @foreach (var a in _accounts.Where(a => a.LegalEntityId == _order.Details?.LegalEntityId))
                        {
                            <option value="@a.Id">@a.Label</option>
                        }
                    </select>
                </label>
                <label>@L("№ платёжного документа") <input @bind="_payDocument" maxlength="@CustomerPayment.DocumentNumberMaxLength" size="10" placeholder="101" /></label>
                <label>@L("Комментарий") <input @bind="_payComment" maxlength="@CustomerPayment.CommentMaxLength" /></label>
                <button type="submit" disabled="@_busy">@L("Записать оплату")</button>
            </form>
        }
        @if (_advances > 0 && _order.Total - _order.Paid > 0)
        {
            <div class="flash" role="status">
                @L("Есть аванс, не разнесённый по заказам: {0}.", Amounts.Format(_advances))
                <button type="button" @onclick="ApplyAdvancesAsync" disabled="@_busy">@L("Зачесть в этот заказ")</button>
            </div>
        }
        @if (_order.Payments.Count > 0)
        {
            <table class="compact">
                <tbody>
                    @foreach (var p in _order.Payments)
                    {
                        <tr class="@(p.Status == CustomerPaymentStatus.Cancelled ? "archived" : null)">
                            <td>@p.Number</td>
                            <td>@p.Date.ToString("dd.MM.yyyy")</td>
                            <td class="num">@Amounts.Format(p.ToOrder ?? p.Amount)@if (p.ToOrder is { } part && part != p.Amount) { <div class="muted small">@L("из {0}", Amounts.Format(p.Amount))</div> }</td>
                            <td>@p.Comment</td>
                            <td>@(p.Status == CustomerPaymentStatus.Cancelled ? L("отменена: {0}", p.CancelReason ?? "") : "")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
}

@code {
    [Parameter]
    public long Id { get; set; }

    [CascadingParameter]
    public CurrentAccessDto CurrentAccess { get; set; } = default!;

    private SalesOrderDto? _order;
    private SalesOptionsDto? _options;
    private HeaderForm? _header;
    private bool _busy;
    private decimal _advances;
    private bool _notFound;
    private string? _denied;
    private string? _message;
    private bool _messageIsError;
    private string _itemText = string.Empty;
    private string _qtyText = string.Empty;
    private string _priceText = string.Empty;
    private string _vatText = string.Empty;
    private string _discountText = string.Empty;
    private string _orderDiscountText = string.Empty;
    private DateTime _payDate = DateTime.Today;
    private string _payText = string.Empty;
    private string? _payComment;
    private string? _payDocument;
    private string _payAccount = string.Empty;
    private IReadOnlyList<KnitErp.Application.Finance.MoneyAccountOptionDto> _accounts = [];
    private static long? AccountId(string value) => long.TryParse(value, out var id) ? id : null;

    private long? _invoiceId;
    private IReadOnlyList<SalesStageDto> _stages = [];
    private DateTime? _dueDate;

    private DetailsForm? _details;
    private SalesOrderDetailOptionsDto? _detailOptions;

    private sealed class DetailsForm
    {
        public TimeOnly? Time { get; set; }
        public string Project { get; set; } = string.Empty;
        public string Channel { get; set; } = string.Empty;
        public string Responsible { get; set; } = string.Empty;
        public string? Address { get; set; }
        public string Account { get; set; } = string.Empty;
        public Dictionary<long, string?> Values { get; } = [];
    }

    private sealed class HeaderForm
    {
        public string Customer { get; set; } = string.Empty;
        public string Warehouse { get; set; } = string.Empty;
        public DateTime Date { get; set; }
        public DateTime? Expected { get; set; }
        public string? Invoice { get; set; }
        public string? Comment { get; set; }
        public bool WithVat { get; set; }
        public string Entity { get; set; } = string.Empty;
    }

    protected override async Task OnParametersSetAsync()
    {
        _order = null;
        _notFound = false;
        try
        {
            await LoadAsync();
            if (_order!.CanEdit)
            {
                _options = await Sales.GetOptionsAsync(_order.OrderDate);
                _vatText = _options.VatRates.FirstOrDefault()?.Percent?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty;
                _accounts = CurrentAccess.Has(Permissions.PriceView) ? await Money.OptionsAsync() : [];
            }

            _payDate = TimeZones.ToLocal(DateTime.UtcNow, CurrentAccess.TimeZoneId).Date;
        }
        catch (AccessDeniedException ex)
        {
            _denied = UiErrors.Message(ex);
        }
        catch (NotFoundException)
        {
            _notFound = true;
        }
    }

    /// <summary>Смена этапа из выпадающего списка в шапке — сразу сохраняется.</summary>
    private Task SetStageAsync(ChangeEventArgs e) => RunAsync(
        () => Sales.SetOrderStageAsync(Id, long.TryParse(e.Value?.ToString(), out var s) ? s : null, _order!.RowVersion), L("Этап заказа изменён."));

    private KnitErp.Application.Warehousing.SalesOrderBatchesDto? _lots;

    private async Task LoadAsync()
    {
        if (_stages.Count == 0)
        {
            _stages = await StageList.ListAsync();
        }

        _order = await Sales.GetOrderAsync(Id);
        _lots = _order.Documents.Count > 0 ? await BatchService.ForSalesOrderAsync(Id) : null;
        _invoiceId = _order.CanSeePrices ? await Invoices.FindForOrderAsync(Id) : null;
        _advances = _order.CanEdit && _order.Status is SalesOrderStatus.Confirmed or SalesOrderStatus.Closed ? await Sales.AvailableAdvancesAsync(Id) : 0;
    }

    /// <summary>Счёт по заказу и сразу его карточка: там печать.</summary>
    private async Task IssueInvoiceAsync()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        try
        {
            var id = await Invoices.CreateAsync(Id, _dueDate is { } d ? DateOnly.FromDateTime(d) : null, null);
            Navigation.NavigateTo($"customer-invoices/{id}");
        }
        catch (Exception ex) when (UiErrors.IsUserFacing(ex))
        {
            _message = UiErrors.Message(ex);
            _messageIsError = true;
        }
        finally
        {
            _busy = false;
        }
    }

    private Task EditHeaderAsync() => RunAsync(() =>
    {
        _header = new HeaderForm
        {
            Customer = _order!.CustomerId.ToString(), Warehouse = _order.WarehouseId.ToString(), Date = _order.OrderDate.ToDateTime(TimeOnly.MinValue),
            Expected = _order.ShipDate?.ToDateTime(TimeOnly.MinValue), Invoice = _order.CustomerReference, Comment = _order.Comment,
            WithVat = _order.PricesIncludeVat, Entity = _order.Details?.LegalEntityId.ToString() ?? string.Empty,
        };
        return Task.CompletedTask;
    }, null);

    private Task EditDetailsAsync() => RunAsync(async () =>
    {
        _detailOptions ??= await Sales.DetailOptionsAsync();
        var d = _order!.Details!;
        _details = new DetailsForm
        {
            Time = d.OrderTime, Project = d.ProjectId?.ToString() ?? string.Empty, Channel = d.ChannelId?.ToString() ?? string.Empty,
            Responsible = d.ResponsibleUserId?.ToString() ?? string.Empty, Address = d.DeliveryAddress,
            Account = d.BankAccountId?.ToString() ?? string.Empty,
        };
        foreach (var f in d.CustomFields.Where(f => !f.IsArchived))
        {
            _details.Values[f.FieldId] = f.Value;
        }
    }, null);

    private Task SaveDetailsAsync() => RunAsync(async () =>
    {
        var d = _details!;
        static long? ParseId(string v) => long.TryParse(v, out var id) ? id : null;
        await Sales.SetOrderDetailsAsync(Id, new SalesOrderDetails(d.Time, ParseId(d.Project), ParseId(d.Channel), d.Address, ParseId(d.Responsible),
            ParseId(d.Account)),
            d.Values, _order!.RowVersion);
        _details = null;
    }, L("Детали заказа сохранены."));

    private bool IsFlagSet(long fieldId) => _details?.Values.GetValueOrDefault(fieldId) == "true";

    private void SetFlag(long fieldId, ChangeEventArgs e) => _details!.Values[fieldId] = e.Value is true ? "true" : null;

    /// <summary>Значение доп. поля для чтения: число и дата — по-русски, флажок — «да».</summary>
    private string CustomValue(SalesOrderCustomValueDto f)
    {
        var ru = System.Globalization.CultureInfo.GetCultureInfo("ru-RU");
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        return f.Value switch
        {
            null => "—",
            var v when f.Type == CustomFieldType.Number && decimal.TryParse(v, inv, out var n) => n.ToString("#,0.######", ru),
            var v when f.Type == CustomFieldType.Date && DateOnly.TryParseExact(v, "yyyy-MM-dd", inv, System.Globalization.DateTimeStyles.None, out var dt)
                => dt.ToString("dd.MM.yyyy"),
            _ when f.Type == CustomFieldType.Flag => L("да"),
            var v => v,
        };
    }

    private Task SaveHeaderAsync() => RunAsync(async () =>
    {
        var h = _header!;
        await Sales.UpdateOrderHeaderAsync(Id, new SalesOrderHeader(DateOnly.FromDateTime(h.Date), long.Parse(h.Customer), long.Parse(h.Warehouse),
            h.Expected is { } e ? DateOnly.FromDateTime(e) : null, h.Invoice, h.WithVat, h.Comment, long.TryParse(h.Entity, out var le) ? le : null),
            _order!.RowVersion);
        _header = null;
    }, L("Сохранено."));

    /// <summary>НДС по умолчанию — ставка позиции из номенклатуры.</summary>
    /// <summary>По выбранной позиции: НДС — ставка из номенклатуры, цена — из карточки.</summary>
    private void SuggestVat()
    {
        if (FindItem() is { } item)
        {
            _itemText = $"{item.Code} — {item.Name}";
            _vatText = item.VatPercent?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty;
            // Цена основного вида из карточки (D79) — если цену ещё не ввели.
            if (item.Price is { } price && string.IsNullOrWhiteSpace(_priceText))
            {
                _priceText = Amounts.Input(Amounts.Reprice(price, item.PriceIncludesVat, _order!.PricesIncludeVat, item.VatPercent));
            }
        }
    }

    private SalesItemOptionDto? FindItem()
    {
        // По коду, артикулу или штрихкоду (сканер вводит штрихкод как текст).
        var code = _itemText.Split(" — ", 2)[0].Trim();
        return _options?.Items.FirstOrDefault(i => string.Equals(i.Code, code, StringComparison.OrdinalIgnoreCase))
               ?? _options?.Items.FirstOrDefault(i => i.Article is not null && string.Equals(i.Article, code, StringComparison.OrdinalIgnoreCase))
               ?? _options?.Items.FirstOrDefault(i => i.Barcodes is not null && i.Barcodes.Split(' ').Contains(code));
    }

    private void EditLine(SalesOrderLineDto l)
    {
        _itemText = $"{l.Code} — {l.Name}";
        _qtyText = Quantities.Format(l.Quantity);
        _priceText = l.Price?.ToString("0.####", System.Globalization.CultureInfo.GetCultureInfo("ru-RU")) ?? string.Empty;
        _vatText = l.VatPercent?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty;
        _discountText = l.DiscountPercent > 0 ? l.DiscountPercent.ToString("0.##", System.Globalization.CultureInfo.GetCultureInfo("ru-RU")) : string.Empty;
    }

    private Task SetOrderDiscountAsync() => RunAsync(async () =>
    {
        await Sales.SetOrderDiscountAsync(Id, Number(_orderDiscountText), _order!.RowVersion);
        _orderDiscountText = string.Empty;
    }, L("Скидка применена ко всем строкам."));

    private Task ToggleReserveAsync(ChangeEventArgs e) =>
        RunAsync(() => Sales.SetOrderReserveAsync(Id, e.Value is true, _order!.RowVersion), e.Value is true ? L("Товар зарезервирован.") : L("Резерв снят."));

    private Task SetLineAsync() => RunAsync(async () =>
    {
        var item = FindItem() ?? throw new BusinessRuleException("sales.item_unknown", L("Позиция «{0}» не найдена. Выберите из списка.", _itemText));
        var qty = Number(_qtyText);
        var price = Number(_priceText);
        decimal? vat = _vatText.Length == 0 ? null : decimal.Parse(_vatText, System.Globalization.CultureInfo.InvariantCulture);
        var discount = string.IsNullOrWhiteSpace(_discountText) ? 0 : Number(_discountText);
        await Sales.SetOrderLineAsync(Id, item.Id, qty, price, vat, discount, _order!.RowVersion);
        _itemText = string.Empty;
        _discountText = string.Empty;
        _qtyText = string.Empty;
        _priceText = string.Empty;
    }, null);

    private Task RemoveLineAsync(SalesOrderLineDto l) => RunAsync(() => Sales.RemoveOrderLineAsync(Id, l.ItemId, _order!.RowVersion), null);

    private Task ConfirmAsync() => RunAsync(() => Sales.ConfirmOrderAsync(Id, _order!.RowVersion), L("Заказ подтверждён."));

    private Task CloseAsync() => RunAsync(() => Sales.CloseOrderAsync(Id, _order!.RowVersion), L("Заказ закрыт."));

    private Task ReopenAsync() => RunAsync(() => Sales.ReopenOrderAsync(Id, _order!.RowVersion), L("Заказ снова в работе."));

    private Task CancelAsync() => RunAsync(() => Sales.CancelOrderAsync(Id, _order!.RowVersion), L("Заказ отменён."));

    private Task ShipmentAsync() => GoAsync(() => Sales.CreateShipmentAsync(Id));

    private Task ReturnAsync() => GoAsync(() => Sales.CreateReturnAsync(Id));

    private Task PayAsync() => RunAsync(async () =>
    {
        await Sales.CreatePaymentAsync(DateOnly.FromDateTime(_payDate), _order!.CustomerId, Id, Number(_payText), _payComment, _payDocument, AccountId(_payAccount));
        _payDocument = null;
        _payText = string.Empty;
        _payComment = null;
    }, L("Оплата записана."));

    /// <summary>Создать документ по заказу и открыть его черновик.</summary>
    private async Task GoAsync(Func<Task<long>> create)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        try
        {
            var id = await create();
            Navigation.NavigateTo($"stock-documents/{id}");
        }
        catch (Exception ex) when (UiErrors.IsUserFacing(ex))
        {
            _message = UiErrors.Message(ex);
            _messageIsError = true;
        }
        finally
        {
            _busy = false;
        }
    }

    private static decimal Number(string text) =>
        Quantities.TryParse(text, out var value) ? value : throw new BusinessRuleException("sales.number", L("Укажите число, например 1 220,50."));

    /// <summary>Одна операция за раз, затем свежий заказ: у вкладки один DbContext.</summary>
    private Task ApplyAdvancesAsync() => RunAsync(() => Sales.ApplyAdvancesAsync(Id), L("Аванс зачтён в заказ."));

    private async Task RunAsync(Func<Task> action, string? success)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _message = null;
        _messageIsError = false;
        try
        {
            await action();
            _message = success ?? _message;
        }
        catch (Exception ex) when (UiErrors.IsUserFacing(ex))
        {
            _message = UiErrors.Message(ex);
            _messageIsError = true;
        }
        finally
        {
            try
            {
                await LoadAsync();
            }
            finally
            {
                _busy = false;
            }
        }
    }

    private string Local(DateTime utc) => TimeZones.ToLocal(utc, CurrentAccess.TimeZoneId).ToString("dd.MM.yyyy HH:mm");
}
