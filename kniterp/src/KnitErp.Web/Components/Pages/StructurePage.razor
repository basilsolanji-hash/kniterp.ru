@page "/structure"
@using KnitErp.Application.Structure
@using KnitErp.Web.Components.Shared
@inject StructureService Structure

<PageTitle>@L("Структура") — knitERP</PageTitle>

@if (_denied is not null)
{
    <AccessDenied Message="@_denied" />
}
else if (_data is null)
{
    <p class="muted">@L("Загрузка…")</p>
}
else
{
    <div class="page-head">
        <h1>@L("Подразделения и должности")</h1>
        <label class="inline"><input type="checkbox" checked="@_showArchived" @onchange="ToggleArchivedAsync" disabled="@_busy" /> @L("Показать архив")</label>
    </div>

    @if (_data.IsScoped)
    {
        <p class="muted">@L("Вы видите только своё подразделение и вложенные в него.")</p>
    }

    @if (_message is not null)
    {
        <div class="@(_messageIsError ? "error" : "flash")" role="@(_messageIsError ? "alert" : "status")">@_message</div>
    }

    <h2>@L("Подразделения")</h2>
    @if (_data.CanEdit)
    {
        <form class="inline-form" @onsubmit="CreateDepartmentAsync">
            <label>@L("Новое подразделение") <input @bind="_newDepartment" maxlength="150" placeholder="@L("Например: Вязальный цех")" /></label>
            <label>
                @L("Входит в")
                <select @bind="_newDepartmentParent">
                    <option value="">@L("— верхний уровень —")</option>
                    @foreach (var d in ActiveDepartments)
                    {
                        <option value="@d.Id">@d.Path</option>
                    }
                </select>
            </label>
            <button type="submit" disabled="@_busy">@L("Добавить")</button>
        </form>
    }

    <div class="scroll">
        <table>
            <thead><tr><th>@L("Подразделение")</th><th>@L("Сотрудников")</th>@if (_data.CanEdit) { <th>@L("Действия")</th> }</tr></thead>
            <tbody>
                @if (_data.Departments.Count == 0)
                {
                    <EmptyRow Colspan="3" Text="@L("Подразделений пока нет.")" Hint="@L("Цеха и отделы фабрики: в них числятся сотрудники.")" />
                }
                @foreach (var d in _data.Departments)
                {
                    <tr class="@(d.IsArchived ? "archived" : null)">
                        <td style="padding-left: @(10 + d.Depth * 24)px">
                            @if (_editDepartment?.Id == d.Id)
                            {
                                <form class="inline-form" @onsubmit="() => SaveDepartmentAsync(d)">
                                    <label class="sr-only" for="dep-name-@d.Id">@L("Название")</label>
                                    <input id="dep-name-@d.Id" @bind="_editName" maxlength="150" />
                                    <label class="sr-only" for="dep-parent-@d.Id">@L("Входит в")</label>
                                    <select id="dep-parent-@d.Id" @bind="_editParent">
                                        <option value="">@L("— верхний уровень —")</option>
                                        @foreach (var p in ActiveDepartments.Where(x => x.Id != d.Id))
                                        {
                                            <option value="@p.Id">@p.Path</option>
                                        }
                                    </select>
                                    <button type="submit" disabled="@_busy">@L("Сохранить")</button>
                                    <button type="button" class="secondary" @onclick="() => _editDepartment = null">@L("Отмена")</button>
                                </form>
                            }
                            else
                            {
                                @d.Name
                                @if (d.IsArchived)
                                {
                                    <span class="tag">@L("архив")</span>
                                }
                            }
                        </td>
                        <td>@d.EmployeeCount</td>
                        @if (_data.CanEdit)
                        {
                            <td>
                                @if (!d.IsArchived && _editDepartment?.Id != d.Id)
                                {
                                    <div class="row-actions">
                                        <button type="button" class="secondary" @onclick="() => StartEditDepartment(d)" disabled="@_busy">@L("Изменить")</button>
                                        <ConfirmButton Class="secondary" OnConfirm="() => ArchiveDepartmentAsync(d)" Disabled="@_busy" Question='@L("Отправить в архив?")'>@L("В архив")</ConfirmButton>
                                    </div>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <h2 style="margin-top: 32px">@L("Должности")</h2>
    @if (_data.CanEdit)
    {
        <form class="inline-form" @onsubmit="CreatePositionAsync">
            <label>@L("Новая должность") <input @bind="_newPosition" maxlength="150" placeholder="@L("Например: Вязальщица")" /></label>
            <button type="submit" disabled="@_busy">@L("Добавить")</button>
        </form>
    }

    <div class="scroll">
        <table>
            <thead><tr><th>@L("Должность")</th><th>@L("Сотрудников")</th>@if (_data.CanEdit) { <th>@L("Действия")</th> }</tr></thead>
            <tbody>
                @if (_data.Positions.Count == 0)
                {
                    <EmptyRow Colspan="3" Text="@L("Должностей пока нет.")" Hint="@L("Должность указывают в карточке сотрудника и в кадровых приказах.")" />
                }
                @foreach (var p in _data.Positions)
                {
                    <tr class="@(p.IsArchived ? "archived" : null)">
                        <td>
                            @if (_editPosition?.Id == p.Id)
                            {
                                <form class="inline-form" @onsubmit="() => SavePositionAsync(p)">
                                    <label class="sr-only" for="pos-name-@p.Id">@L("Название")</label>
                                    <input id="pos-name-@p.Id" @bind="_editName" maxlength="150" />
                                    <button type="submit" disabled="@_busy">@L("Сохранить")</button>
                                    <button type="button" class="secondary" @onclick="() => _editPosition = null">@L("Отмена")</button>
                                </form>
                            }
                            else
                            {
                                @p.Name
                                @if (p.IsArchived)
                                {
                                    <span class="tag">@L("архив")</span>
                                }
                            }
                        </td>
                        <td>@p.EmployeeCount</td>
                        @if (_data.CanEdit)
                        {
                            <td>
                                @if (!p.IsArchived && _editPosition?.Id != p.Id)
                                {
                                    <div class="row-actions">
                                        <button type="button" class="secondary" @onclick="() => StartEditPosition(p)" disabled="@_busy">@L("Переименовать")</button>
                                        <ConfirmButton Class="secondary" OnConfirm="() => ArchivePositionAsync(p)" Disabled="@_busy" Question='@L("Отправить в архив?")'>@L("В архив")</ConfirmButton>
                                    </div>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="muted">@L("Подразделения и должности не удаляются — только в архив, история сохраняется. В архив можно отправить только пустое подразделение.")</p>
}

@code {
    private StructureDto? _data;
    private bool _showArchived;
    private bool _busy;
    private string? _denied;
    private string? _message;
    private bool _messageIsError;

    private string _newDepartment = string.Empty;
    private string _newDepartmentParent = string.Empty;
    private string _newPosition = string.Empty;
    private DepartmentDto? _editDepartment;
    private PositionDto? _editPosition;
    private string _editName = string.Empty;
    private string _editParent = string.Empty;

    private IEnumerable<DepartmentDto> ActiveDepartments => _data!.Departments.Where(d => !d.IsArchived);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _data = await Structure.GetAsync();
        }
        catch (AccessDeniedException ex)
        {
            _denied = UiErrors.Message(ex);
        }
    }

    private async Task ToggleArchivedAsync(ChangeEventArgs e)
    {
        _showArchived = e.Value is true;
        await RunAsync(() => Task.CompletedTask, null);
    }

    private Task CreateDepartmentAsync() => RunAsync(async () =>
    {
        await Structure.CreateDepartmentAsync(_newDepartment, ParseId(_newDepartmentParent));
        _newDepartment = string.Empty;
    }, L("Подразделение добавлено."));

    private void StartEditDepartment(DepartmentDto d)
    {
        _editPosition = null;
        _editDepartment = d;
        _editName = d.Name;
        _editParent = d.ParentId?.ToString() ?? string.Empty;
    }

    private Task SaveDepartmentAsync(DepartmentDto d) => RunAsync(async () =>
    {
        // Переименование и перенос — отдельные изменения; версия после первого берётся заново.
        if (_editName.Trim() != d.Name)
        {
            await Structure.RenameDepartmentAsync(d.Id, _editName, d.RowVersion);
            d = (await Structure.GetAsync(_showArchived)).Departments.Single(x => x.Id == d.Id);
        }

        if (ParseId(_editParent) != d.ParentId)
        {
            await Structure.MoveDepartmentAsync(d.Id, ParseId(_editParent), d.RowVersion);
        }

        _editDepartment = null;
    }, L("Подразделение сохранено."));

    private Task ArchiveDepartmentAsync(DepartmentDto d) =>
        RunAsync(() => Structure.ArchiveDepartmentAsync(d.Id, d.RowVersion), L("Подразделение «{0}» в архиве.", d.Name));

    private Task CreatePositionAsync() => RunAsync(async () =>
    {
        await Structure.CreatePositionAsync(_newPosition);
        _newPosition = string.Empty;
    }, L("Должность добавлена."));

    private void StartEditPosition(PositionDto p)
    {
        _editDepartment = null;
        _editPosition = p;
        _editName = p.Name;
    }

    private Task SavePositionAsync(PositionDto p) => RunAsync(async () =>
    {
        await Structure.RenamePositionAsync(p.Id, _editName, p.RowVersion);
        _editPosition = null;
    }, L("Должность переименована."));

    private Task ArchivePositionAsync(PositionDto p) =>
        RunAsync(() => Structure.ArchivePositionAsync(p.Id, p.RowVersion), L("Должность «{0}» в архиве.", p.Name));

    /// <summary>Одна операция за раз, затем свежие данные: у вкладки один DbContext.</summary>
    private async Task RunAsync(Func<Task> action, string? success)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _message = null;
        try
        {
            await action();
            _message = success;
            _messageIsError = false;
        }
        catch (Exception ex) when (UiErrors.IsUserFacing(ex))
        {
            _message = UiErrors.Message(ex);
            _messageIsError = true;
        }
        finally
        {
            try
            {
                _data = await Structure.GetAsync(_showArchived);
            }
            finally
            {
                _busy = false;
            }
        }
    }

    private static long? ParseId(string value) => long.TryParse(value, out var id) ? id : null;
}
