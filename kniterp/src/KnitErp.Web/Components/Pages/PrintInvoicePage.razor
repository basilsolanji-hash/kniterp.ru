@page "/print/invoice/{Id:long}"
@layout KnitErp.Web.Components.Layout.PrintLayout
@using System.Globalization
@using KnitErp.Application.Printing
@using KnitErp.Application.Sales
@using KnitErp.Domain.Sales
@inject PrintService Print
@inject SalesDocumentPrintService Extras

@* Счёт на оплату — российская форма, печатается по-русски (D68). *@
<PageTitle>@(_doc is null ? "Счёт" : $"Счёт {_doc.Number}") — knitERP</PageTitle>
<style>@@media print { @@page { size: A4 portrait; margin: 12mm; } }</style>
<SalesPrintStyles />

<div class="print-bar">
    <button type="button" data-print>@L("Печать")</button>
    <a href="@(_doc is null ? "customer-invoices" : $"customer-invoices/{Id}")">@L("← К счёту")</a>
    @if (_doc is not null && (_doc.Requisites.BankAccount is null || _doc.Requisites.BankBic is null))
    {
        <span class="warn">@L("Не заполнены банковские реквизиты — раздел «Организация», «Реквизиты для печати».")</span>
    }
</div>

@if (_error is not null)
{
    <div class="sheet portrait"><p>@_error</p></div>
}
else if (_doc is null)
{
    <div class="sheet portrait"><p>@L("Загрузка…")</p></div>
}
else
{
    <InvoiceSheet Doc="_doc" Deco="_deco" QrSvg="_qrSvg" />
}

@code {
    [Parameter]
    public long Id { get; set; }

    private InvoicePrintDto? _doc;
    private SalesPrintDecorations _deco = SalesPrintDecorations.None;
    private string? _qrSvg;
    private string? _error;

    private static readonly CultureInfo Ru = CultureInfo.GetCultureInfo("ru-RU");

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            _doc = await Print.InvoiceAsync(Id);
            _deco = await Extras.DecorationsAsync(SalesMailDocument.Invoice, Id); // D1120, D1121
            _qrSvg = _deco.PaymentQr is { } qr ? KnitErp.Infrastructure.Documents.PaymentQrImage.Svg(qr) : null;
        }
        catch (Exception ex) when (UiErrors.IsUserFacing(ex))
        {
            _error = UiErrors.Message(ex);
        }
    }

    public static string Date(DateOnly d) => d.ToString("d MMMM yyyy", Ru) + " г.";

    public static string Party(PrintPartyDto p) =>
        string.Join(", ", new[] { p.Name, p.Inn is null ? null : $"ИНН {p.Inn}", p.Kpp is null ? null : $"КПП {p.Kpp}", p.Address }.Where(x => x is not null));
}
