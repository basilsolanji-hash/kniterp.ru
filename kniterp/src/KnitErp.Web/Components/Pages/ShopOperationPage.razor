@page "/shop/op/{OrderId:long}/{Stage:int}"
@using KnitErp.Application.Production
@using KnitErp.Domain.Production
@inject ShopFloorService Shop

@* Операция на терминале цеха (D92, дополнение): этап заказа по QR-коду, отметка целиком или частично с причиной. *@
<PageTitle>@(_op is null ? L("Операция") : $"{_op.OrderNumber} · {L(_op.StageName)}") — knitERP</PageTitle>
<ShopStyles />

<p><a href="shop">@L("← Терминал цеха")</a></p>
@if (_denied is not null)
{
    <AccessDenied Message="@_denied" />
}
else if (_notFound)
{
    <p>@L("Операция не найдена — проверьте код.")</p>
}
else if (_op is null)
{
    <p class="muted">@L("Загрузка…")</p>
}
else
{
    var op = _op;
    <div class="shop">
        <h1>@L(op.StageName)</h1>
        <p><b>@op.OrderNumber</b> — @op.ItemCode @op.ItemName@(op.DueDate is { } d ? ", " + L("срок {0}", d.ToString("dd.MM.yyyy")) : "")</p>
        <ShopHintMessage Hint="op.Hint" EmployeeName="@op.EmployeeName" />

        <div class="shop-big">
            <div>@L("Можно отметить")<b>@Quantities.Format(op.Available)</b>@op.UnitSymbol</div>
            <div>@L("Сделано на этапе")<b>@Quantities.Format(op.Done)</b>@L("из {0}", Quantities.Format(op.OrderQuantity))</div>
            <div>@L("Я сегодня")<b>@Quantities.Format(op.MyToday)</b>@op.UnitSymbol</div>
        </div>

        @if (_message is not null)
        {
            <div class="@(_messageIsError ? "flash error" : "flash")" role="@(_messageIsError ? "alert" : "status")">@_message</div>
        }

        @if (op.CanMark && op.IsQualityControl)
        {
            <fieldset class="shop-quick" aria-label="@L("Результат контроля")">
                <label><input type="radio" name="qc" checked="@(_qc == QcMode.Good)" @onchange="() => _qc = QcMode.Good" /> @L("Годное")</label>
                <label><input type="radio" name="qc" checked="@(_qc == QcMode.Defect)" @onchange="() => _qc = QcMode.Defect" /> @L("Брак")</label>
                <label><input type="radio" name="qc" checked="@(_qc == QcMode.Rework)" @onchange="() => _qc = QcMode.Rework" /> @L("На переделку")</label>
            </fieldset>
        }
        @if (op.CanMark && op.IsQualityControl && _qc != QcMode.Good)
        {
            <form @onsubmit="MarkQualityAsync">
                <label>
                    @(_qc == QcMode.Defect ? L("Брак, {0}", op.UnitSymbol) : L("На переделку, {0}", op.UnitSymbol))
                    <input @bind="_quantityText" inputmode="decimal" autocomplete="off" aria-label="@L("Количество")" />
                </label>
                @if (_qc == QcMode.Defect)
                {
                    <label>@L("Причина брака")
                        <input @bind="_comment" maxlength="300" aria-label="@L("Причина брака")" /></label>
                    @if (op.Culprits is { Count: > 0 } people)
                    {
                        <label>@L("Виновник брака")
                            <select @bind="_culprit" aria-label="@L("Виновник брака")">
                                <option value="">@L("— не указан —")</option>
                                @foreach (var e in people)
                                {
                                    @* Табельный номер — только чтобы различить однофамильцев: на общем телефоне цеха лишних данных не показываем. *@
                                    <option value="@e.Id">@(people.Count(x => x.Name == e.Name) > 1 ? $"{e.Name} ({e.PersonnelNumber})" : e.Name)</option>
                                }
                            </select>
                        </label>
                    }
                }
                else
                {
                    <label>@L("Вернуть на этап")
                        <select @bind="_returnTo" aria-label="@L("Вернуть на этап")">
                            @foreach (var r in op.ReworkStages ?? [])
                            {
                                <option value="@r">@L(ProductionFlow.StageName(r))</option>
                            }
                        </select>
                    </label>
                    <label>@L("Комментарий")
                        <input @bind="_comment" maxlength="300" aria-label="@L("Комментарий")" /></label>
                }
                <button type="submit" class="shop-submit" disabled="@_busy">@(_qc == QcMode.Defect ? L("Отметить брак") : L("Отправить на переделку"))</button>
            </form>
        }
        else if (op.CanMark)
        {
            <form @onsubmit="MarkAsync">
                <label>
                    @L("Сделано, {0}", op.UnitSymbol)
                    <input @bind="_quantityText" @bind:event="oninput" inputmode="decimal" autocomplete="off" aria-label="@L("Сделано")" />
                </label>
                <div class="shop-quick">
                    <button type="button" class="secondary" @onclick="() => _quantityText = Quantities.Format(op.Available)">@L("Всё: {0}", Quantities.Format(op.Available))</button>
                </div>
                @if (IsPartial)
                {
                    <label>
                        @L("Почему не всё")
                        <select @bind="_shortfall" aria-label="@L("Почему не всё")">
                            <option value="">@L("— не указано —")</option>
                            @foreach (var r in ShopFloorShortfall.Reasons)
                            {
                                <option value="@r">@L(r)</option>
                            }
                        </select>
                    </label>
                }
                <label>
                    @L("Комментарий")
                    <textarea @bind="_comment" maxlength="@ShopFloorService.CommentMaxLength" aria-label="@L("Комментарий")"></textarea>
                </label>
                <button type="submit" class="shop-submit" disabled="@_busy">@(IsPartial ? L("Отметить частично") : L("Отметить"))</button>
            </form>
        }
        <p class="muted">@L("Код операции: {0}", op.Code)</p>
    </div>
}

@code {
    [Parameter]
    public long OrderId { get; set; }

    [Parameter]
    public int Stage { get; set; }

    private ShopOperationDto? _op;
    private string? _denied;
    private bool _notFound;
    private bool _busy;
    private string _quantityText = string.Empty;
    private string _shortfall = string.Empty;
    private string? _comment;
    private string? _message;
    private bool _messageIsError;

    private enum QcMode { Good, Defect, Rework }

    private QcMode _qc = QcMode.Good;
    private string _culprit = string.Empty;
    private ProductionStage _returnTo = ProductionStage.Knitting;

    /// <summary>Брак или переделка на контроле качества (D407).</summary>
    private async Task MarkQualityAsync()
    {
        if (_busy || _op is null)
        {
            return;
        }

        _busy = true;
        _message = null;
        _messageIsError = false;
        try
        {
            if (!Quantities.TryParse(_quantityText, out var quantity))
            {
                throw new BusinessRuleException("production.stage.quantity_invalid", L("Укажите количество числом, например 100."));
            }

            var kind = _qc == QcMode.Defect ? ProductionOperationKind.Defect : ProductionOperationKind.Rework;
            await Shop.MarkQualityAsync(OrderId, new ShopQualityCommand(kind, quantity, _comment,
                kind == ProductionOperationKind.Defect && long.TryParse(_culprit, out var culprit) ? culprit : null,
                kind == ProductionOperationKind.Rework ? _returnTo : null));
            _message = kind == ProductionOperationKind.Defect
                ? L("Брак отмечен: {0} {1}.", Quantities.Format(quantity), _op.UnitSymbol)
                : L("Отправлено на переделку: {0} {1}.", Quantities.Format(quantity), _op.UnitSymbol);
            _quantityText = string.Empty;
            _comment = null;
            _culprit = string.Empty;
        }
        catch (Exception ex) when (UiErrors.IsUserFacing(ex))
        {
            _message = UiErrors.Message(ex);
            _messageIsError = true;
        }
        finally
        {
            try
            {
                var message = (_message, _messageIsError);
                _op = await Shop.OperationAsync(OrderId, (ProductionStage)Stage);
                (_message, _messageIsError) = message;
                if (_op.ReworkStages is { Count: > 0 } stages && !stages.Contains(_returnTo))
                {
                    _returnTo = stages[0];
                }
            }
            catch (Exception ex) when (UiErrors.IsUserFacing(ex))
            {
                _message = UiErrors.Message(ex);
                _messageIsError = true;
            }
            finally
            {
                _busy = false;
            }
        }
    }

    /// <summary>Введено меньше доступного — спрашиваем причину.</summary>
    private bool IsPartial => _op is not null && Quantities.TryParse(_quantityText, out var q) && q > 0 && q < _op.Available;

    protected override async Task OnParametersSetAsync()
    {
        _op = null;
        _notFound = false;
        _message = null;
        try
        {
            _op = await Shop.OperationAsync(OrderId, (ProductionStage)Stage);
        }
        catch (AccessDeniedException ex)
        {
            _denied = UiErrors.Message(ex);
        }
        catch (NotFoundException)
        {
            _notFound = true;
        }
    }

    private async Task MarkAsync()
    {
        if (_busy || _op is null)
        {
            return;
        }

        _busy = true;
        _message = null;
        _messageIsError = false;
        try
        {
            if (!Quantities.TryParse(_quantityText, out var quantity))
            {
                throw new BusinessRuleException("production.stage.quantity_invalid", L("Укажите количество числом, например 100."));
            }

            var partial = IsPartial;
            await Shop.MarkAsync(OrderId, _op.Stage, new ShopMarkCommand(quantity, partial && _shortfall.Length > 0 ? _shortfall : null, _comment));
            _message = L("Отмечено: {0} {1}.", Quantities.Format(quantity), _op.UnitSymbol);
            _quantityText = string.Empty;
            _shortfall = string.Empty;
            _comment = null;
        }
        catch (Exception ex) when (UiErrors.IsUserFacing(ex))
        {
            _message = UiErrors.Message(ex);
            _messageIsError = true;
        }
        finally
        {
            try
            {
                var message = (_message, _messageIsError);
                _op = await Shop.OperationAsync(OrderId, (ProductionStage)Stage);
                (_message, _messageIsError) = message;
            }
            catch (Exception ex) when (UiErrors.IsUserFacing(ex))
            {
                _message = UiErrors.Message(ex);
                _messageIsError = true;
            }
            finally
            {
                _busy = false;
            }
        }
    }
}
