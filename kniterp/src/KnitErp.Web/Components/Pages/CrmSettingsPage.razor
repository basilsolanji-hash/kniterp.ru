@page "/crm/settings"
@using KnitErp.Application.Crm
@using KnitErp.Domain.Crm
@inject CrmSettingsService Settings
@inject CrmDealService Deals

<PageTitle>@L("Настройки CRM") — knitERP</PageTitle>
<CrmStyles />

@if (_denied is not null)
{
    <AccessDenied Message="@_denied" />
}
else if (_data is null)
{
    <p class="muted">@L("Загрузка…")</p>
}
else
{
    <h1>@L("Настройки CRM")</h1>
    <ReadOnlyNote When="@(!_data.CanEdit)" />
    <p class="muted small">@L("Воронки и их этапы, источники обращений, причины отказа. Ничего не удаляется — уходит в архив; сделки и лиды сохраняют ссылки.")</p>

    @if (_message is not null)
    {
        <div class="@(_isError ? "flash error" : "flash")" role="@(_isError ? "alert" : "status")">@_message</div>
    }

    @if (_auto is not null)
    {
        <form class="panel" @onsubmit="SaveAutomationAsync" aria-label="@L("Автоматизация")">
            <h2>@L("Автоматизация")</h2>
            <fieldset disabled="@(!_data.CanEdit)" title="@((!_data.CanEdit) ? L("Нет права на изменение") : null)">
                <div class="grid">
                    <label>
                        @L("Заявки из API, телефонии и импорта")
                        <select @bind="_auto.AssignMode">
                            <option value="1">@L("на ответственного по умолчанию")</option>
                            <option value="2">@L("по очереди между менеджерами продаж")</option>
                        </select>
                    </label>
                    <label>
                        @L("Ответственный по умолчанию")
                        <select @bind="_auto.DefaultUser">
                            <option value="">@L("автор заявки (владелец токена)")</option>
                            @foreach (var u in _users)
                            {
                                <option value="@u.Id">@u.Name</option>
                            }
                        </select>
                    </label>
                    <label class="inline"><input type="checkbox" @bind="_auto.NextStep" /> @L("Предлагать следующий шаг по этапу")</label>
                    <label class="inline"><input type="checkbox" @bind="_auto.StageByEvents" /> @L("Менять этап по событиям (КП, заказ)")</label>
                    <label>@L("Повторная продажа через, дней (пусто — выкл.)") <input type="number" min="1" max="730" @bind="_auto.RepeatDays" /></label>
                    <label>@L("Лид без действий — напомнить через, дней") <input type="number" min="1" max="90" @bind="_auto.StaleDays" /></label>
                    <label>
                        @L("Факт плана продаж")
                        <select @bind="_auto.PlanFact">
                            <option value="1">@L("оплаты по заказам из сделок")</option>
                            <option value="2">@L("выигранные сделки")</option>
                        </select>
                    </label>
                    <label>@L("КП действует, дней") <input type="number" min="1" max="365" @bind="_auto.OfferDays" /></label>
                    <label class="wide">@L("Условия КП по умолчанию") <textarea rows="3" @bind="_auto.OfferTerms" maxlength="@CrmSettings.OfferTermsMaxLength" placeholder="@L("Предоплата 50 %, срок изготовления 14 рабочих дней, доставка за счёт покупателя.")"></textarea></label>
                </div>
                @if (_data.CanEdit)
                {
                    <div class="actions"><button type="submit" disabled="@_busy">@L("Сохранить")</button></div>
                }
            </fieldset>
        </form>
    }

    <CrmMessengersPanel CanEdit="@_data.CanEdit" TimeZoneId="@CurrentAccess.TimeZoneId" />
    <CrmMailboxPanel CanEdit="@_data.CanEdit" TimeZoneId="@CurrentAccess.TimeZoneId" />
    <CrmEmailTemplatesPanel CanEdit="@_data.CanEdit" />

    <h2>@L("Воронки")</h2>
    @if (_data.CanEdit)
    {
        <form class="inline-form" @onsubmit="CreatePipelineAsync">
            <label>@L("Новая воронка") <input @bind="_pipelineName" maxlength="@CrmPipeline.NameMaxLength" required placeholder="@L("Маркетплейсы")" /></label>
            <button type="submit" disabled="@_busy">@L("Добавить")</button>
        </form>
    }

    @foreach (var p in _data.Pipelines)
    {
        <section class="panel" aria-label="@p.Name">
            <div class="page-head">
                <h3>@p.Name @if (p.IsArchived) { <span class="tag">@L("архив")</span> }</h3>
                @if (_data.CanEdit)
                {
                    <div class="actions">
                        @if (p.IsArchived)
                        {
                            <button type="button" class="secondary" @onclick='() => RunAsync(() => Settings.RestorePipelineAsync(p.Id, p.RowVersion), L("Воронка снова действует."))' disabled="@_busy">@L("Вернуть")</button>
                        }
                        else
                        {
                            <ConfirmButton Class="secondary" OnConfirm="() => RunAsync(() => Settings.ArchivePipelineAsync(p.Id, p.RowVersion), null)" Disabled="@_busy" Question='@L("Отправить воронку в архив?")'>@L("В архив")</ConfirmButton>
                        }
                    </div>
                }
            </div>
            <div class="scroll">
                <table class="compact">
                    <thead><tr><th>@L("Этап")</th><th class="num">@L("Вероятность")</th><th>@L("Вид")</th><th class="opt">@L("Следующий шаг")</th><th class="num">@L("Сделок")</th>@if (_data.CanEdit) { <th></th> }</tr></thead>
                    <tbody>
                        @foreach (var s in p.Stages)
                        {
                            <tr class="@(s.IsArchived ? "archived" : null)" @key="s.Id">
                                @if (_edit?.Id == s.Id)
                                {
                                    <td>
                                        <input @bind="_editName" maxlength="@CrmStage.NameMaxLength" aria-label="@L("Название")" />
                                        <select @bind="_editColor" aria-label="@L("Цвет")">
                                            @foreach (var c in CrmStage.Colors)
                                            {
                                                <option value="@c">@StageChip.ColorName(c)</option>
                                            }
                                        </select>
                                    </td>
                                    <td class="num"><input type="number" min="0" max="100" @bind="_editProbability" disabled="@s.IsFinal" aria-label="@L("Вероятность")" /></td>
                                    <td>@KindName(s.Kind)</td>
                                    <td>
                                        @if (!s.IsFinal)
                                        {
                                            <input @bind="_editStepSubject" maxlength="@CrmActivity.SubjectMaxLength" placeholder="@L("Позвонить: обсудить КП")" aria-label="@L("Задача следующего шага")" />
                                            <input type="number" min="0" max="365" @bind="_editStepDays" aria-label="@L("Через дней")" style="max-width: 70px" />
                                        }
                                    </td>
                                    <td class="num">@s.Deals</td>
                                    <td>
                                        <button type="button" @onclick="SaveStageAsync" disabled="@_busy">@L("Сохранить")</button>
                                        <button type="button" class="secondary" @onclick="() => _edit = null">@L("Отмена")</button>
                                    </td>
                                }
                                else
                                {
                                    <td><span class="stage stage-@s.Color">@s.Name</span> @if (s.IsArchived) { <span class="tag">@L("архив")</span> }</td>
                                    <td class="num">@s.Probability %</td>
                                    <td>@KindName(s.Kind)</td>
                                    <td>@(s.NextStepDays is { } nd ? L("«{0}» через {1} дн.", s.NextStepSubject ?? "", nd) : "—")</td>
                                    <td class="num">@s.Deals</td>
                                    @if (_data.CanEdit)
                                    {
                                        <td>
                                            @if (!s.IsArchived)
                                            {
                                                @if (!s.IsFinal)
                                                {
                                                    <button type="button" class="secondary icon" @onclick="() => RunAsync(() => Settings.MoveStageAsync(s.Id, -1), null)" disabled="@_busy" aria-label="@L("Левее: {0}", s.Name)">↑</button>
                                                    <button type="button" class="secondary icon" @onclick="() => RunAsync(() => Settings.MoveStageAsync(s.Id, 1), null)" disabled="@_busy" aria-label="@L("Правее: {0}", s.Name)">↓</button>
                                                }
                                                <button type="button" class="secondary" @onclick="() => StartEdit(s)" disabled="@_busy">@L("Изменить")</button>
                                                @if (!s.IsFinal)
                                                {
                                                    <ConfirmButton Class="secondary" OnConfirm="() => RunAsync(() => Settings.ArchiveStageAsync(s.Id, s.RowVersion), null)" Disabled="@_busy" Question='@L("Отправить в архив?")'>@L("В архив")</ConfirmButton>
                                                }
                                            }
                                            else
                                            {
                                                <button type="button" class="secondary" @onclick="() => RunAsync(() => Settings.RestoreStageAsync(s.Id, s.RowVersion), null)" disabled="@_busy">@L("Вернуть")</button>
                                            }
                                        </td>
                                    }
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (_data.CanEdit && !p.IsArchived)
            {
                <form class="inline-form" @onsubmit="() => CreateStageAsync(p.Id)">
                    <label>@L("Новый этап") <input @bind="_stageName" maxlength="@CrmStage.NameMaxLength" placeholder="@L("Пробная партия")" /></label>
                    <label>
                        @L("Цвет")
                        <select @bind="_stageColor">
                            @foreach (var c in CrmStage.Colors)
                            {
                                <option value="@c">@StageChip.ColorName(c)</option>
                            }
                        </select>
                    </label>
                    <label>@L("Вероятность, %") <input type="number" min="0" max="100" @bind="_stageProbability" /></label>
                    <button type="submit" class="secondary" disabled="@_busy">@L("Добавить этап")</button>
                </form>
            }
        </section>
    }

    <div class="dash-cols">
        @RefList(L("Источники обращений"), CrmReferenceKind.Source, _data.Sources)
        @RefList(L("Причины отказа и проигрыша"), CrmReferenceKind.LossReason, _data.LossReasons)
    </div>
}

@code {
    private CrmSettingsDto? _data;
    private bool _busy;
    private string? _denied;
    private string? _message;
    private bool _isError;
    private string? _pipelineName;
    private string? _stageName;
    private string _stageColor = "blue";
    private int _stageProbability = 50;
    private CrmStageDto? _edit;
    private string? _editName;
    private string _editColor = "gray";
    private int _editProbability;
    private string? _editStepSubject;
    private int? _editStepDays;
    private AutoForm? _auto;
    [CascadingParameter]
    public CurrentAccessDto CurrentAccess { get; set; } = default!;

    private IReadOnlyList<KnitErp.Application.Structure.LookupDto> _users = [];
    private readonly Dictionary<CrmReferenceKind, string?> _newRef = [];

    private RenderFragment RefList(string title, CrmReferenceKind kind, IReadOnlyList<CrmReferenceDto> items) => __builder =>
    {
        <section aria-label="@title">
            <h2>@title</h2>
            <ul>
                @foreach (var r in items)
                {
                    <li class="@(r.IsArchived ? "archived" : null)" @key="r.Id">
                        @r.Name @if (r.IsArchived) { <span class="tag">@L("архив")</span> }
                        @if (_data!.CanEdit)
                        {
                            <button type="button" class="secondary" @onclick="() => RunAsync(() => Settings.SetReferenceArchivedAsync(r.Id, !r.IsArchived, r.RowVersion), null)"
                                    disabled="@_busy">@(r.IsArchived ? L("Вернуть") : L("В архив"))</button>
                        }
                    </li>
                }
            </ul>
            @if (_data!.CanEdit)
            {
                <form class="inline-form" @onsubmit="() => CreateRefAsync(kind)">
                    <label>@L("Добавить") <input value="@_newRef.GetValueOrDefault(kind)" @onchange="e => _newRef[kind] = e.Value?.ToString()" maxlength="@CrmReference.NameMaxLength" aria-label="@title" /></label>
                    <button type="submit" class="secondary" disabled="@_busy">@L("Добавить")</button>
                </form>
            }
        </section>
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _data = await Settings.GetAsync();
            _users = (await Deals.OptionsAsync()).Users;
            FillAuto();
        }
        catch (AccessDeniedException ex)
        {
            _denied = UiErrors.Message(ex);
        }
    }

    private void FillAuto()
    {
        var a = _data!.Automation ?? new CrmAutomationValues();
        _auto = new AutoForm
        {
            AssignMode = ((byte)a.AssignMode).ToString(), DefaultUser = a.DefaultResponsibleUserId?.ToString() ?? "", NextStep = a.NextStepSuggestions,
            StageByEvents = a.StageByEvents, RepeatDays = a.RepeatSaleDays, StaleDays = a.StaleLeadDays, PlanFact = ((byte)a.PlanFact).ToString(),
            OfferDays = a.OfferValidDays, OfferTerms = a.OfferTerms,
        };
    }

    private Task SaveAutomationAsync() => RunAsync(() => Settings.SaveAutomationAsync(new CrmAutomationValues(
        (CrmAssignMode)byte.Parse(_auto!.AssignMode), long.TryParse(_auto.DefaultUser, out var u) ? u : null, _auto.NextStep, _auto.StageByEvents, _auto.RepeatDays,
        _auto.StaleDays, (CrmPlanFact)byte.Parse(_auto.PlanFact), _auto.OfferTerms, _auto.OfferDays), _data!.AutomationVersion), L("Автоматизация сохранена."));

    private sealed class AutoForm
    {
        public string AssignMode { get; set; } = "1";
        public string DefaultUser { get; set; } = "";
        public bool NextStep { get; set; }
        public bool StageByEvents { get; set; }
        public int? RepeatDays { get; set; }
        public int StaleDays { get; set; }
        public string PlanFact { get; set; } = "1";
        public int OfferDays { get; set; }
        public string? OfferTerms { get; set; }
    }

    private static string KindName(CrmStageKind kind) => kind switch
    {
        CrmStageKind.Won => L("Выигрыш"),
        CrmStageKind.Lost => L("Проигрыш"),
        _ => L("Рабочий"),
    };

    private void StartEdit(CrmStageDto s)
    {
        _edit = s;
        _editName = s.Name;
        _editColor = s.Color;
        _editProbability = s.Probability;
        _editStepSubject = s.NextStepSubject;
        _editStepDays = s.NextStepDays;
    }

    private Task CreatePipelineAsync() => RunAsync(async () =>
    {
        await Settings.CreatePipelineAsync(_pipelineName);
        _pipelineName = null;
    }, L("Воронка добавлена — с готовыми этапами, их можно переименовать."));

    private Task CreateStageAsync(long pipelineId) => RunAsync(async () =>
    {
        await Settings.CreateStageAsync(pipelineId, _stageName, _stageColor, _stageProbability);
        _stageName = null;
    }, L("Этап добавлен."));

    private Task SaveStageAsync() => RunAsync(async () =>
    {
        await Settings.UpdateStageAsync(_edit!.Id, _editName, _editColor, _editProbability, _edit.RowVersion);
        if (!_edit.IsFinal && (_editStepDays != _edit.NextStepDays || _editStepSubject != _edit.NextStepSubject))
        {
            var fresh = (await Settings.GetAsync()).Pipelines.SelectMany(p => p.Stages).Single(x => x.Id == _edit.Id);
            await Settings.SetNextStepAsync(_edit.Id, string.IsNullOrWhiteSpace(_editStepSubject) ? null : _editStepDays, _editStepSubject, fresh.RowVersion);
        }

        _edit = null;
    }, L("Этап сохранён."));

    private Task CreateRefAsync(CrmReferenceKind kind) => RunAsync(async () =>
    {
        await Settings.CreateReferenceAsync(kind, _newRef.GetValueOrDefault(kind));
        _newRef[kind] = null;
    }, null);

    private async Task RunAsync(Func<Task> action, string? success)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _message = null;
        _isError = false;
        try
        {
            await action();
            _message = success;
        }
        catch (Exception ex) when (UiErrors.IsUserFacing(ex))
        {
            _message = UiErrors.Message(ex);
            _isError = true;
        }
        finally
        {
            try
            {
                _data = await Settings.GetAsync();
                FillAuto();
            }
            finally
            {
                _busy = false;
            }
        }
    }
}
