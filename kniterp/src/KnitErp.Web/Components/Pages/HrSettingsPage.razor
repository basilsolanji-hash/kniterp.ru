@page "/hr/settings"
@using KnitErp.Application.Hr
@using KnitErp.Domain.Hr
@inject HrSettingsService Settings

<PageTitle>@L("Кадры и заработок: настройки") — knitERP</PageTitle>

@* D216: параметры заработка (не ниже минимума ТК РФ), коды 1С: ЗУП, кадровые правила, сверка расчёта с данными фабрики. *@
@if (_denied is not null)
{
    <AccessDenied Message="@_denied" />
}
else if (_data is null)
{
    <p class="muted">@L("Загрузка…")</p>
}
else
{
    <div class="page-head"><h1>@L("Кадры и заработок: настройки")</h1></div>

    @if (_message is not null)
    {
        <div class="@(_isError ? "flash error" : "flash")" role="@(_isError ? "alert" : "status")">@_message</div>
    }

    <div class="panel">
        <h2>@L("Доплаты и оплата по окладу")</h2>
        <p class="muted">@L("Значения не ниже минимума Трудового кодекса: ночные — 20 % (ст. 154), сверхурочные — 1,5 и 2 (ст. 152), выходные и праздники — 2 (ст. 153). Больше — если так записано в коллективном договоре или положении об оплате труда.")</p>
        <fieldset disabled="@(!_data.CanEditPayroll || _busy)" style="border: 0; padding: 0; margin: 0; min-width: 0">
            <div class="grid">
                <label>@L("Ночные часы, % часовой ставки") <input type="number" step="0.01" min="20" max="200" @bind="_p.NightPercent" /></label>
                <label>@L("Сверхурочные: первые 2 часа, ×") <input type="number" step="0.01" min="1.5" max="5" @bind="_p.OvertimeFirst" /></label>
                <label>@L("Сверхурочные: следующие часы, ×") <input type="number" step="0.01" min="2" max="5" @bind="_p.OvertimeNext" /></label>
                <label>@L("Выходные и праздники, ×") <input type="number" step="0.01" min="2" max="5" @bind="_p.HolidayMultiplier" /></label>
                <label>
                    @L("Оплата по окладу")
                    <select @bind="_p.SalaryBase">
                        <option value="@SalaryBase.Hours">@L("по часам: оклад × часы / норма часов")</option>
                        <option value="@SalaryBase.Days">@L("по дням: оклад × дни / норма дней")</option>
                    </select>
                </label>
                <label>@L("Часовая тарифная ставка сдельщиков, руб. (для доплат; пусто — сдельный заработок / часы)") <input type="number" step="0.01" min="0.01" @bind="_p.PieceHourlyRate" /></label>
            </div>
        </fieldset>

        <h2>@L("Выгрузка в 1С: Зарплата и управление персоналом")</h2>
        <p class="muted">@L("Коды видов начислений, как они называются в вашей 1С: ЗУП. Пусто — стандартный код. Уточните у бухгалтера перед первой загрузкой.")</p>
        <fieldset disabled="@(!_data.CanEditPayroll || _busy)" style="border: 0; padding: 0; margin: 0; min-width: 0">
            <div class="grid">
                <label>@L("Версия 1С: ЗУП") <input @bind="_p.ZupVersion" maxlength="100" placeholder="3.1" /></label>
                <label>@L("Сдельная оплата") <input @bind="_p.ZupPieceCode" maxlength="100" placeholder="СдельнаяОплата" /></label>
                <label>@L("Оплата по окладу") <input @bind="_p.ZupSalaryCode" maxlength="100" placeholder="ОплатаПоОкладу" /></label>
                <label>@L("Ночные") <input @bind="_p.ZupNightCode" maxlength="100" placeholder="ДоплатаЗаРаботуВНочноеВремя" /></label>
                <label>@L("Сверхурочные") <input @bind="_p.ZupOvertimeCode" maxlength="100" placeholder="ОплатаСверхурочныхЧасов" /></label>
                <label>@L("Выходные и праздники") <input @bind="_p.ZupHolidayCode" maxlength="100" placeholder="ОплатаПраздничныхИВыходныхДней" /></label>
            </div>
        </fieldset>
        @if (_data.CanEditPayroll)
        {
            <div class="actions"><button type="button" @onclick="SavePayrollAsync" disabled="@_busy">@L("Сохранить параметры заработка")</button></div>
        }
        else
        {
            <p class="muted">@L("Изменить может тот, кто рассчитывает заработок.")</p>
        }
    </div>

    <div class="panel">
        <h2>@L("Кадровые правила")</h2>
        <fieldset disabled="@(!_data.CanEditRules || _busy)" style="border: 0; padding: 0; margin: 0; min-width: 0">
            <label class="inline"><input type="checkbox" @bind="_r.HrOfficerClosesTimesheet" /> @L("Кадровик может закрывать табель (иначе закрывает руководитель подразделения)")</label>
            <label class="inline"><input type="checkbox" @bind="_r.LeaveOnlyByOrder" /> @L("Отпуск только по приказу Т-6 (без кнопки «В отпуск» на карточке)")</label>
            <label class="inline"><input type="checkbox" @bind="_r.BlockPersonalDataWithoutConsent" /> @L("Не вводить персональные данные без действующего согласия сотрудника")</label>
            <label class="inline"><input type="checkbox" @bind="_r.RequireAgreements" /> @L("Перед доступом сотрудник подписывает согласие на обработку ПДн, правила работы и обязательство о конфиденциальности")</label>
        </fieldset>
        @if (_data.CanEditRules)
        {
            <div class="actions"><button type="button" @onclick="SaveRulesAsync" disabled="@_busy">@L("Сохранить кадровые правила")</button></div>
        }
        else
        {
            <p class="muted">@L("Изменить может тот, кто меняет реквизиты организации.")</p>
        }
    </div>

    <div class="panel">
        <h2>@L("Приёмка на данных фабрики")</h2>
        <ol>
            <li>@L("Примите сотрудников приказами, заведите штат, графики и сдельные расценки.")</li>
            <li>@L("Составьте и закройте табели месяца; отметки выработки ведёт производство (терминал цеха).")</li>
            <li>@L("Рассчитайте заработок и выгрузите расчёт в Excel — сверьте суммы с расчётом бухгалтера.")</li>
            <li>@L("При расхождении проверьте расценки, табель и настройки доплат выше; затем утвердите и выгрузите в 1С: ЗУП.")</li>
        </ol>
        @if (_data.CalculatedMonths.Count > 0)
        {
            <div class="inline-form">
                <label>@L("Месяц")
                    <select @bind="_month">
                        @foreach (var m in _data.CalculatedMonths)
                        {
                            <option value="@m.ToString("yyyy-MM-dd")">@m.ToString("MM.yyyy")</option>
                        }
                    </select>
                </label>
                <a class="button secondary" href="hr/payroll.xlsx?year=@_month.Year&month=@_month.Month" download data-enhance-nav="false">@L("Расчёт в Excel для сверки")</a>
            </div>
        }
        else
        {
            <p class="muted">@L("Расчётов заработка пока нет — Excel для сверки появится после первого расчёта.")</p>
        }
    </div>
}

@code {
    [CascadingParameter]
    public CurrentAccessDto CurrentAccess { get; set; } = default!;

    private HrSettingsDto? _data;
    private PayrollForm _p = new();
    private RulesForm _r = new();
    private DateOnly _month;
    private bool _busy;
    private string? _denied;
    private string? _message;
    private bool _isError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await ReloadAsync();
        }
        catch (AccessDeniedException ex)
        {
            _denied = UiErrors.Message(ex);
        }
    }

    private async Task ReloadAsync()
    {
        _data = await Settings.GetAsync();
        if (!_data.CalculatedMonths.Contains(_month))
        {
            _month = _data.CalculatedMonths.FirstOrDefault();
        }

        _p = PayrollForm.From(_data.Payroll);
        _r = new RulesForm { HrOfficerClosesTimesheet = _data.Rules.HrOfficerClosesTimesheet, LeaveOnlyByOrder = _data.Rules.LeaveOnlyByOrder,
            BlockPersonalDataWithoutConsent = _data.Rules.BlockPersonalDataWithoutConsent, RequireAgreements = _data.Rules.RequireAgreements };
    }

    private Task SavePayrollAsync() => RunAsync(async () =>
    {
        await Settings.SavePayrollAsync(_p.ToValues(), _data!.RowVersion);
        _message = L("Параметры заработка сохранены: они действуют со следующего расчёта.");
    });

    private Task SaveRulesAsync() => RunAsync(async () =>
    {
        await Settings.SaveRulesAsync(new HrRulesValues(_r.HrOfficerClosesTimesheet, _r.LeaveOnlyByOrder, _r.BlockPersonalDataWithoutConsent, _r.RequireAgreements), _data!.RowVersion);
        _message = L("Кадровые правила сохранены.");
    });

    private async Task RunAsync(Func<Task> action)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _message = null;
        try
        {
            await action();
            _isError = false;
            await ReloadAsync();
        }
        catch (Exception ex) when (UiErrors.IsUserFacing(ex))
        {
            _message = UiErrors.Message(ex);
            _isError = true;
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class RulesForm
    {
        public bool HrOfficerClosesTimesheet { get; set; }
        public bool LeaveOnlyByOrder { get; set; }
        public bool BlockPersonalDataWithoutConsent { get; set; }
        public bool RequireAgreements { get; set; } = true;
    }

    private sealed class PayrollForm
    {
        public decimal NightPercent { get; set; }
        public decimal OvertimeFirst { get; set; }
        public decimal OvertimeNext { get; set; }
        public decimal HolidayMultiplier { get; set; }
        public SalaryBase SalaryBase { get; set; }
        public decimal? PieceHourlyRate { get; set; }
        public string? ZupVersion { get; set; }
        public string? ZupPieceCode { get; set; }
        public string? ZupSalaryCode { get; set; }
        public string? ZupNightCode { get; set; }
        public string? ZupOvertimeCode { get; set; }
        public string? ZupHolidayCode { get; set; }

        public static PayrollForm From(PayrollSettingsValues v) => new()
        {
            NightPercent = v.NightPercent, OvertimeFirst = v.OvertimeFirst, OvertimeNext = v.OvertimeNext, HolidayMultiplier = v.HolidayMultiplier,
            SalaryBase = v.SalaryBase, PieceHourlyRate = v.PieceHourlyRate, ZupVersion = v.ZupVersion, ZupPieceCode = v.ZupPieceCode,
            ZupSalaryCode = v.ZupSalaryCode, ZupNightCode = v.ZupNightCode, ZupOvertimeCode = v.ZupOvertimeCode, ZupHolidayCode = v.ZupHolidayCode,
        };

        public PayrollSettingsValues ToValues() => new(NightPercent, OvertimeFirst, OvertimeNext, HolidayMultiplier, SalaryBase, PieceHourlyRate,
            ZupVersion, ZupPieceCode, ZupSalaryCode, ZupNightCode, ZupOvertimeCode, ZupHolidayCode);
    }
}
