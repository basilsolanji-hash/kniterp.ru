@page "/settings/purchases"
@using KnitErp.Application.Purchasing
@inject PurchaseSettingsService Settings

@* D133 (D132 п. 3): настройки закупок организации — допуск поступления сверх заказа поставщику. *@
<PageTitle>@L("Настройки закупок") — knitERP</PageTitle>

@if (_denied is not null)
{
    <AccessDenied Message="@_denied" />
}
else if (_s is null)
{
    <p class="muted">@L("Загрузка…")</p>
}
else
{
    <div class="page-head"><h1>@L("Настройки закупок")</h1><a class="button secondary" href="settings/automation">@L("Настройки автоматизации")</a></div>
    <ReadOnlyNote When="@(!_s.CanEdit)" />
    @if (_message is not null)
    {
        <div class="@(_messageIsError ? "flash error" : "flash")" role="@(_messageIsError ? "alert" : "status")">@_message</div>
    }

    <form class="panel" @onsubmit="SaveAsync">
        <h2>@L("Поступление по заказу")</h2>
        <label>@L("Допуск поступления сверх заказа, %")
            <input @bind="_percent" @bind:after="SaveAsync" inputmode="decimal" disabled="@(!_s.CanEdit)" title="@((!_s.CanEdit) ? L("Нет права на изменение") : null)" aria-label="@L("Допуск поступления сверх заказа, %")" /></label>
        <p class="muted">@L("По позиции заказа можно принять не больше «заказано × (1 + допуск/100)». От 0 до 10%; 0 — сверх заказа нельзя, лишнее оформляется поступлением без заказа. Менять может пользователь с правом «Организация: изменение».")</p>
        @if (_s.UpdatedAtUtc is { } at)
        {
            <p class="muted">@L("Изменено: {0}, {1}", _s.UpdatedBy ?? "—", TimeZones.ToLocal(at, CurrentAccess.TimeZoneId).ToString("dd.MM.yyyy HH:mm"))</p>
        }
        @if (_s.CanEdit)
        {
            @* D811 (запрос владельца 13.10, п. 3): без кнопки «Сохранить» — каждое изменение сохраняется сразу. *@
            <p class="muted small" aria-live="polite">@(_busy ? L("Сохраняется…") : L("Изменения сохраняются сразу."))</p>
        }
    </form>
}

@code {
    [CascadingParameter]
    public CurrentAccessDto CurrentAccess { get; set; } = default!;

    private PurchaseSettingsDto? _s;
    private string? _denied;
    private bool _busy;
    private string? _message;
    private bool _messageIsError;
    private string _percent = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Fill(await Settings.GetAsync());
        }
        catch (AccessDeniedException ex)
        {
            _denied = UiErrors.Message(ex);
        }
    }

    private void Fill(PurchaseSettingsDto s)
    {
        _s = s;
        _percent = Quantities.Format(s.OverReceiptPercent);
    }

    private bool _again;

    private async Task SaveAsync()
    {
        if (_s is null || !_s.CanEdit)
        {
            return;
        }

        if (_busy)
        {
            _again = true; // изменение во время сохранения — сохраним следом, не потеряем
            return;
        }

        _busy = true;
        _message = null;
        _messageIsError = false;
        try
        {
            if (!Quantities.TryParse(_percent, out var percent))
            {
                throw new BusinessRuleException("purchase.settings.over_receipt", L("Допуск поступления сверх заказа — от 0 до 10%, не больше двух знаков после запятой."));
            }

            await Settings.SaveAsync(percent, _s.RowVersion);
            var fresh = await Settings.GetAsync();
            if (_again)
            {
                _s = fresh; // поля не перезаписываем: пользователь уже изменил их снова
            }
            else
            {
                Fill(fresh);
            }

            _message = L("Сохранено.");
        }
        catch (Exception ex) when (UiErrors.IsUserFacing(ex))
        {
            _message = UiErrors.Message(ex);
            _messageIsError = true;
        }
        finally
        {
            _busy = false;
        }

        if (_again)
        {
            _again = false;
            await SaveAsync();
        }
    }
}
