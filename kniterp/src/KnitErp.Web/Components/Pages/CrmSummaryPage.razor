@page "/crm/summary"
@using KnitErp.Application.Crm
@using KnitErp.Domain.Crm
@inject CrmReportService Reports
@inject CrmSettingsService Settings
@inject CrmDealService Deals

<PageTitle>@L("Сводка и отчёты CRM") — knitERP</PageTitle>
<CrmStyles />

@if (_denied is not null)
{
    <AccessDenied Message="@_denied" />
}
else if (_report is null || _options is null)
{
    <p class="muted">@L("Загрузка…")</p>
}
else
{
    <h1>@L("Сводка и отчёты CRM")</h1>
    @if (_error is not null)
    {
        <div class="flash error" role="alert">@_error</div>
    }
    @if (_dash is not null)
    {
        <div class="crm-kpi" aria-label="@L("Показатели")">
            <div><b>@_dash.OpenDeals</b><span>@L("сделок в работе")</span></div>
            @if (_dash.OpenAmount is { } open)
            {
                <div><b>@Amounts.Compact(open)</b><span>@L("сумма в работе")</span></div>
                <div><b>@Amounts.Compact(_dash.WeightedAmount ?? 0)</b><span>@L("с учётом вероятности")</span></div>
                <div>
                    <b>@Amounts.Compact(_dash.WonThisMonth ?? 0)@(_dash.PlanThisMonth is > 0 ? $" / {Amounts.Compact(_dash.PlanThisMonth.Value)}" : "")</b>
                    <span>@L("факт / план месяца")</span>
                    @if (_dash.PlanThisMonth is > 0 and var plan)
                    {
                        <div class="crm-bar"><i style="width: @(Math.Min(100, (int)(100 * (_dash.WonThisMonth ?? 0) / plan)))%"></i></div>
                    }
                </div>
            }
            <div><b class="@(_dash.OverdueActivities > 0 ? "warn-text" : null)">@_dash.OverdueActivities</b><span><a href="crm/tasks">@L("просроченных задач")</a></span></div>
            <div><b>@_dash.DealsWithoutNextStep</b><span><a href="crm/tasks">@L("без следующего шага")</a></span></div>
        </div>
    }

    <form class="inline-form" @onsubmit="LoadReportAsync">
        <label>@L("С") <input type="date" @bind="_from" /></label>
        <label>@L("По") <input type="date" @bind="_to" /></label>
        <label>
            @L("Воронка")
            <select @bind="_pipeline">
                @foreach (var p in _options.Pipelines)
                {
                    <option value="@p.Id">@p.Name</option>
                }
            </select>
        </label>
        @if (_options.CanAll)
        {
            <label>
                @L("Менеджер")
                <select @bind="_responsible">
                    <option value="">@L("Все")</option>
                    @foreach (var u in _options.Users)
                    {
                        <option value="@u.Id">@u.Name</option>
                    }
                </select>
            </label>
        }
        <button type="submit" class="secondary" disabled="@_busy">@L("Показать")</button>
        <a class="button secondary" href="@ExcelHref" download data-enhance-nav="false">@L("Excel")</a>
    </form>

    var r = _report;
    <div class="crm-kpi">
        <div><b>@r.Leads</b><span>@L("лидов")</span></div>
        <div><b>@(r.LeadToDeal?.ToString("0.#") ?? "—") %</b><span>@L("лид → сделка")</span></div>
        <div><b>@r.DealsCreated</b><span>@L("новых сделок")</span></div>
        <div><b>@(r.DealToWon?.ToString("0.#") ?? "—") %</b><span>@L("сделка → выигрыш")</span></div>
        <div><b>@r.Won / @r.Lost</b><span>@L("выиграно / проиграно")</span></div>
        <div><b>@r.AvgCycleDays.ToString("0.#")</b><span>@L("дней — средний цикл сделки")</span></div>
    </div>

    <h2>@L("Воронка «{0}»", r.Pipeline)</h2>
    <div class="scroll">
        <table class="compact">
            <thead><tr><th>@L("Этап")</th><th class="num">@L("Дошло")</th><th></th>@if (r.CanSeeAmounts) { <th class="num">@L("Сумма")</th> }<th class="num">@L("Конверсия дальше")</th><th class="num">@L("Дней на этапе")</th></tr></thead>
            <tbody>
                @{ var max = Math.Max(1, r.Funnel.Select(f => f.Reached).DefaultIfEmpty(0).Max()); }
                @foreach (var f in r.Funnel)
                {
                    <tr>
                        <td><span class="stage stage-@f.Color">@f.Stage</span></td>
                        <td class="num">@f.Reached</td>
                        <td><div class="crm-bar"><i style="width: @(100 * f.Reached / max)%"></i></div></td>
                        @if (r.CanSeeAmounts)
                        {
                            <td class="num">@Amounts.Format(f.Amount)</td>
                        }
                        <td class="num">@(f.ConversionToNext is { } c ? $"{c:0.#} %" : "—")</td>
                        <td class="num">@f.AvgDays.ToString("0.#")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="dash-cols">
        <section>
            <h2>@L("Причины проигрыша")</h2>
            @if (r.LossReasons.Count == 0) { <p class="muted small">@L("Проигрышей за период нет.")</p> }
            else
            {
                <table class="compact"><tbody>
                    @foreach (var x in r.LossReasons) { <tr><td>@x.Reason</td><td class="num">@x.Deals</td>@if (r.CanSeeAmounts) { <td class="num">@Amounts.Format(x.Amount)</td> }</tr> }
                </tbody></table>
            }
        </section>
        <section>
            <h2>@L("Источники")</h2>
            @if (r.Sources.Count == 0) { <p class="muted small">@L("Нет данных за период.")</p> }
            else
            {
                <table class="compact">
                    <thead><tr><th>@L("Источник")</th><th class="num">@L("Лидов")</th><th class="num">@L("Сделок")</th><th class="num">@L("Выиграно")</th>@if (r.CanSeeAmounts) { <th class="num">@L("Выручка")</th> }</tr></thead>
                    <tbody>
                        @foreach (var x in r.Sources) { <tr><td>@x.Source</td><td class="num">@x.Leads</td><td class="num">@x.Deals</td><td class="num">@x.Won</td>@if (r.CanSeeAmounts) { <td class="num">@Amounts.Format(x.Revenue)</td> }</tr> }
                    </tbody>
                </table>
            }
        </section>
    </div>

    <h2>@L("Менеджеры")</h2>
    <div class="scroll">
        <table class="compact">
            <thead><tr><th>@L("Менеджер")</th><th class="num">@L("Активностей")</th><th class="num">@L("Сделок")</th><th class="num">@L("Выиграно")</th>@if (r.CanSeeAmounts) { <th class="num">@L("Сумма выигрышей")</th><th class="num">@L("План")</th><th class="num">@L("Факт")</th> }</tr></thead>
            <tbody>
                @foreach (var m in r.Managers)
                {
                    <tr><td>@m.Manager</td><td class="num">@m.Activities</td><td class="num">@m.Deals</td><td class="num">@m.Won</td>
                        @if (r.CanSeeAmounts) { <td class="num">@Amounts.Format(m.WonAmount)</td><td class="num">@Amounts.Format(m.Plan)</td><td class="num">@Amounts.Format(m.Fact)</td> }</tr>
                }
            </tbody>
        </table>
    </div>
    <p class="muted small">@(r.FactSource == CrmPlanFact.Payments ? L("Факт — оплаты по заказам покупателей из сделок.") : L("Факт — суммы выигранных сделок."))</p>

    @if (_canPlan)
    {
        <h2>@L("План продаж")</h2>
        <form class="inline-form" @onsubmit="SavePlanAsync" aria-label="@L("План продаж")">
            <label>@L("Месяц") <input type="month" @bind="_planMonth" @bind:format="yyyy-MM" /></label>
            <label>
                @L("Менеджер")
                <select @bind="_planUser">
                    <option value="">@L("Вся организация")</option>
                    @foreach (var u in _options.Users)
                    {
                        <option value="@u.Id">@u.Name</option>
                    }
                </select>
            </label>
            <label>@L("Сумма") <input inputmode="decimal" @bind="_planAmount" required /></label>
            <button type="submit" disabled="@_busy">@L("Сохранить план")</button>
        </form>
        @if (_plans.Count > 0)
        {
            <table class="compact">
                <thead><tr><th>@L("Месяц")</th><th>@L("Менеджер")</th><th class="num">@L("План")</th></tr></thead>
                <tbody>
                    @foreach (var p in _plans) { <tr><td>@($"{p.Month:00}.{p.Year}")</td><td>@(p.User ?? L("Вся организация"))</td><td class="num">@Amounts.Format(p.Amount)</td></tr> }
                </tbody>
            </table>
        }
    }
}

@code {
    [CascadingParameter]
    public CurrentAccessDto CurrentAccess { get; set; } = default!;

    private CrmReportDto? _report;
    private CrmDashboardData? _dash;
    private CrmOptionsDto? _options;
    private IReadOnlyList<CrmPlanRowDto> _plans = [];
    private string? _denied;
    private string? _error;
    private bool _busy;
    private DateTime _from;
    private DateTime _to;
    private string _pipeline = "";
    private string _responsible = "";
    private DateTime _planMonth;
    private string _planUser = "";
    private string? _planAmount;

    private bool _canPlan => CurrentAccess.Has(Permissions.CrmSettings) && CurrentAccess.Has(Permissions.PriceView);

    private string ExcelHref =>
        $"crm/report.xlsx?from={_from:yyyy-MM-dd}&to={_to:yyyy-MM-dd}&pipeline={_pipeline}" + (_responsible.Length > 0 ? $"&responsible={_responsible}" : "");

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var today = TimeZones.ToLocal(DateTime.UtcNow, CurrentAccess.TimeZoneId).Date;
            _from = new DateTime(today.Year, today.Month, 1);
            _to = _from.AddMonths(1).AddDays(-1);
            _planMonth = _from;
            _options = await Deals.OptionsAsync();
            _pipeline = _options.Pipelines.FirstOrDefault()?.Id.ToString() ?? "";
            _dash = await Reports.DashboardAsync();
            await LoadAsync();
        }
        catch (AccessDeniedException ex)
        {
            _denied = UiErrors.Message(ex);
        }
    }

    private async Task LoadAsync()
    {
        _report = await Reports.BuildAsync(new CrmReportFilter(DateOnly.FromDateTime(_from), DateOnly.FromDateTime(_to), long.TryParse(_pipeline, out var p) ? p : null,
            long.TryParse(_responsible, out var r) ? r : null));
        if (_canPlan)
        {
            _plans = await Settings.PlansAsync(_planMonth.Year);
        }
    }

    private Task LoadReportAsync() => RunAsync(LoadAsync);

    private Task SavePlanAsync() => RunAsync(async () =>
    {
        var amount = KnitErp.Domain.Catalog.Decimals.Parse(_planAmount, L("Сумма")) ?? 0;
        await Settings.SetPlanAsync(_planMonth.Year, _planMonth.Month, long.TryParse(_planUser, out var u) ? u : null, null, amount);
        _planAmount = null;
        _dash = await Reports.DashboardAsync();
        await LoadAsync();
    });

    private async Task RunAsync(Func<Task> action)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            await action();
        }
        catch (Exception ex) when (UiErrors.IsUserFacing(ex))
        {
            _error = UiErrors.Message(ex);
        }
        finally
        {
            _busy = false;
        }
    }
}
