@page "/crm/contacts/{Id:long}"
@using KnitErp.Application.Crm
@using KnitErp.Domain.Crm
@using KnitErp.Domain.Tagging
@inject CrmContactService Contacts
@inject CrmDealService Deals

<PageTitle>@(_contact?.Values.FullName ?? L("Контакт")) — knitERP</PageTitle>
<CrmStyles />

@if (_denied is not null)
{
    <AccessDenied Message="@_denied" />
}
else if (_notFound is not null)
{
    <div class="error" role="alert">@_notFound</div>
    <p><a href="crm/contacts">@L("К списку контактов")</a></p>
}
else if (_contact is null)
{
    <p class="muted">@L("Загрузка…")</p>
}
else
{
    var v = _contact.Values;
    var canEdit = _contact.CanEdit && !_contact.IsArchived;
    <p class="muted small"><a href="crm/contacts">@L("Контакты")</a></p>
    <div class="page-head">
        <h1>@v.FullName @if (_contact.IsArchived) { <span class="tag">@L("архив")</span> }</h1>
        @if (_contact.CanEdit)
        {
            <button type="button" class="secondary" @onclick="ToggleArchiveAsync" disabled="@_busy">@(_contact.IsArchived ? L("Вернуть из архива") : L("В архив"))</button>
        }
    </div>
    <ReadOnlyNote When="@(!_contact.CanEdit)" />
    <ReadOnlyNote When="@(_contact.CanEdit && _contact.IsArchived)" Text="@L("Контакт в архиве: верните его из архива, чтобы изменить.")" />
    <TagPicker Entity="TaggedEntity.CrmContact" EntityId="Id" ReadOnly="@(!_contact.CanEdit)" />

    @if (_message is not null)
    {
        <div class="@(_isError ? "flash error" : "flash")" role="@(_isError ? "alert" : "status")">@_message</div>
    }

    <div class="crm-summary">
        <div><span>@L("Компания")</span>@if (v.CounterpartyId is { } cp) { <a href="counterparties/@cp">@_contact.Counterparty</a> } else { <span>—</span> }</div>
        <div><span>@L("Телефон")</span>@if (v.Phone is { } p) { <a href="tel:@p">@CrmText.FormatPhone(p)</a> } else { <span>—</span> }</div>
        <div><span>@L("Почта")</span>@if (v.Email is { } e) { <a href="mailto:@e">@e</a> } else { <span>—</span> }</div>
        <div><span>@L("Ответственный")</span><span>@_contact.Responsible</span></div>
    </div>

    <div class="panel">
        <h2>@L("Данные контакта")</h2>
        <form @onsubmit="SaveAsync">
            <fieldset disabled="@(!canEdit)" title="@((!canEdit) ? L("Нет права на изменение") : null)">
                <div class="grid">
                    <label>@L("ФИО") <input @bind="_f.Name" maxlength="@CrmContact.NameMaxLength" required /></label>
                    <label>@L("Должность") <input @bind="_f.Position" maxlength="@CrmContact.PositionMaxLength" /></label>
                    <label>@L("Телефон") <input type="tel" @bind="_f.Phone" maxlength="@CrmText.PhoneMaxLength" placeholder="+7 900 000-00-01" /></label>
                    <label>@L("Почта") <input type="email" @bind="_f.Email" maxlength="@CrmText.EmailMaxLength" /></label>
                    <label>@L("Мессенджер") <input @bind="_f.Messenger" maxlength="@CrmText.MessengerMaxLength" /></label>
                    <label>@L("День рождения") <input type="date" @bind="_f.Birth" /></label>
                    <label>@L("Компания") <input @bind="_companySearch" @bind:after="SearchCompaniesAsync" placeholder="@L("Название или ИНН")" aria-label="@L("Поиск компании")" /></label>
                    <label>
                        @L("Основная компания")
                        <select @bind="_f.Company">
                            <option value="">—</option>
                            @foreach (var c in _companies)
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        </select>
                    </label>
                    <label class="wide">@L("Комментарий") <textarea rows="2" @bind="_f.Comment" maxlength="@CrmContact.CommentMaxLength"></textarea></label>
                </div>
                @if (canEdit)
                {
                    <div class="actions"><button type="submit" disabled="@_busy">@L("Сохранить")</button></div>
                }
            </fieldset>
        </form>
    </div>

    <h2>@L("Телефоны, почты, мессенджеры")</h2>
    @if (_contact.Channels is { Count: > 0 } channels)
    {
        <ul class="crm-channels">
            @foreach (var c in channels)
            {
                <li>
                    @ChannelName(c.Kind): <b>@(c.Kind == CrmChannelKind.Phone ? CrmText.FormatPhone(c.Value) : c.Value)</b> @if (c.Label is not null) { <span class="muted">(@c.Label)</span> }
                    @if (canEdit)
                    {
                        <button type="button" class="secondary" @onclick="() => RunAsync(() => Contacts.MakePrimaryAsync(Id, c.Id, _contact!.RowVersion), null)" disabled="@_busy">@L("Сделать основным")</button>
                        <button type="button" class="secondary" @onclick="() => RunAsync(() => Contacts.RemoveChannelAsync(Id, c.Id, _contact!.RowVersion), null)" disabled="@_busy" aria-label="@L("Удалить {0}", c.Value)">×</button>
                    }
                </li>
            }
        </ul>
    }
    @if (canEdit)
    {
        <form class="inline-form" @onsubmit="AddChannelAsync" aria-label="@L("Добавить телефон или почту")">
            <label>
                @L("Вид")
                <select @bind="_channelKind">
                    <option value="1">@L("Телефон")</option>
                    <option value="2">@L("Почта")</option>
                    <option value="3">@L("Мессенджер")</option>
                </select>
            </label>
            <label>@L("Значение") <input @bind="_channelValue" required /></label>
            <label>@L("Подпись") <input @bind="_channelLabel" maxlength="@CrmContact.ChannelLabelMaxLength" placeholder="@L("мобильный")" /></label>
            <button type="submit" class="secondary" disabled="@_busy">@L("Добавить")</button>
        </form>
    }

    @if (!_contact.IsErased)
    {
        <div class="panel">
            <h2>@L("Персональные данные (152-ФЗ)")</h2>
            <form @onsubmit="SaveConsentAsync">
                <fieldset disabled="@(!canEdit)" title="@((!canEdit) ? L("Нет права на изменение") : null)">
                    <div class="grid">
                        <label>
                            @L("Основание обработки")
                            <select @bind="_basis">
                                <option value="1">@L("Договор / заявка клиента")</option>
                                <option value="2">@L("Согласие")</option>
                                <option value="3">@L("Иное")</option>
                            </select>
                        </label>
                        <label>@L("Дата основания") <input type="date" @bind="_basisDate" /></label>
                        <label class="wide">@L("Как получено / пояснение") <input @bind="_basisNote" maxlength="@CrmContact.BasisNoteMaxLength" /></label>
                        <label class="inline"><input type="checkbox" @bind="_marketing" /> @L("Согласие на рекламные рассылки (38-ФЗ)")</label>
                        <label>@L("Дата согласия на рассылки") <input type="date" @bind="_marketingDate" /></label>
                    </div>
                    @if (canEdit)
                    {
                        <div class="actions"><button type="submit" disabled="@_busy">@L("Сохранить")</button></div>
                    }
                </fieldset>
            </form>
            @if (_contact.CanErase)
            {
                <details>
                    <summary>@L("Удалить персональные данные по запросу")</summary>
                    <p class="muted small">@L("ФИО, телефоны, почты и мессенджер контакта и связанных лидов будут заменены на «удалено по запросу». Сделки, суммы и история останутся. Отменить нельзя.")</p>
                    <form class="inline-form" @onsubmit="EraseAsync">
                        <label>@L("Основание (запрос субъекта)") <input @bind="_eraseReason" required placeholder="@L("заявление от 11.10.2026")" /></label>
                        <button type="submit" disabled="@_busy">@L("Удалить персональные данные")</button>
                    </form>
                </details>
            }
        </div>
    }
    else
    {
        <div class="flash warn" role="status">@L("Персональные данные удалены по запросу — карточка только для истории сделок.")</div>
    }

    <h2>@L("Сделки")</h2>
    @if (_contact.Deals.Count == 0)
    {
        <p class="muted small">@L("Сделок с этим контактом нет.")</p>
    }
    else
    {
        <div class="scroll">
            <table class="compact">
                <thead><tr><th>@L("Сделка")</th><th>@L("Этап")</th><th class="num">@L("Сумма")</th><th>@L("Ответственный")</th></tr></thead>
                <tbody>
                    @foreach (var d in _contact.Deals)
                    {
                        <tr>
                            <td><a href="crm/deals/@d.Id">@d.Number</a> @d.Title</td>
                            <td><span class="stage stage-@d.StageColor">@d.Stage</span></td>
                            <td class="num">@(d.Amount is { } a ? $"{Amounts.Format(a)} {d.CurrencyCode}" : "—")</td>
                            <td>@d.Responsible</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <CrmActivities Target="CrmTarget.Contact" TargetId="Id" CanEdit="@canEdit" Version="_feedVersion" />

    <Discussion Target="TaggedEntity.CrmContact" TargetId="Id" />
}

@code {
    [Parameter]
    public long Id { get; set; }

    private CrmContactDto? _contact;
    private IReadOnlyList<KnitErp.Application.Structure.LookupDto> _companies = [];
    private ContactForm _f = new();
    private bool _busy;
    private string? _denied;
    private string? _notFound;
    private string? _message;
    private bool _isError;
    private string? _companySearch;
    private int _feedVersion;
    private string _channelKind = "1";
    private string? _channelValue;
    private string? _channelLabel;
    private string _basis = "1";
    private DateTime? _basisDate;
    private string? _basisNote;
    private bool _marketing;
    private DateTime? _marketingDate;
    private string? _eraseReason;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            await LoadAsync();
        }
        catch (AccessDeniedException ex)
        {
            _denied = UiErrors.Message(ex);
        }
        catch (NotFoundException ex)
        {
            _notFound = UiErrors.Message(ex);
        }
    }

    private async Task LoadAsync()
    {
        _feedVersion++;
        _contact = await Contacts.GetAsync(Id);
        var v = _contact.Values;
        if (_contact.Consent is { } consent)
        {
            _basis = ((byte)consent.Basis).ToString();
            _basisDate = consent.BasisDate?.ToDateTime(TimeOnly.MinValue);
            _basisNote = consent.BasisNote;
            _marketing = consent.MarketingConsent;
            _marketingDate = consent.MarketingConsentDate?.ToDateTime(TimeOnly.MinValue);
        }

        _f = new ContactForm
        {
            Name = v.FullName, Position = v.Position, Phone = v.Phone, Email = v.Email, Messenger = v.Messenger, Comment = v.Comment,
            Company = v.CounterpartyId?.ToString() ?? "", Birth = v.BirthDate?.ToDateTime(TimeOnly.MinValue),
        };
        _companies = v.CounterpartyId is { } cp && _contact.Counterparty is { } name ? [new(cp, name)] : [];
    }

    private Task SearchCompaniesAsync() => RunAsync(async () =>
    {
        _companies = await Deals.CounterpartiesAsync(_companySearch);
        _f.Company = _companies.FirstOrDefault()?.Id.ToString() ?? "";
    }, null, reload: false);

    private Task SaveAsync() => RunAsync(() => Contacts.UpdateAsync(Id, new CrmContactValues(_f.Name, _f.Position, long.TryParse(_f.Company, out var c) ? c : null,
        _f.Phone, _f.Email, _f.Messenger, _f.Comment, null, _f.Birth is { } b ? DateOnly.FromDateTime(b) : null), _contact!.RowVersion), L("Контакт сохранён."));

    private Task AddChannelAsync() => RunAsync(async () =>
    {
        await Contacts.AddChannelAsync(Id, (CrmChannelKind)byte.Parse(_channelKind), _channelValue, _channelLabel, _contact!.RowVersion);
        (_channelValue, _channelLabel) = (null, null);
    }, L("Добавлено."));

    private Task SaveConsentAsync() => RunAsync(() => Contacts.SetConsentAsync(Id, new CrmConsentValues((CrmProcessingBasis)byte.Parse(_basis),
        _basisDate is { } d ? DateOnly.FromDateTime(d) : null, _basisNote, _marketing, _marketingDate is { } m ? DateOnly.FromDateTime(m) : null),
        _contact!.RowVersion), L("Основание и согласие сохранены."));

    private Task EraseAsync() => RunAsync(() => Contacts.ErasePersonalDataAsync(Id, _eraseReason), L("Персональные данные удалены."));

    private static string ChannelName(CrmChannelKind kind) => kind switch
    {
        CrmChannelKind.Phone => L("Телефон"),
        CrmChannelKind.Email => L("Почта"),
        _ => L("Мессенджер"),
    };

    private Task ToggleArchiveAsync() => RunAsync(() => Contacts.SetArchivedAsync(Id, !_contact!.IsArchived, _contact.RowVersion), null);

    private async Task RunAsync(Func<Task> action, string? success, bool reload = true)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _message = null;
        _isError = false;
        try
        {
            await action();
            _message = success;
            if (reload)
            {
                await LoadAsync();
            }
        }
        catch (Exception ex) when (UiErrors.IsUserFacing(ex))
        {
            _message = UiErrors.Message(ex);
            _isError = true;
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class ContactForm
    {
        public string? Name { get; set; }
        public string? Position { get; set; }
        public string? Phone { get; set; }
        public string? Email { get; set; }
        public string? Messenger { get; set; }
        public string? Comment { get; set; }
        public string Company { get; set; } = "";
        public DateTime? Birth { get; set; }
    }
}
