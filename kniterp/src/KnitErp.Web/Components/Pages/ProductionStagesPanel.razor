@using KnitErp.Application.Production
@using KnitErp.Domain.Production
@inject ProductionFloorService Floor

@* Ход работ по заказу (D92): этапы, контроль качества и история отметок. *@
@if (_progress is not null)
{
    <h2 style="margin-top: 24px">@L("Ход работ")</h2>
    @if (_message is not null)
    {
        <div class="@(_messageIsError ? "flash error" : "flash")" role="@(_messageIsError ? "alert" : "status")">@_message</div>
    }

    <div class="scroll">
        <table>
            <thead><tr><th>@L("Этап")</th><th class="num">@L("Сделано")</th><th class="num">@L("Можно отметить")</th></tr></thead>
            <tbody>
                @foreach (var s in _progress.Stages)
                {
                    <tr>
                        <td>@L(s.Name)</td>
                        <td class="num">@Quantities.Format(s.Done) @_progress.UnitSymbol</td>
                        <td class="num">@Quantities.Format(s.Available)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="muted">
        @L("Годное: {0}, брак: {1}, на переделку отправлено: {2}, упаковано и не выпущено: {3}.",
            Quantities.Format(_progress.Good), Quantities.Format(_progress.Defect), Quantities.Format(_progress.Rework), Quantities.Format(_progress.ReadyForOutput))
    </p>

    @if (_progress.CanMark)
    {
        <form class="inline-form" @onsubmit="RecordAsync">
            @* Количество подставляется сразу (D413): до подключения Blazor ввод не принимается, иначе набранное заменится подставленным. *@
            <fieldset class="until-interactive" disabled="@(!RendererInfo.IsInteractive)">
            <label>
                @L("Этап")
                <select @bind="_stage" aria-label="@L("Этап")" @bind:after="StageChanged">
                    @foreach (var s in _progress.Stages.Select(x => x.Stage))
                    {
                        <option value="@s">@L(ProductionFlow.StageName(s))</option>
                    }
                </select>
            </label>
            <label>
                @L("Отметка")
                <select @bind="_kind" @bind:after="KindChanged" aria-label="@L("Отметка")">
                    @foreach (var k in KindsFor(_stage))
                    {
                        <option value="@k">@L(ProductionFlow.KindName(k))</option>
                    }
                </select>
            </label>
            <label>@L("Количество") <input @bind="_quantityText" @bind:event="oninput" inputmode="decimal" size="8" aria-label="@L("Количество")" /></label>
            @if (_kind == ProductionOperationKind.Rework)
            {
                <label>
                    @L("Вернуть на этап")
                    <select @bind="_returnTo" aria-label="@L("Вернуть на этап")">
                        @foreach (var r in _progress.Stages.Select(x => x.Stage).Where(x => x < ProductionStage.QualityControl))
                        {
                            <option value="@r">@L(ProductionFlow.StageName(r))</option>
                        }
                    </select>
                </label>
            }
            @if (_kind == ProductionOperationKind.Defect && _progress.Employees is { Count: > 0 } people)
            {
                <label>
                    @L("Виновник брака")
                    <select @bind="_culprit" aria-label="@L("Виновник брака")">
                        <option value="">@L("— не указан —")</option>
                        @foreach (var group in people.GroupBy(x => x.WorkedOnOrder).OrderByDescending(g => g.Key))
                        {
                            <optgroup label="@(group.Key ? L("Работали по заказу") : L("Остальные сотрудники"))">
                                @foreach (var e in group)
                                {
                                    <option value="@e.Id">@e.Name (@e.PersonnelNumber)</option>
                                }
                            </optgroup>
                        }
                    </select>
                </label>
            }
            <label>@(_kind is ProductionOperationKind.Correction or ProductionOperationKind.Defect ? L("Причина") : L("Комментарий"))
                <input @bind="_reason" maxlength="@ProductionOperation.ReasonMaxLength" size="24" aria-label="@L("Причина или комментарий")"
                       list="@(ReasonHints is { Count: > 0 } ? $"stage-reasons-{OrderId}" : null)" /></label>
            @if (ReasonHints is { Count: > 0 } hints)
            {
                <datalist id="stage-reasons-@OrderId">
                    @foreach (var h in hints)
                    {
                        <option value="@h"></option>
                    }
                </datalist>
            }
            <label>@L("Дата") <input type="date" @bind="_date" aria-label="@L("Дата")" /></label>
            <button type="submit" disabled="@_busy">@L("Отметить")</button>
            </fieldset>
        </form>
        <p class="muted">@L("Исправление уменьшает сделанное на этапе — укажите, на сколько. Переделка возвращает изделия на выбранный этап, брак списывается с причиной.")</p>
    }

    @if (_progress.History.Count > 0)
    {
        <details>
            <summary>@L("История отметок ({0})", _progress.History.Count)</summary>
            <div class="scroll">
                <table>
                    <thead><tr><th>@L("Дата")</th><th>@L("Этап")</th><th>@L("Отметка")</th><th class="num">@L("Количество")</th><th>@L("Причина или комментарий")</th><th class="opt">@L("Кто")</th></tr></thead>
                    <tbody>
                        @foreach (var h in _progress.History)
                        {
                            <tr>
                                <td>@h.OccurredOn.ToString("dd.MM.yyyy")</td>
                                <td>@L(h.StageName)</td>
                                <td>@L(h.KindName)@(h.ReturnToName is null ? "" : $" → {L(h.ReturnToName)}")@(h.Culprit is null ? "" : $" ({L("виновник")} {h.Culprit})")</td>
                                <td class="num">@Quantities.Format(h.Quantity)@if (h.Repeat != 0)
                                    {
                                        <br /><span class="muted" title="@L("Повторная работа после переделки — не входит в выработку для оплаты")">@L("повторно {0}", Quantities.Format(h.Repeat))</span>
                                    }</td>
                                <td>@h.Reason</td>
                                <td>
                                    @h.CreatedBy@(h.Employee is null ? "" : $" ({L("исполнитель")} {h.Employee})")
                                    @if (h.CanCorrect && _correcting != h.Id)
                                    {
                                        <button type="button" class="secondary" disabled="@_busy" @onclick="() => StartCorrect(h.Id)"
                                                aria-label="@L("Исправить отметку {0}", h.Id)">@L("Исправить")</button>
                                    }
                                </td>
                            </tr>
                            @if (_correcting == h.Id)
                            {
                                <tr>
                                    <td colspan="6">
                                        <form class="inline-form" @onsubmit="() => CorrectAsync(h.Id)">
                                            <span>@L("Уменьшить выработку {0} (осталось {1}); исправление встанет сегодняшним днём.", h.Employee ?? "", Quantities.Format(h.Remaining ?? 0))</span>
                                            <label>@L("На сколько") <input @bind="_correctText" inputmode="decimal" size="6" aria-label="@L("На сколько уменьшить")" /></label>
                                            <label>@L("Причина") <input @bind="_correctReason" maxlength="300" aria-label="@L("Причина исправления")" /></label>
                                            <button type="submit" disabled="@_busy">@L("Исправить")</button>
                                            <button type="button" class="secondary" @onclick="() => _correcting = null">@L("Отмена")</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </details>
    }
}

@code {
    [Parameter, EditorRequired]
    public long OrderId { get; set; }

    /// <summary>Ход работ загружает карточка — по очереди с заказом и материалами (у вкладки один DbContext).</summary>
    [Parameter, EditorRequired]
    public ProductionProgressDto? Progress { get; set; }

    [Parameter]
    public DateOnly Today { get; set; }

    /// <summary>После отметки карточка перечитывает заказ, ход работ и материалы.</summary>
    [Parameter]
    public EventCallback OnChanged { get; set; }

    private ProductionProgressDto? _progress => Progress;
    private ProductionProgressDto? _prefilledFor;

    private IReadOnlyList<string>? ReasonHints => _kind switch
    {
        ProductionOperationKind.Defect => _progress?.DefectReasons,
        ProductionOperationKind.Rework => _progress?.ReworkReasons,
        _ => null,
    };

    /// <summary>
    /// D413: после загрузки и после каждой отметки — этап, где есть что отмечать (текущий, если на нём ещё есть), и количество «сколько можно».
    /// Набранное пользователем не затирается: подстановка — только в пустое поле и только для «Сделано».
    /// </summary>
    protected override void OnParametersSet()
    {
        if (_progress is null || ReferenceEquals(_progress, _prefilledFor))
        {
            return;
        }

        _prefilledFor = _progress;
        if (_quantityText.Length > 0 || _kind != ProductionOperationKind.Done)
        {
            return;
        }

        var current = _progress.Stages.FirstOrDefault(x => x.Stage == _stage);
        if (current is null || current.Available <= 0)
        {
            _stage = (_progress.Stages.FirstOrDefault(x => x.Available > 0) ?? current ?? _progress.Stages.FirstOrDefault())?.Stage ?? _stage;
        }

        Prefill();
    }

    private void StageChanged()
    {
        if (!KindsFor(_stage).Contains(_kind))
        {
            _kind = ProductionOperationKind.Done;
        }

        Prefill();
    }

    private void KindChanged() => Prefill();

    private void Prefill()
    {
        var available = _progress?.Stages.FirstOrDefault(x => x.Stage == _stage)?.Available ?? 0;
        _quantityText = _kind == ProductionOperationKind.Done && available > 0 ? Quantities.Format(available) : string.Empty;
    }
    private bool _busy;
    private string? _message;
    private bool _messageIsError;
    private ProductionStage _stage = ProductionStage.Knitting;
    private ProductionOperationKind _kind = ProductionOperationKind.Done;
    private ProductionStage _returnTo = ProductionStage.Knitting;
    private string _quantityText = string.Empty;
    private string? _reason;
    private DateTime _date = DateTime.Today;
    private long? _correcting;
    private string _culprit = string.Empty;
    private string _correctText = string.Empty;
    private string? _correctReason;

    private void StartCorrect(long id)
    {
        _correcting = id;
        _correctText = string.Empty;
        _correctReason = null;
    }

    /// <summary>Исправление отметки рабочего: уменьшает её выработку сегодняшним днём (D92, дополнение).</summary>
    private async Task CorrectAsync(long operationId)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _message = null;
        _messageIsError = false;
        try
        {
            if (!Quantities.TryParse(_correctText, out var quantity))
            {
                throw new BusinessRuleException("production.stage.quantity_invalid", L("Укажите количество числом, например 100."));
            }

            await Floor.CorrectAsync(OrderId, operationId, quantity, _correctReason);
            _message = L("Отметка исправлена.");
            _correcting = null;
        }
        catch (Exception ex) when (UiErrors.IsUserFacing(ex))
        {
            _message = UiErrors.Message(ex);
            _messageIsError = true;
        }
        finally
        {
            try
            {
                await OnChanged.InvokeAsync();
            }
            finally
            {
                _busy = false;
            }
        }
    }

    protected override void OnInitialized() => _date = Today.ToDateTime(TimeOnly.MinValue);

    private static IEnumerable<ProductionOperationKind> KindsFor(ProductionStage stage) =>
        stage == ProductionStage.QualityControl
            ? [ProductionOperationKind.Done, ProductionOperationKind.Rework, ProductionOperationKind.Defect, ProductionOperationKind.Correction]
            : [ProductionOperationKind.Done, ProductionOperationKind.Correction];

    private async Task RecordAsync()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _message = null;
        _messageIsError = false;
        try
        {
            if (!KindsFor(_stage).Contains(_kind))
            {
                _kind = ProductionOperationKind.Done;
            }

            if (!Quantities.TryParse(_quantityText, out var quantity))
            {
                throw new BusinessRuleException("production.stage.quantity_invalid", L("Укажите количество числом, например 100."));
            }

            await Floor.RecordAsync(OrderId, new ProductionOperationCommand(_stage, _kind, quantity,
                _kind == ProductionOperationKind.Rework ? _returnTo : null, _reason, DateOnly.FromDateTime(_date),
                _kind == ProductionOperationKind.Defect && long.TryParse(_culprit, out var culprit) ? culprit : null));
            _message = L("Отмечено.");
            _quantityText = string.Empty;
            _reason = null;
            _culprit = string.Empty;
        }
        catch (Exception ex) when (UiErrors.IsUserFacing(ex))
        {
            _message = UiErrors.Message(ex);
            _messageIsError = true;
        }
        finally
        {
            try
            {
                await OnChanged.InvokeAsync();
            }
            finally
            {
                _busy = false;
            }
        }
    }
}
