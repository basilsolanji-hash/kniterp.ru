@page "/catalog/price-list"
@using KnitErp.Application.Catalog
@using KnitErp.Domain.Common
@inject SupplierPriceListService PriceLists
@inject ItemSupplierService Suppliers

<PageTitle>@L("Прайс-лист поставщика") — knitERP</PageTitle>

@*
    D323 (сессия 4): загрузка прайс-листа поставщика — закупочные цены позиций без ручного ввода. Сначала предпросмотр (ничего не меняется),
    затем «Применить»: цены, запоминание артикулов поставщика, автоцены по правилам — одной транзакцией.
*@
@if (_denied is not null)
{
    <AccessDenied Message="@_denied" />
}
else if (_suppliers is null)
{
    <p class="muted">@L("Загрузка…")</p>
}
else
{
    <p><a href="catalog">@L("← Номенклатура")</a></p>
    <h1>@L("Прайс-лист поставщика")</h1>
    <p class="muted">@L("Excel поставщика как есть: knitERP сам найдёт строку заголовка со столбцами «Артикул» (или «Код») и «Цена»; наименование и штрихкод — по желанию. Позиции сопоставляются по артикулу поставщика (блок «Поставщики» в карточке), затем по штрихкоду; найденное по штрихкоду запоминается — следующий прайс сопоставится сам.")</p>

    @if (_message is not null)
    {
        <div class="@(_isError ? "flash error" : "flash")" role="@(_isError ? "alert" : "status")">@_message</div>
    }

    <div class="panel">
        @if (_suppliers.Count == 0)
        {
            <p class="muted">@L("Нет поставщиков: отметьте роль «Поставщик» у контрагента.") <a href="counterparties">@L("Контрагенты")</a></p>
        }
        else
        {
            <div class="grid">
                <label>
                    @L("Поставщик")
                    <select @bind="_supplierId" disabled="@_busy">
                        @foreach (var s in _suppliers)
                        {
                            <option value="@s.Id">@s.Name</option>
                        }
                    </select>
                </label>
                <label class="check"><input type="checkbox" @bind="_withVat" disabled="@_busy" /> @L("Цены в файле с НДС (пересчитать без НДС по ставке позиции)")</label>
                <label>@L("Файл .xlsx") <InputFile OnChange="PreviewAsync" accept=".xlsx" disabled="@_busy" /></label>
            </div>
        }
    </div>

    @if (_plan is { } plan)
    {
        <div class="totals">
            <span>@L("Строк: {0}", plan.Rows.Count)</span>
            <span>@L("Изменится цен: {0}", plan.ToUpdate)</span>
            <span>@L("Не найдено: {0}", plan.NotFound)</span>
            <span class="@(plan.Errors > 0 ? "neg" : null)">@L("С ошибками: {0}", plan.Errors)</span>
        </div>
        <div class="actions">
            <ConfirmButton Disabled="@(_busy || plan.ToUpdate == 0)" Title="@((plan.ToUpdate == 0) ? L("Нечего обновлять: цены совпадают") : null)" Question="@L("Обновить закупочные цены по прайс-листу? Включённые автоцены пересчитаются.")"
                           OnConfirm="ApplyAsync">@L("Применить")</ConfirmButton>
            <button type="button" class="secondary" @onclick="() => _plan = null" disabled="@_busy">@L("Отменить")</button>
        </div>
        <div class="scroll">
            <table class="compact">
                <thead><tr><th>@L("Строка")</th><th>@L("Артикул")</th><th class="opt">@L("В файле")</th><th>@L("Позиция")</th><th class="num">@L("Было")</th><th class="num">@L("Станет")</th><th>@L("Действие")</th></tr></thead>
                <tbody>
                    @foreach (var r in plan.Rows.OrderBy(r => r.Action switch { PriceListAction.Error => 0, PriceListAction.Update => 1, PriceListAction.NotFound => 2, _ => 3 }).ThenBy(r => r.RowNumber).Take(1000))
                    {
                        <tr>
                            <td>@r.RowNumber</td>
                            <td>@(r.Article ?? r.Barcode ?? "—")</td>
                            <td class="small">@r.Name</td>
                            <td>
                                @if (r.ItemId is { } id)
                                {
                                    <a href="catalog/items/@id" target="_blank" rel="noopener">@r.ItemCode @r.ItemName</a>
                                    <div class="muted small">@(r.MatchedBy == "штрихкод" ? L("по штрихкоду") : L("по артикулу поставщика"))</div>
                                }
                                else
                                {
                                    <span class="muted">—</span>
                                }
                            </td>
                            <td class="num">@(r.OldPurchasePrice is { } o ? Amounts.Format(o) : "—")</td>
                            <td class="num">@(r.NewPurchasePrice is { } n ? Amounts.Format(n) : r.FilePrice is { } f ? Amounts.Format(f) : "—")</td>
                            <td class="@(r.Action == PriceListAction.Error ? "neg" : null)">@ActionText(r)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (plan.Rows.Count > 1000)
        {
            <p class="muted small">@L("Показаны первые 1000 строк; применяются все.")</p>
        }
    }
}

@code {
    private IReadOnlyList<SupplierOptionDto>? _suppliers;
    private long _supplierId;
    private bool _withVat;
    private PriceListPlanDto? _plan;
    private bool _busy;
    private string? _denied;
    private string? _message;
    private bool _isError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _suppliers = await Suppliers.SupplierOptionsAsync();
            _supplierId = _suppliers.FirstOrDefault()?.Id ?? 0;
        }
        catch (AccessDeniedException ex)
        {
            _denied = UiErrors.Message(ex);
        }
    }

    private string ActionText(PriceListRowDto r) => r.Action switch
    {
        PriceListAction.Update => L("обновить"),
        PriceListAction.Unchanged => L("без изменений"),
        PriceListAction.NotFound => L("не найдена"),
        _ => r.Error switch
        {
            PriceListErrors.Bundle => L("У комплекта нет закупочной цены — она складывается из компонентов."),
            PriceListErrors.Duplicate => L("Позиция уже есть выше в файле — цена берётся из первой строки."),
            _ => L("Цена не число или не больше нуля."),
        },
    };

    private Task PreviewAsync(InputFileChangeEventArgs e) => RunAsync(async () =>
    {
        _plan = null;
        const long maxSize = 10 * 1024 * 1024;
        if (e.File.Size > maxSize)
        {
            throw new BusinessRuleException("import.file_too_large", L("Файл больше 10 МБ. Разбейте его на части."));
        }

        await using var upload = e.File.OpenReadStream(maxAllowedSize: maxSize);
        using var buffer = new MemoryStream();
        await upload.CopyToAsync(buffer);
        buffer.Position = 0;
        _plan = await PriceLists.PreviewAsync(_supplierId, buffer, _withVat);
    }, null);

    private Task ApplyAsync() => RunAsync(async () =>
    {
        var r = await PriceLists.ApplyAsync(_plan!);
        _plan = null;
        _message = L("Закупочных цен обновлено: {0}; запомнено артикулов поставщика: {1}; автоцен пересчитано: {2}.", r.Updated, r.Linked, r.AutoPrices);
    }, null);

    private async Task RunAsync(Func<Task> action, string? success)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _message = null;
        _isError = false;
        try
        {
            await action();
            _message = success ?? _message;
        }
        catch (Exception ex) when (UiErrors.IsUserFacing(ex))
        {
            _message = UiErrors.Message(ex);
            _isError = true;
        }
        finally
        {
            _busy = false;
        }
    }
}
