@using KnitErp.Application.Development
@using KnitErp.Domain.Development
@using System.Globalization
@inject DevGate Gate
@inject DevShopService Shop

@*
    Размеры (D713) — экран конструктора: размерная сетка (образцы 1, 2, 3… или 42–52), размеры деталей по размерам (длина с машины, после ВТО,
    ширина), упаковка (штук в коробке, короб), табель мер с допуском и градацией от базового размера.
*@
@if (_message is not null)
{
    <div class="@(_isError ? "flash error" : "flash")" role="@(_isError ? "alert" : "status")">@_message</div>
}
@if (_s is null)
{
    <p class="muted">@L("Загрузка…")</p>
}
else
{
    var s = _s;
    <fieldset class="until-interactive" disabled="@(!RendererInfo.IsInteractive || !s.CanEdit)">
        <div class="dev-panels">
        <div class="panel">
            <h2>@L("Размерная сетка")</h2>
            <div class="inline-form">
                <label>@L("Размеры через запятую") <input @bind="_grid" placeholder="1, 2, 3, 4" /></label>
                <label>@L("Базовый размер") <input @bind="_base" style="max-width: 90px" /></label>
                @if (s.CanEdit)
                {
                    <button type="button" @onclick="SaveGridAsync" disabled="@_busy">@L("Сохранить сетку")</button>
                }
            </div>
            <p class="muted small">@L("Базовый размер — от него считается градация табеля мер. Пусто — средний размер сетки.")</p>
        </div>

        @if (s.Sizes.Count > 0)
        {
            <div class="panel">
                <h2>@L("Упаковка")</h2>
                <div class="scroll">
                    <table class="dev-matrix">
                        <thead><tr><th>@L("Размер")</th>@foreach (var z in s.Sizes) { <th class="num">@z.Name</th> }</tr></thead>
                        <tbody>
                            <tr>
                                <td>@L("Штук в коробке")</td>
                                @foreach (var z in s.Sizes)
                                {
                                    var size = z.Id;
                                    <td class="num"><input type="number" min="1" step="1" inputmode="numeric" style="max-width: 64px" value="@_perBox.GetValueOrDefault(size)"
                                                           @onchange="e => _perBox[size] = int.TryParse(e.Value as string, out var n) ? n : null" aria-label="@L("Штук в коробке, размер {0}", z.Name)" /></td>
                                }
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="inline-form">
                    <label>@L("Размер короба") <input @bind="_packBox" maxlength="60" placeholder="40 × 30 × 30 см" /></label>
                    @if (s.CanEdit)
                    {
                        <button type="button" @onclick="SavePackingAsync" disabled="@_busy">@L("Сохранить упаковку")</button>
                    }
                </div>
            </div>

            <div class="panel">
                <h2>@L("Вес изделия по размерам")</h2>
                <div class="scroll">
                    <table class="dev-matrix">
                        <thead><tr><th>@L("Размер")</th>@foreach (var z in s.Sizes) { <th class="num">@z.Name</th> }</tr></thead>
                        <tbody>
                            <tr>
                                <td>@L("Вес изделия, г")</td>
                                @foreach (var z in s.Sizes)
                                {
                                    var size = z.Id;
                                    <td class="num"><input type="number" min="0" step="0.1" inputmode="decimal" style="max-width: 72px"
                                                           value="@(_weight.GetValueOrDefault(size)?.ToString("0.##", CultureInfo.InvariantCulture))"
                                                           @onchange="e => _weight[size] = ParseDecimal(e.Value)" aria-label="@L("Вес изделия, размер {0}", z.Name)" /></td>
                                }
                            </tr>
                        </tbody>
                    </table>
                </div>
                @if (s.CanEdit)
                {
                    <div class="actions"><button type="button" @onclick="SaveWeightsAsync" disabled="@_busy">@L("Сохранить вес")</button></div>
                }
            </div>

            <div class="panel wide">
                <h2>@L("Размеры деталей, см")</h2>
                @if (s.Details.Count == 0)
                {
                    <p class="muted">@L("Сначала добавьте детали на вкладке «Детали и заправка».")</p>
                }
                @foreach (var d in s.Details)
                {
                    var detail = d;
                    <h3>@d.DetailName</h3>
                    <div class="scroll">
                        <table class="dev-matrix">
                            <thead><tr><th>@L("Параметр")</th>@foreach (var z in s.Sizes) { <th class="num">@z.Name@(z.IsBase ? " *" : "")</th> }</tr></thead>
                            <tbody>
                                @foreach (var p in Params)
                                {
                                    var param = p.Key;
                                    <tr>
                                        <td>@p.Value</td>
                                        @foreach (var z in s.Sizes)
                                        {
                                            var size = z.Id;
                                            <td class="num"><input type="number" min="0" step="0.1" inputmode="decimal" style="max-width: 64px"
                                                                   value="@Cell(_detail, (detail.DetailId, size, param))"
                                                                   @onchange="e => SetCell(_detail, (detail.DetailId, size, param), e.Value)"
                                                                   aria-label="@L("{0}, {1}, размер {2}", detail.DetailName, p.Value, z.Name)" /></td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                @if (s.CanEdit && s.Details.Count > 0)
                {
                    <div class="actions"><button type="button" @onclick="SaveDetailSizesAsync" disabled="@_busy">@L("Сохранить размеры деталей")</button></div>
                }
            </div>

            <div class="panel wide">
                <h2>@L("Табель мер, см")</h2>
                @if (s.Measures.Count > 0)
                {
                    <div class="scroll">
                        <table class="dev-matrix">
                            <thead><tr><th>@L("Точка измерения")</th><th class="num">±</th><th class="num opt">@L("Шаг")</th>@foreach (var z in s.Sizes) { <th class="num">@z.Name@(z.IsBase ? " *" : "")</th> }<th></th></tr></thead>
                            <tbody>
                                @foreach (var m in s.Measures)
                                {
                                    var measure = m;
                                    <tr>
                                        <td>@m.Name</td>
                                        <td class="num">@DevFormat.Number(m.Tolerance)</td>
                                        <td class="num">@DevFormat.Number(m.Step)</td>
                                        @foreach (var z in s.Sizes)
                                        {
                                            var size = z.Id;
                                            <td class="num"><input type="number" min="0" step="0.1" inputmode="decimal" style="max-width: 64px"
                                                                   value="@Cell(_measure, (measure.Id, size, 0))" @onchange="e => SetCell(_measure, (measure.Id, size, 0), e.Value)"
                                                                   aria-label="@L("{0}, размер {1}", measure.Name, z.Name)" /></td>
                                        }
                                        <td>@if (s.CanEdit) { <button type="button" class="secondary" @onclick="() => RemoveMeasureAsync(measure)" disabled="@_busy">@L("Убрать")</button> }</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (s.CanEdit)
                    {
                        <div class="actions">
                            <button type="button" @onclick="SaveMeasuresAsync" disabled="@_busy">@L("Сохранить табель мер")</button>
                            <button type="button" class="secondary" @onclick="() => GradeAsync(false)" disabled="@_busy">@L("Заполнить пустые по градации")</button>
                            <button type="button" class="secondary" @onclick="() => GradeAsync(true)" disabled="@_busy">@L("Пересчитать все по градации")</button>
                        </div>
                        <p class="muted small">@L("Градация: значение базового размера (*) ± шаг на каждый размер. Сначала сохраните значения базового размера.")</p>
                    }
                }
                @if (s.CanEdit)
                {
                    <div class="actions">
                        <button type="button" class="secondary" @onclick="ApplyTemplateAsync" disabled="@_busy">@L("Заполнить по шаблону категории")</button>
                    </div>
                    <form class="inline-form" @onsubmit="AddMeasureAsync">
                        <label>@L("Точка измерения") <input @bind="_mName" list="dev-measure-points" maxlength="@DevMeasure.NameMaxLength" placeholder="@L("Длина изделия")" required /></label>
                        <datalist id="dev-measure-points">
                            @foreach (var p in s.MeasurePointSuggestions)
                            {
                                <option value="@p"></option>
                            }
                        </datalist>
                        <label>@L("Допуск ±, см") <input type="number" min="0" step="0.1" inputmode="decimal" style="max-width: 90px" @bind="_mTol" /></label>
                        <label>@L("Шаг градации, см") <input type="number" step="0.1" inputmode="decimal" style="max-width: 90px" @bind="_mStep" /></label>
                        <button type="submit" disabled="@_busy">@L("Добавить точку")</button>
                    </form>
                }
            </div>
        }
        </div>
    </fieldset>
}

@code {
    [Parameter, EditorRequired]
    public long ModelId { get; set; }

    private DevSizesDto? _s;
    private readonly Dictionary<(long, long, int), decimal?> _detail = [];
    private readonly Dictionary<(long, long, int), decimal?> _measure = [];
    private readonly Dictionary<long, int?> _perBox = [];

    // D720: значения, которые пришли с сервера, — с ними сравниваются правки; на сервер уходят только изменённые ячейки.
    private readonly Dictionary<(long, long, int), decimal?> _wasDetail = [];
    private readonly Dictionary<(long, long, int), decimal?> _wasMeasure = [];
    private readonly Dictionary<long, int?> _wasPerBox = [];
    private readonly Dictionary<long, decimal?> _weight = [];
    private readonly Dictionary<long, decimal?> _wasWeight = [];
    private string? _packBoxWas;
    private string? _grid;
    private string? _base;
    private string? _packBox;
    private string? _mName;
    private decimal _mTol = 1;
    private decimal? _mStep;
    private bool _busy;
    private string? _message;
    private bool _isError;
    private long _loaded;

    private static IReadOnlyList<KeyValuePair<int, string>> Params =>
        [new(0, L("Длина с машины")), new(1, L("Длина после ВТО")), new(2, L("Ширина"))];

    protected override async Task OnParametersSetAsync()
    {
        if (_loaded != ModelId)
        {
            _loaded = ModelId;
            await LoadAsync();
        }
    }

    [Flags]
    private enum Part
    {
        None = 0,
        Detail = 1,
        Measure = 2,
        Pack = 4,
        Weight = 8,
        All = Detail | Measure | Pack | Weight,
    }

    /// <summary>
    /// Перечитать таблицы. Сохранённая часть (<paramref name="reset"/>) показывает значения сервера; в остальных несохранённые правки
    /// пользователя остаются — сохранение упаковки не стирает начатый табель мер.
    /// </summary>
    private async Task LoadAsync(Part reset = Part.All)
    {
        _s = await Gate.Run(() => Shop.SizesAsync(ModelId));
        _grid = string.Join(", ", _s.Sizes.Select(z => z.Name));
        _base = _s.Sizes.FirstOrDefault(z => z.IsBase)?.Name;
        if (reset.HasFlag(Part.Pack) || _packBox == _packBoxWas)
        {
            _packBox = _s.PackBox;
        }

        _packBoxWas = _s.PackBox;
        var detail = new Dictionary<(long, long, int), decimal?>();
        foreach (var d in _s.Details)
        {
            foreach (var (size, v) in d.Values)
            {
                detail[(d.DetailId, size, 0)] = v.OffMachine;
                detail[(d.DetailId, size, 1)] = v.AfterSteam;
                detail[(d.DetailId, size, 2)] = v.Width;
            }
        }

        var measure = new Dictionary<(long, long, int), decimal?>();
        foreach (var m in _s.Measures)
        {
            foreach (var (size, v) in m.Values)
            {
                measure[(m.Id, size, 0)] = v;
            }
        }

        Merge(_detail, _wasDetail, detail, reset.HasFlag(Part.Detail));
        Merge(_measure, _wasMeasure, measure, reset.HasFlag(Part.Measure));
        Merge(_perBox, _wasPerBox, _s.Sizes.ToDictionary(z => z.Id, z => z.PerBox), reset.HasFlag(Part.Pack));
        Merge(_weight, _wasWeight, _s.Sizes.ToDictionary(z => z.Id, z => z.WeightGrams), reset.HasFlag(Part.Weight));
    }

    private static void Merge<TKey, TValue>(Dictionary<TKey, TValue?> current, Dictionary<TKey, TValue?> was, Dictionary<TKey, TValue?> fresh, bool reset)
        where TKey : notnull
        where TValue : struct
    {
        var dirty = reset ? [] : current.Where(kv => !Nullable.Equals(kv.Value, was.GetValueOrDefault(kv.Key))).ToList();
        was.Clear();
        current.Clear();
        foreach (var (k, v) in fresh)
        {
            was[k] = v;
            current[k] = v;
        }

        foreach (var (k, v) in dirty)
        {
            current[k] = v;
        }
    }

    private static List<DevCellEdit> Edits(Dictionary<(long, long, int), decimal?> current, Dictionary<(long, long, int), decimal?> was) =>
        current.Where(kv => kv.Value != was.GetValueOrDefault(kv.Key))
            .Select(kv => new DevCellEdit(kv.Key.Item1, kv.Key.Item2, kv.Key.Item3, was.GetValueOrDefault(kv.Key), kv.Value)).ToList();

    private static string Cell(Dictionary<(long, long, int), decimal?> d, (long, long, int) key) =>
        d.GetValueOrDefault(key)?.ToString("0.#", CultureInfo.InvariantCulture) ?? string.Empty;

    private static void SetCell(Dictionary<(long, long, int), decimal?> d, (long, long, int) key, object? value) =>
        d[key] = decimal.TryParse((value as string)?.Replace(',', '.'), NumberStyles.Number, CultureInfo.InvariantCulture, out var v) ? v : null;

    private static decimal? ParseDecimal(object? value) =>
        decimal.TryParse((value as string)?.Replace(',', '.'), NumberStyles.Number, CultureInfo.InvariantCulture, out var v) ? v : null;

    private Task SaveWeightsAsync() => RunAsync(() => Shop.SetSizeWeightsAsync(ModelId,
        _weight.Where(kv => kv.Value != _wasWeight.GetValueOrDefault(kv.Key)).Select(kv => (kv.Key, kv.Value)).ToList()), L("Вес изделия сохранён."), Part.Weight);

    private async Task ApplyTemplateAsync()
    {
        var added = 0;
        await RunAsync(async () => added = await Shop.ApplyMeasureTemplateAsync(ModelId), null);
        if (!_isError)
        {
            _message = added > 0 ? L("Добавлено точек из шаблона категории: {0}.", added)
                : L("Новых точек нет: шаблон категории пуст или все его точки уже в табеле мер.");
        }
    }

    private Task SaveGridAsync() => RunAsync(() => Shop.SetSizeGridAsync(ModelId, Expand(_grid), _base), L("Размерная сетка сохранена."));

    /// <summary>«1, 2, 3» как есть; «42-52» — через 2 (российская размерная сетка одежды).</summary>
    private static IReadOnlyList<string> Expand(string? grid)
    {
        var text = (grid ?? string.Empty).Trim();
        var range = System.Text.RegularExpressions.Regex.Match(text, @"^(\d+)\s*[-–]\s*(\d+)$");
        if (range.Success && int.TryParse(range.Groups[1].Value, out var a) && int.TryParse(range.Groups[2].Value, out var b) && b > a && b - a <= 40)
        {
            var step = (b - a) % 2 == 0 && a >= 20 ? 2 : 1;
            return Enumerable.Range(0, (b - a) / step + 1).Select(i => (a + i * step).ToString(CultureInfo.InvariantCulture)).ToList();
        }

        return text.Split([',', ';', ' '], StringSplitOptions.RemoveEmptyEntries).ToList();
    }

    private Task SaveDetailSizesAsync() => SaveAsync(() => Shop.SetDetailSizesAsync(ModelId, Edits(_detail, _wasDetail)), Part.Detail,
        L("Размеры деталей сохранены."));

    private Task SavePackingAsync() => SaveAsync(() => Shop.SetPackingAsync(ModelId,
        _perBox.Where(kv => kv.Value != _wasPerBox.GetValueOrDefault(kv.Key))
            .Select(kv => new DevCellEdit(kv.Key, 0, 0, _wasPerBox.GetValueOrDefault(kv.Key), kv.Value)).ToList(), _packBoxWas, _packBox), Part.Pack,
        L("Упаковка сохранена."));

    private Task SaveMeasuresAsync() => SaveAsync(() => Shop.SetMeasureValuesAsync(ModelId, Edits(_measure, _wasMeasure)), Part.Measure, L("Табель мер сохранён."));

    /// <summary>Сохранить таблицу; ячейки, которые успел изменить другой пользователь, — в сообщении, на экране — его значения (D720).</summary>
    private async Task SaveAsync(Func<Task<DevSaveResult>> save, Part part, string success)
    {
        DevSaveResult? result = null;
        await RunAsync(async () => result = await save(), success, part);
        if (result is { Conflicts.Count: > 0 } r && !_isError)
        {
            _message = L("Сохранено значений: {0}. Не сохранено — уже изменил другой пользователь, показаны его значения: {1}.", r.Saved,
                string.Join("; ", r.Conflicts));
            _isError = true;
        }
    }

    private async Task GradeAsync(bool overwrite)
    {
        var filled = 0;
        await RunAsync(async () => filled = await Shop.GradeAsync(ModelId, overwrite), null);
        if (!_isError)
        {
            _message = L("Заполнено по градации: {0}.", filled);
        }
    }

    private Task AddMeasureAsync() => RunAsync(async () =>
    {
        await Shop.AddMeasureAsync(ModelId, _mName, _mTol, _mStep);
        _mName = null;
        _mStep = null;
    }, L("Точка добавлена."));

    private Task RemoveMeasureAsync(DevMeasureDto m) => RunAsync(() => Shop.RemoveMeasureAsync(m.Id), L("Точка убрана."));

    private async Task RunAsync(Func<Task> action, string? success, Part reset = Part.None)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _message = null;
        _isError = false;
        try
        {
            await Gate.Run(action);
            _message = success;
        }
        catch (Exception ex) when (UiErrors.IsUserFacing(ex))
        {
            _message = UiErrors.Message(ex);
            _isError = true;
        }
        finally
        {
            try
            {
                await LoadAsync(_isError ? Part.None : reset);
            }
            finally
            {
                _busy = false;
            }
        }
    }
}
