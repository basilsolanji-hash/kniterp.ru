@*
    Стили модуля «Разработка» (D706): доска по стадиям и карточка модели. Компактно (D114); на телефоне 390 px — без горизонтальной
    прокрутки страницы: колонки доски идут одна под другой, вкладки карточки переносятся на новую строку.
*@
<style>
    .dev-switch { display: flex; gap: 6px; flex-wrap: wrap; margin: 8px 0; }
    .dev-board { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(170px, 1fr); gap: 8px; overflow-x: auto; padding-bottom: 8px; }
    .dev-col { background: var(--surface-2); border: 1px solid var(--line); border-radius: 8px; padding: 8px; min-width: 0; }
    .dev-col.empty { background: transparent; padding: 8px 6px; }
    .dev-col.empty h2 { flex-direction: column; gap: 0; font-size: 12px; font-weight: 500; color: var(--text-2); }
    .dev-col h2 { font-size: 13px; margin: 0 0 6px; display: flex; justify-content: space-between; gap: 6px; }
    .dev-col ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
    .dev-cardlet { border: 1px solid var(--line); border-radius: 6px; padding: 6px 8px; background: var(--surface); overflow-wrap: anywhere; }
    .dev-cardlet a { font-weight: 600; text-decoration: none; }
    .dev-cardlet .meta { font-size: 12px; color: var(--muted); display: flex; flex-wrap: wrap; gap: 2px 8px; }
    .dev-cardlet.late { border-left: 3px solid var(--bad-text); }
    .dev-tabs { flex-wrap: wrap; }
    .dev-stage-path { display: flex; flex-wrap: wrap; gap: 4px; margin: 6px 0 10px; padding: 0; list-style: none; font-size: 12px; }
    .dev-stage-path li { padding: 2px 8px; border-radius: 999px; background: var(--line); color: var(--text-2); }
    .dev-stage-path li.done { background: var(--ok-bg); color: var(--ok-text); }
    .dev-stage-path li.current { background: var(--accent); color: var(--on-accent); font-weight: 600; }
    .dev-stage-path li.off { opacity: .45; text-decoration: line-through; }
    .dev-files { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 6px; }
    .dev-files li { display: flex; flex-wrap: wrap; gap: 4px 10px; align-items: baseline; overflow-wrap: anywhere; }
    .dev-thumb { max-width: 160px; max-height: 120px; border-radius: 6px; border: 1px solid var(--line); display: block; }
    .dev-tasks { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px; }
    .dev-tasks li { border: 1px solid var(--line); border-radius: 8px; padding: 8px 10px; overflow-wrap: anywhere; }
    .dev-tasks li.now { border-left: 3px solid var(--accent); }
    .dev-placeholder { color: var(--muted); }
    .dev-hints { border-color: var(--warn-line); background: var(--warn-bg); }
    .dev-hints ul { margin: 4px 0 0; padding-left: 18px; }
    .dev-swatch { display: inline-block; width: 12px; height: 12px; border-radius: 3px; border: 1px solid var(--line); margin-right: 6px; vertical-align: -1px; }
    .dev-progress { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin: 6px 0 10px; }
    .dev-progress meter, .dev-progress progress { width: 160px; height: 10px; }
    .dev-sections { display: flex; flex-wrap: wrap; gap: 4px; list-style: none; padding: 0; margin: 0; font-size: 12px; }
    .dev-sections li { padding: 1px 8px; border-radius: 999px; background: var(--line); color: var(--text-2); }
    .dev-sections li.done { background: var(--ok-bg); color: var(--ok-text); }
    .dev-feeders { display: grid; gap: 6px; }
    .dev-feeder { display: grid; grid-template-columns: minmax(0, 1fr) 40px minmax(0, 1fr); gap: 6px; align-items: stretch; }
    .dev-feeder > .n { display: flex; align-items: center; justify-content: center; font-weight: 700; border-radius: 50%; background: var(--accent);
        color: var(--on-accent); width: 30px; height: 30px; align-self: center; justify-self: center; }
    .dev-slot { border: 1px solid var(--line); border-radius: 8px; padding: 6px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 4px 6px;
        background: var(--surface-2); min-width: 0; }
    .dev-slot.off { opacity: .55; }
    .dev-slot label { display: flex; flex-direction: column; gap: 2px; font-size: 11px; color: var(--text-2); min-width: 0; }
    .dev-slot label.check { flex-direction: row; align-items: center; gap: 4px; }
    .dev-slot select, .dev-slot input[type=text], .dev-slot input[type=number] { width: 100%; min-width: 0; }
    .dev-slot .wide { grid-column: 1 / -1; }
    .dev-slot input, .dev-slot select { box-sizing: border-box; }
    .dev-slot.off { align-self: center; padding: 4px 6px; }
    .dev-slot .checks { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 4px 14px; }
    /* Широкий экран: цвет, нитей и режим — в одну строку, флажки — под ними; выключенный нитеводитель — узкой строкой (D719). */
    @@media (min-width: 900px) {
        .dev-slot { grid-template-columns: minmax(0, 1fr) 72px 72px; align-content: start; }
        .dev-slot label.pick { grid-column: 1; }
    }
    @@media (max-width: 640px) {
        .dev-feeder { grid-template-columns: 1fr; }
        .dev-feeder > .n { justify-self: start; }
    }
    .late-text { color: var(--bad-text); }
    /* Без пустых полей (D719): панели — сеткой на всю ширину, факты карточки — плитками, формы в строку слева, матрицы размеров — по содержимому. */
    .dev-panels { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr)); gap: 16px; align-items: start; margin: 16px 0; }
    .dev-panels > .panel { margin: 0; min-width: 0; }
    .dev-panels > .panel.wide { grid-column: 1 / -1; }
    dl.dev-facts { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 210px), 1fr)); gap: 8px; max-width: none; }
    dl.dev-facts > div { background: var(--surface-2); border: 1px solid var(--line); border-radius: 8px; padding: 6px 10px; min-width: 0; }
    dl.dev-facts > div.wide { grid-column: span 2; }
    dl.dev-facts dt { font-size: 12px; }
    dl.dev-facts dd { margin: 0; }
    ul.dev-tiles > li.open { grid-column: 1 / -1; }
    ul.dev-tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); gap: 8px; }
    .dev-checks { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 180px), 1fr)); gap: 4px 12px; }
    .dev-cost-tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 150px), 1fr)); gap: 8px; margin: 8px 0 12px; }
    .dev-cost-tiles > div { background: var(--surface-2); border: 1px solid var(--line); border-radius: 8px; padding: 8px 10px; display: flex; flex-direction: column; gap: 2px; min-width: 0; }
    .dev-cost-tiles > div.hi { border-color: var(--accent); }
    .dev-cost-tiles.compact { grid-template-columns: repeat(auto-fit, minmax(min(100%, 118px), 1fr)); }
    .dev-cost-tiles span { font-size: 12px; color: var(--text-2); }
    .dev-cost-tiles b { font-size: 18px; font-variant-numeric: tabular-nums; }
    .dev-cost-tiles small { font-size: 11px; }
    .ok-text { color: var(--ok-text); }
    table.dev-matrix { width: auto; }
    table.dev-matrix th, table.dev-matrix td { padding-right: 10px; }
    table.dev-matrix th:first-child { min-width: 120px; }
    @@media (min-width: 600px) {
        .panel form.inline-form { flex-direction: row; align-items: flex-end; }
    }
    @@media (max-width: 599px) {
        dl.dev-facts > div.wide { grid-column: auto; }
    }
    @@media (max-width: 899px) {
        .dev-board { grid-auto-flow: row; grid-auto-columns: auto; grid-template-columns: 1fr !important; overflow-x: visible; }
        .dev-col.empty { padding: 4px 8px; } .dev-col.empty h2 { margin: 0; flex-direction: row; } .dev-col.empty p { display: none; }
    }
    /* Пересмотр интерфейса 13.10 (ui-review §0 п. 4): одна главная кнопка, редкие действия — в меню «Ещё», пустые факты — одной строкой. */
    .dev-actions { align-items: center; }
    .dev-more { position: relative; display: inline-block; }
    .dev-more-toggle::after { content: " ▾"; }
    .dev-more-backdrop { position: fixed; inset: 0; z-index: 19; background: transparent; }
    .dev-more-menu { position: absolute; z-index: 20; right: 0; top: calc(100% + 4px); min-width: 210px; display: flex; flex-direction: column; gap: 4px;
        padding: 6px; background: var(--surface); border: 1px solid var(--line-strong); border-radius: 8px; box-shadow: 0 6px 18px var(--shadow-2); }
    .dev-more-menu > button, .dev-more-menu > a.button { text-align: left; width: 100%; box-sizing: border-box; }
    .dev-more-menu .danger-text { color: var(--bad-text); }
    .dev-move { margin: 0 0 10px; }
    .dev-missing { margin: 4px 0 10px; }
    .dev-brief-missing { margin: 6px 0 0; }
    /* Телефон: путь стадий — только текущая и соседние, разделы заполнения — под счётчиком не показываем (есть на компьютере). */
    @@media (max-width: 720px) {
        .dev-stage-path li:not(.current) { display: none; }
        .dev-progress .dev-sections { display: none; }
        .dev-more { flex: 1 1 100%; }
        .dev-more-toggle { width: 100%; }
        .dev-more-menu { left: 0; right: 0; }
        .dev-move > * { flex: 1 1 100%; }
    }
    /* ui-review §0 п. 6: объект открывается нажатием на любое место строки или карточки. Главная ссылка растягивается на всю строку
       (настоящая ссылка: Ctrl и средняя кнопка — новая вкладка, Enter с клавиатуры); кнопки и ссылки внутри строки остаются над ней. */
    .dev-row { position: relative; cursor: pointer; }
    .dev-row:hover { background: var(--hover-wash); }
    .dev-row a.dev-open::after { content: ""; position: absolute; inset: 0; }
    .dev-row a.dev-open:focus-visible { outline: none; }
    .dev-row:has(a.dev-open:focus-visible) { outline: 2px solid var(--accent); outline-offset: -2px; }
    .dev-row button, .dev-row a:not(.dev-open), .dev-row input, .dev-row select { position: relative; z-index: 1; }
</style>
