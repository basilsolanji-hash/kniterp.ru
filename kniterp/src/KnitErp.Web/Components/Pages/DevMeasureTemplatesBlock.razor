@using KnitErp.Application.Development
@using KnitErp.Domain.Development
@inject DevGate Gate
@inject DevSettingsService Settings

@*
    Шаблоны табеля мер по категориям (D729, ТЗ §9): точки измерения с допуском и шагом градации. В карточке модели кнопка
    «Заполнить по шаблону категории» добавляет недостающие точки в табель мер. Блок ходит в базу через DevGate.
*@
<h2>@L("Шаблоны табеля мер")</h2>
<p class="muted">@L("Точки измерения по категории изделия: в разделе «Размеры» модели кнопка «Заполнить по шаблону категории» добавит недостающие точки в табель мер.")</p>
@if (_message is not null)
{
    <div class="@(_isError ? "flash error" : "flash")" role="@(_isError ? "alert" : "status")">@_message</div>
}
<div class="tabs dev-tabs" role="tablist">
    @foreach (var c in Enum.GetValues<DevCategory>())
    {
        var category = c;
        <button type="button" role="tab" class="@(_category == category ? "tab active" : "tab secondary")" aria-selected="@(_category == category ? "true" : "false")"
                @onclick="() => OpenAsync(category)" disabled="@_busy">@L(DevModel.CategoryName(category))</button>
    }
</div>
@if (_rows is null)
{
    <p class="muted">@L("Загрузка…")</p>
}
else
{
    @if (_canEdit)
    {
        <form class="inline-form" @onsubmit="AddAsync">
            <fieldset class="until-interactive" disabled="@(!RendererInfo.IsInteractive)">
                <label>@L("Точка измерения") <input @bind="_name" maxlength="@DevMeasure.NameMaxLength" placeholder="@L("Длина изделия")" required /></label>
                <label>@L("Допуск ±, см") <input type="number" min="0" max="50" step="0.1" inputmode="decimal" style="max-width: 90px" @bind="_tolerance" /></label>
                <label>@L("Шаг градации, см") <input type="number" min="-50" max="50" step="0.1" inputmode="decimal" style="max-width: 90px" @bind="_step" /></label>
                <button type="submit" disabled="@_busy">@L("Добавить точку")</button>
            </fieldset>
        </form>
    }
    <div class="scroll">
        <table>
            <thead><tr><th>@L("Точка измерения")</th><th class="num">@L("Допуск ±, см")</th><th class="num">@L("Шаг градации, см")</th>@if (_canEdit) { <th></th> }</tr></thead>
            <tbody>
                @if (_rows.Count == 0)
                {
                    <tr><td colspan="4" class="muted">@L("Записей пока нет.")</td></tr>
                }
                @foreach (var r in _rows)
                {
                    var row = r;
                    <tr>
                        <td>@row.Name</td>
                        <td class="num">@DevFormat.Number(row.Tolerance)</td>
                        <td class="num">@DevFormat.Number(row.Step)</td>
                        @if (_canEdit)
                        {
                            <td><button type="button" class="secondary" @onclick="() => RemoveAsync(row)" disabled="@_busy"
                                        aria-label="@L("Убрать точку {0}", row.Name)">@L("Убрать")</button></td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [CascadingParameter]
    public CurrentAccessDto CurrentAccess { get; set; } = default!;

    private DevCategory _category = DevCategory.Sweater;
    private IReadOnlyList<DevCategoryMeasureDto>? _rows;
    private bool _canEdit;
    private string? _name;
    private decimal _tolerance = 1m;
    private decimal? _step;
    private bool _busy;
    private string? _message;
    private bool _isError;

    protected override async Task OnInitializedAsync()
    {
        _canEdit = CurrentAccess.Has(Permissions.DevSettings);
        _category = Enum.GetValues<DevCategory>()[0];
        _rows = await Gate.Run(() => Settings.CategoryMeasuresAsync(_category));
    }

    private Task OpenAsync(DevCategory category) => RunAsync(async () =>
    {
        _category = category;
        _rows = await Settings.CategoryMeasuresAsync(category);
    }, null);

    private Task AddAsync() => RunAsync(async () =>
    {
        await Settings.AddCategoryMeasureAsync(_category, _name, _tolerance, _step);
        _name = null;
        _step = null;
        _rows = await Settings.CategoryMeasuresAsync(_category);
    }, L("Добавлено."));

    private Task RemoveAsync(DevCategoryMeasureDto row) => RunAsync(async () =>
    {
        await Settings.RemoveCategoryMeasureAsync(row.Id);
        _rows = await Settings.CategoryMeasuresAsync(_category);
    }, L("Точка убрана."));

    private async Task RunAsync(Func<Task> action, string? success)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _message = null;
        _isError = false;
        try
        {
            await Gate.Run(action);
            _message = success;
        }
        catch (Exception ex) when (UiErrors.IsUserFacing(ex))
        {
            _message = UiErrors.Message(ex);
            _isError = true;
        }
        finally
        {
            _busy = false;
        }
    }
}
