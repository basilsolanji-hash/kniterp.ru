@page "/stock"
@using KnitErp.Application.Warehousing
@using KnitErp.Domain.Catalog
@using KnitErp.Web.Components.Shared
@inject StockService Stock

<PageTitle>@L("Остатки") — knitERP</PageTitle>

@if (_denied is not null)
{
    <AccessDenied Message="@_denied" />
}
else if (_rows is null)
{
    <p class="muted">@L("Загрузка…")</p>
}
else
{
    <h1>@L("Остатки")</h1>
    <p class="muted">@L("Текущий остаток — сумма движений по складу: начальные остатки и проведённые поступления, перемещения и списания.")</p>

    <form data-autosubmit class="inline-form" @onsubmit="ReloadAsync">
        <label>
            @L("Склад")
            <select @bind="_warehouse">
                <option value="">@L("Все доступные")</option>
                @foreach (var w in _warehouses)
                {
                    <option value="@w.Id">@w.Name</option>
                }
            </select>
        </label>
        <label>
            @L("Тип")
            <select @bind="_type">
                <option value="">@L("Все типы")</option>
                @foreach (var t in ItemTypes.Stocked)
                {
                    <option value="@((byte)t)">@L(ItemTypes.Name(t))</option>
                }
            </select>
        </label>
        <label>@L("Поиск") <input @bind="_search" placeholder="@L("Код или наименование")" /></label>
        <button type="submit" class="filter-apply secondary" disabled="@_busy">@L("Показать")</button>
        <a class="button secondary" href="@ExportHref" download data-enhance-nav="false" title="@L("Выгрузить с текущими фильтрами")">Excel</a>
        @* D325: ценники по одной на позицию и этикетки по остатку — для показанных строк. *@
        <LabelsButton Lines="@(_rows.Where(r => r.Quantity > 0).Select(r => r.ItemId).Distinct().Select(id => (id, 1m)))" Text="@L("Ценники")" />
        <LabelsButton Lines="@(_rows.Where(r => r.Quantity > 0).Select(r => (r.ItemId, r.Quantity)))" Text="@L("Этикетки по остатку")" />
    </form>

    <div class="scroll">
        <table>
            <thead><tr><th>@L("Склад")</th><th>@L("Код")</th><th>@L("Наименование")</th><th class="opt">@L("Тип")</th><th class="num">@L("Остаток")</th><th class="num opt" title="@L("Под подтверждённые заказы покупателей с галочкой «Резерв»")">@L("Резерв")</th><th class="num">@L("Доступно")</th><th>@L("Ед.")</th></tr></thead>
            <tbody>
                @if (_rows.Count == 0)
                {
                    <tr><td colspan="8" class="muted">@L("Остатков нет.")</td></tr>
                }
                @foreach (var r in _rows)
                {
                    <tr>
                        <td>@r.WarehouseName</td>
                        <td>@r.Code</td>
                        <td>@r.Name</td>
                        <td>@L(r.TypeName)</td>
                        <td class="num">@Quantities.Format(r.Quantity)</td>
                        <td class="num">@(r.Reserved > 0 ? Quantities.Format(r.Reserved) : "—")</td>
                        <td class="num @(r.Available < 0 ? "cell-short" : null)">@Quantities.Format(r.Available)</td>
                        <td>@r.UnitSymbol</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private IReadOnlyList<StockBalanceDto>? _rows;
    private IReadOnlyList<LookupWarehouseDto> _warehouses = [];
    private bool _busy;
    private string? _denied;
    private string _warehouse = string.Empty;
    private string _type = string.Empty;
    private string _search = string.Empty;

    /// <summary>Поиск из ссылки (быстрый поиск панели): /stock?search=ПР-1.</summary>
    [SupplyParameterFromQuery(Name = "search")]
    public string? SearchQuery { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _search = SearchQuery ?? _search;
        try
        {
            _warehouses = await Stock.ListWarehousesAsync();
            await LoadAsync();
        }
        catch (AccessDeniedException ex)
        {
            _denied = UiErrors.Message(ex);
        }
    }

    private string ExportHref => KnitErp.Web.Exports.ExportLink.Build("reports/stock.xlsx", ("warehouse", _warehouse), ("type", _type), ("search", _search));

    private async Task LoadAsync() =>
        _rows = await Stock.BalancesAsync(new StockFilter(
            long.TryParse(_warehouse, out var w) ? w : null,
            byte.TryParse(_type, out var t) ? (ItemType)t : null,
            _search));

    private async Task ReloadAsync()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        try
        {
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }
}
