@page "/catalog"
@using KnitErp.Application.Catalog
@using KnitErp.Domain.Catalog
@using KnitErp.Web.Components.Shared
@inject KnitErp.Application.Tagging.TagService TagLookup
@inject CatalogService Catalog
@inject ItemExchangeService Exchange
@inject VatRateService VatRates
@inject NomenclatureService Nomenclature
@inject CatalogSettingsService Settings
@inject GroupDefaultsService GroupDefaults
@inject BulkEditService Bulk
@inject PackService Packs
@inject NavigationManager Navigation
@inject CatalogViewService Views
@inject IJSRuntime JS

<PageTitle>@L("Номенклатура") — knitERP</PageTitle>

@if (_denied is not null)
{
    <AccessDenied Message="@_denied" />
}
else if (_loadError is not null)
{
    <LoadError Message="@_loadError" />
}
else if (_list is null)
{
    <p class="muted">@L("Загрузка…")</p>
}
else
{
    <div class="page-head">
        <h1>@L("Номенклатура")</h1>
        <div class="actions">
            <a class="button secondary" href="catalog/settings">@L("Группы, цены, доп. поля, справочники")</a>
            @if (CurrentAccess.Has(Permissions.PriceEdit) && CurrentAccess.Has(Permissions.PriceView))
            {
                <a class="button secondary" href="catalog/revaluation">@L("Массовая переоценка")</a>
            }
            @if (_list.CanEdit && _mode == Mode.None)
            {
                <button type="button" @onclick="OpenCreateAsync" disabled="@_busy">@L("Добавить позицию")</button>
            }
        </div>
    </div>

    @if (_flash is not null)
    {
        <div class="@(_flashIsError ? "flash error" : "flash")" role="@(_flashIsError ? "alert" : "status")"><span>@_flash@if (_created is { } created && !_flashIsError) { <text> </text><a href="catalog/items/@created.Id">@created.Name</a> }</span><button type="button" class="link" aria-label="@L("Закрыть сообщение")" @onclick="() => _flash = null">×</button></div>
    }

    @if (_archiveAsk is { } ask)
    {
        @* D343: позиция в учёте уходит в архив только после подтверждения, с перечнем последствий. *@
        <div class="notice warning archive-ask" role="alert">
            <p><strong>@L("Позиция «{0}» уже в учёте:", ask.Item.Name)</strong></p>
            <ul>
                @foreach (var w in ask.Warnings)
                {
                    <li>@KnitErp.Web.Localization.Text.Message(w)</li>
                }
            </ul>
            <div class="row-actions">
                <button type="button" class="danger" @onclick="() => ArchiveItemAsync(ask.Item, true)" disabled="@_busy">@L("Всё равно в архив")</button>
                <button type="button" class="secondary" @onclick="() => _archiveAsk = null" disabled="@_busy">@L("Отмена")</button>
            </div>
        </div>
    }

    @if (_mode is Mode.Create or Mode.Edit)
    {
        <div class="panel">
            <h2>@(_mode == Mode.Create ? L("Новая позиция") : L("Позиция {0}", _target!.Code))</h2>
            <EditForm Model="_form" OnValidSubmit="SaveItemAsync" FormName="item">
                <div class="grid">
                    @if (_mode == Mode.Create && _settings.NextCode is { } next)
                    {
                        <label>@L("Код (артикул)") <InputText @bind-Value="_form.Code" maxlength="40" placeholder="@L("авто: {0}", next)" /></label>
                    }
                    else
                    {
                        <label>@L("Код (артикул)") <InputText @bind-Value="_form.Code" maxlength="40" required /></label>
                    }
                    <label>@L("Наименование") <InputText @bind-Value="_form.Name" @bind-Value:after="CheckSimilarAsync" maxlength="300" required /></label>
                    @if (_mode == Mode.Create && _similar.Count > 0)
                    {
                        @* D320: подсказка о похожих позициях — не запрет. *@
                        <div class="hint warn" role="status" style="grid-column: 1 / -1">
                            @L("Похожие позиции уже есть:")
                            @foreach (var sim in _similar)
                            {
                                <a href="catalog/items/@sim.Id" target="_blank" rel="noopener">@sim.Code @sim.Name</a>@(" ")
                            }
                        </div>
                    }
                    <label>
                        @L("Тип")
                        <InputSelect @bind-Value="_form.Type" @bind-Value:after="TypeChanged">
                            @foreach (var t in ItemTypes.All.Where(t => _settings.IsEnabled(t) || t == _form.Type))
                            {
                                <option value="@t">@L(ItemTypes.Name(t))</option>
                            }
                        </InputSelect>
                    </label>
                    <label>
                        @L("Единица")
                        <InputSelect @bind-Value="_form.UnitId">
                            <option value="0">@L("— выберите —")</option>
                            @foreach (var u in _units.Where(u => !u.IsArchived))
                            {
                                <option value="@u.Id">@u.Name (@u.Symbol)</option>
                            }
                        </InputSelect>
                    </label>
                    <label>
                        @(_form.Type == ItemType.Service ? L("Ставка НДС (обязательна для услуги)") : _settings.RequireVat ? L("Ставка НДС (обязательна)") : L("Ставка НДС"))
                        <InputSelect @bind-Value="_form.VatRateId">
                            <option value="">@L("не указана")</option>
                            @foreach (var r in _vatRates)
                            {
                                <option value="@r.Id">@L(r.Name) — @L(r.CurrentText)</option>
                            }
                        </InputSelect>
                    </label>
                    <label>@L("Описание") <InputText @bind-Value="_form.Description" maxlength="1000" placeholder="@L("Состав, цвет, размер…")" /></label>
                    @if (_mode == Mode.Create && (_groups.Count > 0 || _settings.RequireGroup))
                    {
                        <label>
                            @(_settings.RequireGroup ? L("Группа (обязательна)") : L("Группа"))
                            <InputSelect @bind-Value="_form.GroupId" @bind-Value:after="ApplyGroupDefaultsAsync">
                                <option value="">@L("без группы")</option>
                                @foreach (var g in _groups)
                                {
                                    <option value="@g.Id">@g.Path</option>
                                }
                            </InputSelect>
                        </label>
                    }
                </div>
                @if (_formError is not null)
                {
                    <div class="error" role="alert">@_formError</div>
                }
                <div class="actions">
                    <button type="submit" disabled="@_busy">@L("Сохранить")</button>
                    <button type="button" class="secondary" @onclick="Close" disabled="@_busy">@L("Отмена")</button>
                </div>
            </EditForm>
        </div>
    }

    <div class="actions" style="margin-bottom: 12px">
        <button type="button" class="secondary" @onclick="() => _showExchange = !_showExchange" aria-expanded="@(_showExchange ? "true" : "false")">
            @L("Excel: выгрузка и загрузка") @(_showExchange ? "▲" : "▼")
        </button>
    </div>
    @if (_showExchange)
    {
    <div class="panel exchange">
        <div class="actions">
            <a class="button secondary" href="catalog/items.xlsx" download data-enhance-nav="false">@L("Выгрузить номенклатуру")</a>
            @if (CurrentAccess.Has(Permissions.CatalogImport))
            {
                <a class="button secondary" href="catalog/items-template.xlsx" download data-enhance-nav="false">@L("Скачать шаблон")</a>
            }
        </div>
        @if (CurrentAccess.Has(Permissions.CatalogImport))
        {
            <p class="muted">
                @L("Загрузка создаёт новые позиции и обновляет существующие по коду.")
                @L("Сначала файл проверяется целиком; если в нём есть ошибки, не загружается ничего.")
                @L("До {0} строк, файл до 5 МБ.", ItemExchangeService.MaxRows)
            </p>
            <label>@L("Файл .xlsx") <InputFile OnChange="PreviewImportAsync" accept=".xlsx" disabled="@_busy" /></label>
        }

        @if (_plan is not null)
        {
            <div class="totals" role="status">
                <span>@L("Строк:") <b>@_plan.Total</b></span>
                <span>@L("Создать:") <b>@_plan.ToCreate</b></span>
                <span>@L("Обновить:") <b>@_plan.ToUpdate</b></span>
                <span>@L("Без изменений:") <b>@_plan.Unchanged</b></span>
                <span class="@(_plan.ErrorRows > 0 ? "bad" : null)">@L("С ошибками:") <b>@_plan.ErrorRows</b></span>
            </div>
            @if (_plan.ErrorRows > 0)
            {
                <div class="error" role="alert">@L("В файле есть ошибки — ничего не будет загружено. Исправьте строки ниже и загрузите файл снова.")</div>
            }
            <div class="scroll" style="max-height: 360px; overflow-y: auto">
                <table>
                    <thead><tr><th>@L("Строка")</th><th>@L("Код")</th><th>@L("Наименование")</th><th>@L("Действие")</th><th>@L("Ошибки")</th></tr></thead>
                    <tbody>
                        @foreach (var r in _plan.Rows.OrderBy(r => r.Action == ImportAction.Error ? 0 : 1).ThenBy(r => r.RowNumber).Take(500))
                        {
                            <tr>
                                <td>@r.RowNumber</td>
                                <td>@r.Code</td>
                                <td>@r.Name</td>
                                <td><span class="tag @ActionClass(r.Action)">@ActionText(r.Action)</span></td>
                                <td>@string.Join(" ", r.Errors)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (_plan.Bundles.Count > 0)
            {
                <h3>@L("Состав комплектов")</h3>
                <div class="scroll" style="max-height: 240px; overflow-y: auto">
                    <table>
                        <thead><tr><th>@L("Строка")</th><th>@L("Комплект")</th><th>@L("Компонент")</th><th class="num">@L("Количество")</th><th>@L("Ошибки")</th></tr></thead>
                        <tbody>
                            @foreach (var b in _plan.Bundles.OrderBy(b => b.Errors.Count == 0).ThenBy(b => b.RowNumber).Take(500))
                            {
                                <tr>
                                    <td>@b.RowNumber</td><td>@b.BundleCode</td><td>@b.ComponentCode</td><td class="num">@b.QuantityText</td>
                                    <td>@if (b.Errors.Count > 0) { <span class="tag bad">@string.Join(" ", b.Errors)</span> }</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            <div class="actions">
                @if (_plan.CanApply)
                {
                    <button type="button" @onclick="ApplyImportAsync" disabled="@_busy">@L("Загрузить: создать {0}, обновить {1}", _plan.ToCreate, _plan.ToUpdate)</button>
                }
                <button type="button" class="secondary" @onclick="() => _plan = null" disabled="@_busy">@L("Закрыть протокол")</button>
            </div>
        }
    </div>
    }

    <div class="catalog-layout">
    <nav class="group-tree" aria-label="@L("Группы номенклатуры")">
        <button type="button" class="@(_groupId is null ? "link active" : "link")" @onclick="() => SelectGroupAsync(null)">@L("Все позиции")</button>
        @foreach (var g in _groups)
        {
            var group = g;
            <button type="button" class="@(_groupId == g.Id ? "link active" : "link")" style="padding-left: @(8 + g.Depth * 14)px"
                    @onclick="() => SelectGroupAsync(group.Id)">📁 @g.Name <span class="muted">@(g.Items > 0 ? g.Items.ToString() : "")</span></button>
        }
        @if (_groups.Count > 0)
        {
            <button type="button" class="@(_groupId == 0 ? "link active" : "link")" @onclick="() => SelectGroupAsync(0)">@L("Без группы")</button>
        }
    </nav>
    <div>
    <form data-autosubmit class="inline-form" @onsubmit="SearchAsync">
        <TagFilter Value="_tagId" ValueChanged="TagChangedAsync" />
        <label>
            @L("Вид")
            <select @bind="_kindFilter">
                <option value="">@L("Все виды")</option>
                <option value="@((byte)ItemKind.Goods)">@L("Товары")</option>
                @if (_settings.ServicesEnabled)
                {
                    <option value="@((byte)ItemKind.Service)">@L("Услуги")</option>
                }
                @if (_settings.BundlesEnabled)
                {
                    <option value="@((byte)ItemKind.Bundle)">@L("Комплекты")</option>
                }
            </select>
        </label>
        <label>
            @L("Тип")
            <select @bind="_typeFilter">
                <option value="">@L("Все типы")</option>
                @foreach (var t in ItemTypes.All.Where(t => _settings.IsEnabled(t) || _typeFilter == ((byte)t).ToString()))
                {
                    <option value="@((byte)t)">@L(ItemTypes.Name(t))</option>
                }
            </select>
        </label>
        <label>@L("Поиск") <input @bind="_search" placeholder="@L("Код, наименование, артикул или штрихкод")" /></label>
        <label class="inline"><input type="checkbox" @bind="_includeArchived" /> @L("Показать архив")</label>
        <button type="submit" class="filter-apply secondary" disabled="@_busy">@L("Найти")</button>
    </form>

    @if (_selected.Count > 0 || _allByFilter)
    {
        @* D318: массовое изменение и этикетки для выбранных позиций. *@
        <div class="panel bulk-bar">
            <div class="actions">
                <b>@(_allByFilter ? L("Выбраны все по отбору: {0}", _list.Total) : L("Выбрано: {0}", _selected.Count))</b>
                @if (!_allByFilter && _list.Total > _selected.Count)
                {
                    <button type="button" class="link" @onclick="SelectAllByFilterAsync">@L("Выбрать все по отбору ({0})", _list.Total)</button>
                }
                <button type="button" class="link" @onclick="ClearSelection">@L("Снять выбор")</button>
                <a class="button secondary" href="@SelectedLabelsLink" target="_blank" rel="noopener">@L("Этикетки для выбранных")</a>
                @if (_allByFilter && _list.Total > LabelService.MaxItems)
                {
                    <span class="muted small">@L("Этикетки — для первых {0} позиций отбора.", LabelService.MaxItems)</span>
                }
                @if (_list.CanEdit)
                {
                    <button type="button" class="secondary" @onclick="() => _bulkOpen = !_bulkOpen">@L("Изменить выбранные")</button>
                }
            </div>
            @if (_bulkOpen && _list.CanEdit)
            {
                <p class="muted small">@L("Отметьте поля, которые нужно изменить; остальные не меняются. Пустое значение при отметке — очистить поле.")</p>
                <div class="grid">
                    <label class="check"><input type="checkbox" @bind="_bulk.SetGroup" /> @L("Группа")</label>
                    <select @bind="_bulkGroup" disabled="@(!_bulk.SetGroup)" aria-label="@L("Группа")">
                        <option value="">@L("без группы")</option>
                        @foreach (var g in _groups)
                        {
                            <option value="@g.Id">@g.Path</option>
                        }
                    </select>
                    <label class="check"><input type="checkbox" @bind="_bulk.SetVat" /> @L("Ставка НДС")</label>
                    <select @bind="_bulkVat" disabled="@(!_bulk.SetVat)" aria-label="@L("Ставка НДС")">
                        <option value="">@L("не указана")</option>
                        @foreach (var r in _vatRates)
                        {
                            <option value="@r.Id">@L(r.Name)</option>
                        }
                    </select>
                    <label class="check"><input type="checkbox" @bind="_bulk.SetTnVed" /> @L("Код ТН ВЭД")</label>
                    <input @bind="_bulk.TnVedCode" disabled="@(!_bulk.SetTnVed)" maxlength="10" inputmode="numeric" aria-label="@L("Код ТН ВЭД")" />
                    <label class="check"><input type="checkbox" @bind="_bulk.SetCountry" /> @L("Страна (код ОКСМ)")</label>
                    <div class="inline-form" style="margin: 0">
                        <input @bind="_bulk.CountryCode" disabled="@(!_bulk.SetCountry)" maxlength="3" inputmode="numeric" placeholder="643" aria-label="@L("Страна (код ОКСМ)")" style="width: 5em" />
                        <input @bind="_bulk.CountryName" disabled="@(!_bulk.SetCountry)" maxlength="100" placeholder="@L("Россия")" aria-label="@L("Страна — краткое наименование")" />
                    </div>
                    <label class="check"><input type="checkbox" @bind="_bulk.SetTracking" /> @L("Маркировка")</label>
                    <select @bind="_bulk.Tracking" disabled="@(!_bulk.SetTracking)" aria-label="@L("Маркировка")">
                        @foreach (var m in Marking.All)
                        {
                            <option value="@m">@(m == TrackingType.None ? L("без маркировки") : L(Marking.Name(m)))</option>
                        }
                    </select>
                </div>
                <div class="actions">
                    <ConfirmButton Disabled="@(_busy || !_bulk.Any)" Title="@((!_bulk.Any) ? L("Отметьте, что изменить") : null)" Question="@L("Изменить выбранные позиции? Изменения запишутся в журнал по каждой позиции.")"
                                   OnConfirm="ApplyBulkAsync">@L("Применить")</ConfirmButton>
                </div>
            }
            @if (_bulkResult is { } br)
            {
                <p role="status">@L("Изменено: {0}, без изменений: {1}, пропущено: {2}.", br.Changed, br.Unchanged, br.Skipped.Count)</p>
                @if (br.Skipped.Count > 0)
                {
                    <details>
                        <summary>@L("Пропущенные позиции")</summary>
                        <ul class="small">
                            @foreach (var sk in br.Skipped)
                            {
                                <li>@sk.Code @sk.Name — @SkipReason(sk.Reason)</li>
                            }
                        </ul>
                    </details>
                }
            }
        </div>
    }

    @* D338: какие столбцы видны — личная настройка, сохраняется. *@
    <details class="columns-menu">
        <summary>@L("Столбцы")</summary>
        <div class="panel">
            @foreach (var (key, title) in Columns)
            {
                var k = key;
                <label class="check"><input type="checkbox" checked="@V.Shows(k)" @onchange="e => ToggleColumnAsync(k, e)" disabled="@_busy" /> @title</label>
            }
            <button type="button" class="link" @onclick="ResetViewAsync" disabled="@_busy">@L("Вид по умолчанию")</button>
        </div>
    </details>
    <div class="scroll">
        <table>
            <thead>
                <tr>
                    <th class="select-col"><input type="checkbox" checked="@PageSelected" @onchange="TogglePage" aria-label="@L("Выбрать все на странице")" /></th>
                    @* D338: сортировка по столбцу — на сервере; повторный щелчок меняет направление, третий — вид по умолчанию. *@
                    <th aria-sort="@AriaSort(ItemSort.Code)"><button type="button" class="th-sort" @onclick="() => SortByAsync(ItemSort.Code)" disabled="@_busy">@L("Код")@SortMark(ItemSort.Code)</button></th>
                    <th aria-sort="@AriaSort(ItemSort.Name)"><button type="button" class="th-sort" @onclick="() => SortByAsync(ItemSort.Name)" disabled="@_busy">@L("Наименование")@SortMark(ItemSort.Name)</button></th>
                    @if (V.Shows("article"))
                    {
                        <th class="opt" aria-sort="@AriaSort(ItemSort.Article)"><button type="button" class="th-sort" @onclick="() => SortByAsync(ItemSort.Article)" disabled="@_busy">@L("Артикул")@SortMark(ItemSort.Article)</button></th>
                    }
                    @if (V.Shows("type")) { <th class="opt">@L("Тип")</th> }
                    @if (V.Shows("unit")) { <th>@L("Ед.")</th> }
                    @if (V.Shows("vat")) { <th class="opt">@L("НДС")</th> }
                    @if (CurrentAccess.Has(Permissions.PriceView) && V.Shows("price"))
                    {
                        <th class="num">@L("Цена продажи")</th>
                    }
                    @if (_list.CanEdit || _list.CanArchive)
                    {
                        <th>@L("Действия")</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (_list.Items.Count == 0)
                {
                    <EmptyRow Colspan="10" Text="@L("Позиций пока нет.")" Hint="@L("Номенклатура — всё, что вы покупаете, производите и продаёте: товары, материалы, полуфабрикаты, услуги.")"
                              Filtered="@(_search != "" || _kindFilter != "" || _typeFilter != "" || _tagId is not null)"
                              CreateHref="@(_list.CanEdit ? "catalog?new=1" : null)" CreateText="@L("Добавить позицию")" />
                }
                @foreach (var i in _list.Items)
                {
                    <tr class="@(i.IsArchived ? "archived" : null)">
                        <td class="select-col"><input type="checkbox" checked="@(_allByFilter || _selected.Contains(i.Id))" @onchange="e => ToggleOne(i.Id, e)" aria-label="@L("Выбрать позицию")" /></td>
                        <td>@i.Code</td>
                        <td>@if (i.PhotoId is { } photo) { <img class="item-thumb" src="catalog/photos/@photo" alt="" loading="lazy" /> }@if (i.ParentItemId is not null) { <span class="variant-of" title="@L("Модификация")">↳ </span> }<a href="catalog/items/@i.Id">@i.Name</a><TagDots Tags="@_tagMap.GetValueOrDefault(i.Id)" /> @if (i.Modifications > 0) { <span class="tag">@L("модификаций: {0}", i.Modifications)</span> } @if (i.IsArchived) { <span class="tag">@L("архив")</span> }@if (i.Description is not null) { <div class="muted">@i.Description</div> }</td>
                        @if (V.Shows("article")) { <td>@(i.Article ?? "—")</td> }
                        @if (V.Shows("type")) { <td>@L(i.TypeName)</td> }
                        @if (V.Shows("unit")) { <td>@i.UnitSymbol</td> }
                        @if (V.Shows("vat")) { <td>@(i.VatRateName is { } vat ? L(vat) : "—")</td> }
                        @if (CurrentAccess.Has(Permissions.PriceView) && V.Shows("price"))
                        {
                            <td class="num">@(i.SalePrice is { } sp ? Amounts.Format(sp) : "—")</td>
                        }
                        @if (_list.CanEdit || _list.CanArchive)
                        {
                            <td>
                                <div class="row-actions">
                                    @if (!i.IsArchived && _list.CanEdit)
                                    {
                                        <button type="button" class="secondary" @onclick="() => OpenEdit(i)" disabled="@(_busy || _mode != Mode.None)" title="@((_mode != Mode.None) ? L("Сначала сохраните или закройте открытую форму") : null)">@L("Изменить")</button>
                                    }
                                    @if (_list.CanArchive)
                                    {
                                        @if (i.IsArchived)
                                        {
                                            <button type="button" class="secondary" @onclick="() => RestoreItemAsync(i)" disabled="@_busy">@L("Вернуть")</button>
                                        }
                                        else
                                        {
                                            <ConfirmButton Class="secondary" OnConfirm="() => ArchiveItemAsync(i)" Disabled="@(_busy || _mode != Mode.None)" Title="@((_mode != Mode.None) ? L("Сначала сохраните или закройте открытую форму") : null)" Question='@L("Отправить в архив?")'>@L("В архив")</ConfirmButton>
                                        }
                                    }
                                </div>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (_list.Items.Count > 0)
    {
        @* D316: этикетки для позиций текущей страницы (с учётом отбора). *@
        <div class="actions" style="margin-top: 8px">
            <a class="button secondary" href="@LabelsLink" target="_blank" rel="noopener">@L("Этикетки для позиций на странице")</a>
            <a href="catalog/labels">@L("Конструктор этикеток")</a>
        </div>
    }
    @if (_list.Total > PageSize)
    {
        @* Серверные страницы (сессия 4): список на десятки тысяч позиций читается по PageSize строк. *@
        <nav class="pager" aria-label="@L("Страницы списка")">
            <button type="button" class="secondary" @onclick="() => GoToPageAsync(_page - 1)" disabled="@(_busy || _page == 0)">@L("← Назад")</button>
            <span>@L("Позиции {0}–{1} из {2}", _page * PageSize + 1, _page * PageSize + _list.Items.Count, _list.Total)</span>
            <button type="button" class="secondary" @onclick="() => GoToPageAsync(_page + 1)" disabled="@(_busy || (_page + 1) * PageSize >= _list.Total)">@L("Далее →")</button>
        </nav>
    }
    </div>
    </div>

}

@code {

    /// <summary>D108: «?new=…» с главного экрана — сразу открыть форму создания.</summary>
    [SupplyParameterFromQuery(Name = "new")]
    public string? NewQuery { get; set; }

    // D104: отбор по тегу и цветные точки тегов у строк.
    private long? _tagId;
    private IReadOnlyDictionary<long, IReadOnlyList<KnitErp.Application.Tagging.TagDto>> _tagMap = new Dictionary<long, IReadOnlyList<KnitErp.Application.Tagging.TagDto>>();

    private Task TagChangedAsync(long? tagId)
    {
        _tagId = tagId;
        return ReloadAsync();
    }

    private async Task LoadTagsAsync() => _tagMap = await TagLookup.MapAsync(KnitErp.Domain.Tagging.TaggedEntity.Item, _list!.Items.Select(r => r.Id).ToList());

    private enum Mode { None, Create, Edit }

    private ItemListDto? _list;
    private (long Id, string Name)? _created;
    private CatalogSettingsDto _settings = new(true, true, null, 5, 1, ItemType.Finished, null, false, []);
    private IReadOnlyList<UnitDto> _units = [];
    private IReadOnlyList<VatRateDto> _vatRates = [];
    private ItemForm _form = new();
    private ItemDto? _target;
    private Mode _mode;
    private bool _busy;
    private string? _loadError;
    private string? _denied;
    private string? _formError;
    private string? _flash;
    private ItemImportPlan? _plan;
    private bool _showExchange;

    [CascadingParameter]
    public CurrentAccessDto CurrentAccess { get; set; } = default!;
    private bool _flashIsError;
    private string _typeFilter = string.Empty;
    private string _kindFilter = string.Empty;
    private string _search = string.Empty;
    private bool _includeArchived;
    private long? _groupId;
    private IReadOnlyList<ItemGroupDto> _groups = [];

    /// <summary>Поиск из ссылки (быстрый поиск панели): /stock?search=ПР-1.</summary>
    [SupplyParameterFromQuery(Name = "search")]
    public string? SearchQuery { get; set; }

    /// <summary>D817: остальной фильтр — тоже в адресе (пишется после применения), «Назад» открывает тот же отбор.</summary>
    [SupplyParameterFromQuery(Name = "kind")]
    public string? KindQuery { get; set; }

    [SupplyParameterFromQuery(Name = "type")]
    public string? TypeQuery { get; set; }

    [SupplyParameterFromQuery(Name = "archived")]
    public string? ArchivedQuery { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _search = SearchQuery ?? _search;
        _kindFilter = KindQuery ?? string.Empty;
        _typeFilter = TypeQuery ?? string.Empty;
        _includeArchived = ArchivedQuery == "1";
        try
        {
            await LoadAsync();
            if (NewQuery == "1")
            {
                OpenCreate();
            }
        }
        catch (AccessDeniedException ex)
        {
            _denied = UiErrors.Message(ex);
        }
        catch (Exception ex) when (UiErrors.IsUserFacing(ex))
        {
            _loadError = UiErrors.Message(ex);
        }
    }

    private async Task LoadAsync()
    {
        ItemType? type = byte.TryParse(_typeFilter, out var t) ? (ItemType)t : null;
        ItemKind? kind = byte.TryParse(_kindFilter, out var k) ? (ItemKind)k : null;
        _view ??= await Views.GetAsync(); // D338: личный вид списка — один раз при открытии
        _list = await Catalog.ListItemsAsync(new ItemFilter(type, _search, _includeArchived, PageSize, _groupId, _tagId, kind, _page * PageSize, _view.Sort, _view.Descending));
        if (_list.Items.Count == 0 && _page > 0)
        {
            // Последнюю страницу опустошили (архив, смена отбора) — на последнюю непустую.
            _page = Math.Max(0, (_list.Total - 1) / PageSize);
            _list = await Catalog.ListItemsAsync(new ItemFilter(type, _search, _includeArchived, PageSize, _groupId, _tagId, kind, _page * PageSize, _view.Sort, _view.Descending));
        }

        await LoadTagsAsync();
        _groups = await Nomenclature.GroupsAsync();
        _units = await Catalog.ListUnitsAsync(_includeArchived);
        _vatRates = await VatRates.ActiveAsync();
        _settings = await Settings.GetAsync();
    }

    private const int PageSize = 100;

    // D318: выбор позиций и массовое изменение.
    private readonly HashSet<long> _selected = [];
    private bool _allByFilter;
    private bool _bulkOpen;
    private BulkForm _bulk = new();
    private string _bulkGroup = string.Empty;
    private string _bulkVat = string.Empty;
    private BulkEditResult? _bulkResult;

    private sealed class BulkForm
    {
        public bool SetGroup { get; set; }
        public bool SetVat { get; set; }
        public bool SetTnVed { get; set; }
        public string? TnVedCode { get; set; }
        public bool SetCountry { get; set; }
        public string? CountryCode { get; set; }
        public string? CountryName { get; set; }
        public bool SetTracking { get; set; }
        public TrackingType Tracking { get; set; } = TrackingType.None;
        public bool Any => SetGroup || SetVat || SetTnVed || SetCountry || SetTracking;
    }

    private bool PageSelected => _list is { Items.Count: > 0 } l && (_allByFilter || l.Items.All(i => _selected.Contains(i.Id)));

    private void TogglePage(ChangeEventArgs e)
    {
        _allByFilter = false;
        foreach (var i in _list!.Items)
        {
            if (e.Value is true) { _selected.Add(i.Id); } else { _selected.Remove(i.Id); }
        }
    }

    private void ToggleOne(long id, ChangeEventArgs e)
    {
        if (_allByFilter)
        {
            // Из «всех по отбору» в явный выбор страницы без снятой позиции.
            _allByFilter = false;
            _selected.UnionWith(_list!.Items.Select(i => i.Id));
        }

        if (e.Value is true) { _selected.Add(id); } else { _selected.Remove(id); }
    }

    private string SkipReason(string reason) => reason switch
    {
        "в архиве" => L("в архиве"),
        "ставка НДС обязательна" => L("ставка НДС обязательна"),
        "услугу и комплект не маркируют" => L("услугу и комплект не маркируют"),
        "модификация в группе основной позиции" => L("модификация в группе основной позиции"),
        "не найдена" => L("не найдена"),
        _ => reason,
    };

    private void ClearSelection()
    {
        _selected.Clear();
        _allByFilter = false;
        _bulkOpen = false;
        _bulkResult = null;
    }

    // Ревью: «все по отбору» — этикетки для всех позиций отбора (до LabelService.MaxItems), а не только для текущей страницы.
    private string SelectedLabelsLink => "catalog/labels/print?ids=" + string.Join(",", (_allByFilter ? _allIds : (IEnumerable<long>)_selected).Take(LabelService.MaxItems));

    private IReadOnlyList<long> _allIds = [];

    private Task SelectAllByFilterAsync() => RunAsync(async () =>
    {
        _allIds = await Catalog.ListIdsAsync(CurrentFilter(), LabelService.MaxItems);
        _allByFilter = true;
    }, null);

    private CatalogViewDto? _view;

    private CatalogViewDto V => _view ?? new CatalogViewDto();

    private (string Key, string Title)[] Columns =>
    [
        ("article", L("Артикул")), ("type", L("Тип")), ("unit", L("Ед.")), ("vat", L("НДС")),
        .. CurrentAccess.Has(Permissions.PriceView) ? new[] { ("price", L("Цена продажи")) } : [],
    ];

    private string AriaSort(ItemSort sort) => V.Sort != sort ? "none" : V.Descending ? "descending" : "ascending";

    private string SortMark(ItemSort sort) => V.Sort != sort ? "" : V.Descending ? " ↓" : " ↑";

    /// <summary>По возрастанию → по убыванию → вид по умолчанию (тип, наименование).</summary>
    private Task SortByAsync(ItemSort sort)
    {
        var v = V;
        _view = v.Sort != sort ? v with { Sort = sort, Descending = false }
            : !v.Descending ? v with { Descending = true }
            : v with { Sort = ItemSort.Default, Descending = false };
        _page = 0;
        return RunAsync(async () => _view = await Views.SaveAsync(_view), null);
    }

    private Task ToggleColumnAsync(string column, ChangeEventArgs e)
    {
        var hidden = (V.Hidden ?? []).Where(h => h != column).ToList();
        if (e.Value is not true)
        {
            hidden.Add(column);
        }

        _view = V with { Hidden = hidden };
        return RunAsync(async () => _view = await Views.SaveAsync(_view), null);
    }

    private Task ResetViewAsync()
    {
        _view = new CatalogViewDto();
        _page = 0;
        return RunAsync(async () => _view = await Views.SaveAsync(_view), null);
    }

    private ItemFilter CurrentFilter(int take = 500, int skip = 0)
    {
        ItemType? type = byte.TryParse(_typeFilter, out var t) ? (ItemType)t : null;
        ItemKind? kind = byte.TryParse(_kindFilter, out var k) ? (ItemKind)k : null;
        return new ItemFilter(type, _search, _includeArchived, take, _groupId, _tagId, kind, skip, _view?.Sort ?? ItemSort.Default, _view?.Descending ?? false);
    }

    private Task ApplyBulkAsync() => RunAsync(async () =>
    {
        var ids = _allByFilter ? await Catalog.ListIdsAsync(CurrentFilter(), BulkEditService.MaxItems) : _selected.ToList();
        _bulkResult = await Bulk.ApplyAsync(ids, new BulkItemChanges(
            _bulk.SetGroup, long.TryParse(_bulkGroup, out var g) ? g : null, _bulk.SetVat, long.TryParse(_bulkVat, out var v) ? v : null,
            _bulk.SetTnVed, _bulk.TnVedCode, _bulk.SetCountry, _bulk.CountryCode, _bulk.CountryName, _bulk.SetTracking, _bulk.Tracking));
    }, L("Массовое изменение выполнено."));

    private string LabelsLink => "catalog/labels/print?ids=" + string.Join(",", _list!.Items.Where(i => !i.IsArchived).Select(i => i.Id));
    private int _page;

    /// <summary>Новый отбор — с первой страницы.</summary>
    private IReadOnlyList<ItemDto> _similar = [];

    /// <summary>D320: при вводе наименования новой позиции — подсказка о похожих.</summary>
    private Task CheckSimilarAsync() => Background(async () =>
    {
        if (_mode == Mode.Create)
        {
            _similar = await Catalog.SimilarAsync(_form.Name);
        }
    });

    /// <summary>
    /// Фоновая подсказка формы (похожие, значения группы): не блокирует кнопки, но идёт строго после предыдущей — у вкладки один DbContext.
    /// Действия (RunAsync) сначала дожидаются фоновых: быстрый клик «Сохранить» сразу после ввода не теряется.
    /// </summary>
    private Task _background = Task.CompletedTask;

    private Task Background(Func<Task> work)
    {
        var previous = _background;
        _background = Chain();
        return _background;

        async Task Chain()
        {
            try
            {
                await previous;
            }
            catch
            {
                // Ошибку предыдущей подсказки уже получил её вызов; цепочка дальше не блокируется.
            }

            try
            {
                await work();
            }
            catch (Exception ex) when (UiErrors.IsUserFacing(ex))
            {
                _formError = UiErrors.Message(ex);
            }
        }
    }

    /// <summary>
    /// D320: поиск. Отсканированный штрихкод позиции или упаковки (только цифры, 8–14 знаков, или точное совпадение) сразу открывает карточку.
    /// </summary>
    private async Task SearchAsync()
    {
        try
        {
            await _background;
        }
        catch
        {
            // см. RunAsync
        }

        var text = _search.Trim();
        if (text.Length is >= 8 and <= 14 && text.All(char.IsAsciiDigit) && !_busy)
        {
            _busy = true;
            ScanResultDto? hit;
            try
            {
                hit = await Packs.ScanAsync(text);
            }
            finally
            {
                _busy = false;
            }

            if (hit is not null)
            {
                Navigation.NavigateTo($"catalog/items/{hit.ItemId}");
                return;
            }
        }

        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _page = 0;
        ClearSelection(); // новый отбор — выбор сбрасывается, чтобы изменение не ушло на невидимые позиции
        await RunAsync(() => Task.CompletedTask, null);
        await JS.InvokeVoidAsync("kniterp.setQuery", new Dictionary<string, string?>
        {
            ["search"] = _search, ["kind"] = _kindFilter, ["type"] = _typeFilter,
            ["archived"] = _includeArchived ? "1" : null, ["new"] = null,
        });
    }

    private Task GoToPageAsync(int page)
    {
        _page = Math.Max(0, page);
        return RunAsync(() => Task.CompletedTask, null);
    }

    /// <summary>Группа слева — фильтр списка (с подгруппами); null — все, 0 — без группы.</summary>
    private Task SelectGroupAsync(long? groupId)
    {
        _groupId = groupId;
        return ReloadAsync();
    }

    /// <summary>D317: выбрана группа — тип, единица и ставка НДС новой позиции берутся из значений по умолчанию группы.</summary>
    private Task ApplyGroupDefaultsAsync() => Background(ApplyGroupDefaultsCoreAsync);

    private async Task ApplyGroupDefaultsCoreAsync()
    {
        if (_mode != Mode.Create || _form.GroupId is not { } gid)
        {
            return;
        }

        try
        {
            var d = (await GroupDefaults.GetAsync(gid)).Effective;
            if (d.Type is { } t && _settings.IsEnabled(t))
            {
                _form.Type = t;
                TypeChanged();
            }

            _form.UnitId = d.UnitId ?? _form.UnitId;
            _form.VatRateId = d.VatRateId ?? _form.VatRateId;
        }
        catch (Exception ex) when (UiErrors.IsUserFacing(ex))
        {
            _formError = UiErrors.Message(ex);
        }
    }

    /// <summary>Новая позиция в выбранной слева группе — сразу со значениями по умолчанию этой группы (D317).</summary>
    private async Task OpenCreateAsync()
    {
        OpenCreate();
        await ApplyGroupDefaultsAsync();
    }

    private void OpenCreate()
    {
        _similar = [];
        _flash = null;
        _flashIsError = false;
        _formError = null;
        _target = null;
        _form = new ItemForm
        {
            UnitId = _units.FirstOrDefault(u => u.Code == "796")?.Id ?? 0,
            VatRateId = _vatRates.FirstOrDefault(r => r.Kind == KnitErp.Domain.Catalog.VatRateKind.Standard)?.Id,
            GroupId = _groupId is > 0 ? _groupId : null,
            Type = _settings.DefaultItemType,
        };
        TypeChanged();
        _mode = Mode.Create;
    }

    /// <summary>D300: у новой услуги единица по умолчанию — «усл. ед» (ОКЕИ 876), если единица не выбрана вручную.</summary>
    private void TypeChanged()
    {
        if (_mode != Mode.Create)
        {
            return;
        }

        var piece = _units.FirstOrDefault(u => u.Code == "796")?.Id;
        var service = _units.FirstOrDefault(u => u.Code == ServiceRules.ServiceUnitCode)?.Id;
        if (_form.Type == ItemType.Service && service is { } s && (_form.UnitId == 0 || _form.UnitId == piece))
        {
            _form.UnitId = s;
        }
        else if (_form.Type != ItemType.Service && piece is { } p && _form.UnitId == service)
        {
            _form.UnitId = p;
        }
    }

    private void OpenEdit(ItemDto i)
    {
        _flash = null;
        _flashIsError = false;
        _formError = null;
        _target = i;
        _form = new ItemForm { Code = i.Code, Name = i.Name, Type = i.Type, UnitId = i.UnitId, Description = i.Description, VatRateId = i.VatRateId };
        _mode = Mode.Edit;
    }

    private void Close()
    {
        _mode = Mode.None;
        _target = null;
        _formError = null;
    }

    private Task SaveItemAsync() => RunAsync(async () =>
    {
        var cmd = new ItemCommand(_form.Code, _form.Name, _form.Type, _form.UnitId, _form.Description, _form.VatRateId, _form.GroupId);
        if (_mode == Mode.Create)
        {
            // Список листается страницами — новая позиция может быть не на текущей: ссылка на неё — в сообщении.
            _created = (await Catalog.CreateItemAsync(cmd), _form.Name);
        }
        else
        {
            await Catalog.UpdateItemAsync(_target!.Id, cmd, _target.RowVersion);
        }

        Close();
    }, L("Позиция сохранена."));

    private (ItemDto Item, IReadOnlyList<string> Warnings)? _archiveAsk;

    /// <summary>D343: сначала без подтверждения — сервис вернёт предупреждения, если позиция в учёте; тогда спрашиваем.</summary>
    private async Task ArchiveItemAsync(ItemDto i, bool confirmed = false)
    {
        _archiveAsk = null;
        IReadOnlyList<string>? warnings = null;
        await RunAsync(async () => warnings = await Catalog.ArchiveItemAsync(i.Id, i.RowVersion, confirmed), null);
        if (warnings is null)
        {
            return; // ошибка уже показана
        }

        if (warnings.Count > 0)
        {
            _archiveAsk = (i, warnings);
        }
        else
        {
            _flash = L("Позиция «{0}» в архиве.", i.Name);
        }
    }

    private Task RestoreItemAsync(ItemDto i) =>
        RunAsync(() => Catalog.RestoreItemAsync(i.Id, i.RowVersion), L("Позиция «{0}» возвращена из архива.", i.Name));


    /// <summary>Файл читается в память целиком (до 5 МБ) и проверяется; в базе ничего не меняется.</summary>
    private Task PreviewImportAsync(InputFileChangeEventArgs e) => RunAsync(async () =>
    {
        _plan = null;
        const long maxSize = 5 * 1024 * 1024;
        if (e.File.Size > maxSize)
        {
            throw new BusinessRuleException("import.file_too_large", L("Файл больше 5 МБ. Разбейте его на части."));
        }

        await using var upload = e.File.OpenReadStream(maxAllowedSize: maxSize);
        using var buffer = new MemoryStream();
        await upload.CopyToAsync(buffer);
        buffer.Position = 0;
        _plan = await Exchange.PreviewAsync(buffer);
    }, null);

    private Task ApplyImportAsync() => RunAsync(async () =>
    {
        var result = await Exchange.ApplyAsync(_plan!.Rows, _plan.Bundles);
        _plan = null;
        _flash = result.Bundles > 0
            ? L("Загружено: создано {0}, обновлено {1}, составов комплектов {2}.", result.Created, result.Updated, result.Bundles)
            : L("Загружено: создано {0}, обновлено {1}.", result.Created, result.Updated);
    }, null);

    private static string ActionText(ImportAction a) => a switch
    {
        ImportAction.Create => L("создать"),
        ImportAction.Update => L("обновить"),
        ImportAction.Unchanged => L("без изменений"),
        _ => L("ошибка"),
    };

    private static string? ActionClass(ImportAction a) => a switch
    {
        ImportAction.Create or ImportAction.Update => "ok",
        ImportAction.Error => "bad",
        _ => null,
    };

    /// <summary>Одна операция за раз, затем свежие данные: у вкладки один DbContext.</summary>
    private async Task RunAsync(Func<Task> action, string? success)
    {
        try
        {
            await _background; // подсказки формы — до действия, не одновременно с ним
        }
        catch
        {
            // ошибка подсказки показана при её вызове; действие выполняется
        }

        if (_busy)
        {
            return;
        }

        _busy = true;
        _flash = null;
        _flashIsError = false;
        _formError = null;
        _created = null;
        try
        {
            await action();
            _flash = success ?? _flash;
        }
        catch (Exception ex) when (UiErrors.IsUserFacing(ex))
        {
            if (_mode == Mode.None)
            {
                _flash = UiErrors.Message(ex);
                _flashIsError = true;
            }
            else
            {
                _formError = UiErrors.Message(ex);
            }
        }
        finally
        {
            try
            {
                await LoadAsync();
            }
            finally
            {
                _busy = false;
            }
        }
    }

    private sealed class ItemForm
    {
        public string Code { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public ItemType Type { get; set; } = ItemType.RawMaterial;
        public long UnitId { get; set; }
        public string? Description { get; set; }
        public long? VatRateId { get; set; }
        public long? GroupId { get; set; }
    }
}
