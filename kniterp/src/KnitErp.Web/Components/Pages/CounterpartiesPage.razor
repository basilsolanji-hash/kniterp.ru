@page "/counterparties"
@using KnitErp.Application.Catalog
@using KnitErp.Web.Components.Shared
@inject IJSRuntime JS
@inject KnitErp.Application.Tagging.TagService TagLookup
@inject CounterpartyService Counterparties
@inject CounterpartyExchangeService Exchange
@inject KnitErp.Application.Common.RequisitesLookupService Requisites

<PageTitle>@L("Контрагенты") — knitERP</PageTitle>

@if (_denied is not null)
{
    <AccessDenied Message="@_denied" />
}
else if (_list is null)
{
    <p class="muted">@L("Загрузка…")</p>
}
else
{
    <div class="page-head">
        <h1>@(RoleQuery switch { "customer" => L("Покупатели"), "supplier" => L("Поставщики"), _ => L("Контрагенты") })</h1>
        @if (_list.CanEdit && _mode == Mode.None)
        {
            <button type="button" @onclick="OpenCreate" disabled="@_busy">@L("Добавить контрагента")</button>
        }
    </div>

    @if (_flash is not null)
    {
        <div class="@(_flashIsError ? "flash error" : "flash")" role="@(_flashIsError ? "alert" : "status")"><span>@_flash</span><button type="button" class="link" aria-label="@L("Закрыть сообщение")" @onclick="() => _flash = null">×</button></div>
    }

    @if (_mode is Mode.Create or Mode.Edit)
    {
        <div class="panel">
            <h2>@(_mode == Mode.Create ? L("Новый контрагент") : _target!.Name)</h2>
            @if (_mode == Mode.Edit && _target is not null)
            {
                <TagPicker Entity="KnitErp.Domain.Tagging.TaggedEntity.Counterparty" EntityId="_target.Id" />
            }
            <EditForm Model="_form" OnValidSubmit="SaveAsync" FormName="counterparty">
                <div class="grid">
                    <label>@L("Наименование") <InputText @bind-Value="_form.Name" maxlength="300" required placeholder="@L("ООО «Пряжа»")" /></label>
                    <label>
                        @L("Страна")
                        <InputSelect @bind-Value="_form.CountryCode">
                            @foreach (var country in KnitErp.Domain.Organizations.Countries.All)
                            {
                                <option value="@country.Code">@country.Name</option>
                            }
                        </InputSelect>
                    </label>
                    <label>
                        @FormCountry.TaxIdName
                        <span class="inn-fill">
                            <InputText @bind-Value="_form.Inn" maxlength="14" inputmode="numeric" placeholder="@KnitErp.Domain.Organizations.Countries.TaxIdRule(FormCountry.Code, organization: false)" />
                            @if (Requisites.IsConfigured && FormCountry.Code == KnitErp.Domain.Organizations.Countries.Russia)
                            {
                                <button type="button" class="secondary" @onclick="FillByInnAsync" disabled="@_busy" title="@L("Подставить реквизиты из ЕГРЮЛ/ЕГРИП")">@L("Заполнить по ИНН")</button>
                            }
                        </span>
                    </label>
                    @if (FormCountry.HasKpp)
                    {
                        <label>@L("КПП") <InputText @bind-Value="_form.Kpp" maxlength="9" placeholder="@L("только у организации")" /></label>
                    }
                    <label>@L("Адрес") <InputText @bind-Value="_form.Address" maxlength="500" placeholder="@L("для счёта и УПД")" /></label>
                    <label>@L("Комментарий") <InputText @bind-Value="_form.Comment" maxlength="1000" /></label>
                    <label class="inline"><InputCheckbox @bind-Value="_form.IsSupplier" /> @L("Поставщик")</label>
                    <label class="inline"><InputCheckbox @bind-Value="_form.IsCustomer" /> @L("Покупатель")</label>
                </div>
                @if (_formError is not null)
                {
                    <div class="error" role="alert">@_formError</div>
                }
                <div class="actions">
                    <button type="submit" disabled="@_busy">@L("Сохранить")</button>
                    <button type="button" class="secondary" @onclick="Close" disabled="@_busy">@L("Отмена")</button>
                </div>
            </EditForm>
            @if (_mode == Mode.Edit && _target is not null)
            {
                <Discussion Target="KnitErp.Domain.Tagging.TaggedEntity.Counterparty" TargetId="_target.Id" />
            }
        </div>
    }

    <ImportPanel ExportHref="counterparties.xlsx" TemplateHref="counterparties-template.xlsx" CanImport="@CurrentAccess.Has(Permissions.CatalogImport)"
                 Hint="@L("Загрузка создаёт новых контрагентов и обновляет существующих: по ИНН и КПП, а без ИНН — по наименованию.")"
                 ShownColumns="@([0, 1, 2])" Preview="s => Exchange.PreviewAsync(s)" Apply="r => Exchange.ApplyAsync(r)" Applied="ReloadAsync" />

    <FoldOnPhone Title="@L("Фильтры")">
    <form data-autosubmit class="inline-form" @onsubmit="ReloadAsync">
        <TagFilter Value="_tagId" ValueChanged="TagChangedAsync" />
        <label>
            @L("Показать")
            <select @bind="_role">
                <option value="">@L("Всех")</option>
                <option value="s">@L("Поставщиков")</option>
                <option value="c">@L("Покупателей")</option>
            </select>
        </label>
        <label>@L("Поиск") <input @bind="_search" placeholder="@L("Наименование или ИНН")" /></label>
        <label class="inline"><input type="checkbox" @bind="_includeArchived" /> @L("Показать архив")</label>
        <button type="submit" class="filter-apply secondary" disabled="@_busy">@L("Найти")</button>
    </form>
    </FoldOnPhone>

    @if (_selected.Count > 0)
    {
        @* D818 (раздел 0 п. 7): массовые действия над отмеченными строками — по одному вызову сервиса подряд (у вкладки один DbContext). *@
        <div class="bulk-bar" role="region" aria-label="@L("Действия с отмеченными")">
            <span>@L("Отмечено: {0}", _selected.Count)</span>
            <ConfirmButton Class="secondary" OnConfirm="() => BulkAsync(archive: true)" Disabled="@(_busy || _mode != Mode.None)"
                           Question='@L("Отправить отмеченных в архив?")'>@L("В архив")</ConfirmButton>
            <button type="button" class="secondary" @onclick="() => BulkAsync(archive: false)" disabled="@(_busy || _mode != Mode.None)">@L("Вернуть из архива")</button>
            <button type="button" class="link" @onclick="() => _selected.Clear()">@L("Снять отметку")</button>
        </div>
    }
    <div class="scroll">
        <table>
            <thead><tr>@if (_list.CanArchive) { <th class="select-col"><input type="checkbox" checked="@AllSelected" @onchange="ToggleAll" aria-label="@L("Выбрать все")" /></th> }<th>@L("Наименование")</th><th>@L("Налоговый номер")</th><th>@L("Роль")</th>@if (_list.CanEdit || _list.CanArchive) { <th>@L("Действия")</th> }</tr></thead>
            <tbody>
                @if (_list.Counterparties.Count == 0)
                {
                    <EmptyRow Colspan="5" Text="@L("Контрагентов пока нет.")" Hint="@L("Покупатели и поставщики: реквизиты, договоры, контакты. Их выбирают в заказах, счетах и документах.")"
                              Filtered="@(_search != "" || _role != "" || _tagId is not null)"
                              CreateHref="@(_list.CanEdit ? "counterparties?new=1" : null)" CreateText="@L("Добавить контрагента")" />
                }
                @foreach (var c in _list.Counterparties)
                {
                    <tr class="@(c.IsArchived ? "archived" : null)">
                        @if (_list.CanArchive)
                        {
                            <td class="select-col"><input type="checkbox" checked="@_selected.Contains(c.Id)" @onchange="e => Toggle(c.Id, e.Value is true)" aria-label="@L("Выбрать: {0}", c.Name)" /></td>
                        }
                        <td><a href="counterparties/@c.Id">@c.Name</a><TagDots Tags="@_tagMap.GetValueOrDefault(c.Id)" /> @if (c.IsArchived) { <span class="tag">@L("архив")</span> }@if (c.Comment is not null) { <div class="muted">@c.Comment</div> }</td>
                        <td>@if (c.Inn is not null) { <span class="muted">@c.Country.TaxIdName </span>@c.Inn } else { <span>—</span> }@if (c.Kpp is not null) { <span class="muted"> / @c.Kpp</span> }@if (c.CountryCode != _orgCountry) { <div class="muted">@c.Country.Name</div> }</td>
                        <td>@L(c.RolesText)</td>
                        @if (_list.CanEdit || _list.CanArchive)
                        {
                            <td>
                                <div class="row-actions">
                                    @if (!c.IsArchived && _list.CanEdit)
                                    {
                                        <button type="button" class="secondary" @onclick="() => OpenEdit(c)" disabled="@(_busy || _mode != Mode.None)" title="@((_mode != Mode.None) ? L("Сначала сохраните или закройте открытую форму") : null)">@L("Изменить")</button>
                                    }
                                    @if (_list.CanArchive)
                                    {
                                        @if (c.IsArchived)
                                        {
                                            <button type="button" class="secondary" @onclick="() => RestoreAsync(c)" disabled="@_busy">@L("Вернуть")</button>
                                        }
                                        else
                                        {
                                            <ConfirmButton Class="secondary" OnConfirm="() => ArchiveAsync(c)" Disabled="@(_busy || _mode != Mode.None)" Title="@((_mode != Mode.None) ? L("Сначала сохраните или закройте открытую форму") : null)" Question='@L("Отправить в архив?")'>@L("В архив")</ConfirmButton>
                                        }
                                    }
                                </div>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {

    /// <summary>D108: «?new=…» с главного экрана — сразу открыть форму создания.</summary>
    [SupplyParameterFromQuery(Name = "new")]
    public string? NewQuery { get; set; }

    // D104: отбор по тегу и цветные точки тегов у строк.
    private long? _tagId;
    private IReadOnlyDictionary<long, IReadOnlyList<KnitErp.Application.Tagging.TagDto>> _tagMap = new Dictionary<long, IReadOnlyList<KnitErp.Application.Tagging.TagDto>>();

    private Task TagChangedAsync(long? tagId)
    {
        _tagId = tagId;
        return ReloadAsync();
    }

    private async Task LoadTagsAsync() => _tagMap = await TagLookup.MapAsync(KnitErp.Domain.Tagging.TaggedEntity.Counterparty, _list!.Counterparties.Select(r => r.Id).ToList());

    private enum Mode { None, Create, Edit }

    private CounterpartyListDto? _list;
    private CounterpartyForm _form = new();
    private CounterpartyDto? _target;
    private Mode _mode;
    [CascadingParameter]
    public CurrentAccessDto CurrentAccess { get; set; } = default!;

    private string _orgCountry => CurrentAccess.CountryCode;
    private KnitErp.Domain.Organizations.CountryInfo FormCountry => KnitErp.Domain.Organizations.Countries.Get(_form.CountryCode);

    private bool _busy;
    private string? _denied;
    private string? _formError;
    private string? _flash;
    private bool _flashIsError;
    private string _role = string.Empty;
    private string _search = string.Empty;
    private bool _includeArchived;

    /// <summary>Из меню: «Поставщики» — ?role=supplier, «Покупатели» — ?role=customer.</summary>
    [SupplyParameterFromQuery(Name = "role")]
    public string? RoleQuery { get; set; }

    /// <summary>D500: «Изменить» из карточки контрагента — ?edit={id} сразу открывает форму.</summary>
    [SupplyParameterFromQuery(Name = "edit")]
    public long? EditQuery { get; set; }

    /// <summary>D817: поиск и «показать архив» — в адресе (пишутся после применения фильтра).</summary>
    [SupplyParameterFromQuery(Name = "q")]
    public string? SearchQuery { get; set; }

    [SupplyParameterFromQuery(Name = "archived")]
    public string? ArchivedQuery { get; set; }

    private string? _appliedRole;

    protected override async Task OnParametersSetAsync()
    {
        if (_list is not null && _appliedRole == RoleQuery)
        {
            return;
        }

        _appliedRole = RoleQuery;
        _role = RoleQuery switch { "supplier" => "s", "customer" => "c", _ => _role };
        if (_list is null)
        {
            _search = SearchQuery ?? string.Empty;
            _includeArchived = ArchivedQuery == "1";
        }
        try
        {
            await LoadAsync();
            if (NewQuery == "1" && _mode != Mode.Create)
            {
                OpenCreate();
            }
            else if (EditQuery is { } editId && _list!.CanEdit && _list.Counterparties.FirstOrDefault(c => c.Id == editId && !c.IsArchived) is { } target)
            {
                OpenEdit(target);
            }
        }
        catch (AccessDeniedException ex)
        {
            _denied = UiErrors.Message(ex);
        }
    }

    private async Task LoadAsync()
    {
        _list = await Counterparties.ListAsync(new CounterpartyFilter(
            _role == "s" ? true : null, _role == "c" ? true : null, _search, _includeArchived, _tagId));
        await LoadTagsAsync();
    }

    private async Task ReloadAsync()
    {
        await RunAsync(() => Task.CompletedTask, null);
        await JS.InvokeVoidAsync("kniterp.setQuery", new Dictionary<string, string?>
        {
            ["role"] = _role switch { "s" => "supplier", "c" => "customer", _ => null }, ["q"] = _search,
            ["archived"] = _includeArchived ? "1" : null, ["new"] = null, ["edit"] = null,
        });
    }

    private void OpenCreate()
    {
        _flash = null;
        _formError = null;
        _target = null;
        _form = new CounterpartyForm { IsSupplier = true, CountryCode = _orgCountry };
        _mode = Mode.Create;
    }

    private void OpenEdit(CounterpartyDto c)
    {
        _flash = null;
        _formError = null;
        _target = c;
        _form = new CounterpartyForm
        {
            Name = c.Name, Inn = c.Inn, Kpp = c.Kpp, IsSupplier = c.IsSupplier, IsCustomer = c.IsCustomer, Comment = c.Comment, CountryCode = c.CountryCode,
            Address = c.Address,
        };
        _mode = Mode.Edit;
    }

    private void Close()
    {
        _mode = Mode.None;
        _target = null;
        _formError = null;
    }

    private Task SaveAsync() => RunAsync(async () =>
    {
        var cmd = new CounterpartyCommand(_form.Name, _form.Inn, FormCountry.HasKpp ? _form.Kpp : null, _form.IsSupplier, _form.IsCustomer, _form.Comment,
            _form.CountryCode, _form.Address ?? string.Empty);
        if (_mode == Mode.Create)
        {
            await Counterparties.CreateAsync(cmd);
        }
        else
        {
            await Counterparties.UpdateAsync(_target!.Id, cmd, _target.RowVersion);
        }

        Close();
    }, L("Контрагент сохранён."));

    /// <summary>Наименование, КПП и адрес из ЕГРЮЛ/ЕГРИП по ИНН (D78) — пользователь проверяет и сохраняет сам.</summary>
    private async Task FillByInnAsync()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _formError = null;
        try
        {
            var r = await Requisites.ForCounterpartyAsync(_form.Inn);
            _form.Inn = r.Inn;
            _form.Name = r.ShortName;
            _form.Kpp = r.Kpp;
            _form.Address = r.Address ?? _form.Address;
            if (!r.Active)
            {
                _formError = L("Внимание: по реестру организация не действует ({0}). Проверьте, прежде чем сохранять.", r.Status ?? "—");
            }
        }
        catch (Exception ex) when (UiErrors.IsUserFacing(ex))
        {
            _formError = UiErrors.Message(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    private Task ArchiveAsync(CounterpartyDto c) => RunAsync(() => Counterparties.ArchiveAsync(c.Id, c.RowVersion), L("Контрагент «{0}» в архиве.", c.Name));

    private Task RestoreAsync(CounterpartyDto c) => RunAsync(() => Counterparties.RestoreAsync(c.Id, c.RowVersion), L("Контрагент «{0}» возвращён из архива.", c.Name));

    private readonly HashSet<long> _selected = [];

    private bool AllSelected => _list is { Counterparties.Count: > 0 } && _list.Counterparties.All(c => _selected.Contains(c.Id));

    private void Toggle(long id, bool on)
    {
        if (on)
        {
            _selected.Add(id);
        }
        else
        {
            _selected.Remove(id);
        }
    }

    private void ToggleAll(ChangeEventArgs e)
    {
        _selected.Clear();
        if (e.Value is true)
        {
            _selected.UnionWith(_list!.Counterparties.Select(c => c.Id));
        }
    }

    /// <summary>В архив или из архива все отмеченные: подряд, по одному, тем же методом, что и кнопка в строке; итог — одним сообщением.</summary>
    private async Task BulkAsync(bool archive)
    {
        if (_busy || _list is null)
        {
            return;
        }

        _busy = true;
        _flash = null;
        _flashIsError = false;
        var done = 0;
        var failed = new List<string>();
        try
        {
            foreach (var c in _list.Counterparties.Where(c => _selected.Contains(c.Id) && c.IsArchived != archive).ToList())
            {
                try
                {
                    if (archive)
                    {
                        await Counterparties.ArchiveAsync(c.Id, c.RowVersion);
                    }
                    else
                    {
                        await Counterparties.RestoreAsync(c.Id, c.RowVersion);
                    }

                    done++;
                }
                catch (Exception ex) when (UiErrors.IsUserFacing(ex))
                {
                    failed.Add($"{c.Name}: {UiErrors.Message(ex)}");
                }
            }

            _selected.Clear();
            _flash = (archive ? L("В архиве: {0}.", done) : L("Возвращено из архива: {0}.", done))
                     + (failed.Count > 0 ? " " + L("Не получилось: {0}", string.Join("; ", failed)) : "");
            _flashIsError = failed.Count > 0;
        }
        finally
        {
            try
            {
                await LoadAsync();
            }
            finally
            {
                _busy = false;
            }
        }
    }

    /// <summary>Одна операция за раз, затем свежие данные: у вкладки один DbContext.</summary>
    private async Task RunAsync(Func<Task> action, string? success)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _flash = null;
        _flashIsError = false;
        _formError = null;
        try
        {
            await action();
            _flash = success;
        }
        catch (Exception ex) when (UiErrors.IsUserFacing(ex))
        {
            if (_mode == Mode.None)
            {
                _flash = UiErrors.Message(ex);
                _flashIsError = true;
            }
            else
            {
                _formError = UiErrors.Message(ex);
            }
        }
        finally
        {
            try
            {
                await LoadAsync();
            }
            finally
            {
                _busy = false;
            }
        }
    }

    private sealed class CounterpartyForm
    {
        public string Name { get; set; } = string.Empty;
        public string? Inn { get; set; }
        public string? Kpp { get; set; }
        public bool IsSupplier { get; set; }
        public bool IsCustomer { get; set; }
        public string? Comment { get; set; }
        public string? Address { get; set; }
        public string CountryCode { get; set; } = KnitErp.Domain.Organizations.Countries.Russia;
    }
}
