@page "/stock-documents/{Id:long}"
@using KnitErp.Application.Warehousing
@using KnitErp.Domain.Warehousing
@using KnitErp.Web.Components.Shared
@inject StockDocumentService Documents
@inject StockBatchService BatchService

<PageTitle>@(_doc?.Number ?? L("Документ")) — knitERP</PageTitle>

@if (_denied is not null)
{
    <AccessDenied Message="@_denied" />
}
else if (_notFound)
{
    <h1>@L("Документ не найден")</h1>
    <p><a href="stock-documents">@L("К списку документов")</a></p>
}
else if (_doc is null)
{
    <p class="muted">@L("Загрузка…")</p>
}
else
{
    <p><a href="stock-documents">@L("← Складские документы")</a></p>
    <div class="page-head">
        <h1>@L(_doc.KindName) @_doc.Number <span class="tag @StockDocumentsPage.StatusClass(_doc.Status)">@L(_doc.StatusName)</span></h1>
    </div>
    <TagPicker Entity="KnitErp.Domain.Tagging.TaggedEntity.StockDocument" EntityId="Id" />

    @if (_message is not null)
    {
        <div class="@(_messageIsError ? "flash error" : "flash")" role="@(_messageIsError ? "alert" : "status")">@_message</div>
    }

    @if (_header is not null)
    {
        <div class="panel">
            <h2>@L("Шапка документа")</h2>
            <form @onsubmit="SaveHeaderAsync">
                <div class="grid">
                    <StockDocumentHeaderFields Form="_header" Kind="_doc.Kind" Options="_options!" />
                </div>
                <div class="actions">
                    <button type="submit" disabled="@_busy">@L("Сохранить")</button>
                    <button type="button" class="secondary" @onclick="() => _header = null">@L("Отмена")</button>
                </div>
            </form>
        </div>
    }
    else
    {
        <dl class="facts">
            <dt>@L("Дата")</dt><dd>@_doc.DocumentDate.ToString("dd.MM.yyyy")</dd>
            <dt>@(StockDocument.IsOutgoing(_doc.Kind) ? L("Склад-отправитель") : L("Склад-получатель"))</dt><dd>@_doc.WarehouseName</dd>
            @if (_doc.TargetWarehouseName is not null)
            {
                <dt>@L("Куда")</dt><dd>@_doc.TargetWarehouseName</dd>
            }
            @if (StockDocument.WithSupplier(_doc.Kind) || StockDocument.WithCustomer(_doc.Kind))
            {
                <dt>@(StockDocument.WithCustomer(_doc.Kind) ? L("Покупатель") : L("Поставщик"))</dt><dd>@(_doc.CounterpartyName ?? "—")</dd>
            }
            @if (_doc.SalesOrderId is { } salesOrderId)
            {
                <dt>@L("Заказ покупателя")</dt><dd><a href="sales-orders/@salesOrderId">@_doc.SalesOrderNumber</a>
                    @if (_doc.Kind == StockOperationKind.Shipment && _doc.Status == StockDocumentStatus.Posted && CurrentAccess.Has(Permissions.PriceView))
                    {
                        <span> · <a href="print/upd/@_doc.Id" target="_blank" rel="noopener">@L("Печать УПД")</a></span>
                    }
                </dd>
            }
            @if (_doc.PurchaseOrderId is { } orderId)
            {
                <dt>@L("Заказ поставщику")</dt><dd><a href="purchase-orders/@orderId">@_doc.PurchaseOrderNumber</a></dd>
            }
            <dt>@L("Причина")</dt><dd>@(_doc.ReasonName is { } reason ? L(reason) : L("не указана"))@(_doc.ReasonRequiresComment ? " " + L("(нужно пояснение)") : "")</dd>
            @if (_doc.Comment is not null)
            {
                <dt>@L("Комментарий")</dt><dd>@_doc.Comment</dd>
            }
            <dt>@L("Автор")</dt><dd>@_doc.CreatedBy, @Local(_doc.CreatedAtUtc)</dd>
            @if (_doc.PostedBy is not null)
            {
                <dt>@L("Провёл")</dt><dd>@_doc.PostedBy, @Local(_doc.PostedAtUtc!.Value)</dd>
            }
            @if (_doc.ReversedBy is not null)
            {
                <dt>@L("Сторнировал")</dt><dd>@_doc.ReversedBy, @Local(_doc.ReversedAtUtc!.Value): @_doc.ReversalReason</dd>
            }
        </dl>
        @if (_doc.CanEdit)
        {
            <button type="button" class="secondary" @onclick="EditHeaderAsync" disabled="@_busy">@L("Изменить шапку")</button>
        }
    }

    <h2 style="margin-top: 24px">@L("Строки ({0})", _doc.Lines.Count)</h2>

    @if (_doc.CanEdit)
    {
        <form class="inline-form" @onsubmit="AddLineAsync">
            <label>
                @L("Позиция")
                <input list="items" @bind="_itemText" size="40" placeholder="@L("Код или наименование")" />
                <datalist id="items">
                    @foreach (var i in _items)
                    {
                        <option value="@($"{i.Code} — {i.Name}")">@i.UnitSymbol</option>
                    }
                </datalist>
            </label>
            <label>@L("Количество") <input @bind="_qtyText" inputmode="decimal" size="10" /></label>
            <button type="submit" disabled="@_busy">@L("Добавить")</button>
        </form>
        <div class="actions">
            <a class="button secondary" href="stock-documents/template.xlsx" download data-enhance-nav="false">@L("Шаблон Excel")</a>
            <label class="inline">@L("Загрузить строки из Excel (заменят текущие)") <InputFile OnChange="ImportAsync" accept=".xlsx" disabled="@_busy" /></label>
        </div>
    }

    @if (_import is { Applied: false })
    {
        <div class="error" role="alert">@L("В файле есть ошибки ({0}) — строки не загружены.", _import.ErrorRows)</div>
        <div class="scroll" style="max-height: 300px; overflow-y: auto">
            <table>
                <thead><tr><th>@L("Строка")</th><th>@L("Код")</th><th>@L("Количество")</th><th>@L("Ошибки")</th></tr></thead>
                <tbody>
                    @foreach (var r in _import.Rows.Where(r => r.Errors.Count > 0).Take(500))
                    {
                        <tr><td>@r.RowNumber</td><td>@r.Code</td><td>@r.QuantityText</td><td>@string.Join(" ", r.Errors)</td></tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (_doc.Shortages.Any())
    {
        <div class="error" role="alert">@L("Остатка не хватает по {0} поз. — такой документ не проведётся.", _doc.Shortages.Count())</div>
    }

    var showAvailable = _doc.Lines.Any(l => l.Available is not null);
    <div class="scroll">
        <table>
            <thead>
                <tr>
                    <th>@L("Код")</th><th>@L("Наименование")</th><th class="num">@L("Количество")</th><th>@L("Ед.")</th>
                    @if (showAvailable) { <th class="num">@L("Есть на складе")</th> }
                    @if (_doc.CanEdit) { <th></th> }
                </tr>
            </thead>
            <tbody>
                @if (_doc.Lines.Count == 0)
                {
                    <tr><td colspan="6" class="muted">@L("Строк пока нет.")</td></tr>
                }
                @foreach (var l in _doc.Lines)
                {
                    @if (l.BundleItemId is { } bundleId && _doc.Lines.First(x => x.BundleItemId == bundleId) == l)
                    {
                        @* D352 (сессия 4, Р2): комплект — заголовком над своими компонентами; меняется количество комплектов целиком. *@
                        <tr>
                            <td><b>@l.BundleCode</b></td>
                            <td><b>@l.BundleName</b> <span class="muted">@L("комплект — компоненты ниже")</span></td>
                            <td class="num">
                                @if (_doc.CanEdit)
                                {
                                    <input value="@BundleQtyText(l)" @onchange="e => _bundleQty[bundleId] = e.Value?.ToString() ?? string.Empty" inputmode="decimal" size="6"
                                           aria-label="@L("Количество комплекта {0}", l.BundleCode)" />
                                }
                                else
                                {
                                    <b>@Quantities.Format(l.BundleQuantity ?? 0)</b>
                                }
                            </td>
                            <td>@l.BundleUnitSymbol</td>
                            @if (showAvailable) { <td></td> }
                            @if (_doc.CanEdit)
                            {
                                <td>
                                    <button type="button" class="secondary" @onclick="() => SetBundleAsync(l)" disabled="@_busy">@L("Изменить")</button>
                                    <ConfirmButton Class="secondary" OnConfirm="() => RemoveBundleAsync(l)" Disabled="@_busy" AriaLabel="@L("Удалить комплект {0}", l.BundleCode)" Question='@L("Удалить комплект со всеми компонентами?")'>@L("Удалить")</ConfirmButton>
                                </td>
                            }
                        </tr>
                    }
                    var total = _doc.Lines.Where(x => x.ItemId == l.ItemId).Sum(x => x.Quantity);
                    <tr class="@(l.Available is { } a && a < total ? "short" : "")">
                        <td>@(l.BundleItemId is null ? l.Code : $"↳ {l.Code}")</td>
                        <td>@l.Name</td>
                        <td class="num">@Quantities.Format(l.Quantity)</td>
                        <td>@l.UnitSymbol</td>
                        @if (showAvailable)
                        {
                            <td class="num">@Quantities.Format(l.Available ?? 0)</td>
                        }
                        @if (_doc.CanEdit && l.BundleItemId is null)
                        {
                            <td><ConfirmButton Class="secondary" OnConfirm="() => RemoveLineAsync(l)" Disabled="@_busy" AriaLabel="@L("Удалить строку {0}", l.Code)" Question='@L("Удалить?")'>@L("Удалить")</ConfirmButton></td>
                        }
                        else if (_doc.CanEdit)
                        {
                            <td></td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (_batches is { } bt && bt.Items.Count > 0 && (bt.CanEdit || bt.Items.Any(i => i.Rows.Count > 0) || bt.Movements.Count > 0))
    {
        @* D89: разбивка строк по партиям (цвет, крашение), места, брутто/нетто и пересчёт в кг. *@
        <h2 style="margin-top: 24px">@L("Партии и вес")</h2>
        @foreach (var w in bt.Warnings ?? [])
        {
            <div class="flash error" role="alert">⚠ @w</div>
        }
        <p class="muted small">
            @(bt.IsIncoming
                ? L("Укажите партию (номер, цвет, крашение) для каждой позиции — сумма по партиям должна совпасть с количеством строки. Без разбивки товар поступит «без партии».")
                : _doc.Kind == StockOperationKind.Shipment && _doc.SalesOrderId is not null
                    ? L("Выберите партии или оставьте автоподбор: он берёт одно крашение на весь заказ — сначала уже отгруженное покупателю, затем самое старое, которого хватает целиком.")
                    : L("Выберите партии для расхода. Без выбора спишется сначала остаток без партии, затем самые старые партии."))
        </p>
        <div class="scroll">
            <table class="compact">
                <thead>
                    <tr>
                        <th>@L("Позиция")</th><th>@L("Партия")</th><th class="num">@L("Количество")</th><th class="num">@L("Нетто, кг")</th>
                        <th class="num">@L("Мест")</th><th class="num opt">@L("Брутто, кг")</th><th class="num opt">@L("Тара, кг")</th><th class="num opt">@L("Кг на место")</th>
                        @if (bt.CanEdit) { <th></th> }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var it in bt.Items)
                    {
                        <tr class="@(it.Matches ? null : "short")">
                            <td><strong>@it.Code</strong> <span class="muted small">@it.Name</span></td>
                            <td class="muted">@(it.Rows.Count == 0 ? L("без разбивки") : it.Matches ? L("разбито полностью") : L("по партиям {0} из {1}", Quantities.Format(it.Allocated), Quantities.Format(it.LineQuantity)))</td>
                            <td class="num"><strong>@Quantities.Format(it.LineQuantity) @it.UnitSymbol</strong></td>
                            <td class="num">@KgText(it.LineKg)</td>
                            <td class="num">@(it.Rows.Any(r => r.Packages is not null) ? it.Rows.Sum(r => r.Packages ?? 0).ToString() : "")</td>
                            <td class="num opt">@(it.Rows.Any(r => r.GrossWeightKg is not null) ? KgText(it.Rows.Sum(r => r.GrossWeightKg ?? 0)) : "")</td>
                            <td class="opt"></td><td class="opt"></td>
                            @if (bt.CanEdit) { <td></td> }
                        </tr>
                        @foreach (var r in it.Rows)
                        {
                            <tr>
                                <td></td>
                                <td>@r.BatchLabel</td>
                                <td class="num">@Quantities.Format(r.Quantity)</td>
                                <td class="num">@KgText(r.NetKg)</td>
                                <td class="num">@(r.Packages?.ToString() ?? "—")</td>
                                <td class="num opt">@KgText(r.GrossWeightKg)</td>
                                <td class="num opt @(r.TareKg < 0 ? "neg" : null)">@KgText(r.TareKg)</td>
                                <td class="num opt">@KgText(r.NetPerPackageKg)</td>
                                @if (bt.CanEdit)
                                {
                                    <td><button type="button" class="secondary" @onclick="() => RemoveBatchAsync(r)" disabled="@_busy" aria-label="@L("Убрать партию {0}", r.BatchLabel)">@L("Убрать")</button></td>
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (bt.Items.Any(i => i.Rows.Count > 0))
        {
            <div class="actions"><a class="button secondary" href="print/batch-labels?doc=@Id" target="_blank" rel="noopener">@L("Ярлыки партий (по местам)")</a></div>
        }
        @if (bt.CanEdit)
        {
            <form class="inline-form" @onsubmit="ScanAsync">
                <label>@L("Сканер: ярлык партии") <input @bind="_scan" placeholder="KB…" size="16" autocomplete="off" /></label>
                <button type="submit" class="secondary" disabled="@_busy">@L("Найти")</button>
            </form>
        }
        @if (bt.CanEdit)
        {
            var selected = bt.Items.FirstOrDefault(i => i.ItemId == _bItemId);
            <form class="panel" @onsubmit="AddBatchAsync">
                <div class="grid">
                    <label>
                        @L("Позиция")
                        <select @bind="_bItemId" @bind:after="BatchItemChanged">
                            <option value="">—</option>
                            @foreach (var it in bt.Items)
                            {
                                <option value="@it.ItemId">@it.Code — @it.Name</option>
                            }
                        </select>
                    </label>
                    <label>
                        @L("Партия")
                        <select @bind="_bBatchId">
                            @if (bt.IsIncoming)
                            {
                                <option value="0">@L("+ новая партия")</option>
                            }
                            else
                            {
                                <option value="">—</option>
                            }
                            @foreach (var o in selected?.Options ?? [])
                            {
                                <option value="@o.Id">@o.Label@(o.Available is { } a ? " — " + L("есть {0}", Quantities.Format(a)) : "")</option>
                            }
                        </select>
                    </label>
                    @if (bt.IsIncoming && _bBatchId == 0)
                    {
                        <label>@L("Номер партии") <input @bind="_bNumber" maxlength="@KnitErp.Domain.Warehousing.StockBatch.NumberMaxLength" /></label>
                        <label>@L("Цвет") <input @bind="_bColor" maxlength="@KnitErp.Domain.Warehousing.StockBatch.ColorMaxLength" /></label>
                        <label>@L("Номер крашения") <input @bind="_bDyeLot" maxlength="@KnitErp.Domain.Warehousing.StockBatch.DyeLotMaxLength" /></label>
                    }
                    <label>@L("Количество") <input @bind="_bQty" inputmode="decimal" placeholder="@(selected is null ? "" : Quantities.Format(selected.LineQuantity - selected.Allocated))" /></label>
                    <label>@L("Мест (бобин)") <input @bind="_bPackages" inputmode="numeric" /></label>
                    <label>@L("Брутто, кг") <input @bind="_bGross" inputmode="decimal" /></label>
                </div>
                <div class="actions"><button type="submit" disabled="@(_busy || _bItemId is null)">@L("Добавить партию")</button></div>
            </form>
        }

        @if (bt.Movements.Count > 0)
        {
            <h3>@L("Движения партий")</h3>
            <div class="scroll">
                <table class="compact">
                    <thead><tr><th>@L("Склад")</th><th>@L("Код")</th><th>@L("Партия")</th><th class="num">@L("Количество")</th><th class="num">@L("кг")</th></tr></thead>
                    <tbody>
                        @foreach (var m in bt.Movements)
                        {
                            <tr>
                                <td>@m.WarehouseName</td><td>@m.ItemCode</td><td>@m.BatchLabel</td>
                                <td class="num @(m.Quantity < 0 ? "neg" : null)">@Quantities.Format(m.Quantity) @m.UnitSymbol</td>
                                <td class="num">@KgText(m.Kg)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }

    <div class="actions" style="margin-top: 16px">
        <LabelsButton Lines="@(_doc.Lines.Select(l => (l.ItemId, l.Quantity)))" />
        @if (_doc.CanPost)
        {
            <button type="button" @onclick="PostAsync" disabled="@(_busy || _doc.Lines.Count == 0)">@L("Провести")</button>
        }
        @if (_doc.CanEdit)
        {
            <ConfirmButton Class="secondary" OnConfirm="CancelAsync" Disabled="@_busy" Question='@L("Отменить документ?")'>@L("Отменить документ")</ConfirmButton>
        }
    </div>

    @if (_doc.Status == StockDocumentStatus.Draft && !_doc.CanPost)
    {
        <p class="muted">@L("Провести документ может Старший кладовщик этого склада или Владелец.")</p>
    }

    @if (_doc.CanReverse)
    {
        <div class="panel">
            <h2>@L("Сторно")</h2>
            <p class="muted">@L("Движения документа гасятся обратными, документ остаётся в истории со статусом «Сторнирован». Правильные данные вводятся новым документом.")</p>
            <form class="inline-form" @onsubmit="ReverseAsync">
                <label>@L("Причина сторно") <input @bind="_reverseReason" maxlength="500" size="40" /></label>
                <button type="submit" class="secondary" disabled="@_busy">@L("Сторнировать")</button>
            </form>
        </div>
    }
}


@if (_doc is not null)
{
    <Discussion Target="KnitErp.Domain.Tagging.TaggedEntity.StockDocument" TargetId="Id" />
}

@code {
    [Parameter]
    public long Id { get; set; }

    [CascadingParameter]
    public CurrentAccessDto CurrentAccess { get; set; } = default!;

    private StockDocumentDto? _doc;
    private IReadOnlyList<EntryItemDto> _items = [];
    private StockDocumentOptions? _options;
    private StockDocumentHeaderFields.Model? _header;
    private LineImportResult? _import;
    private bool _busy;
    private bool _notFound;
    private string? _denied;
    private string? _message;
    private bool _messageIsError;
    private string _itemText = string.Empty;
    private string _qtyText = string.Empty;
    private string _reverseReason = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadAsync();
            if (_doc!.CanEdit)
            {
                _items = await Documents.ListItemsForEntryAsync();
            }
        }
        catch (AccessDeniedException ex)
        {
            _denied = UiErrors.Message(ex);
        }
        catch (NotFoundException)
        {
            _notFound = true;
        }
    }

    private DocumentBatchesDto? _batches;
    private long? _bItemId;
    private long? _bBatchId = 0;
    private string? _bNumber;
    private string? _bColor;
    private string? _bDyeLot;
    private string? _bQty;
    private string? _bPackages;
    private string? _bGross;

    private async Task LoadAsync()
    {
        _doc = await Documents.GetAsync(Id);
        _batches = await BatchService.ForDocumentAsync(Id);
    }

    private string? _scan;

    /// <summary>D101: ярлык со сканера выбирает позицию и партию в форме разбивки.</summary>
    private Task ScanAsync() => RunAsync(async () =>
    {
        var found = await BatchService.FindByCodeAsync(_scan);
        _scan = null;
        var item = _batches!.Items.FirstOrDefault(i => i.ItemId == found.ItemId)
                   ?? throw new BusinessRuleException("stock.batch.scan_not_in_document", L("Позиции {0} нет в документе — сначала добавьте строку.", found.ItemCode));
        if (!_batches.IsIncoming && item.Options.All(o => o.Id != found.Id))
        {
            throw new BusinessRuleException("stock.batch.insufficient", L("Партии {0} нет на складе-отправителе.", found.Label));
        }

        _bItemId = found.ItemId;
        _bBatchId = found.Id;
        _message = L("Выбрана партия {0} — укажите количество.", found.Label);
    }, null);

    private void BatchItemChanged() => _bBatchId = _batches?.IsIncoming == true ? 0 : null;

    private static string KgText(decimal? kg) => kg is { } v ? v.ToString("#,0.###") : "—";

    private Task AddBatchAsync() => RunAsync(async () =>
    {
        var item = _batches!.Items.FirstOrDefault(i => i.ItemId == _bItemId)
                   ?? throw new BusinessRuleException("stock.batch.item", L("Выберите позицию."));
        var qty = string.IsNullOrWhiteSpace(_bQty) ? item.LineQuantity - item.Allocated
            : Quantities.TryParse(_bQty, out var q) ? q : throw new BusinessRuleException("stock.quantity.invalid", L("Укажите количество числом, например 12,5."));
        int? packages = null;
        if (!string.IsNullOrWhiteSpace(_bPackages))
        {
            packages = int.TryParse(_bPackages.Trim(), out var p) ? p : throw new BusinessRuleException("stock.batch.packages", L("Мест — целое положительное число."));
        }

        decimal? gross = null;
        if (!string.IsNullOrWhiteSpace(_bGross))
        {
            gross = Quantities.TryParse(_bGross, out var g) ? g : throw new BusinessRuleException("stock.batch.gross_weight", L("Вес брутто — числом, например 25,4."));
        }

        long batchId;
        if (_batches.IsIncoming && _bBatchId is 0)
        {
            // Вес места новой партии — из нетто строки и числа мест, если вес позиции известен.
            var netKg = item.LineQuantity == 0 || item.LineKg is null ? null : (decimal?)(item.LineKg.Value / item.LineQuantity * qty);
            decimal? perPackage = netKg is { } kg && packages is > 0 ? decimal.Round(kg / packages.Value, 3) : null;
            batchId = await BatchService.CreateAsync(item.ItemId,
                new KnitErp.Domain.Warehousing.StockBatchData(_bNumber, _bColor, _bDyeLot, StockDocument.WithSupplier(_doc!.Kind) ? _doc.CounterpartyId : null, perPackage is > 0 ? perPackage : null, null));
            _batches = await BatchService.ForDocumentAsync(Id);
        }
        else
        {
            batchId = _bBatchId ?? throw new BusinessRuleException("stock.batch.required", L("Выберите партию."));
        }

        await BatchService.SetDocumentBatchAsync(Id, item.ItemId, batchId, qty, packages, gross, _batches.RowVersion);
        _bNumber = _bColor = _bDyeLot = _bQty = _bPackages = _bGross = null;
    }, L("Партия добавлена."));

    private Task RemoveBatchAsync(DocumentBatchRowDto r) => RunAsync(() => BatchService.RemoveDocumentBatchAsync(Id, r.Id, _batches!.RowVersion), null);

    private Task EditHeaderAsync() => RunAsync(async () =>
    {
        _options = await Documents.GetOptionsAsync(_doc!.Kind);
        _header = StockDocumentHeaderFields.Model.From(_doc);
    }, null);

    private Task SaveHeaderAsync() => RunAsync(async () =>
    {
        await Documents.UpdateHeaderAsync(Id, _header!.ToHeader(), _doc!.RowVersion);
        _header = null;
    }, L("Шапка сохранена."));

    private Task AddLineAsync() => RunAsync(async () =>
    {
        var code = _itemText.Split(" — ", 2)[0].Trim();
        var item = _items.FirstOrDefault(i => string.Equals(i.Code, code, StringComparison.OrdinalIgnoreCase))
                   ?? throw new BusinessRuleException("stock.item.unknown", L("Позиция «{0}» не найдена. Выберите из списка.", _itemText));
        if (!Quantities.TryParse(_qtyText, out var qty))
        {
            throw new BusinessRuleException("stock.quantity.invalid", L("Укажите количество числом, например 12,5."));
        }

        await Documents.SetLineAsync(Id, item.Id, qty, _doc!.RowVersion);
        _itemText = string.Empty;
        _qtyText = string.Empty;
    }, null);

    private Task RemoveLineAsync(StockDocumentLineDto line) => RunAsync(() => Documents.RemoveLineAsync(Id, line.ItemId, _doc!.RowVersion), null);

    // D352 (сессия 4, Р2): количество комплекта в отгрузке или возврате по заказу — компоненты пересчитывает сервер.
    private readonly Dictionary<long, string> _bundleQty = [];

    private string BundleQtyText(StockDocumentLineDto l) =>
        _bundleQty.TryGetValue(l.BundleItemId!.Value, out var text) ? text : Quantities.Format(l.BundleQuantity ?? 0);

    private Task SetBundleAsync(StockDocumentLineDto l) => RunAsync(async () =>
    {
        if (!Quantities.TryParse(BundleQtyText(l), out var qty))
        {
            throw new BusinessRuleException("stock.quantity.invalid", L("Укажите количество числом, например 12,5."));
        }

        await Documents.SetBundleAsync(Id, l.BundleItemId!.Value, qty, _doc!.RowVersion);
        _bundleQty.Remove(l.BundleItemId.Value);
    }, L("Количество комплекта изменено."));

    private Task RemoveBundleAsync(StockDocumentLineDto l) => RunAsync(() => Documents.RemoveBundleAsync(Id, l.BundleItemId!.Value, _doc!.RowVersion), null);

    private Task ImportAsync(InputFileChangeEventArgs e) => RunAsync(async () =>
    {
        const long maxSize = 5 * 1024 * 1024;
        if (e.File.Size > maxSize)
        {
            throw new BusinessRuleException("import.file_too_large", L("Файл больше 5 МБ."));
        }

        await using var upload = e.File.OpenReadStream(maxSize);
        using var buffer = new MemoryStream();
        await upload.CopyToAsync(buffer);
        buffer.Position = 0;
        _import = await Documents.ImportLinesAsync(Id, buffer, _doc!.RowVersion);
        if (_import.Applied)
        {
            _message = L("Загружено строк: {0}.", _import.Lines);
            _import = null;
        }
    }, null);

    private Task PostAsync() => RunAsync(() => Documents.PostAsync(Id, _doc!.RowVersion), L("Документ проведён, остатки изменены."));

    private Task CancelAsync() => RunAsync(() => Documents.CancelAsync(Id, _doc!.RowVersion), L("Документ отменён."));

    private Task ReverseAsync() => RunAsync(async () =>
    {
        await Documents.ReverseAsync(Id, _reverseReason, _doc!.RowVersion);
        _reverseReason = string.Empty;
    }, L("Документ сторнирован, остатки возвращены."));

    /// <summary>Одна операция за раз, затем свежий документ: у вкладки один DbContext.</summary>
    private async Task RunAsync(Func<Task> action, string? success)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _message = null;
        _messageIsError = false;
        try
        {
            await action();
            _message = success ?? _message;
        }
        catch (Exception ex) when (UiErrors.IsUserFacing(ex))
        {
            _message = UiErrors.Message(ex);
            _messageIsError = true;
        }
        finally
        {
            try
            {
                await LoadAsync();
            }
            finally
            {
                _busy = false;
            }
        }
    }

    private string Local(DateTime utc) => TimeZones.ToLocal(utc, CurrentAccess.TimeZoneId).ToString("dd.MM.yyyy HH:mm");
}
