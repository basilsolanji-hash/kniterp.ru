@page "/print/production/{Id:long}"
@layout KnitErp.Web.Components.Layout.PrintLayout
@using System.Globalization
@using KnitErp.Application.Production
@inject ProductionPrintService Print

@*
    Документы производственного заказа (D96). Унифицированные формы с 2013 года не обязательны (ч. 4 ст. 9 Федерального закона № 402-ФЗ);
    формы — по образцу М-11 «Требование-накладная» (постановление Госкомстата России от 30.10.1997 № 71а) и МХ-18 «Накладная на передачу
    готовой продукции в места хранения» (постановление Госкомстата России от 09.08.1999 № 66) с обязательными реквизитами ч. 2 ст. 9.
    Российская форма — печатается по-русски (D68). Корреспондирующие счета заполняет бухгалтер.
*@
<PageTitle>@(_doc is null ? "Документ производства" : $"{_doc.Form} {_doc.Number}") — knitERP</PageTitle>
<style>@@media print { @@page { size: A4 landscape; margin: 10mm; } }</style>

<div class="print-bar">
    <button type="button" data-print>@L("Печать")</button>
    <a href="@(BackHref)">@L("← Назад")</a>
    @if (_doc is { PricesVisible: false })
    {
        <span class="warn">@L("Цены и суммы не показаны: нет права «Цены и суммы» — их заполнит бухгалтер.")</span>
    }
</div>

@if (_error is not null)
{
    <div class="sheet"><p>@_error</p></div>
}
else if (_doc is null)
{
    <div class="sheet"><p>@L("Загрузка…")</p></div>
}
else
{
    var d = _doc;
    <div class="sheet">
        @if (d.Reversed)
        {
            <div class="stamp">ДОКУМЕНТ СТОРНИРОВАН</div>
        }
        <div class="small" style="text-align: right">
            Форма по образцу № @d.Form<br />
            @(d.IsOutput ? "(постановление Госкомстата России от 09.08.1999 № 66)" : "(постановление Госкомстата России от 30.10.1997 № 71а)")
        </div>
        <table class="plain">
            <tr><td></td><td style="width: 120px; text-align: right">Форма по ОКУД</td><td class="code">@d.Okud</td></tr>
            <tr><td><b>@d.Organization</b>@(d.Inn is null ? "" : $", ИНН {d.Inn}")@(d.Kpp is null ? "" : $", КПП {d.Kpp}")<div class="small">организация</div></td>
                <td style="text-align: right">по ОКПО</td><td class="code"></td></tr>
        </table>

        <h1 style="text-align: center; margin: 12px 0 4px">@d.Title № @d.Number</h1>

        <table>
            <tr>
                <th>Дата составления</th>
                @if (!d.IsOutput) { <th>Код вида операции</th> }
                <th>@(d.IsOutput ? "Сдал (структурное подразделение)" : "Отправитель (структурное подразделение)")</th>
                <th>@(d.IsOutput ? "Принял (место хранения)" : "Получатель (структурное подразделение)")</th>
                <th>Корреспондирующий счёт</th>
                <th>Основание</th>
            </tr>
            <tr>
                <td>@d.Date.ToString("dd.MM.yyyy")</td>
                @if (!d.IsOutput) { <td></td> }
                <td>@d.Sender</td>
                <td>@d.Receiver</td>
                <td></td>
                <td>Производственный заказ @d.OrderNumber (@d.ProductName)@(d.Reason is null ? "" : $"; {d.Reason}")</td>
            </tr>
        </table>

        @if (!d.IsOutput)
        {
            <p>Через кого <span class="line"></span> &nbsp; Затребовал <span class="line"></span> &nbsp; Разрешил <span class="line"></span></p>
        }

        <table>
            <thead>
                <tr>
                    <th rowspan="2">№ п/п</th>
                    <th rowspan="2">@(d.IsOutput ? "Продукция: наименование" : "Материальные ценности: наименование")</th>
                    <th rowspan="2">@(d.IsOutput ? "Код продукции" : "Номенклатурный номер")</th>
                    <th colspan="2">Единица измерения</th>
                    @if (d.IsOutput)
                    {
                        <th rowspan="2">Количество</th>
                    }
                    else
                    {
                        <th colspan="2">Количество</th>
                    }
                    <th rowspan="2">Цена, руб. коп.</th>
                    <th rowspan="2">Сумма без учёта НДС, руб. коп.</th>
                    <th rowspan="2">Порядковый номер по складской картотеке</th>
                </tr>
                <tr>
                    <th>код по ОКЕИ</th><th>наименование</th>
                    @if (!d.IsOutput) { <th>затребовано</th><th>отпущено</th> }
                </tr>
            </thead>
            <tbody>
                @foreach (var l in d.Lines)
                {
                    <tr>
                        <td class="num">@l.No</td>
                        <td>@l.Name</td>
                        <td>@l.Code</td>
                        <td>@l.UnitCode</td>
                        <td>@l.UnitName</td>
                        @if (!d.IsOutput) { <td class="num">@Qty(l.Quantity)</td> }
                        <td class="num">@Qty(l.Quantity)</td>
                        <td class="num">@(l.Price?.ToString("N2", Ru) ?? "")</td>
                        <td class="num">@(l.Amount?.ToString("N2", Ru) ?? "")</td>
                        <td></td>
                    </tr>
                }
                <tr>
                    <td colspan="@(d.IsOutput ? 5 : 6)" style="text-align: right"><b>Итого</b></td>
                    <td class="num">@Qty(d.Lines.Sum(l => l.Quantity))</td>
                    <td></td>
                    <td class="num">@(d.Total?.ToString("N2", Ru) ?? "")</td>
                    <td></td>
                </tr>
            </tbody>
        </table>
        @if (d.Comment is not null)
        {
            <p class="small">Примечание: @d.Comment</p>
        }

        <div class="sign">
            <div>@(d.IsOutput ? "Сдал" : "Отпустил") <span class="line"></span><div class="small">должность, подпись, расшифровка подписи</div></div>
            <div>@(d.IsOutput ? "Принял" : "Получил") <span class="line"></span><div class="small">должность, подпись, расшифровка подписи</div></div>
        </div>
    </div>
}

@code {
    [Parameter]
    public long Id { get; set; }

    [SupplyParameterFromQuery(Name = "order")]
    public long? OrderId { get; set; }

    private string BackHref => OrderId is { } o ? $"production-orders/{o}" : "production-orders";

    private ProductionPrintDto? _doc;
    private string? _error;

    private static readonly CultureInfo Ru = CultureInfo.GetCultureInfo("ru-RU");

    private static string Qty(decimal q) => Quantities.Format(q);

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            _doc = await Print.DocumentAsync(Id);
        }
        catch (Exception ex) when (UiErrors.IsUserFacing(ex))
        {
            _error = UiErrors.Message(ex);
        }
    }
}
