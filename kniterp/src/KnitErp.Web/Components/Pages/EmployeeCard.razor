@page "/employees/{Id:long}"
@using KnitErp.Application.Hr
@using KnitErp.Application.Structure
@using KnitErp.Domain.Hr
@using KnitErp.Domain.Structure
@using KnitErp.Web.Components.Shared
@inject EmployeeAgreementService Agreements
@inject EmployeeService Employees
@inject PersonalDataService PersonalData
@inject PersonnelOrderService Orders
@inject EmployeeDataRequestService DataRequests
@inject IJSRuntime JS

<PageTitle>@(_employee?.FullName ?? L("Сотрудник")) — knitERP</PageTitle>

@* D200–D202: карточка сотрудника; персональные данные — отдельное право, открываются по кнопке, каждое открытие — в журнале. *@
@if (_denied is not null)
{
    <AccessDenied Message="@_denied" />
}
else if (_notFound)
{
    <p>@L("Сотрудник не найден.") <a href="employees">@L("К списку сотрудников")</a></p>
}
else if (_employee is null || _summary is null)
{
    <p class="muted">@L("Загрузка…")</p>
}
else
{
    var e = _employee;
    <div class="page-head">
        <h1>@e.FullName <span class="tag @(e.Status == EmploymentStatus.Working ? "ok" : e.Status == EmploymentStatus.OnLeave ? "warn" : "bad")">@L(e.StatusName)</span></h1>
        <div class="row-actions">
            @if (_summary.CanViewPersonalData)
            {
                <a class="button secondary" href="print/employee-t2/@e.Id" target="_blank" rel="noopener">@L("Личная карточка Т-2")</a>
            }
            <a class="button secondary" href="employees">@L("← К сотрудникам")</a>
        </div>
    </div>

    @if (_message is not null)
    {
        <div class="@(_isError ? "flash error" : "flash")" role="@(_isError ? "alert" : "status")">@_message</div>
    }

    <dl class="facts">
        <dt>@L("Табельный номер")</dt><dd>@e.PersonnelNumber</dd>
        <dt>@L("Подразделение")</dt><dd>@e.DepartmentName</dd>
        <dt>@L("Должность")</dt><dd>@e.PositionName</dd>
        <dt>@L("Дата приёма")</dt><dd>@e.HiredOn.ToString("dd.MM.yyyy")</dd>
        @if (e.DismissedOn is { } dismissed)
        {
            <dt>@L("Дата увольнения")</dt><dd>@dismissed.ToString("dd.MM.yyyy")</dd>
        }
        <dt>@L("Учётная запись")</dt><dd>@(e.UserEmail ?? "—")</dd>
        <dt>@L("Согласие на обработку ПДн")</dt>
        <dd>
            <span class="tag @(_summary.State == ConsentState.Valid ? "ok" : "warn")">@ConsentText(_summary.State)</span>
            @if (_summary.ValidUntil is { } until && _summary.State == ConsentState.Valid)
            {
                <span class="muted">@L("до {0}", until.ToString("dd.MM.yyyy"))</span>
            }
        </dd>
    </dl>

    @if (_summary.State != ConsentState.Valid)
    {
        <div class="flash error" role="alert">@L("Нет действующего согласия на обработку персональных данных (ст. 9 152-ФЗ). Получите подписанное согласие и отметьте его в карточке.")</div>
    }

    @if (_completeness is { } c)
    {
        @* D226: заполненность карточки — только факт наличия, без значений. *@
        <div class="panel">
            <h2>@L("Заполненность карточки: {0} %", c.Percent)</h2>
            <progress value="@c.Percent" max="100" style="width: 100%" aria-label="@L("Заполненность карточки")"></progress>
            @if (c.Missing.Count > 0)
            {
                <p class="muted small">@L("Не хватает:") @string.Join(", ", c.Missing.Select(m => L(m)))</p>
            }
        </div>
    }

    @if (_dataStatus is { } ds)
    {
        @* D125: анкета сотрудника по ссылке — выдача ссылки и проверка присланного (в карточку — только после «Принять»). *@
        <div class="panel invite-panel">
            <h2>@L("Анкета сотрудника")</h2>
            @if (ds.Pending > 0)
            {
                <p class="flash error" role="status">@L("Данные от сотрудника — проверить ({0})", ds.Pending)</p>
                @if (ds.CanReview && _reviews is null)
                {
                    <button type="button" @onclick="ShowReviewsAsync" disabled="@_busy">@L("Показать анкету")</button>
                    <p class="muted small">@L("Просмотр записывается в журнал аудита.")</p>
                }
            }
            @if (ds.LinkExpiresAtUtc is { } linkUntil)
            {
                <p class="muted small">@L("Ссылка для заполнения действует до {0}.", TimeZones.ToLocal(linkUntil, CurrentAccess.TimeZoneId).ToString("dd.MM.yyyy HH:mm"))</p>
            }
            @if (ds.LastRejectReason is { } rejectReason)
            {
                <p class="muted small">@L("Последняя анкета отклонена: {0}", rejectReason)</p>
            }
            @if (_reviews is { } reviews)
            {
                @foreach (var r in reviews)
                {
                    <h3>@L("Анкета от {0}", TimeZones.ToLocal(r.SubmittedAtUtc, CurrentAccess.TimeZoneId).ToString("dd.MM.yyyy HH:mm"))</h3>
                    @if (r.Fields.Count > 0)
                    {
                        <div class="scroll">
                            <table class="compact data-compare">
                                <thead><tr><th>@L("Поле")</th><th>@L("В карточке")</th><th>@L("Прислал сотрудник")</th></tr></thead>
                                <tbody>
                                    @foreach (var f in r.Fields)
                                    {
                                        <tr class="@(f.Differs ? "differs" : null)"><td>@L(f.Name)</td><td>@(f.Current ?? "—")</td><td>@f.Submitted</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    @if (r.Files.Count > 0)
                    {
                        <ul>
                            @foreach (var file in r.Files)
                            {
                                <li>@L(file.KindName): <a href="employees/data-files/@file.Id" download data-enhance-nav="false">@file.FileName</a> <span class="muted small">@(file.SizeBytes / 1024 + 1) @L("КБ")</span></li>
                            }
                        </ul>
                    }
                    <p class="muted small">
                        @L("Согласие на обработку ПДн дано в анкете (редакция {0}), адрес отправки: {1}.", r.ConsentVersion, r.ClientAddress ?? "—")
                        @if (r.ConsentWillBeRecorded)
                        {
                            @L("При принятии в карточке будет отмечено согласие от даты отправки.")
                        }
                    </p>
                    @if (r.CanDecide)
                    {
                        <div class="actions">
                            <button type="button" @onclick="() => AcceptDataAsync(r)" disabled="@_busy">@L("Принять")</button>
                        </div>
                        <div class="inline-form">
                            <label>@L("Причина отказа") <input @bind="_rejectReason" maxlength="500" disabled="@_busy" /></label>
                            <button type="button" class="secondary" @onclick="() => RejectDataAsync(r)" disabled="@_busy">@L("Отклонить")</button>
                        </div>
                    }
                }
            }
            @if (ds.CanIssue && e.Status != EmploymentStatus.Dismissed)
            {
                <div class="actions">
                    <button type="button" class="secondary" @onclick="IssueDataLinkAsync" disabled="@_busy">@L("Ссылка для заполнения данных")</button>
                </div>
                <p class="muted small">@L("Сотрудник откроет ссылку без входа и заполнит недостающие данные. Ссылка одноразовая и действует 4 часа; новая ссылка отменяет прежнюю.")</p>
            }
            @if (_dataLink is { } link)
            {
                var linkEnds = TimeZones.ToLocal(link.ExpiresAtUtc, CurrentAccess.TimeZoneId).ToString("dd.MM.yyyy HH:mm");
                @if (link.Sent == true)
                {
                    <p class="invite-sent">✓ @L("Письмо со ссылкой отправлено на {0}. Ссылка действует до {1}.", link.Email ?? "", linkEnds)</p>
                }
                else if (link.Sent == false)
                {
                    <p class="error" role="alert">@L("Письмо не отправлено. Передайте ссылку сами — кнопками ниже. Ссылка действует до {0}.", linkEnds)</p>
                }
                else if (link.MailAvailable)
                {
                    <p class="muted">@L("У сотрудника нет почты в карточке — передайте ссылку сами: «Поделиться» или «Копировать». Действует до {0}.", linkEnds)</p>
                }
                else
                {
                    <p class="muted">@L("Почта сервера не настроена — передайте ссылку сами: «Поделиться» (мессенджер на телефоне) или «Копировать». Ссылка личная, действует до {0}.", linkEnds)</p>
                }
                <label for="employee-data-link">@L("Ссылка")</label>
                <input id="employee-data-link" readonly value="@link.Link" style="width: 100%" onfocus="this.select()" />
                <div class="actions">
                    <button type="button" @onclick="CopyDataLinkAsync">@(_copied ? L("Скопировано ✓") : L("Копировать ссылку"))</button>
                    @if (_canShare)
                    {
                        <button type="button" class="secondary" @onclick="ShareDataLinkAsync">@L("Поделиться")</button>
                    }
                    <button type="button" class="secondary" @onclick="() => _dataLink = null">@L("Готово")</button>
                </div>
            }
        </div>
    }

    @if (_agreementStatus is { Count: > 0 } ags)
    {
        @* D227: документы перед доступом — подписаны ли, печать с данными сотрудника, отметка бумажной подписи. *@
        <div class="panel">
            <h2>@L("Документы перед доступом")</h2>
            <ul>
                @foreach (var a in ags)
                {
                    <li>
                        @L(a.Title):
                        @if (a.Signature is { } sig)
                        {
                            <span class="tag ok">@L("подписано")</span>
                            <span class="muted small">@(sig.Method == KnitErp.Domain.Hr.AgreementMethod.Electronic ? L("электронно") : L("на бумаге")),
                                @TimeZones.ToLocal(sig.SignedAtUtc, CurrentAccess.TimeZoneId).ToString("dd.MM.yyyy HH:mm")</span>
                            @if (!sig.TextMatches) { <span class="tag warn">@L("данные изменились после подписания")</span> }
                        }
                        else
                        {
                            <span class="tag warn">@L("не подписано")</span>
                            @if (a.CanMarkPaper)
                            {
                                <button type="button" class="secondary" @onclick="() => MarkPaperAsync(a.Kind)" disabled="@_busy">@L("Подписан на бумаге")</button>
                            }
                        }
                        @if (_summary.CanViewPersonalData)
                        {
                            <a href="print/employee-agreement/@Id/@((int)a.Kind)" target="_blank" rel="noopener">@L("Печать")</a>
                        }
                    </li>
                }
            </ul>
            <p class="muted small">@L("Сотрудник со своей учётной записью подписывает их паролем при первом входе. Тексты — типовые: проверьте их у юриста.")</p>
        </div>
    }

    <TagPicker Entity="KnitErp.Domain.Tagging.TaggedEntity.Employee" EntityId="e.Id" />

    @if (_history is { Count: > 0 })
    {
        <h2>@L("История назначений")</h2>
        <div class="scroll">
            <table class="compact">
                <thead><tr><th>@L("Дата")</th><th>@L("Событие")</th><th>@L("Подразделение и должность")</th><th class="num opt">@L("Ставка")</th>
                    @if (_history.Any(h => h.Salary is not null)) { <th class="num opt">@L("Оклад")</th> }</tr></thead>
                <tbody>
                    @foreach (var h in _history)
                    {
                        <tr>
                            <td>@h.EffectiveFrom.ToString("dd.MM.yyyy")@(h.EffectiveTo is { } to ? " – " + to.ToString("dd.MM.yyyy") : "")</td>
                            <td>
                                @if (h.OrderId is { } oid)
                                {
                                    <a href="hr/orders/@oid">@L(h.KindName) № @h.OrderNumber</a>
                                }
                                else
                                {
                                    @L(h.KindName)
                                }
                                @if (h.Note is not null)
                                {
                                    <div class="muted">@h.Note</div>
                                }
                            </td>
                            <td>@h.Department, @h.Position</td>
                            <td class="num">@h.Rate.ToString("0.##")</td>
                            @if (_history.Any(x => x.Salary is not null)) { <td class="num">@h.Salary?.ToString("N2")</td> }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (_summary.CanViewPersonalData)
    {
        <h2>@L("Персональные данные")</h2>
        @if (_pd is null)
        {
            <p class="muted">@L("Персональные данные скрыты. Каждое открытие записывается в журнал аудита: кто и когда смотрел.")</p>
            <button type="button" class="secondary" @onclick="ShowPersonalDataAsync" disabled="@_busy">@L("Показать персональные данные")</button>
        }
        else
        {
            var canEdit = _pd.CanEdit && e.Status != EmploymentStatus.Dismissed;
            <EditForm Model="_form" OnValidSubmit="SavePersonalDataAsync" FormName="personal-data">
                <fieldset disabled="@(!canEdit || _busy)" title="@((!canEdit) ? L("Нет права на изменение") : null)" style="border: 0; padding: 0; margin: 0; min-width: 0">
                    <div class="grid">
                        <label>
                            @L("Пол")
                            <InputSelect @bind-Value="_form.Gender">
                                <option value="@Gender.NotSet">@L("не указан")</option>
                                <option value="@Gender.Female">@L("женский")</option>
                                <option value="@Gender.Male">@L("мужской")</option>
                            </InputSelect>
                        </label>
                        <label>@L("Место рождения") <InputText @bind-Value="_form.BirthPlace" maxlength="500" /></label>
                        <label>@L("Гражданство") <InputText @bind-Value="_form.Citizenship" maxlength="100" /></label>
                        <label>@L("Паспорт: серия и номер") <InputText @bind-Value="_form.PassportNumber" maxlength="20" /></label>
                        <label>@L("Кем выдан") <InputText @bind-Value="_form.PassportIssuer" maxlength="500" /></label>
                        <label>@L("Дата выдачи") <InputDate @bind-Value="_form.PassportIssuedOn" /></label>
                        <label>@L("Код подразделения") <InputText @bind-Value="_form.PassportDivisionCode" maxlength="7" placeholder="000-000" /></label>
                        <label>@L("СНИЛС") <InputText @bind-Value="_form.Snils" maxlength="14" placeholder="000-000-000 00" /></label>
                        <label>@L("ИНН") <InputText @bind-Value="_form.Inn" maxlength="12" inputmode="numeric" /></label>
                        <label>@L("Адрес регистрации") <InputText @bind-Value="_form.RegistrationAddress" maxlength="500" /></label>
                        <label>@L("Фактический адрес") <InputText @bind-Value="_form.ActualAddress" maxlength="500" /></label>
                        <label>@L("Телефон") <InputText @bind-Value="_form.Phone" maxlength="20" inputmode="tel" /></label>
                        <label>@L("Личная почта") <InputText @bind-Value="_form.PersonalEmail" type="email" maxlength="254" /></label>
                        <label>@L("Образование") <InputText @bind-Value="_form.Education" maxlength="500" /></label>
                        <label>@L("Профессия") <InputText @bind-Value="_form.Profession" maxlength="100" /></label>
                        <label>@L("Семейное положение") <InputText @bind-Value="_form.MaritalStatus" maxlength="100" /></label>
                        <label>@L("Состав семьи") <InputText @bind-Value="_form.FamilyMembers" maxlength="500" /></label>
                    </div>
                </fieldset>
                @if (_formError is not null)
                {
                    <div class="error" role="alert">@_formError</div>
                }
                <div class="actions">
                    @if (canEdit)
                    {
                        <button type="submit" disabled="@_busy">@L("Сохранить персональные данные")</button>
                    }
                    <button type="button" class="secondary" @onclick="HidePersonalData" disabled="@_busy">@L("Скрыть")</button>
                </div>
            </EditForm>

            <h2>@L("Согласие на обработку персональных данных")</h2>
            <p class="muted">@L("Статья 9 Федерального закона № 152-ФЗ: письменное согласие с датой; срок можно не указывать — тогда до отзыва.")</p>
            @if (canEdit)
            {
                <div class="inline-form">
                    <label>@L("Дата согласия") <InputDate @bind-Value="_consentGiven" /></label>
                    <label>@L("Действует до (необязательно)") <InputDate @bind-Value="_consentUntil" /></label>
                    <button type="button" @onclick="GiveConsentAsync" disabled="@_busy">@L("Отметить согласие")</button>
                    @if (_pd.Consent == ConsentState.Valid)
                    {
                        <button type="button" class="secondary" @onclick="RevokeConsentAsync" disabled="@_busy">@L("Отзыв согласия")</button>
                    }
                </div>
            }

            <h2>@L("Документы сотрудника")</h2>
            @if (_pd.Scans.FirstOrDefault(d => d.Kind == EmployeeDocumentKind.Photo) is { } photo)
            {
                <img src="employees/consent-scans/@photo.Id" alt="@L("Фотография")" style="max-width: 160px; max-height: 200px; border-radius: 8px" />
            }
            @if (canEdit)
            {
                <div class="inline-form">
                    <label>
                        @L("Вид документа")
                        <select @bind="_documentKind" disabled="@_busy">
                            @foreach (var k in EmployeeDocumentKinds.All)
                            {
                                <option value="@k">@L(EmployeeDocumentKinds.Name(k))</option>
                            }
                        </select>
                    </label>
                    <label>
                        @(_documentKind == EmployeeDocumentKind.Photo ? L("Файл (JPEG или PNG, до 3 МБ)") : L("Файл (PDF, JPEG или PNG, до 3 МБ)"))
                        <InputFile OnChange="UploadScanAsync" accept="@(_documentKind == EmployeeDocumentKind.Photo ? ".jpg,.jpeg,.png" : ".pdf,.jpg,.jpeg,.png")" disabled="@_busy" />
                    </label>
                </div>
            }
            @if (_pd.Scans.Count > 0)
            {
                <ul>
                    @foreach (var s in _pd.Scans)
                    {
                        <li>@L(s.KindName): <a href="employees/consent-scans/@s.Id" target="_blank" rel="noopener">@s.FileName</a> <span class="muted">@TimeZones.ToLocal(s.UploadedAtUtc, CurrentAccess.TimeZoneId).ToString("dd.MM.yyyy HH:mm")</span></li>
                    }
                </ul>
            }
            else
            {
                <p class="muted">@L("Документов пока нет.")</p>
            }
        }
    }

    <p class="muted">@L("В обсуждении видны только ФИО и должность. Не пишите сюда паспортные данные, СНИЛС, ИНН, адрес и зарплату.")</p>
    <Discussion Target="KnitErp.Domain.Tagging.TaggedEntity.Employee" TargetId="Id" />
}

@code {
    [Parameter]
    public long Id { get; set; }

    [CascadingParameter]
    public CurrentAccessDto CurrentAccess { get; set; } = default!;

    private EmployeeRowDto? _employee;
    private ConsentSummaryDto? _summary;
    private PersonalDataDto? _pd;
    private EmployeeCompleteness? _completeness;
    private IReadOnlyList<AgreementStatusDto>? _agreementStatus;
    private EmployeeDataStatusDto? _dataStatus;
    private IReadOnlyList<EmployeeDataReviewDto>? _reviews;
    private EmployeeDataLinkDto? _dataLink;
    private string? _rejectReason;
    private bool _copied;
    private bool _canShare;
    private EmployeeDocumentKind _documentKind = EmployeeDocumentKind.Passport;
    private IReadOnlyList<EmploymentRecordDto>? _history;
    private PersonalDataForm _form = new();
    private DateOnly? _consentGiven;
    private DateOnly? _consentUntil;
    private bool _busy;
    private bool _notFound;
    private string? _denied;
    private string? _message;
    private bool _isError;
    private string? _formError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _employee = await Employees.GetAsync(Id);
            _summary = await PersonalData.SummaryAsync(Id);
            _history = await Orders.HistoryAsync(Id);
            await LoadCompletenessAsync();
        }
        catch (AccessDeniedException ex)
        {
            _denied = UiErrors.Message(ex);
        }
        catch (NotFoundException)
        {
            _notFound = true;
        }
    }

    /// <summary>D125: новая ссылка анкеты (прежняя отменяется), письмо сотруднику — если почта настроена и адрес известен.</summary>
    private Task IssueDataLinkAsync() => RunAsync(async () =>
    {
        _copied = false;
        _dataLink = await DataRequests.IssueAsync(Id);
        _message = L("Выдана ссылка для заполнения данных. Прежняя больше не действует.");
        _dataStatus = await DataRequests.StatusAsync(Id);
    }, atForm: false);

    private Task ShowReviewsAsync() => RunAsync(async () => _reviews = await DataRequests.ReviewAsync(Id), atForm: false);

    private Task AcceptDataAsync(EmployeeDataReviewDto review) => RunAsync(async () =>
    {
        await DataRequests.AcceptAsync(review.Id, review.RowVersion);
        _message = L("Анкета принята: данные перенесены в карточку.");
        await AfterReviewAsync();
    }, atForm: false);

    private Task RejectDataAsync(EmployeeDataReviewDto review) => RunAsync(async () =>
    {
        await DataRequests.RejectAsync(review.Id, _rejectReason, review.RowVersion);
        _message = L("Анкета отклонена.");
        await AfterReviewAsync();
    }, atForm: false);

    private async Task AfterReviewAsync()
    {
        _rejectReason = null;
        _reviews = null;
        _employee = await Employees.GetAsync(Id);
        if (_pd is not null)
        {
            await ReloadPersonalDataAsync();
        }
        else
        {
            _summary = await PersonalData.SummaryAsync(Id);
            await LoadCompletenessAsync();
        }
    }

    private async Task CopyDataLinkAsync()
    {
        if (_dataLink is not null)
        {
            _copied = await JS.InvokeAsync<bool>("kniterp.copy", _dataLink.Link);
        }
    }

    private async Task ShareDataLinkAsync()
    {
        if (_dataLink is not null)
        {
            await JS.InvokeAsync<bool>("kniterp.share", "knitERP", L("Ссылка для заполнения ваших данных (личная, не пересылайте):"), _dataLink.Link);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _canShare = await JS.InvokeAsync<bool>("kniterp.canShare");
            if (_canShare)
            {
                StateHasChanged();
            }
        }
    }

    private Task ShowPersonalDataAsync() => RunAsync(async () =>
    {
        _pd = await PersonalData.GetAsync(Id);
        _form = PersonalDataForm.From(_pd.Values);
        _consentGiven = _pd.ConsentGivenOn ?? Today();
        _consentUntil = _pd.ConsentValidUntil;
    });

    private void HidePersonalData()
    {
        _pd = null;
        _form = new PersonalDataForm();
        _formError = null;
    }

    private Task SavePersonalDataAsync() => RunAsync(async () =>
    {
        await PersonalData.SaveAsync(Id, _form.ToValues(), _pd!.RowVersion);
        _message = L("Персональные данные сохранены.");
        await ReloadPersonalDataAsync();
    });

    private Task GiveConsentAsync() => RunAsync(async () =>
    {
        await PersonalData.GiveConsentAsync(Id, _consentGiven ?? Today(), _consentUntil, _pd!.RowVersion);
        _message = L("Согласие отмечено.");
        await ReloadPersonalDataAsync();
    });

    private Task RevokeConsentAsync() => RunAsync(async () =>
    {
        await PersonalData.RevokeConsentAsync(Id, Today(), _pd!.RowVersion);
        _message = L("Отзыв согласия отмечен.");
        await ReloadPersonalDataAsync();
    });

    private Task MarkPaperAsync(KnitErp.Domain.Hr.AgreementKind kind) => RunAsync(async () =>
    {
        await Agreements.MarkPaperAsync(Id, kind);
        _message = L("Отмечено: подписан на бумаге.");
        await LoadCompletenessAsync();
    });

    private Task UploadScanAsync(InputFileChangeEventArgs args) => RunAsync(async () =>
    {
        var file = args.File;
        if (file.Size > ConsentScan.MaxBytes)
        {
            throw new KnitErp.Domain.Common.BusinessRuleException("hr.consent.scan_size", L("{0}: файл до 3 МБ.", L(EmployeeDocumentKinds.Name(_documentKind))));
        }

        using var buffer = new MemoryStream();
        await using (var stream = file.OpenReadStream(ConsentScan.MaxBytes))
        {
            await stream.CopyToAsync(buffer);
        }

        await PersonalData.AddDocumentAsync(Id, _documentKind, file.Name, file.ContentType, buffer.ToArray());
        _message = L("Документ загружен: {0}.", L(EmployeeDocumentKinds.Name(_documentKind)));
        await ReloadPersonalDataAsync();
    });

    private async Task ReloadPersonalDataAsync()
    {
        _pd = await PersonalData.GetAsync(Id);
        _form = PersonalDataForm.From(_pd.Values);
        _summary = await PersonalData.SummaryAsync(Id);
        await LoadCompletenessAsync();
    }

    /// <summary>Показатель — только тем, кому он положен (иначе отказ засорит журнал).</summary>
    private async Task LoadCompletenessAsync()
    {
        _completeness = _summary!.CanViewPersonalData || CurrentAccess.Has(Permissions.EmployeeEdit) ? await PersonalData.CompletenessAsync(Id) : null;
        _agreementStatus = _summary!.CanViewPersonalData || CurrentAccess.Has(Permissions.EmployeeEdit) ? await Agreements.StatusAsync(Id) : null;
        _dataStatus = await DataRequests.StatusAsync(Id); // D125: null — блок не для этой роли
    }

    /// <summary>Одна операция за раз: у вкладки один DbContext.</summary>
    private async Task RunAsync(Func<Task> action, bool atForm = true)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _message = null;
        _formError = null;
        try
        {
            await action();
            _isError = false;
        }
        catch (Exception ex) when (UiErrors.IsUserFacing(ex))
        {
            // Ошибка формы ПДн — у формы, остальные — сообщением вверху.
            if (_pd is not null && atForm)
            {
                _formError = UiErrors.Message(ex);
            }
            else
            {
                _message = UiErrors.Message(ex);
                _isError = true;
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private static string ConsentText(ConsentState state) => state switch
    {
        ConsentState.Valid => L("Согласие действует"),
        ConsentState.Expired => L("Срок согласия истёк"),
        ConsentState.Revoked => L("Согласие отозвано"),
        _ => L("Согласия нет"),
    };

    private DateOnly Today() => DateOnly.FromDateTime(TimeZones.ToLocal(DateTime.UtcNow, CurrentAccess.TimeZoneId));

    private sealed class PersonalDataForm
    {
        public Gender Gender { get; set; }
        public string? BirthPlace { get; set; }
        public string? Citizenship { get; set; }
        public string? PassportNumber { get; set; }
        public string? PassportIssuer { get; set; }
        public DateOnly? PassportIssuedOn { get; set; }
        public string? PassportDivisionCode { get; set; }
        public string? Snils { get; set; }
        public string? Inn { get; set; }
        public string? RegistrationAddress { get; set; }
        public string? ActualAddress { get; set; }
        public string? Phone { get; set; }
        public string? Education { get; set; }
        public string? Profession { get; set; }
        public string? MaritalStatus { get; set; }
        public string? FamilyMembers { get; set; }
        public string? PersonalEmail { get; set; }

        public static PersonalDataForm From(PersonalDataValues v) => new()
        {
            Gender = v.Gender, BirthPlace = v.BirthPlace, Citizenship = v.Citizenship, PassportNumber = v.PassportNumber,
            PassportIssuer = v.PassportIssuer, PassportIssuedOn = v.PassportIssuedOn, PassportDivisionCode = v.PassportDivisionCode,
            Snils = v.Snils is null ? null : PersonIds.FormatSnils(v.Snils), Inn = v.Inn, RegistrationAddress = v.RegistrationAddress,
            ActualAddress = v.ActualAddress, Phone = v.Phone, Education = v.Education, Profession = v.Profession,
            MaritalStatus = v.MaritalStatus, FamilyMembers = v.FamilyMembers, PersonalEmail = v.PersonalEmail,
        };

        public PersonalDataValues ToValues() => new(Gender, BirthPlace, Citizenship, PassportNumber, PassportIssuer, PassportIssuedOn,
            PassportDivisionCode, Snils, Inn, RegistrationAddress, ActualAddress, Phone, Education, Profession, MaritalStatus, FamilyMembers, PersonalEmail);
    }
}
