@page "/reports/customer-balances"
@using KnitErp.Application.Sales
@inject SalesService Sales

<PageTitle>@L("Расчёты с покупателями") — knitERP</PageTitle>

@if (_denied is not null)
{
    <AccessDenied Message="@_denied" />
}
else if (_rows is null)
{
    <p class="muted">@L("Загрузка…")</p>
}
else
{
    <h1>@L("Расчёты с покупателями")</h1>
    <p class="muted">@L("Отгружено и возвращено — по проведённым документам по заказам и ценам заказов с НДС; оплачено — действующие оплаты. Долг больше нуля — покупатель должен нам, меньше нуля — его аванс. Отгрузки без заказа сюда не входят: у них нет цены.")</p>

    <form data-autosubmit class="inline-form" @onsubmit="ReloadAsync">
        <label>@L("На дату") <input type="date" @bind="_asOf" /></label>
        <button type="submit" class="filter-apply secondary" disabled="@_busy">@L("Показать")</button>
    </form>

    <div class="scroll">
        <table>
            <thead><tr><th>@L("Покупатель")</th><th class="num">@L("Отгружено")</th><th class="num opt">@L("Возвращено")</th><th class="num">@L("Оплачено")</th><th class="num">@L("Долг")</th></tr></thead>
            <tbody>
                @if (_rows.Count == 0)
                {
                    <tr><td colspan="5" class="muted">@L("Расчётов пока нет.")</td></tr>
                }
                @foreach (var b in _rows)
                {
                    <tr>
                        <td><a href="settlement-statement?counterparty=@b.CustomerId" title="@L("Акт сверки")">@b.Customer</a></td>
                        <td class="num">@Amounts.Format(b.Shipped)</td>
                        <td class="num">@Amounts.Format(b.Returned)</td>
                        <td class="num">@Amounts.Format(b.Paid)</td>
                        <td class="num"><b class="@(b.Debt > 0 ? "warn-text" : "")">@Amounts.Format(b.Debt)</b></td>
                    </tr>
                }
            </tbody>
            @if (_rows.Count > 0)
            {
                <tfoot><tr><td><b>@L("Итого")</b></td><td class="num">@Amounts.Format(_rows.Sum(r => r.Shipped))</td><td class="num">@Amounts.Format(_rows.Sum(r => r.Returned))</td><td class="num">@Amounts.Format(_rows.Sum(r => r.Paid))</td><td class="num"><b>@Amounts.Format(_rows.Sum(r => r.Debt))</b></td></tr></tfoot>
            }
        </table>
    </div>
}

@code {
    [CascadingParameter]
    public CurrentAccessDto CurrentAccess { get; set; } = default!;

    private IReadOnlyList<CustomerBalanceDto>? _rows;
    private bool _busy;
    private string? _denied;
    private DateTime? _asOf;

    protected override async Task OnInitializedAsync()
    {
        _asOf ??= TimeZones.Today(CurrentAccess.TimeZoneId); // D809: отчёт «на дату» — сегодня организации, а не пустое поле
        try
        {
            await LoadAsync();
        }
        catch (AccessDeniedException ex)
        {
            _denied = UiErrors.Message(ex);
        }
    }

    private async Task LoadAsync() => _rows = await Sales.BalancesAsync(_asOf is { } d ? DateOnly.FromDateTime(d) : null);

    private async Task ReloadAsync()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        try
        {
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }
}
