@page "/catalog/items/{Id:long}"
@using KnitErp.Application.Catalog
@using KnitErp.Application.Common
@using KnitErp.Domain.Catalog
@using KnitErp.Domain.Common
@inject NomenclatureService Nomenclature
@inject ModificationService Modifications
@inject BundleService Bundles
@inject ItemTradeService Trade
@inject PackService PackList
@inject ItemSupplierService Suppliers
@inject CatalogService Catalog
@inject CatalogSettingsService CatalogSettings
@inject ItemCodesService Codes
@inject ItemCopyService Copies
@inject ValueSetService ValueSets
@inject NavigationManager Nav
@inject CounterpartyService CounterpartyList

<PageTitle>@(_item?.Name ?? L("Позиция")) — knitERP</PageTitle>

@if (_denied is not null)
{
    <AccessDenied Message="@_denied" />
}
else if (_notFound)
{
    <h1>@L("Позиция не найдена")</h1>
    <p><a href="catalog">@L("К номенклатуре")</a></p>
}
else if (_item is null)
{
    <p class="muted">@L("Загрузка…")</p>
}
else
{
    var editable = _item.CanEdit && !_item.IsArchived;
    <p><a href="catalog">@L("← Номенклатура")</a></p>
    <div class="page-head">
        <h1>@_item.Name <span class="tag">@L(_item.TypeName)</span> @if (_item.IsArchived) { <span class="tag">@L("архив")</span> }</h1>
    </div>
    <TagPicker Entity="KnitErp.Domain.Tagging.TaggedEntity.Item" EntityId="Id" />

    @if (_message is not null)
    {
        <div class="@(_isError ? "flash error" : "flash")" role="@(_isError ? "alert" : "status")">@_message</div>
    }

    @if (_variants?.Parent is { } parent)
    {
        <p class="muted">@L("Модификация позиции") <a href="catalog/items/@parent.Id">@parent.Code — @parent.Name</a>:
            @string.Join(", ", _variants.Values.Select(v => $"{v.Characteristic}: {v.Value}"))</p>
    }

    <div class="item-head">
        @if (_photos.Count > 0)
        {
            <img class="item-main-photo" src="catalog/photos/@_photos[0].Id" alt="@_item.Name" />
        }
    <dl class="facts">
        <dt>@L("Код")</dt><dd>@_item.Code</dd>
        <dt>@L("Группа")</dt><dd>@(_item.GroupPath ?? L("без группы"))</dd>
        <dt>@L("Единица")</dt><dd>@_item.UnitSymbol</dd>
        @if (_item.IsStocked && _item.Stock is { } stock)
        {
            @* D118: остаток — только по складам области пользователя; без складских прав строки нет. *@
            <dt>@(_item.StockAllWarehouses ? L("Остаток на всех складах") : L("Остаток на ваших складах"))</dt><dd>@Quantities.Format(stock) @_item.UnitSymbol
                @if (_item.StockAllWarehouses && _item.Details.MinStock is { } min && stock < min) { <span class="tag bad">@L("ниже неснижаемого {0}", Quantities.Format(min))</span> }</dd>
        }
        else if (_item.Type == ItemType.Bundle)
        {
            <dt>@L("Склад")</dt><dd>@L("комплект не хранится на складе: доступность и списание — по компонентам")</dd>
        }
        else
        {
            <dt>@L("Склад")</dt><dd>@L("не хранится на складе: продаётся и покупается, закрывается актом или УПД")</dd>
        }
        <dt>@L("Предмет расчёта (чек)")</dt><dd>@(_item.IsStocked ? L("товар") : L("услуга"))</dd>
        @if (_item.Description is not null)
        {
            <dt>@L("Описание")</dt><dd>@_item.Description</dd>
        }
    </dl>
    </div>
    <p class="muted">@L("Код, наименование, тип, единица и НДС меняются в списке номенклатуры кнопкой «Изменить».")</p>

    @* Широкий экран: разделы карточки в две колонки, модификации — во всю ширину (замечание «пустая площадь»). *@
    <div class="card-flow">
    <section class="card-sec">
    <h2>@L("Сведения")</h2>
    <div class="panel">
        <form @onsubmit="SaveDetailsAsync">
            <div class="grid">
                <label>
                    @(_settings.RequireGroup && _variants?.Parent is null ? L("Группа (обязательна)") : L("Группа"))
                    <select @bind="_form.Group" disabled="@(!editable)">
                        <option value="">@L("без группы")</option>
                        @foreach (var g in _groups)
                        {
                            <option value="@g.Id">@g.Path</option>
                        }
                    </select>
                </label>
                <label>@L("Артикул") <input @bind="_form.Article" maxlength="@ItemDetailRules.ArticleMaxLength" disabled="@(!editable)" /></label>
                @if (_item.IsStocked)
                {
                    <label>@L("Страна происхождения (код ОКСМ)")
                        <input @bind="_form.Country" list="countries" maxlength="3" inputmode="numeric" placeholder="643" disabled="@(!editable)" />
                        <datalist id="countries">
                            @foreach (var c in ItemDetailRules.CommonCountries)
                            {
                                <option value="@c.Code">@c.Name</option>
                            }
                        </datalist>
                    </label>
                    <label>@L("Страна — краткое наименование") <input @bind="_form.CountryName" maxlength="@ItemDetailRules.CountryNameMaxLength" placeholder="@L("подставится по коду")" disabled="@(!editable)" /></label>
                    <label>@L("Номер декларации на товары") <input @bind="_form.Declaration" maxlength="@ItemDetailRules.DeclarationMaxLength" placeholder="10702010/101026/0012345" disabled="@(!editable)" /></label>
                    <label>@L("Код ТН ВЭД ЕАЭС") <input @bind="_form.TnVed" maxlength="13" inputmode="numeric" disabled="@(!editable)" /></label>
                    <label>@L("Вес, кг (на единицу)") <input @bind="_form.Weight" inputmode="decimal" disabled="@(!editable)" /></label>
                    <label>@L("Объём, м³ (на единицу)") <input @bind="_form.Volume" inputmode="decimal" disabled="@(!editable)" /></label>
                    <label>@L("Неснижаемый остаток") <input @bind="_form.MinStock" inputmode="decimal" disabled="@(!editable)" /></label>
                }
                @if (_item.CanSeePrices)
                {
                    <label>@L("Закупочная цена, без НДС") <input @bind="_form.PurchasePrice" inputmode="decimal" disabled="@(!editable)" /></label>
                }
                @foreach (var f in _item.CustomFields.Where(f => !f.IsArchived))
                {
                    var field = f;
                    @switch (field.Type)
                    {
                        case CustomFieldType.Flag:
                            <label class="inline"><input type="checkbox" checked="@(_form.Values.GetValueOrDefault(field.FieldId) == "true")"
                                                         @onchange="e => SetFlag(field.FieldId, e)" disabled="@(!editable)" /> @field.Name</label>
                            break;
                        case CustomFieldType.Catalog:
                            <label>
                                @field.Name
                                <select value="@_form.Values.GetValueOrDefault(field.FieldId)" @onchange="e => _form.Values[field.FieldId] = e.Value?.ToString()" disabled="@(!editable)">
                                    <option value="">—</option>
                                    @foreach (var entry in _entries.GetValueOrDefault(field.CatalogId ?? 0) ?? [])
                                    {
                                        <option value="@entry.Id">@entry.Display</option>
                                    }
                                    @if (field.Value is not null && field.Display is not null && (_entries.GetValueOrDefault(field.CatalogId ?? 0) ?? []).All(x => x.Id.ToString() != field.Value))
                                    {
                                        <option value="@field.Value">@field.Display (@L("в архиве"))</option>
                                    }
                                </select>
                            </label>
                            break;
                        case CustomFieldType.LongText:
                            @* D328: многострочный текст — во всю ширину формы. *@
                            <label class="wide">@field.Name <textarea rows="3" maxlength="@CustomFieldDefinition.ValueMaxLength" @onchange="e => _form.Values[field.FieldId] = e.Value?.ToString()" disabled="@(!editable)">@_form.Values.GetValueOrDefault(field.FieldId)</textarea></label>
                            break;
                        case CustomFieldType.Link:
                            <label>
                                @field.Name
                                <input type="url" inputmode="url" placeholder="https://" maxlength="@CustomFieldDefinition.ValueMaxLength" value="@_form.Values.GetValueOrDefault(field.FieldId)" @onchange="e => _form.Values[field.FieldId] = e.Value?.ToString()" disabled="@(!editable)" />
                                @if (field.Value is { } url && Uri.TryCreate(url, UriKind.Absolute, out var u) && u.Scheme is "http" or "https")
                                {
                                    <a href="@u.AbsoluteUri" target="_blank" rel="noopener noreferrer" class="small">@L("открыть")</a>
                                }
                            </label>
                            break;
                        case CustomFieldType.Counterparty:
                            <label>
                                @field.Name
                                <select value="@_form.Values.GetValueOrDefault(field.FieldId)" @onchange="e => _form.Values[field.FieldId] = e.Value?.ToString()" disabled="@(!editable)">
                                    <option value="">—</option>
                                    @foreach (var cp in _counterparties)
                                    {
                                        <option value="@cp.Id">@cp.Name</option>
                                    }
                                    @if (field.Value is not null && field.Display is not null && _counterparties.All(x => x.Id.ToString() != field.Value))
                                    {
                                        <option value="@field.Value">@field.Display (@L("в архиве"))</option>
                                    }
                                </select>
                            </label>
                            break;
                        case CustomFieldType.Date:
                            <label>@field.Name <input type="date" value="@_form.Values.GetValueOrDefault(field.FieldId)" @onchange="e => _form.Values[field.FieldId] = e.Value?.ToString()" disabled="@(!editable)" /></label>
                            break;
                        case CustomFieldType.Number:
                            <label>@field.Name <input inputmode="decimal" value="@_form.Values.GetValueOrDefault(field.FieldId)" @onchange="e => _form.Values[field.FieldId] = e.Value?.ToString()" disabled="@(!editable)" /></label>
                            break;
                        default:
                            <label>@field.Name <input maxlength="@CustomFieldDefinition.ValueMaxLength" value="@_form.Values.GetValueOrDefault(field.FieldId)" @onchange="e => _form.Values[field.FieldId] = e.Value?.ToString()" disabled="@(!editable)" /></label>
                            break;
                    }
                }
            </div>
            @if (editable)
            {
                <div class="actions">
                    <button type="submit" disabled="@_busy">@L("Сохранить сведения")</button>
                    <a href="catalog/settings" class="muted">@L("Доп. поля и свои справочники")</a>
                </div>
            }
        </form>
    </div>

    </section>
    @if (_trade is { } trade && _settings.Shows(CardBlocks.Trade))
    {
        var tradeEditable = trade.CanEdit;
        <section class="card-sec">
        <h2 style="margin-top: 20px">@L("Торговля и маркировка")</h2>
        <div class="panel">
            <form @onsubmit="SaveTradeAsync">
                <div class="grid">
                    <label>
                        @L("Признак предмета расчёта (чек)")
                        <select @bind="_tradeForm.Subject" disabled="@(!tradeEditable || _item.Type == ItemType.Service)">
                            @if (_item.Type == ItemType.Service)
                            {
                                <option value="@PaymentSubject.Service">@L("Услуга")</option>
                            }
                            else
                            {
                                <option value="@PaymentSubject.Goods">@L("Товар")</option>
                                <option value="@PaymentSubject.ExcisableGoods">@L("Подакцизный товар")</option>
                            }
                        </select>
                    </label>
                    @if (_item.Type != ItemType.Service)
                    {
                        <label class="inline"><input type="checkbox" @bind="_tradeForm.IsMarked" disabled="@(!tradeEditable)" /> @L("Маркируемый товар («Честный ЗНАК»)")</label>
                        <label>
                            @L("Вид продукции")
                            <select @bind="_tradeForm.Tracking" disabled="@(!tradeEditable || !_tradeForm.IsMarked)">
                                @foreach (var t in Marking.All.Where(t => t != TrackingType.None))
                                {
                                    <option value="@t">@TrackingName(t)</option>
                                }
                            </select>
                        </label>
                        <label>@L("GTIN (14 цифр)") <input @bind="_tradeForm.Gtin" inputmode="numeric" maxlength="16" placeholder="04601234567893" disabled="@(!tradeEditable)" /></label>
                    }
                    @if (trade.CanSeePrices)
                    {
                        <label>@L("Минимальная цена продажи") <input @bind="_tradeForm.MinPrice" inputmode="decimal" disabled="@(!tradeEditable)" /></label>
                    }
                </div>
                <p class="muted small">@L("Коды маркировки (DataMatrix), ЭДО и ГИС МТ подключаются отдельно; здесь — признак, вид продукции и GTIN из Национального каталога.")</p>
                @if (tradeEditable)
                {
                    <div class="actions"><button type="submit" disabled="@_busy">@L("Сохранить торговые сведения")</button></div>
                }
            </form>
        </div>
        </section>
    }

    @if (_bundle is { } bundle)
    {
        <section class="card-sec">
        <h2 style="margin-top: 20px">@L("Состав комплекта")</h2>
        <p class="muted">@L("Комплект продаётся одной строкой, а на складе списываются его компоненты. Изменение состава не меняет проведённые документы.")</p>
        <div class="totals" role="status">
            <span>@L("Можно собрать:") <b>@Quantities.Format(bundle.TotalAvailable) @bundle.UnitSymbol</b></span>
            @foreach (var w in bundle.Availability.Where(a => a.Available > 0))
            {
                <span>@w.Warehouse: <b>@Quantities.Format(w.Available)</b></span>
            }
        </div>
        <div class="scroll">
            <table class="compact">
                <thead>
                    <tr>
                        <th>@L("Компонент")</th><th class="num">@L("В комплекте")</th><th class="num">@L("Доступно")</th>
                        @if (bundle.CanSeePrices)
                        {
                            <th class="num opt">@L("Цена")</th><th class="num opt">@L("Себестоимость")</th>
                        }
                        @if (bundle.CanEdit)
                        {
                            <th></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (bundle.Components.Count == 0)
                    {
                        <tr><td colspan="6" class="muted">@L("Состав не задан — добавьте компоненты.")</td></tr>
                    }
                    @foreach (var c in bundle.Components)
                    {
                        var row = c;
                        <tr class="@(c.IsArchived ? "archived" : null)">
                            <td><a href="catalog/items/@c.ItemId">@c.Code</a> @c.Name @if (c.IsArchived) { <span class="tag bad">@L("в архиве")</span> }</td>
                            <td class="num">@Quantities.Format(c.Quantity) @c.UnitSymbol</td>
                            <td class="num">@Quantities.Format(c.Available)</td>
                            @if (bundle.CanSeePrices)
                            {
                                <td class="num">@(c.Price is { } p ? Amounts.Format(p) : "—")</td>
                                <td class="num">@(c.UnitCost is { } uc ? Amounts.Format(uc) : "—")</td>
                            }
                            @if (bundle.CanEdit)
                            {
                                <td>
                                    <div class="row-actions">
                                        <button type="button" class="secondary" @onclick='() => RunAsync(() => Bundles.MoveComponentAsync(row.Id, -1), null)' disabled="@_busy" aria-label="@L("Выше")">↑</button>
                                        <button type="button" class="secondary" @onclick='() => RunAsync(() => Bundles.MoveComponentAsync(row.Id, 1), null)' disabled="@_busy" aria-label="@L("Ниже")">↓</button>
                                        <ConfirmButton Class="secondary" OnConfirm='() => RunAsync(() => Bundles.RemoveComponentAsync(row.Id, row.RowVersion), L("Компонент убран."))' Disabled="@_busy" Question='@L("Убрать из состава?")'>@L("Убрать")</ConfirmButton>
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (bundle.Price is { } hint)
        {
            <p class="muted">
                @if (hint.ComponentsTotal is { } total)
                {
                    @L("Сумма цен компонентов: {0}.", Amounts.Format(total))
                    @if (hint.Discount is { } d && hint.DiscountPercent is { } dp)
                    {
                        @(" ")@(d >= 0 ? L("Скидка набора: {0} ({1}%).", Amounts.Format(d), dp.ToString("0.##")) : L("Комплект дороже суммы компонентов на {0}.", Amounts.Format(-d)))
                    }
                    else
                    {
                        @(" ")@L("Задайте цену комплекта в блоке «Цены».")
                    }
                }
                else if (bundle.Components.Count > 0)
                {
                    @L("Не у всех компонентов задана основная цена — сумма не считается.")
                }
                @if (bundle.Cost is { } cost)
                {
                    @(" ")@L("Себестоимость по компонентам: {0}.", Amounts.Format(cost))
                }
            </p>
        }
        @if (bundle.CanEdit)
        {
            <form class="inline-form" @onsubmit="AddComponentAsync">
                <label>@L("Компонент")
                    <input @bind="_component" list="bundle-options" placeholder="@L("код или наименование")" size="28" />
                    <datalist id="bundle-options">
                        @foreach (var o in _componentOptions.Where(o => o.Id != Id))
                        {
                            <option value="@o.Code">@o.Name (@o.UnitSymbol)</option>
                        }
                    </datalist>
                </label>
                <label>@L("Количество в комплекте") <input @bind="_componentQty" inputmode="decimal" size="8" /></label>
                <button type="submit" disabled="@_busy">@L("Добавить в состав")</button>
            </form>
        }
        </section>
    }

    @if (_item.CustomFields.Any(f => f.IsArchived))
    {
        <section class="card-sec wide">
        <dl class="facts">
            @foreach (var f in _item.CustomFields.Where(f => f.IsArchived))
            {
                <dt>@f.Name (@L("в архиве"))</dt><dd>@(f.Display ?? f.Value)</dd>
            }
        </dl>
        </section>
    }

    <section class="card-sec">
    <h2 style="margin-top: 20px">@L("Штрихкоды")</h2>
    <div class="scroll">
        <table class="compact">
            <thead><tr><th>@L("Тип")</th><th>@L("Штрихкод")</th>@if (editable) { <th></th> }</tr></thead>
            <tbody>
                @if (_item.Barcodes.Count == 0)
                {
                    <tr><td colspan="3" class="muted">@L("Штрихкодов нет.")</td></tr>
                }
                @foreach (var b in _item.Barcodes)
                {
                    <tr>
                        <td>@b.TypeName</td>
                        <td class="barcode">@b.Code</td>
                        @if (editable)
                        {
                            <td><ConfirmButton Class="secondary" OnConfirm="() => RemoveBarcodeAsync(b)" Disabled="@_busy" Question='@L("Удалить?")'>@L("Удалить")</ConfirmButton></td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (editable)
    {
        <form class="inline-form" @onsubmit="AddBarcodeAsync">
            <label>@L("Штрихкод") <input @bind="_barcode" maxlength="@ItemBarcode.CodeMaxLength" placeholder="@L("EAN-13 или отсканируйте")" /></label>
            <label>
                @L("Тип")
                <select @bind="_barcodeType">
                    <option value="">@L("определить по коду")</option>
                    @foreach (var t in Enum.GetValues<BarcodeType>().Where(t => _item.IsStocked || t != BarcodeType.Gtin))
                    {
                        <option value="@t">@ItemBarcode.TypeName(t)</option>
                    }
                </select>
            </label>
            <button type="submit" disabled="@_busy">@L("Добавить")</button>
            @* D315: внутренний EAN-13 по счётчику настроек каталога. *@
            <button type="button" class="secondary" @onclick="GenerateBarcodeAsync" disabled="@_busy">@L("Создать EAN-13")</button>
        </form>
    }
    <div class="actions" style="margin-top: 8px">
        @* D316: печать этикеток по шаблону организации. *@
        <a class="button secondary" href="catalog/labels/print?ids=@Id" target="_blank" rel="noopener">@L("Печать этикеток")</a>
        @if (editable && _variants?.Parent is null)
        {
            <button type="button" class="secondary" @onclick="ToggleCopy" disabled="@_busy">@L("Создать по образцу")</button>
        }
    </div>
    @if (_copyOpen && editable)
    {
        @* D319: копия карточки — сведения, цены, упаковки, поставщики, состав комплекта; без штрихкодов, GTIN и артикула. *@
        <form class="inline-form panel" @onsubmit="CopyAsync">
            <label>@L("Код новой позиции") <input @bind="_copyCode" maxlength="40" placeholder="@L("пусто — по автокоду")" /></label>
            <label>@L("Наименование") <input @bind="_copyName" maxlength="300" required /></label>
            <button type="submit" disabled="@_busy">@L("Создать копию")</button>
            <span class="muted small">@L("Скопируются сведения, цены, упаковки, поставщики и состав комплекта. Штрихкоды, GTIN и артикул — новые.")</span>
        </form>
    }
    </section>

    @if (_item.IsStocked && _settings.Shows(CardBlocks.Packs))
    {
        <section class="card-sec">
        <h2 style="margin-top: 20px">@L("Упаковки")</h2>
        <p class="muted">@L("Например, коробка = 12 шт или мешок = 25 кг. Свой штрихкод упаковки: скан даёт позицию и количество в основных единицах.")</p>
        <div class="scroll">
            <table class="compact">
                <thead><tr><th>@L("Упаковка")</th><th class="num">@L("Основных единиц")</th><th>@L("Штрихкод")</th>@if (editable) { <th></th> }</tr></thead>
                <tbody>
                    @if (_packs.Count == 0)
                    {
                        <tr><td colspan="4" class="muted">@L("Упаковок нет.")</td></tr>
                    }
                    @foreach (var p in _packs)
                    {
                        var pack = p;
                        <tr>
                            <td>@p.UnitName (@p.UnitSymbol)</td>
                            <td class="num">@Quantities.Format(p.Factor) @_item.UnitSymbol</td>
                            <td class="barcode">@(p.Barcode ?? "—")</td>
                            @if (editable)
                            {
                                <td><ConfirmButton Class="secondary" OnConfirm='() => RunAsync(() => PackList.RemoveAsync(pack.Id, pack.RowVersion), L("Упаковка убрана."))' Disabled="@_busy" Question='@L("Убрать упаковку?")'>@L("Убрать")</ConfirmButton></td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (editable)
        {
            <form class="inline-form" @onsubmit="SavePackAsync">
                <label>
                    @L("Упаковка")
                    <select @bind="_packUnit">
                        <option value="">@L("— выберите —")</option>
                        @foreach (var u in _units.Where(u => u.Id != _item.UnitId))
                        {
                            <option value="@u.Id">@u.Name (@u.Symbol)</option>
                        }
                    </select>
                </label>
                <label>@L("Сколько {0} в упаковке", _item.UnitSymbol) <input @bind="_packFactor" inputmode="decimal" size="8" /></label>
                <label>@L("Штрихкод упаковки") <input @bind="_packBarcode" maxlength="@ItemBarcode.CodeMaxLength" size="16" /></label>
                <button type="submit" disabled="@_busy">@L("Сохранить упаковку")</button>
            </form>
            <p class="muted small">@L("Нет нужной единицы (коробка, мешок)? Добавьте её в справочник единиц:") <a href="catalog/settings">@L("Единицы")</a></p>
        }
        </section>
    }

    @if (_item.Type != ItemType.Bundle && _settings.Shows(CardBlocks.Suppliers))
    {
        <section class="card-sec">
        <h2 style="margin-top: 20px">@L("Поставщики")</h2>
        <div class="scroll">
            <table class="compact">
                <thead>
                    <tr>
                        <th>@L("Поставщик")</th><th class="opt">@L("Его артикул")</th><th class="opt">@L("Его наименование")</th>
                        @if (_item.CanSeePrices) { <th class="num">@L("Последняя цена без НДС")</th> }
                        @if (editable) { <th></th> }
                    </tr>
                </thead>
                <tbody>
                    @if (_suppliers.Count == 0)
                    {
                        <tr><td colspan="5" class="muted">@L("Поставщики не указаны.")</td></tr>
                    }
                    @foreach (var s in _suppliers)
                    {
                        var supplier = s;
                        <tr>
                            <td>@s.Supplier @if (s.IsMain) { <span class="tag ok">@L("основной")</span> }</td>
                            <td>@(s.SupplierArticle ?? "—")</td>
                            <td>@(s.SupplierItemName ?? "—")</td>
                            @if (_item.CanSeePrices)
                            {
                                <td class="num">@(s.LastPrice is { } lp ? $"{Amounts.Format(lp)} ({s.LastOrderDate:dd.MM.yyyy})" : "—")</td>
                            }
                            @if (editable)
                            {
                                <td>
                                    <div class="row-actions">
                                        @if (!s.IsMain)
                                        {
                                            <button type="button" class="secondary" @onclick='() => RunAsync(() => Suppliers.SetAsync(Id, supplier.SupplierId, supplier.SupplierArticle, supplier.SupplierItemName, true), L("Основной поставщик изменён."))' disabled="@_busy">@L("Основной")</button>
                                        }
                                        <ConfirmButton Class="secondary" OnConfirm='() => RunAsync(() => Suppliers.RemoveAsync(supplier.Id, supplier.RowVersion), L("Поставщик убран."))' Disabled="@_busy" Question='@L("Убрать поставщика?")'>@L("Убрать")</ConfirmButton>
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (editable)
        {
            <form class="inline-form" @onsubmit="SaveSupplierAsync">
                <label>
                    @L("Поставщик")
                    <select @bind="_supplierId">
                        <option value="">@L("— выберите —")</option>
                        @foreach (var o in _supplierOptions)
                        {
                            <option value="@o.Id">@o.Name</option>
                        }
                    </select>
                </label>
                <label>@L("Его артикул") <input @bind="_supplierArticle" maxlength="@ItemSupplier.ArticleMaxLength" size="12" /></label>
                <label>@L("Его наименование") <input @bind="_supplierName" maxlength="@ItemSupplier.NameMaxLength" size="24" /></label>
                <label class="inline"><input type="checkbox" @bind="_supplierMain" /> @L("основной")</label>
                <button type="submit" disabled="@_busy">@L("Сохранить поставщика")</button>
            </form>
        }
        </section>
    }

    @if (_settings.Shows(CardBlocks.Photos))
    {
        <section class="card-sec">
        <h2 style="margin-top: 20px">@L("Фото")</h2>
        <p class="muted">@L("JPEG, PNG или WebP до 2 МБ, не больше {0}. Первое — основное: оно видно в списке номенклатуры.", ItemPhoto.MaxPerItem)</p>
        @if (_photos.Count > 0)
        {
            <div class="photo-strip">
                @foreach (var ph in _photos)
                {
                    var photo = ph;
                    <figure>
                        <a href="catalog/photos/@photo.Id" target="_blank" rel="noopener"><img src="catalog/photos/@photo.Id" alt="@L("Фото позиции")" loading="lazy" /></a>
                        <figcaption>
                            @if (photo == _photos[0])
                            {
                                <span class="tag ok">@L("основное")</span>
                            }
                            else if (editable)
                            {
                                <button type="button" class="secondary" @onclick='() => RunAsync(() => Modifications.MakeMainPhotoAsync(photo.Id), L("Основное фото изменено."))' disabled="@_busy">@L("Основное")</button>
                            }
                            @if (editable)
                            {
                                <button type="button" class="secondary" @onclick='() => RunAsync(() => Modifications.RemovePhotoAsync(photo.Id), L("Фото удалено."))' disabled="@_busy"
                                        aria-label="@L("Удалить фото")">✕</button>
                            }
                        </figcaption>
                    </figure>
                }
            </div>
        }
        @if (editable && _photos.Count < ItemPhoto.MaxPerItem)
        {
            <label class="file-pick">@L("Добавить фото") <InputFile OnChange="UploadAsync" accept="image/jpeg,image/png,image/webp" multiple disabled="@_busy" /></label>
        }
        </section>
    }

    @if (_item.CanSeePrices)
    {
        <section class="card-sec">
        <h2 style="margin-top: 20px">@L("Цены")</h2>
        <form @onsubmit="SavePricesAsync">
            <div class="scroll">
                <table class="compact">
                    <thead><tr><th>@L("Вид цены")</th><th>@L("НДС")</th><th class="num">@L("Цена")</th></tr></thead>
                    <tbody>
                        @foreach (var p in _item.Prices)
                        {
                            var price = p;
                            <tr>
                                <td>@p.PriceType @if (p.IsDefault) { <span class="tag ok">@L("основная")</span> }</td>
                                <td>@(p.IncludesVat ? L("с НДС") : L("без НДС"))</td>
                                <td class="num">
                                    @if (editable)
                                    {
                                        <input value="@_prices.GetValueOrDefault(price.PriceTypeId)" @onchange="e => _prices[price.PriceTypeId] = e.Value?.ToString()"
                                               inputmode="decimal" size="12" aria-label="@p.PriceType" />
                                    }
                                    else
                                    {
                                        @(p.Price is { } v ? Amounts.Format(v) : "—")
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (editable)
            {
                <div class="actions">
                    <button type="submit" disabled="@_busy">@L("Сохранить цены")</button>
                    <a href="catalog/settings" class="muted">@L("Виды цен")</a>
                    @if (CurrentAccess.Has(Permissions.PriceEdit))
                    {
                        <a href="catalog/revaluation" class="muted">@L("Массовая переоценка")</a>
                    }
                </div>
            }
        </form>
        @if (_trade is { History.Count: > 0 } withHistory)
        {
            <details class="history">
                <summary>@L("История цен") (@withHistory.History.Count)</summary>
                <div class="scroll">
                    <table class="compact">
                        <thead><tr><th>@L("Когда")</th><th>@L("Вид цены")</th><th class="num">@L("Было")</th><th class="num">@L("Стало")</th><th class="opt">@L("Кто")</th><th class="opt">@L("Откуда")</th></tr></thead>
                        <tbody>
                            @foreach (var h in withHistory.History)
                            {
                                <tr>
                                    <td>@h.ChangedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                    <td>@h.PriceType</td>
                                    <td class="num">@(h.OldPrice is { } o ? Amounts.Format(o) : "—")</td>
                                    <td class="num">@(h.NewPrice is { } n ? Amounts.Format(n) : "—")</td>
                                    <td>@(h.User ?? "—")</td>
                                    <td>@SourceName(h.Source)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </details>
        }
        </section>
    }

    @if (_variants is { Parent: null } variants && _item.IsStocked && _settings.Shows(CardBlocks.Modifications))
    {
        <section class="card-sec wide">
        <h2 style="margin-top: 20px">@L("Модификации")</h2>
        <p class="muted">@L("Цвет, размер и другие характеристики. Каждая модификация — отдельная позиция со своим кодом, остатком, штрихкодом и ценой: в документах и отчётах она выбирается как обычная позиция.")</p>
        @if (variants.Modifications.Count > 0)
        {
            <div class="scroll">
                <table class="compact">
                    <thead><tr><th>@L("Код")</th><th>@L("Наименование")</th><th>@L("Характеристики")</th><th class="num">@L("Остаток")</th></tr></thead>
                    <tbody>
                        @foreach (var m in variants.Modifications)
                        {
                            <tr class="@(m.IsArchived ? "archived" : null)">
                                <td><a href="catalog/items/@m.Id">@m.Code</a></td>
                                <td>@m.Name @if (m.IsArchived) { <span class="tag">@L("архив")</span> }</td>
                                <td>@string.Join(", ", m.Values.Select(v => $"{v.Characteristic}: {v.Value}"))</td>
                                <td class="num">@(m.Stock is { } ms ? $"{Quantities.Format(ms)} {_item.UnitSymbol}" : "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        @if (editable)
        {
            var active = _characteristics.Where(c => !c.IsArchived).ToList();
            @if (active.Count == 0)
            {
                <p class="muted">@L("Сначала заведите характеристики — например, «Цвет» и «Размер»:") <a href="catalog/settings?tab=Characteristics">@L("Характеристики")</a></p>
            }
            else
            {
                <form class="inline-form" @onsubmit="CreateModificationsAsync">
                    @foreach (var c in active)
                    {
                        var id = c.Id;
                        <label>
                            @c.Name <input value="@_axes.GetValueOrDefault(id)" @onchange="e => _axes[id] = e.Value?.ToString()" size="18"
                                           inputmode="@(c.Type == CharacteristicType.Number ? "decimal" : null)"
                                           placeholder="@(c.Type == CharacteristicType.Number ? L("числа: 46, 48 или 42-56/2") : c.Type == CharacteristicType.Text ? L("через запятую или 42-56/2") : L("выберите справа"))" />
                            @if (c.Options is { Count: > 0 } options)
                            {
                                @* D328: да/нет и записи своего справочника — выбором, другое значение сервер не примет. *@
                                <select aria-label="@L("Добавить значение")" value="" @onchange="e => AppendValue(id, e)">
                                    <option value="">@L("добавить…")</option>
                                    @foreach (var o in options)
                                    {
                                        <option value="@o">@o</option>
                                    }
                                </select>
                            }
                            @if (_valueSets.Where(v => v.CharacteristicId == id).ToList() is { Count: > 0 } sets)
                            {
                                @* D321: набор значений — подставить одним выбором. *@
                                <select aria-label="@L("Набор значений")" @onchange="e => ApplySet(id, e)">
                                    <option value="">@L("из набора…")</option>
                                    @foreach (var vs in sets)
                                    {
                                        <option value="@vs.Id">@vs.Name</option>
                                    }
                                </select>
                            }
                        </label>
                    }
                    <button type="submit" disabled="@_busy">@L("Создать модификации")</button>
                </form>
                <p class="muted small">@L("Например, Цвет «красный, синий» и Размер «46, 48, 50» — 6 модификаций. Уже созданные сочетания пропускаются; цены копируются с этой позиции.")
                    @L("Диапазон с шагом: «42-56/2». Свои наборы — в")
                    <a href="catalog/settings?tab=Characteristics">@L("Характеристики")</a>.</p>
            }
        }
        </section>
    }
    else if (_variants is { Parent: not null } own && editable)
    {
        <section class="card-sec">
        <h2 style="margin-top: 20px">@L("Характеристики модификации")</h2>
        <form class="inline-form" @onsubmit="SaveValuesAsync">
            @foreach (var c in _characteristics.Where(c => !c.IsArchived || own.Values.Any(v => v.CharacteristicId == c.Id)))
            {
                var id = c.Id;
                <label>@c.Name <input value="@_values.GetValueOrDefault(id)" @onchange="e => _values[id] = e.Value?.ToString()" maxlength="@ItemCharacteristicValue.ValueMaxLength" size="14" /></label>
            }
            <button type="submit" disabled="@_busy">@L("Сохранить")</button>
        </form>
        </section>
    }
    </div>
}


@if (_item is not null)
{
    <Discussion Target="KnitErp.Domain.Tagging.TaggedEntity.Item" TargetId="Id" />
}

@code {
    [Parameter]
    public long Id { get; set; }

    [CascadingParameter]
    public CurrentAccessDto CurrentAccess { get; set; } = default!;

    private ItemCardDto? _item;
    private ItemVariantsDto? _variants;
    private BundleDto? _bundle;
    private ItemTradeDto? _trade;
    private IReadOnlyList<ItemPackDto> _packs = [];
    private IReadOnlyList<ItemSupplierDto> _suppliers = [];
    private IReadOnlyList<SupplierOptionDto> _supplierOptions = [];
    private string _supplierId = string.Empty;
    private string? _supplierArticle;
    private string? _supplierName;
    private bool _supplierMain;

    /// <summary>D309: поставщик тот же — меняются его артикул, наименование, признак «основной».</summary>
    private Task SaveSupplierAsync() => RunAsync(async () =>
    {
        if (!long.TryParse(_supplierId, out var supplierId))
        {
            throw new BusinessRuleException("catalog.supplier.choose", L("Выберите поставщика."));
        }

        await Suppliers.SetAsync(Id, supplierId, _supplierArticle, _supplierName, _supplierMain);
        _supplierId = string.Empty;
        _supplierArticle = null;
        _supplierName = null;
        _supplierMain = false;
    }, L("Поставщик сохранён."));
    private IReadOnlyList<UnitDto> _units = [];
    private string _packUnit = string.Empty;
    private string? _packFactor;
    private string? _packBarcode;

    /// <summary>D307: упаковка той же единицы заменяется (новый коэффициент и штрихкод).</summary>
    private Task SavePackAsync() => RunAsync(async () =>
    {
        if (!long.TryParse(_packUnit, out var unitId))
        {
            throw new BusinessRuleException("catalog.pack.unit", L("Выберите единицу упаковки."));
        }

        var factor = Decimals.Parse(_packFactor, L("Основных единиц")) ?? throw new BusinessRuleException("catalog.pack.factor", L("Укажите, сколько основных единиц в упаковке."));
        await PackList.SetAsync(Id, unitId, factor, _packBarcode);
        _packUnit = string.Empty;
        _packFactor = null;
        _packBarcode = null;
    }, L("Упаковка сохранена."));
    private TradeForm _tradeForm = new();

    private sealed class TradeForm
    {
        public PaymentSubject Subject { get; set; } = PaymentSubject.Goods;
        public bool IsMarked { get; set; }
        public TrackingType Tracking { get; set; } = TrackingType.Clothes;
        public string? Gtin { get; set; }
        public string? MinPrice { get; set; }
    }

    private static string TrackingName(TrackingType t) => t switch
    {
        TrackingType.Clothes => L("Предметы одежды (лёгкая промышленность)"),
        TrackingType.Linens => L("Постельное, столовое и туалетное бельё"),
        TrackingType.Shoes => L("Обувь"),
        _ => L("Другой вид маркировки"),
    };

    private static string SourceName(PriceChangeSource s) => s switch
    {
        PriceChangeSource.Revaluation => L("переоценка"),
        PriceChangeSource.Import => L("загрузка из Excel"),
        PriceChangeSource.External => L("внешняя система"),
        PriceChangeSource.Modification => L("создание модификации"),
        PriceChangeSource.Rule => L("автоцена по правилу"),
        _ => L("вручную"),
    };

    private Task SaveTradeAsync() => RunAsync(async () =>
    {
        var f = _tradeForm;
        await Trade.SaveAsync(Id, new ItemTradeDetails(f.Subject, f.IsMarked, f.IsMarked ? f.Tracking : TrackingType.None, f.Gtin,
            Decimals.Parse(f.MinPrice, L("Минимальная цена продажи"))), _item!.RowVersion);
    }, L("Торговые сведения сохранены."));
    private IReadOnlyList<BundleComponentOptionDto> _componentOptions = [];
    private string? _component;
    private string? _componentQty = "1";
    private IReadOnlyList<ItemPhotoDto> _photos = [];
    private IReadOnlyList<CharacteristicDto> _characteristics = [];
    private Dictionary<long, string?> _axes = [];
    private IReadOnlyList<ValueSetDto> _valueSets = [];

    private void ApplySet(long characteristicId, ChangeEventArgs e)
    {
        if (long.TryParse(e.Value?.ToString(), out var setId) && _valueSets.FirstOrDefault(v => v.Id == setId) is { } set)
        {
            _axes[characteristicId] = string.Join(", ", set.Values);
        }
    }
    private Dictionary<long, string?> _values = [];
    private IReadOnlyList<CounterpartyDto> _counterparties = [];

    /// <summary>D328: значение из справочника или «Да/Нет» — добавить к списку значений характеристики.</summary>
    private void AppendValue(long characteristicId, ChangeEventArgs e)
    {
        if (e.Value?.ToString() is { Length: > 0 } value)
        {
            var current = _axes.GetValueOrDefault(characteristicId);
            _axes[characteristicId] = string.IsNullOrWhiteSpace(current) ? value : $"{current}, {value}";
        }
    }
    private IReadOnlyList<ItemGroupDto> _groups = [];
    private IReadOnlyDictionary<long, IReadOnlyList<UserCatalogEntryDto>> _entries = new Dictionary<long, IReadOnlyList<UserCatalogEntryDto>>();
    private DetailsForm _form = new();
    private Dictionary<long, string?> _prices = [];
    private string? _barcode;
    private string _barcodeType = string.Empty;
    private bool _busy;
    private bool _notFound;
    private string? _denied;
    private string? _message;
    private bool _isError;

    private sealed class DetailsForm
    {
        public string Group { get; set; } = string.Empty;
        public string? Article { get; set; }
        public string? Country { get; set; }
        public string? CountryName { get; set; }
        public string? Declaration { get; set; }
        public string? TnVed { get; set; }
        public string? Weight { get; set; }
        public string? Volume { get; set; }
        public string? MinStock { get; set; }
        public string? PurchasePrice { get; set; }
        public Dictionary<long, string?> Values { get; } = [];
    }

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            await LoadAsync();
        }
        catch (AccessDeniedException ex)
        {
            _denied = UiErrors.Message(ex);
        }
        catch (NotFoundException)
        {
            _notFound = true;
        }
    }

    // D312: блоки, скрытые настройками каталога организации (только отображение).
    private CatalogSettingsDto _settings = new(true, true, null, 5, 1, ItemType.Finished, null, false, []);

    private bool _copyOpen;
    private string? _copyCode;
    private string? _copyName;

    private void ToggleCopy()
    {
        _copyOpen = !_copyOpen;
        _copyName = L("{0} (копия)", _item?.Name ?? "");
        _copyCode = null;
    }

    private async Task CopyAsync()
    {
        long? id = null;
        await RunAsync(async () => id = await Copies.CopyAsync(Id, _copyCode, string.IsNullOrWhiteSpace(_copyName) ? null : _copyName), null);
        if (id is { } created)
        {
            _copyOpen = false;
            Nav.NavigateTo($"catalog/items/{created}");
        }
    }

    private Task GenerateBarcodeAsync() => RunAsync(async () =>
    {
        await Codes.GenerateBarcodeAsync(Id);
        _barcode = null;
    }, L("Штрихкод создан."));

    private async Task LoadAsync()
    {
        _item = await Nomenclature.GetItemAsync(Id);
        _settings = await CatalogSettings.GetAsync();
        _valueSets = await ValueSets.ListAsync();
        _groups = await Nomenclature.GroupsAsync();
        _entries = await Nomenclature.EntriesByCatalogAsync();
        // D328: контрагенты — только если есть поле такого типа.
        _counterparties = _item.CustomFields.Any(f => f.Type == CustomFieldType.Counterparty && !f.IsArchived)
            ? (await CounterpartyList.ListAsync(new CounterpartyFilter())).Counterparties
            : [];
        var d = _item.Details;
        static string? N(decimal? v) => v is { } x ? Amounts.Input(x) : null;
        _form = new DetailsForm
        {
            Group = d.GroupId?.ToString() ?? string.Empty, Article = d.Article, Country = d.OriginCountryCode, CountryName = d.OriginCountryName,
            Declaration = d.CustomsDeclaration, TnVed = d.TnVedCode, Weight = N(d.WeightKg), Volume = N(d.VolumeM3), MinStock = N(d.MinStock),
            PurchasePrice = N(d.PurchasePrice),
        };
        foreach (var f in _item.CustomFields.Where(f => !f.IsArchived))
        {
            _form.Values[f.FieldId] = f.Value;
        }

        _prices = _item.Prices.ToDictionary(p => p.PriceTypeId, p => p.Price is { } v ? Amounts.Input(v) : null);
        _variants = await Modifications.VariantsAsync(Id);
        _photos = await Modifications.PhotosAsync(Id);
        _characteristics = await Modifications.CharacteristicsAsync(includeArchived: true);
        _values = _variants.Values.ToDictionary(v => v.CharacteristicId, v => (string?)v.Value);
        _bundle = _item.Type == ItemType.Bundle ? await Bundles.GetAsync(Id) : null;
        _trade = await Trade.GetAsync(Id);
        _packs = _item.IsStocked ? await PackList.ListAsync(Id) : [];
        _suppliers = _item.Type != ItemType.Bundle ? await Suppliers.ListAsync(Id) : [];
        _supplierOptions = _item.Type != ItemType.Bundle && _item.CanEdit && !_item.IsArchived ? await Suppliers.SupplierOptionsAsync() : [];
        _units = _item.IsStocked && _item.CanEdit ? await Catalog.ListUnitsAsync() : [];
        _tradeForm = new TradeForm
        {
            Subject = _trade.Trade.PaymentSubject, IsMarked = _trade.Trade.IsMarked,
            Tracking = _trade.Trade.TrackingType == TrackingType.None ? TrackingType.Clothes : _trade.Trade.TrackingType,
            Gtin = _trade.Trade.Gtin, MinPrice = _trade.Trade.MinPrice is { } mp ? Amounts.Input(mp) : null,
        };
        _componentOptions = _bundle?.CanEdit == true ? await Bundles.ComponentOptionsAsync() : [];
    }

    /// <summary>D302: компонент по коду (или «код — наименование» из подсказки) и количество на один комплект.</summary>
    private Task AddComponentAsync() => RunAsync(async () =>
    {
        var text = (_component ?? string.Empty).Trim();
        var option = _componentOptions.FirstOrDefault(o => string.Equals(o.Code, text, StringComparison.OrdinalIgnoreCase))
                     ?? _componentOptions.FirstOrDefault(o => string.Equals(o.Name, text, StringComparison.OrdinalIgnoreCase))
                     ?? throw new BusinessRuleException("catalog.bundle.component_unknown", L("Выберите компонент из списка: товар или модификацию."));
        var qty = Decimals.Parse(_componentQty, L("Количество в комплекте"))
                  ?? throw new BusinessRuleException("catalog.bundle.quantity", L("Укажите количество компонента в комплекте."));
        await Bundles.SetComponentAsync(Id, option.Id, qty);
        _component = null;
        _componentQty = "1";
    }, L("Состав сохранён."));

    private Task CreateModificationsAsync() => RunAsync(async () =>
    {
        var result = await Modifications.CreateModificationsAsync(Id, _axes);
        _axes = [];
        _message = result.Skipped > 0
            ? L("Создано модификаций: {0}; уже были: {1}.", result.Created, result.Skipped)
            : L("Создано модификаций: {0}.", result.Created);
    }, null);

    private Task SaveValuesAsync() => RunAsync(() => Modifications.SetValuesAsync(Id, _values, _variants!.RowVersion), L("Характеристики сохранены."));

    /// <summary>Фото по одному: каждое проверяется на сервере по содержимому (тип и размер).</summary>
    private Task UploadAsync(InputFileChangeEventArgs e) => RunAsync(async () =>
    {
        foreach (var file in e.GetMultipleFiles(ItemPhoto.MaxPerItem))
        {
            if (file.Size > ItemPhoto.MaxBytes)
            {
                throw new BusinessRuleException("catalog.photo.too_large", L("Фото — не больше 2 МБ. Уменьшите размер снимка."));
            }

            await using var stream = file.OpenReadStream(ItemPhoto.MaxBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            await Modifications.AddPhotoAsync(Id, buffer.ToArray());
        }
    }, L("Фото добавлено."));

    private void SetFlag(long fieldId, ChangeEventArgs e) => _form.Values[fieldId] = e.Value is true ? "true" : null;

    private Task SaveDetailsAsync() => RunAsync(async () =>
    {
        var f = _form;
        var details = new ItemDetails(long.TryParse(f.Group, out var g) ? g : null, f.Article, f.Country, f.CountryName, f.Declaration, f.TnVed,
            Decimals.Parse(f.Weight, L("Вес")), Decimals.Parse(f.Volume, L("Объём")), Decimals.Parse(f.MinStock, L("Неснижаемый остаток")),
            Decimals.Parse(f.PurchasePrice, L("Закупочная цена")));
        await Nomenclature.SaveItemDetailsAsync(Id, details, f.Values, _item!.RowVersion);
    }, L("Сведения сохранены."));

    private Task AddBarcodeAsync() => RunAsync(async () =>
    {
        await Nomenclature.AddBarcodeAsync(Id, _barcode, Enum.TryParse<BarcodeType>(_barcodeType, out var t) ? t : null);
        _barcode = null;
    }, L("Штрихкод добавлен."));

    private Task RemoveBarcodeAsync(ItemBarcodeDto b) => RunAsync(() => Nomenclature.RemoveBarcodeAsync(b.Id), L("Штрихкод удалён."));

    private Task SavePricesAsync() => RunAsync(async () =>
    {
        var prices = _prices.ToDictionary(p => p.Key, p => Decimals.Parse(p.Value, L("Цена")));
        await Nomenclature.SetPricesAsync(Id, prices);
    }, L("Цены сохранены."));

    /// <summary>Одна операция за раз, затем свежая карточка: у вкладки один DbContext.</summary>
    private async Task RunAsync(Func<Task> action, string? success)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _message = null;
        _isError = false;
        try
        {
            await action();
            _message = success ?? _message;
            await LoadAsync();
        }
        catch (Exception ex) when (UiErrors.IsUserFacing(ex))
        {
            _message = UiErrors.Message(ex);
            _isError = true;
        }
        finally
        {
            _busy = false;
        }
    }
}
