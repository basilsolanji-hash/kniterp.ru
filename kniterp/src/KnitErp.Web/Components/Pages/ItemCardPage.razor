@page "/catalog/items/{Id:long}"
@using KnitErp.Application.Catalog
@using KnitErp.Application.Common
@using KnitErp.Domain.Catalog
@using KnitErp.Domain.Common
@inject NomenclatureService Nomenclature
@inject ModificationService Modifications

<PageTitle>@(_item?.Name ?? L("Позиция")) — knitERP</PageTitle>

@if (_denied is not null)
{
    <AccessDenied Message="@_denied" />
}
else if (_notFound)
{
    <h1>@L("Позиция не найдена")</h1>
    <p><a href="catalog">@L("К номенклатуре")</a></p>
}
else if (_item is null)
{
    <p class="muted">@L("Загрузка…")</p>
}
else
{
    var editable = _item.CanEdit && !_item.IsArchived;
    <p><a href="catalog">@L("← Номенклатура")</a></p>
    <div class="page-head">
        <h1>@_item.Name <span class="tag">@L(_item.TypeName)</span> @if (_item.IsArchived) { <span class="tag">@L("архив")</span> }</h1>
    </div>
    <TagPicker Entity="KnitErp.Domain.Tagging.TaggedEntity.Item" EntityId="Id" />

    @if (_message is not null)
    {
        <div class="@(_isError ? "flash error" : "flash")" role="@(_isError ? "alert" : "status")">@_message</div>
    }

    @if (_variants?.Parent is { } parent)
    {
        <p class="muted">@L("Модификация позиции") <a href="catalog/items/@parent.Id">@parent.Code — @parent.Name</a>:
            @string.Join(", ", _variants.Values.Select(v => $"{v.Characteristic}: {v.Value}"))</p>
    }

    <div class="item-head">
        @if (_photos.Count > 0)
        {
            <img class="item-main-photo" src="catalog/photos/@_photos[0].Id" alt="@_item.Name" />
        }
    <dl class="facts">
        <dt>@L("Код")</dt><dd>@_item.Code</dd>
        <dt>@L("Группа")</dt><dd>@(_item.GroupPath ?? L("без группы"))</dd>
        <dt>@L("Единица")</dt><dd>@_item.UnitSymbol</dd>
        <dt>@L("Остаток на всех складах")</dt><dd>@Quantities.Format(_item.Stock) @_item.UnitSymbol
            @if (_item.Details.MinStock is { } min && _item.Stock < min) { <span class="tag bad">@L("ниже неснижаемого {0}", Quantities.Format(min))</span> }</dd>
        @if (_item.Description is not null)
        {
            <dt>@L("Описание")</dt><dd>@_item.Description</dd>
        }
    </dl>
    </div>
    <p class="muted">@L("Код, наименование, тип, единица и НДС меняются в списке номенклатуры кнопкой «Изменить».")</p>

    <h2>@L("Сведения")</h2>
    <div class="panel">
        <form @onsubmit="SaveDetailsAsync">
            <div class="grid">
                <label>
                    @L("Группа")
                    <select @bind="_form.Group" disabled="@(!editable)">
                        <option value="">@L("без группы")</option>
                        @foreach (var g in _groups)
                        {
                            <option value="@g.Id">@g.Path</option>
                        }
                    </select>
                </label>
                <label>@L("Артикул") <input @bind="_form.Article" maxlength="@ItemDetailRules.ArticleMaxLength" disabled="@(!editable)" /></label>
                <label>@L("Страна происхождения (код ОКСМ)")
                    <input @bind="_form.Country" list="countries" maxlength="3" inputmode="numeric" placeholder="643" disabled="@(!editable)" />
                    <datalist id="countries">
                        @foreach (var c in ItemDetailRules.CommonCountries)
                        {
                            <option value="@c.Code">@c.Name</option>
                        }
                    </datalist>
                </label>
                <label>@L("Страна — краткое наименование") <input @bind="_form.CountryName" maxlength="@ItemDetailRules.CountryNameMaxLength" placeholder="@L("подставится по коду")" disabled="@(!editable)" /></label>
                <label>@L("Номер декларации на товары") <input @bind="_form.Declaration" maxlength="@ItemDetailRules.DeclarationMaxLength" placeholder="10702010/101026/0012345" disabled="@(!editable)" /></label>
                <label>@L("Код ТН ВЭД ЕАЭС") <input @bind="_form.TnVed" maxlength="13" inputmode="numeric" disabled="@(!editable)" /></label>
                <label>@L("Вес, кг (на единицу)") <input @bind="_form.Weight" inputmode="decimal" disabled="@(!editable)" /></label>
                <label>@L("Объём, м³ (на единицу)") <input @bind="_form.Volume" inputmode="decimal" disabled="@(!editable)" /></label>
                <label>@L("Неснижаемый остаток") <input @bind="_form.MinStock" inputmode="decimal" disabled="@(!editable)" /></label>
                @if (_item.CanSeePrices)
                {
                    <label>@L("Закупочная цена, без НДС") <input @bind="_form.PurchasePrice" inputmode="decimal" disabled="@(!editable)" /></label>
                }
                @foreach (var f in _item.CustomFields.Where(f => !f.IsArchived))
                {
                    var field = f;
                    @switch (field.Type)
                    {
                        case CustomFieldType.Flag:
                            <label class="inline"><input type="checkbox" checked="@(_form.Values.GetValueOrDefault(field.FieldId) == "true")"
                                                         @onchange="e => SetFlag(field.FieldId, e)" disabled="@(!editable)" /> @field.Name</label>
                            break;
                        case CustomFieldType.Catalog:
                            <label>
                                @field.Name
                                <select value="@_form.Values.GetValueOrDefault(field.FieldId)" @onchange="e => _form.Values[field.FieldId] = e.Value?.ToString()" disabled="@(!editable)">
                                    <option value="">—</option>
                                    @foreach (var entry in _entries.GetValueOrDefault(field.CatalogId ?? 0) ?? [])
                                    {
                                        <option value="@entry.Id">@entry.Display</option>
                                    }
                                    @if (field.Value is not null && field.Display is not null && (_entries.GetValueOrDefault(field.CatalogId ?? 0) ?? []).All(x => x.Id.ToString() != field.Value))
                                    {
                                        <option value="@field.Value">@field.Display (@L("в архиве"))</option>
                                    }
                                </select>
                            </label>
                            break;
                        case CustomFieldType.Date:
                            <label>@field.Name <input type="date" value="@_form.Values.GetValueOrDefault(field.FieldId)" @onchange="e => _form.Values[field.FieldId] = e.Value?.ToString()" disabled="@(!editable)" /></label>
                            break;
                        case CustomFieldType.Number:
                            <label>@field.Name <input inputmode="decimal" value="@_form.Values.GetValueOrDefault(field.FieldId)" @onchange="e => _form.Values[field.FieldId] = e.Value?.ToString()" disabled="@(!editable)" /></label>
                            break;
                        default:
                            <label>@field.Name <input maxlength="@CustomFieldDefinition.ValueMaxLength" value="@_form.Values.GetValueOrDefault(field.FieldId)" @onchange="e => _form.Values[field.FieldId] = e.Value?.ToString()" disabled="@(!editable)" /></label>
                            break;
                    }
                }
            </div>
            @if (editable)
            {
                <div class="actions">
                    <button type="submit" disabled="@_busy">@L("Сохранить сведения")</button>
                    <a href="catalog/settings" class="muted">@L("Доп. поля и свои справочники")</a>
                </div>
            }
        </form>
    </div>

    @if (_item.CustomFields.Any(f => f.IsArchived))
    {
        <dl class="facts">
            @foreach (var f in _item.CustomFields.Where(f => f.IsArchived))
            {
                <dt>@f.Name (@L("в архиве"))</dt><dd>@(f.Display ?? f.Value)</dd>
            }
        </dl>
    }

    <h2 style="margin-top: 20px">@L("Штрихкоды")</h2>
    <div class="scroll">
        <table class="compact">
            <thead><tr><th>@L("Тип")</th><th>@L("Штрихкод")</th>@if (editable) { <th></th> }</tr></thead>
            <tbody>
                @if (_item.Barcodes.Count == 0)
                {
                    <tr><td colspan="3" class="muted">@L("Штрихкодов нет.")</td></tr>
                }
                @foreach (var b in _item.Barcodes)
                {
                    <tr>
                        <td>@b.TypeName</td>
                        <td class="barcode">@b.Code</td>
                        @if (editable)
                        {
                            <td><ConfirmButton Class="secondary" OnConfirm="() => RemoveBarcodeAsync(b)" Disabled="@_busy" Question='@L("Удалить?")'>@L("Удалить")</ConfirmButton></td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (editable)
    {
        <form class="inline-form" @onsubmit="AddBarcodeAsync">
            <label>@L("Штрихкод") <input @bind="_barcode" maxlength="@ItemBarcode.CodeMaxLength" placeholder="@L("EAN-13 или отсканируйте")" /></label>
            <label>
                @L("Тип")
                <select @bind="_barcodeType">
                    <option value="">@L("определить по коду")</option>
                    @foreach (var t in Enum.GetValues<BarcodeType>())
                    {
                        <option value="@t">@ItemBarcode.TypeName(t)</option>
                    }
                </select>
            </label>
            <button type="submit" disabled="@_busy">@L("Добавить")</button>
        </form>
    }

    <h2 style="margin-top: 20px">@L("Фото")</h2>
    <p class="muted">@L("JPEG, PNG или WebP до 2 МБ, не больше {0}. Первое — основное: оно видно в списке номенклатуры.", ItemPhoto.MaxPerItem)</p>
    @if (_photos.Count > 0)
    {
        <div class="photo-strip">
            @foreach (var ph in _photos)
            {
                var photo = ph;
                <figure>
                    <a href="catalog/photos/@photo.Id" target="_blank" rel="noopener"><img src="catalog/photos/@photo.Id" alt="@L("Фото позиции")" loading="lazy" /></a>
                    <figcaption>
                        @if (photo == _photos[0])
                        {
                            <span class="tag ok">@L("основное")</span>
                        }
                        else if (editable)
                        {
                            <button type="button" class="secondary" @onclick='() => RunAsync(() => Modifications.MakeMainPhotoAsync(photo.Id), L("Основное фото изменено."))' disabled="@_busy">@L("Основное")</button>
                        }
                        @if (editable)
                        {
                            <button type="button" class="secondary" @onclick='() => RunAsync(() => Modifications.RemovePhotoAsync(photo.Id), L("Фото удалено."))' disabled="@_busy"
                                    aria-label="@L("Удалить фото")">✕</button>
                        }
                    </figcaption>
                </figure>
            }
        </div>
    }
    @if (editable && _photos.Count < ItemPhoto.MaxPerItem)
    {
        <label class="file-pick">@L("Добавить фото") <InputFile OnChange="UploadAsync" accept="image/jpeg,image/png,image/webp" multiple disabled="@_busy" /></label>
    }

    @if (_item.CanSeePrices)
    {
        <h2 style="margin-top: 20px">@L("Цены")</h2>
        <form @onsubmit="SavePricesAsync">
            <div class="scroll">
                <table class="compact">
                    <thead><tr><th>@L("Вид цены")</th><th>@L("НДС")</th><th class="num">@L("Цена")</th></tr></thead>
                    <tbody>
                        @foreach (var p in _item.Prices)
                        {
                            var price = p;
                            <tr>
                                <td>@p.PriceType @if (p.IsDefault) { <span class="tag ok">@L("основная")</span> }</td>
                                <td>@(p.IncludesVat ? L("с НДС") : L("без НДС"))</td>
                                <td class="num">
                                    @if (editable)
                                    {
                                        <input value="@_prices.GetValueOrDefault(price.PriceTypeId)" @onchange="e => _prices[price.PriceTypeId] = e.Value?.ToString()"
                                               inputmode="decimal" size="12" aria-label="@p.PriceType" />
                                    }
                                    else
                                    {
                                        @(p.Price is { } v ? Amounts.Format(v) : "—")
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (editable)
            {
                <div class="actions">
                    <button type="submit" disabled="@_busy">@L("Сохранить цены")</button>
                    <a href="catalog/settings" class="muted">@L("Виды цен")</a>
                </div>
            }
        </form>
    }

    @if (_variants is { Parent: null } variants)
    {
        <h2 style="margin-top: 20px">@L("Модификации")</h2>
        <p class="muted">@L("Цвет, размер и другие характеристики. Каждая модификация — отдельная позиция со своим кодом, остатком, штрихкодом и ценой: в документах и отчётах она выбирается как обычная позиция.")</p>
        @if (variants.Modifications.Count > 0)
        {
            <div class="scroll">
                <table class="compact">
                    <thead><tr><th>@L("Код")</th><th>@L("Наименование")</th><th>@L("Характеристики")</th><th class="num">@L("Остаток")</th></tr></thead>
                    <tbody>
                        @foreach (var m in variants.Modifications)
                        {
                            <tr class="@(m.IsArchived ? "archived" : null)">
                                <td><a href="catalog/items/@m.Id">@m.Code</a></td>
                                <td>@m.Name @if (m.IsArchived) { <span class="tag">@L("архив")</span> }</td>
                                <td>@string.Join(", ", m.Values.Select(v => $"{v.Characteristic}: {v.Value}"))</td>
                                <td class="num">@Quantities.Format(m.Stock) @_item.UnitSymbol</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        @if (editable)
        {
            var active = _characteristics.Where(c => !c.IsArchived).ToList();
            @if (active.Count == 0)
            {
                <p class="muted">@L("Сначала заведите характеристики — например, «Цвет» и «Размер»:") <a href="catalog/settings?tab=Characteristics">@L("Характеристики")</a></p>
            }
            else
            {
                <form class="inline-form" @onsubmit="CreateModificationsAsync">
                    @foreach (var c in active)
                    {
                        var id = c.Id;
                        <label>@c.Name <input value="@_axes.GetValueOrDefault(id)" @onchange="e => _axes[id] = e.Value?.ToString()" placeholder="@L("через запятую")" size="18" /></label>
                    }
                    <button type="submit" disabled="@_busy">@L("Создать модификации")</button>
                </form>
                <p class="muted small">@L("Например, Цвет «красный, синий» и Размер «46, 48, 50» — 6 модификаций. Уже созданные сочетания пропускаются; цены копируются с этой позиции.")</p>
            }
        }
    }
    else if (_variants is { Parent: not null } own && editable)
    {
        <h2 style="margin-top: 20px">@L("Характеристики модификации")</h2>
        <form class="inline-form" @onsubmit="SaveValuesAsync">
            @foreach (var c in _characteristics.Where(c => !c.IsArchived || own.Values.Any(v => v.CharacteristicId == c.Id)))
            {
                var id = c.Id;
                <label>@c.Name <input value="@_values.GetValueOrDefault(id)" @onchange="e => _values[id] = e.Value?.ToString()" maxlength="@ItemCharacteristicValue.ValueMaxLength" size="14" /></label>
            }
            <button type="submit" disabled="@_busy">@L("Сохранить")</button>
        </form>
    }
}


@if (_item is not null)
{
    <Discussion Target="KnitErp.Domain.Tagging.TaggedEntity.Item" TargetId="Id" />
}

@code {
    [Parameter]
    public long Id { get; set; }

    [CascadingParameter]
    public CurrentAccessDto CurrentAccess { get; set; } = default!;

    private ItemCardDto? _item;
    private ItemVariantsDto? _variants;
    private IReadOnlyList<ItemPhotoDto> _photos = [];
    private IReadOnlyList<CharacteristicDto> _characteristics = [];
    private Dictionary<long, string?> _axes = [];
    private Dictionary<long, string?> _values = [];
    private IReadOnlyList<ItemGroupDto> _groups = [];
    private IReadOnlyDictionary<long, IReadOnlyList<UserCatalogEntryDto>> _entries = new Dictionary<long, IReadOnlyList<UserCatalogEntryDto>>();
    private DetailsForm _form = new();
    private Dictionary<long, string?> _prices = [];
    private string? _barcode;
    private string _barcodeType = string.Empty;
    private bool _busy;
    private bool _notFound;
    private string? _denied;
    private string? _message;
    private bool _isError;

    private sealed class DetailsForm
    {
        public string Group { get; set; } = string.Empty;
        public string? Article { get; set; }
        public string? Country { get; set; }
        public string? CountryName { get; set; }
        public string? Declaration { get; set; }
        public string? TnVed { get; set; }
        public string? Weight { get; set; }
        public string? Volume { get; set; }
        public string? MinStock { get; set; }
        public string? PurchasePrice { get; set; }
        public Dictionary<long, string?> Values { get; } = [];
    }

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            await LoadAsync();
        }
        catch (AccessDeniedException ex)
        {
            _denied = UiErrors.Message(ex);
        }
        catch (NotFoundException)
        {
            _notFound = true;
        }
    }

    private async Task LoadAsync()
    {
        _item = await Nomenclature.GetItemAsync(Id);
        _groups = await Nomenclature.GroupsAsync();
        _entries = await Nomenclature.EntriesByCatalogAsync();
        var d = _item.Details;
        static string? N(decimal? v) => v is { } x ? Amounts.Input(x) : null;
        _form = new DetailsForm
        {
            Group = d.GroupId?.ToString() ?? string.Empty, Article = d.Article, Country = d.OriginCountryCode, CountryName = d.OriginCountryName,
            Declaration = d.CustomsDeclaration, TnVed = d.TnVedCode, Weight = N(d.WeightKg), Volume = N(d.VolumeM3), MinStock = N(d.MinStock),
            PurchasePrice = N(d.PurchasePrice),
        };
        foreach (var f in _item.CustomFields.Where(f => !f.IsArchived))
        {
            _form.Values[f.FieldId] = f.Value;
        }

        _prices = _item.Prices.ToDictionary(p => p.PriceTypeId, p => p.Price is { } v ? Amounts.Input(v) : null);
        _variants = await Modifications.VariantsAsync(Id);
        _photos = await Modifications.PhotosAsync(Id);
        _characteristics = await Modifications.CharacteristicsAsync(includeArchived: true);
        _values = _variants.Values.ToDictionary(v => v.CharacteristicId, v => (string?)v.Value);
    }

    private Task CreateModificationsAsync() => RunAsync(async () =>
    {
        var result = await Modifications.CreateModificationsAsync(Id, _axes);
        _axes = [];
        _message = result.Skipped > 0
            ? L("Создано модификаций: {0}; уже были: {1}.", result.Created, result.Skipped)
            : L("Создано модификаций: {0}.", result.Created);
    }, null);

    private Task SaveValuesAsync() => RunAsync(() => Modifications.SetValuesAsync(Id, _values, _variants!.RowVersion), L("Характеристики сохранены."));

    /// <summary>Фото по одному: каждое проверяется на сервере по содержимому (тип и размер).</summary>
    private Task UploadAsync(InputFileChangeEventArgs e) => RunAsync(async () =>
    {
        foreach (var file in e.GetMultipleFiles(ItemPhoto.MaxPerItem))
        {
            if (file.Size > ItemPhoto.MaxBytes)
            {
                throw new BusinessRuleException("catalog.photo.too_large", L("Фото — не больше 2 МБ. Уменьшите размер снимка."));
            }

            await using var stream = file.OpenReadStream(ItemPhoto.MaxBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            await Modifications.AddPhotoAsync(Id, buffer.ToArray());
        }
    }, L("Фото добавлено."));

    private void SetFlag(long fieldId, ChangeEventArgs e) => _form.Values[fieldId] = e.Value is true ? "true" : null;

    private Task SaveDetailsAsync() => RunAsync(async () =>
    {
        var f = _form;
        var details = new ItemDetails(long.TryParse(f.Group, out var g) ? g : null, f.Article, f.Country, f.CountryName, f.Declaration, f.TnVed,
            Decimals.Parse(f.Weight, L("Вес")), Decimals.Parse(f.Volume, L("Объём")), Decimals.Parse(f.MinStock, L("Неснижаемый остаток")),
            Decimals.Parse(f.PurchasePrice, L("Закупочная цена")));
        await Nomenclature.SaveItemDetailsAsync(Id, details, f.Values, _item!.RowVersion);
    }, L("Сведения сохранены."));

    private Task AddBarcodeAsync() => RunAsync(async () =>
    {
        await Nomenclature.AddBarcodeAsync(Id, _barcode, Enum.TryParse<BarcodeType>(_barcodeType, out var t) ? t : null);
        _barcode = null;
    }, L("Штрихкод добавлен."));

    private Task RemoveBarcodeAsync(ItemBarcodeDto b) => RunAsync(() => Nomenclature.RemoveBarcodeAsync(b.Id), L("Штрихкод удалён."));

    private Task SavePricesAsync() => RunAsync(async () =>
    {
        var prices = _prices.ToDictionary(p => p.Key, p => Decimals.Parse(p.Value, L("Цена")));
        await Nomenclature.SetPricesAsync(Id, prices);
    }, L("Цены сохранены."));

    /// <summary>Одна операция за раз, затем свежая карточка: у вкладки один DbContext.</summary>
    private async Task RunAsync(Func<Task> action, string? success)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _message = null;
        _isError = false;
        try
        {
            await action();
            _message = success ?? _message;
            await LoadAsync();
        }
        catch (Exception ex) when (UiErrors.IsUserFacing(ex))
        {
            _message = UiErrors.Message(ex);
            _isError = true;
        }
        finally
        {
            _busy = false;
        }
    }
}
