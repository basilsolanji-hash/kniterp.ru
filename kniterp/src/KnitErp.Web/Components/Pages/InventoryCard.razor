@page "/inventory/{Id:long}"
@using KnitErp.Application.Warehousing
@using KnitErp.Domain.Warehousing
@using KnitErp.Web.Components.Shared
@inject InventoryService Inventory
@inject StockBatchBreakdownService Breakdowns

<PageTitle>@(_doc?.Number ?? L("Инвентаризация")) — knitERP</PageTitle>

@if (_denied is not null)
{
    <AccessDenied Message="@_denied" />
}
else if (_notFound)
{
    <h1>@L("Инвентаризация не найдена")</h1>
    <p><a href="inventory">@L("К списку")</a></p>
}
else if (_doc is null)
{
    <p class="muted">@L("Загрузка…")</p>
}
else
{
    <p><a href="inventory">@L("← Инвентаризация")</a></p>
    <div class="page-head">
        <h1>@L("Инвентаризация") @_doc.Number <span class="tag @InventoryPage.StatusClass(_doc.Status)">@L(_doc.StatusName)</span></h1>
    </div>

    @if (_message is not null)
    {
        <div class="@(_messageIsError ? "flash error" : "flash")" role="@(_messageIsError ? "alert" : "status")">@_message</div>
    }

    <dl class="facts">
        <dt>@L("Склад")</dt><dd>@_doc.WarehouseName</dd>
        <dt>@L("Дата")</dt><dd>@_doc.CountDate.ToString("dd.MM.yyyy")</dd>
        <dt>@L("Комментарий")</dt><dd>@(_doc.Comment ?? "—")</dd>
        <dt>@L("Автор")</dt><dd>@_doc.CreatedBy, @Local(_doc.CreatedAtUtc)</dd>
        @if (_doc.PostedBy is not null)
        {
            <dt>@L("Провёл")</dt><dd>@_doc.PostedBy, @Local(_doc.PostedAtUtc!.Value)</dd>
        }
    </dl>

    @if (_doc.CanEdit)
    {
        <form class="inline-form" @onsubmit="SaveHeaderAsync">
            <label>@L("Дата") <input type="date" @bind="_date" /></label>
            <label>@L("Комментарий") <input @bind="_comment" maxlength="1000" size="40" placeholder="@L("Пояснение недостачи")" /></label>
            <button type="submit" class="secondary" disabled="@_busy">@L("Сохранить")</button>
        </form>
    }

    <div class="totals">
        <span>@L("Позиций:") <b>@_doc.Lines.Count</b></span>
        <span>@L("Не пересчитано:") <b class="@(_doc.NotCounted > 0 ? "bad" : "")">@_doc.NotCounted</b></span>
        <span>@L("Излишков:") <b>@_doc.Deviations.Count(d => d.Difference > 0)</b></span>
        <span>@L("Недостач:") <b class="@(_doc.Deviations.Any(d => d.Difference < 0) ? "bad" : "")">@_doc.Deviations.Count(d => d.Difference < 0)</b></span>
    </div>

    @if (_doc.CanEdit)
    {
        <div class="actions">
            <a class="button secondary" href="inventory/@Id/sheet.xlsx" download data-enhance-nav="false">@L("Бланк пересчёта (Excel)")</a>
            <label class="inline">@L("Загрузить факт из Excel") <InputFile OnChange="ImportAsync" accept=".xlsx" disabled="@_busy" /></label>
            <button type="button" class="secondary" @onclick="RefillAsync" disabled="@_busy">@L("Обновить учёт")</button>
        </div>
        <form class="inline-form" @onsubmit="AddLineAsync">
            <label>
                @L("Позиции нет в списке")
                <input list="items" @bind="_itemText" size="40" placeholder="@L("Код или наименование")" />
                <datalist id="items">
                    @foreach (var i in _items)
                    {
                        <option value="@($"{i.Code} — {i.Name}")">@i.UnitSymbol</option>
                    }
                </datalist>
            </label>
            <label>@L("Факт") <input @bind="_qtyText" inputmode="decimal" size="10" /></label>
            <button type="submit" class="secondary" disabled="@_busy">@L("Добавить")</button>
        </form>
    }

    @if (_import is { Applied: false })
    {
        <div class="error" role="alert">@L("В файле есть ошибки ({0}) — факт не загружен.", _import.ErrorRows)</div>
        <div class="scroll" style="max-height: 300px; overflow-y: auto">
            <table>
                <thead><tr><th>@L("Строка")</th><th>@L("Код")</th><th>@L("Количество")</th><th>@L("Ошибки")</th></tr></thead>
                <tbody>
                    @foreach (var r in _import.Rows.Where(r => r.Errors.Count > 0).Take(500))
                    {
                        <tr><td>@r.RowNumber</td><td>@r.Code</td><td>@r.QuantityText</td><td>@string.Join(" ", r.Errors)</td></tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <label class="inline" style="margin: 12px 0">
        <input type="checkbox" @bind="_onlyDeviations" /> @L("Только расхождения и непересчитанные")
    </label>

    <div class="scroll">
        <table>
            <thead><tr><th>@L("Код")</th><th>@L("Наименование")</th><th class="num">@L("По учёту")</th><th class="num">@L("Факт")</th><th class="num">@L("Разница")</th><th>@L("Ед.")</th></tr></thead>
            <tbody>
                @if (_doc.Lines.Count == 0)
                {
                    <tr><td colspan="6" class="muted">@L("По учёту на складе ничего нет. Добавьте позиции, которые нашли.")</td></tr>
                }
                @foreach (var l in _doc.Lines.Where(l => !_onlyDeviations || l.Counted is null || l.Difference != 0))
                {
                    <tr class="@(l.Difference < 0 ? "short" : "")">
                        <td>@l.Code</td>
                        <td>@l.Name</td>
                        <td class="num">@Quantities.Format(l.Book)</td>
                        <td class="num">
                            @if (_doc.CanEdit)
                            {
                                <input value="@(l.Counted is { } c ? Quantities.Format(c) : "")" inputmode="decimal" size="8" style="text-align: right"
                                       aria-label="@L("Факт {0}", l.Code)" disabled="@_busy" @onchange="e => SetCountedAsync(l, e.Value as string)" />
                            }
                            else
                            {
                                @(l.Counted is { } c ? Quantities.Format(c) : "—")
                            }
                        </td>
                        <td class="num">@(l.Counted is null ? "" : l.Difference > 0 ? "+" + Quantities.Format(l.Difference) : Quantities.Format(l.Difference))</td>
                        <td>@l.UnitSymbol</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (_batches is { } bt && bt.Items.Any(i => i.Rows.Count > 0 || (bt.CanEdit && i.Options.Count > 0)) || _batches?.Movements.Count > 0)
    {
        var bt2 = _batches!;
        @* D100: факт по партиям. Позиция с фактом хотя бы по одной партии пересчитана по партиям полностью. *@
        <h2 style="margin-top: 24px">@L("Партии")</h2>
        <p class="muted small">@L("Если указан факт хотя бы по одной партии позиции, позиция считается пересчитанной по партиям: партия без факта спишется до нуля, остаток сверх партий — «без партии». Без фактов по партиям недостача спишется сначала без партии, затем со старых партий.")</p>
        @if (bt2.CanEdit)
        {
            <div class="actions"><button type="button" class="secondary" @onclick="FillBatchesAsync" disabled="@_busy">@L("Заполнить факт партий по учёту")</button></div>
            <form class="inline-form" @onsubmit="ScanAsync">
                <label title="@L("Каждое сканирование прибавляет к факту партии одно место: вес места партии или одну штуку")">@L("Сканер: ярлык места") <input @bind="_scan" placeholder="KB…" size="16" autocomplete="off" /></label>
                <button type="submit" class="secondary" disabled="@_busy">@L("+1 место")</button>
            </form>
        }
        <div class="scroll">
            <table class="compact">
                <thead><tr><th>@L("Позиция")</th><th>@L("Партия")</th><th class="num">@L("Учёт")</th><th class="num">@L("Факт")</th><th class="num">@L("Разница")</th></tr></thead>
                <tbody>
                    @foreach (var it in bt2.Items.Where(i => i.Rows.Count > 0 || (bt2.CanEdit && i.Options.Count > 0)))
                    {
                        <tr class="@(it.WithoutBatch < 0 ? "short" : null)">
                            <td><strong>@it.Code</strong> <span class="muted small">@it.Name</span></td>
                            <td class="muted">@(it.CountedByBatches ? L("без партии после проведения: {0}", Quantities.Format(it.WithoutBatch ?? 0)) : L("по партиям не пересчитано"))</td>
                            <td></td>
                            <td class="num"><strong>@(it.Counted is { } c ? Quantities.Format(c) + " " + it.UnitSymbol : "—")</strong></td>
                            <td></td>
                        </tr>
                        @foreach (var r in it.Rows)
                        {
                            var row = r;
                            var item = it;
                            <tr>
                                <td></td>
                                <td>@r.Label</td>
                                <td class="num">@Quantities.Format(r.Book)</td>
                                <td class="num">
                                    @if (bt2.CanEdit)
                                    {
                                        <input value="@(r.Counted is { } rc ? Quantities.Format(rc) : "")" inputmode="decimal" size="8" style="text-align: right"
                                               aria-label="@L("Факт по партии {0}", r.Label)" disabled="@_busy" @onchange="e => SetBatchAsync(item, row.BatchId, e)" />
                                    }
                                    else
                                    {
                                        @(r.Counted is { } rc2 ? Quantities.Format(rc2) : "—")
                                    }
                                </td>
                                <td class="num @(r.Difference(it.CountedByBatches) < 0 ? "neg" : null)">@(it.CountedByBatches ? Quantities.Format(r.Difference(true)) : "")</td>
                            </tr>
                        }
                        @if (bt2.CanEdit && it.Options.Count > 0)
                        {
                            var item = it;
                            <tr>
                                <td></td>
                                <td colspan="4">
                                    <select aria-label="@L("Добавить партию")" disabled="@_busy" @onchange="e => AddBatchAsync(item, e)">
                                        <option value="">@L("+ партия, которой нет в учёте")</option>
                                        @foreach (var o in it.Options) { <option value="@o.Id">@o.Label</option> }
                                    </select>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        @if (bt2.Movements.Count > 0)
        {
            <h3>@L("Движения партий")</h3>
            <div class="scroll">
                <table class="compact">
                    <thead><tr><th>@L("Код")</th><th>@L("Партия")</th><th class="num">@L("Количество")</th></tr></thead>
                    <tbody>
                        @foreach (var m in bt2.Movements)
                        {
                            <tr><td>@m.ItemCode</td><td>@m.BatchLabel</td><td class="num @(m.Quantity < 0 ? "neg" : null)">@Quantities.Format(m.Quantity) @m.UnitSymbol</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }

    <div class="actions" style="margin-top: 16px">
        @if (_doc.CanPost)
        {
            <button type="button" @onclick="PostAsync" disabled="@(_busy || _doc.Lines.Count == 0)">@L("Провести")</button>
        }
        @if (_doc.CanEdit)
        {
            <button type="button" class="secondary" @onclick="CancelAsync" disabled="@_busy">@L("Отменить инвентаризацию")</button>
        }
    </div>
    @if (_doc.Status == InventoryStatus.Draft && !_doc.CanPost)
    {
        <p class="muted">@L("Провести инвентаризацию может Старший кладовщик этого склада или Владелец.")</p>
    }
    @if (_doc.Status == InventoryStatus.Posted)
    {
        <p class="muted">@L("Проведённая инвентаризация не отменяется: если в ней ошибка, проведите повторную инвентаризацию по этим позициям.")</p>
    }
}

@code {
    [Parameter]
    public long Id { get; set; }

    [CascadingParameter]
    public CurrentAccessDto CurrentAccess { get; set; } = default!;

    private InventoryDto? _doc;
    private IReadOnlyList<EntryItemDto> _items = [];
    private LineImportResult? _import;
    private bool _busy;
    private bool _notFound;
    private bool _onlyDeviations;
    private string? _denied;
    private string? _message;
    private bool _messageIsError;
    private string _itemText = string.Empty;
    private string _qtyText = string.Empty;
    private DateTime _date;
    private string? _comment;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadAsync();
            if (_doc!.CanEdit)
            {
                _items = await Inventory.ListItemsForEntryAsync();
            }
        }
        catch (AccessDeniedException ex)
        {
            _denied = UiErrors.Message(ex);
        }
        catch (NotFoundException)
        {
            _notFound = true;
        }
    }

    private InventoryBatchesDto? _batches;
    private string? _scan;

    /// <summary>D101: сканирование ярлыка места прибавляет к факту партии одно место.</summary>
    private Task ScanAsync() => RunAsync(async () =>
    {
        var (label, counted) = await Breakdowns.ScanInventoryAsync(Id, _scan, _batches!.RowVersion);
        _scan = null;
        _message = L("{0}: факт {1}.", label, Quantities.Format(counted));
    }, null);

    private Task FillBatchesAsync() => RunAsync(async () =>
    {
        var n = await Breakdowns.FillInventoryBatchesAsync(Id, _batches!.RowVersion);
        _message = L("Заполнено партий: {0}.", n);
    }, null);

    private Task SetBatchAsync(InventoryBatchItemDto item, long batchId, ChangeEventArgs e) => RunAsync(async () =>
    {
        var text = e.Value?.ToString();
        decimal? counted = null;
        if (!string.IsNullOrWhiteSpace(text))
        {
            counted = Quantities.TryParse(text, out var v) ? v : throw new BusinessRuleException("stock.quantity.invalid", L("Укажите количество числом, например 12,5."));
        }

        await Breakdowns.SetInventoryBatchAsync(Id, item.ItemId, batchId, counted, _batches!.RowVersion);
    }, null);

    private Task AddBatchAsync(InventoryBatchItemDto item, ChangeEventArgs e) =>
        long.TryParse(e.Value?.ToString(), out var batchId)
            ? RunAsync(() => Breakdowns.SetInventoryBatchAsync(Id, item.ItemId, batchId, 0m, _batches!.RowVersion), null)
            : Task.CompletedTask;

    private async Task LoadAsync()
    {
        _doc = await Inventory.GetAsync(Id);
        _batches = await Breakdowns.ForInventoryAsync(Id);
        _date = _doc.CountDate.ToDateTime(TimeOnly.MinValue);
        _comment = _doc.Comment;
    }

    private Task SaveHeaderAsync() =>
        RunAsync(() => Inventory.UpdateHeaderAsync(Id, DateOnly.FromDateTime(_date), _comment, _doc!.RowVersion), L("Сохранено."));

    private Task SetCountedAsync(InventoryLineDto line, string? text) => RunAsync(async () =>
    {
        decimal? value = null;
        if (!string.IsNullOrWhiteSpace(text))
        {
            if (!Quantities.TryParse(text, out var parsed))
            {
                throw new BusinessRuleException("stock.quantity.invalid", L("{0}: укажите количество числом, например 12,5.", line.Code));
            }

            value = parsed;
        }

        await Inventory.SetCountedAsync(Id, line.ItemId, value, _doc!.RowVersion);
    }, null);

    private Task AddLineAsync() => RunAsync(async () =>
    {
        var code = _itemText.Split(" — ", 2)[0].Trim();
        var item = _items.FirstOrDefault(i => string.Equals(i.Code, code, StringComparison.OrdinalIgnoreCase))
                   ?? throw new BusinessRuleException("stock.item.unknown", L("Позиция «{0}» не найдена. Выберите из списка.", _itemText));
        if (!Quantities.TryParse(_qtyText, out var qty))
        {
            throw new BusinessRuleException("stock.quantity.invalid", L("Укажите количество числом, например 12,5."));
        }

        await Inventory.SetCountedAsync(Id, item.Id, qty, _doc!.RowVersion);
        _itemText = string.Empty;
        _qtyText = string.Empty;
    }, null);

    private Task RefillAsync() => RunAsync(async () =>
    {
        var added = await Inventory.RefillFromBookAsync(Id, _doc!.RowVersion);
        _message = added > 0 ? L("Учёт обновлён, добавлено позиций: {0}.", added) : L("Учёт обновлён.");
    }, null);

    private Task ImportAsync(InputFileChangeEventArgs e) => RunAsync(async () =>
    {
        const long maxSize = 5 * 1024 * 1024;
        if (e.File.Size > maxSize)
        {
            throw new BusinessRuleException("import.file_too_large", L("Файл больше 5 МБ."));
        }

        await using var upload = e.File.OpenReadStream(maxSize);
        using var buffer = new MemoryStream();
        await upload.CopyToAsync(buffer);
        buffer.Position = 0;
        _import = await Inventory.ImportCountsAsync(Id, buffer, _doc!.RowVersion);
        if (_import.Applied)
        {
            _message = L("Загружен факт по {0} поз.", _import.Lines);
            _import = null;
        }
    }, null);

    private Task PostAsync() => RunAsync(() => Inventory.PostAsync(Id, _doc!.RowVersion), L("Инвентаризация проведена, остатки исправлены."));

    private Task CancelAsync() => RunAsync(() => Inventory.CancelAsync(Id, _doc!.RowVersion), L("Инвентаризация отменена."));

    /// <summary>Одна операция за раз, затем свежий документ: у вкладки один DbContext.</summary>
    private async Task RunAsync(Func<Task> action, string? success)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _message = null;
        _messageIsError = false;
        try
        {
            await action();
            _message = success ?? _message;
        }
        catch (Exception ex) when (UiErrors.IsUserFacing(ex))
        {
            _message = UiErrors.Message(ex);
            _messageIsError = true;
        }
        finally
        {
            try
            {
                await LoadAsync();
            }
            finally
            {
                _busy = false;
            }
        }
    }

    private string Local(DateTime utc) => TimeZones.ToLocal(utc, CurrentAccess.TimeZoneId).ToString("dd.MM.yyyy HH:mm");
}
