@* Настройка панели: какие инструменты закреплены и их порядок. Хранится в профиле пользователя.
   D801: все закреплённые видны сразу, со значком и подписью — меню «Ещё» и число «Видно сразу» убраны. *@

<p class="muted">@L("Закреплённые инструменты видны в верхней строке по порядку — значок и подпись. Быстрый поиск в строке всегда; обучение и поддержка — внизу меню слева. На телефоне инструменты — в одном меню «Инструменты».")</p>

<h3>@L("Закреплённые")</h3>
@if (_pinned.Count == 0)
{
    <p class="muted">@L("Ничего не закреплено — инструменты доступны через «Все инструменты».")</p>
}
<ol class="pin-list">
    @for (var i = 0; i < _pinned.Count; i++)
    {
        var index = i;
        var tool = ToolCatalog.Find(_pinned[index])!;
        <li>
            <span class="pin-icon"><Icon Name="@tool.Id" /></span>
            <span class="pin-title">@L(tool.Title)</span>
            <button type="button" class="secondary icon" @onclick="() => ChangeAsync(() => Move(index, -1))" disabled="@(index == 0)" aria-label="@L("Выше: {0}", L(tool.Title))" title="@L("Выше")">↑</button>
            <button type="button" class="secondary icon" @onclick="() => ChangeAsync(() => Move(index, 1))" disabled="@(index == _pinned.Count - 1)" aria-label="@L("Ниже: {0}", L(tool.Title))" title="@L("Ниже")">↓</button>
            <button type="button" class="secondary icon" @onclick="() => ChangeAsync(() => _pinned.RemoveAt(index))" aria-label="@L("Открепить: {0}", L(tool.Title))" title="@L("Открепить")">✕</button>
        </li>
    }
</ol>

<h3>@L("Можно добавить")</h3>
<ul class="plain pin-list">
    @foreach (var tool in ToolCatalog.Configurable.Where(t => !_pinned.Contains(t.Id)))
    {
        <li>
            <span class="pin-icon"><Icon Name="@tool.Id" /></span>
            <span class="pin-title">@tool.Title <span class="muted">— @tool.Hint</span></span>
            <button type="button" class="secondary icon" @onclick="() => ChangeAsync(() => _pinned.Add(tool.Id))" aria-label="@L("Закрепить: {0}", L(tool.Title))" title="@L("Закрепить")">+</button>
        </li>
    }
</ul>

@if (_message is not null)
{
    <div class="@(_isError ? "flash error" : "flash")" role="status">@_message</div>
}
@* D811 (запрос владельца 13.10, п. 3): без «Сохранить» — каждое изменение панели сохраняется сразу. *@
<div class="actions">
    <span class="muted small" aria-live="polite">@(_busy ? L("Сохраняется…") : L("Изменения сохраняются сразу."))</span>
    <button type="button" class="secondary" @onclick="() => ChangeAsync(Reset)">@L("Как было по умолчанию")</button>
</div>

@code {
    [Parameter, EditorRequired]
    public PanelSettings Settings { get; set; } = default!;

    [Parameter]
    public EventCallback<PanelSettings> OnSave { get; set; }

    private List<string> _pinned = [];
    private int _visible;
    private string? _message;
    private bool _isError;
    private bool _busy;
    private PanelSettings? _loaded;

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_loaded, Settings) && !_busy && !_again)
        {
            _pinned = Settings.Pinned.ToList();
            _visible = Settings.Visible;
            _loaded = Settings;
        }
    }

    private void Move(int index, int delta)
    {
        var target = index + delta;
        (_pinned[index], _pinned[target]) = (_pinned[target], _pinned[index]);
    }

    private void Reset()
    {
        _pinned = ToolCatalog.DefaultPinned.ToList();
        _visible = ToolCatalog.DefaultVisible;
    }

    private bool _again;

    /// <summary>Изменение применяется сразу и сохраняется; изменение во время сохранения сохраняется следом.</summary>
    private async Task ChangeAsync(Action change)
    {
        change();
        if (_busy)
        {
            _again = true;
            return;
        }

        do
        {
            _again = false;
            await SaveAsync();
        }
        while (_again);
    }

    private async Task SaveAsync()
    {
        _busy = true;
        try
        {
            await OnSave.InvokeAsync(new PanelSettings(_pinned.ToList(), _visible));
            _message = L("Сохранено — панель будет такой же на других устройствах.");
            _isError = false;
        }
        catch (Exception ex) when (UiErrors.IsUserFacing(ex))
        {
            _message = UiErrors.Message(ex);
            _isError = true;
        }
        finally
        {
            _busy = false;
        }
    }
}
