@inject AssistantService Assistant
@using KnitErp.Web.Components.Layout

@if (PersonaName is { } persona)
{
    @* D116: лицо помощника — выбранный в профиле персонаж. *@
    <div class="assistant-head">
        <img src="knit-mascot/assets/@(Choice!.Persona)-business-128.webp" alt="" width="43" height="64" />
        <div><b>@persona</b><div class="muted small">@(Choice!.Persona == KnitErp.Application.Workspace.AssistantPersonas.Nika ? L("Помощница knitERP") : L("Помощник knitERP"))</div></div>
    </div>
}
<p class="muted">
    @(Assistant.ModelConfigured
        ? L("Помощник отвечает по работе в knitERP с учётом ваших прав и текущего раздела. Не пишите сюда пароли и персональные данные.")
        : L("ИИ-модель не подключена — помощник подбирает ответы из справочного центра. Подключение — в настройках сервера."))
</p>

<div class="chat" aria-live="polite">
    @foreach (var m in _messages)
    {
        <div class="chat-msg @(m.FromUser ? "user" : "bot")">
            @if (!m.FromUser && PersonaName is { } who)
            {
                <div class="chat-who muted small">@who</div>
            }
            @if (!m.FromUser && m.Answer is { } kb)
            {
                @* D900: готовый ответ базы знаний — по абзацам, с кнопками «Открыть» и источниками. *@
                @if (m.FromModel)
                {
                    <div class="chat-text">@m.Text</div>
                }
                else if (m.Lead is not null)
                {
                    <div class="chat-text">@m.Lead</div>
                }
                <KnowledgeAnswerView Doc="kb" Context="Context" ShowText="@(!m.FromModel)" />
                <div class="muted small">@L("Ответ из базы знаний:") <button type="button" class="link" @onclick="() => Context.OpenTool(ToolCatalog.Help, kb.Id)">@L(kb.Article.Title)</button></div>
            }
            else
            {
                <div class="chat-text">@m.Text</div>
            }
            @if (m.Articles.Count > 0)
            {
                <div class="chat-links">
                    @if (m.Answer is not null)
                    {
                        <span class="muted small">@L("Ещё по теме:")</span>
                    }
                    @foreach (var a in m.Articles)
                    {
                        <button type="button" class="link" @onclick="() => Context.OpenTool(ToolCatalog.Help, a.Id)">📖 @L(a.Title)</button>
                    }
                </div>
            }
        </div>
    }
    @if (_busy)
    {
        <div class="chat-msg bot"><div class="chat-text muted">@L("Думаю…")</div></div>
    }
</div>

@if (_error is not null)
{
    <div class="error" role="alert">@_error</div>
}

<form class="tool-form" @onsubmit="AskAsync">
    <label>
        @L("Вопрос")
        <textarea @bind="_question" rows="3" maxlength="1000" placeholder="@L("Например: как исправить проведённое списание?")"></textarea>
    </label>
    <div class="actions">
        <button type="submit" disabled="@_busy">@L("Спросить")</button>
        @if (_messages.Count > 0)
        {
            <button type="button" class="secondary" @onclick="() => _messages.Clear()" disabled="@_busy">@L("Новый разговор")</button>
        }
    </div>
</form>

@code {
    [Parameter, EditorRequired]
    public ToolContext Context { get; set; } = default!;

    [CascadingParameter]
    public AssistantChoice? Choice { get; set; }

    private string? PersonaName => Choice is null ? null : KnitErp.Application.Workspace.AssistantPersonas.Name(Choice.Persona) is { } n ? L(n) : null;

    private sealed record Message(bool FromUser, string Text, IReadOnlyList<HelpArticle> Articles,
        KnitErp.Application.Workspace.Knowledge.KnowledgeDoc? Answer = null, bool FromModel = false, string? Lead = null);

    private readonly List<Message> _messages = [];
    private string _question = string.Empty;
    private string? _error;
    private bool _busy;

    private static string? LeadOf(string text, KnitErp.Application.Workspace.Knowledge.KnowledgeDoc answer)
    {
        var first = answer.Article.Body.Count > 0 ? text.IndexOf(answer.Article.Body[0], StringComparison.Ordinal) : -1;
        return first > 0 ? text[..first].Trim() : null;
    }

    private async Task AskAsync()
    {
        if (_busy || string.IsNullOrWhiteSpace(_question))
        {
            return;
        }

        _busy = true;
        _error = null;
        var question = _question.Trim();
        var history = _messages.Select(m => new AssistantTurn(m.FromUser, m.Text)).ToList();
        _messages.Add(new Message(true, question, []));
        _question = string.Empty;
        try
        {
            var reply = await Assistant.AskAsync(question, Context.Route, history, Choice?.Persona);
            // Без модели текст ответа — абзацы готового ответа; строка перед ними (лимит, недоступность модели) — пояснение.
            var lead = reply.Answer is not null && !reply.FromModel ? LeadOf(reply.Text, reply.Answer) : null;
            _messages.Add(new Message(false, reply.Text, reply.Articles, reply.Answer, reply.FromModel, lead));
        }
        catch (Exception ex) when (UiErrors.IsUserFacing(ex))
        {
            _error = UiErrors.Message(ex);
            _messages.RemoveAt(_messages.Count - 1);
            _question = question;
        }
        finally
        {
            _busy = false;
        }
    }
}
