@using System.Globalization
@using KnitErp.Application.Hr

@* Состав заработка из расчётного листка (ст. 136 ТК РФ). *@
<dl class="facts">
    <dt>@L("Сотрудник")</dt><dd>@Slip.FullName (@Slip.PersonnelNumber)</dd>
    <dt>@L("Подразделение и должность")</dt><dd>@Slip.Department, @Slip.Position</dd>
    <dt>@L("Месяц")</dt><dd>@Slip.Month.ToString("00").@Slip.Year</dd>
    <dt>@L("Отработано")</dt><dd>@L("{0} дн., {1} ч", Slip.DaysWorked, Slip.HoursWorked.ToString("0.##", Ru))</dd>
</dl>
<div class="scroll">
    <table class="compact">
        <thead><tr><th>@L("Вид начисления")</th><th class="opt">@L("Расчёт")</th><th class="num">@L("Количество")</th><th class="num">@L("Сумма")</th></tr></thead>
        <tbody>
            @foreach (var l in Slip.Lines)
            {
                <tr><td>@L(l.KindName)</td><td>@l.Description</td><td class="num">@l.Quantity.ToString("0.###", Ru)</td><td class="num">@l.Amount.ToString("N2", Ru)</td></tr>
            }
        </tbody>
        <tfoot><tr><th colspan="3">@L("Всего начислено")</th><th class="num">@Slip.Total.ToString("N2", Ru)</th></tr></tfoot>
    </table>
</div>

@code {
    private static readonly CultureInfo Ru = CultureInfo.GetCultureInfo("ru-RU");

    [Parameter, EditorRequired]
    public PayslipDto Slip { get; set; } = default!;
}
