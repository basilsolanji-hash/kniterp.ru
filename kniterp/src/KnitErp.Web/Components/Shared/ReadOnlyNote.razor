@*
    D809: страница или блок открыт без права изменения — поля неактивны, и здесь сказано почему (раньше поля были просто серыми).
    Сервер проверяет право сам; это только объяснение.
*@
@if (When)
{
    <p class="hint readonly-note" role="note">
        <span aria-hidden="true">🔒</span> @(Text ?? L("Только просмотр: изменять может пользователь с правом на изменение этого раздела. Если нужно что-то поменять — обратитесь к администратору."))
    </p>
}

@code {
    [Parameter]
    public bool When { get; set; }

    [Parameter]
    public string? Text { get; set; }
}
