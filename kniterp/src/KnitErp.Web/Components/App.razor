        .role-card.archived { opacity: .65; }
        .role-card header { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
        .role-card header .tag { margin-left: 0; }
        .role-card p { margin: 0; }
        .role-card .actions { margin-top: auto; padding-top: 6px; flex-wrap: wrap; }
        .role-perms { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
        .role-tools { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin: 8px 0; }
        .role-tools input[type=search] { flex: 1 1 220px; max-width: 360px; }
        .perm-groups { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 10px; }
        .perm-group { border: 1px solid var(--line); border-radius: 10px; padding: 8px 12px 10px; margin: 0; min-width: 0; }
        .perm-group legend { padding: 0 4px; }
        .perm-all { display: flex; align-items: center; gap: 8px; cursor: pointer; }
        .switch { display: flex; align-items: center; gap: 10px; padding: 5px 0; cursor: pointer; }
        .switch.locked { opacity: .55; cursor: not-allowed; }
        .switch input { position: absolute; opacity: 0; width: 1px; height: 1px; }
        .switch-ui { flex: 0 0 34px; height: 20px; border-radius: 999px; background: var(--line); position: relative; transition: background .15s; }
        .switch-ui::after { content: ""; position: absolute; top: 2px; left: 2px; width: 16px; height: 16px; border-radius: 50%; background: var(--text); transition: transform .15s; }
        .switch input:checked + .switch-ui { background: var(--accent); }
        .switch input:checked + .switch-ui::after { transform: translateX(14px); background: #fff; }
        .switch input:focus-visible + .switch-ui { outline: 2px solid var(--accent); outline-offset: 2px; }
        .switch .tag { margin-left: 4px; }
        .segmented { display: inline-flex; border: 1px solid var(--line); border-radius: 8px; overflow: hidden; align-self: flex-end; }
        .segmented button { border: 0; border-radius: 0; background: transparent; color: var(--text); padding: 7px 12px; }
        .segmented button.on { background: var(--accent); color: #fff; }
        .segmented button.on.bad { background: var(--bad); }
        .panel .perm-group label.switch, .panel .perm-group label.perm-all { flex-direction: row; align-items: center; justify-content: flex-start; text-align: left;
            font-size: 13px; color: var(--text); gap: 10px; }
        .perm-group label.perm-all { gap: 8px; }
        .perm-group label.perm-all input { width: 18px; height: 18px; min-height: 0; flex: none; }
        .switch > span:last-child { flex: 1 1 auto; min-width: 0; }
        .switch-ui { display: inline-block; background: color-mix(in srgb, var(--text) 22%, transparent); }
        .panel form.rights-add { display: grid; grid-template-columns: minmax(220px, 2fr) auto minmax(150px, 1fr) minmax(200px, 2fr) auto;
            gap: 10px; align-items: end; justify-items: stretch; }
        .panel form.rights-add label { text-align: left; }
        .panel form.rights-add .segmented { align-self: end; }
        @@media (max-width: 899px) { .panel form.rights-add { grid-template-columns: 1fr; } .panel form.rights-add .segmented { justify-self: start; } }
        .rights-list li { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; padding: 6px 0; border-bottom: 1px solid var(--line); }
        .rights-list .tag { margin-left: 0; }
        /* D115: «Пароль и сессии» — две формы рядом, на телефоне одна под другой. */
        .security-forms { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 12px; align-items: start; }
        .security-forms .panel { margin: 0; }
        .security-forms h3 { margin: 0 0 8px; }
        .security-forms label.inline { flex-direction: row; align-items: flex-start; gap: 8px; }
        .rights-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 10px 18px; }
        .rights-group ul { margin: 4px 0 0; }
        .rights-group li { display: flex; gap: 8px; padding: 2px 0; }
        .rights-group li.off { color: var(--muted-2); }
        /* D111: производство на главном экране — воронка этапов, готовность заказов, смена. */
        .prod-box h2 { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
        .prod-box h2 > a { margin-left: auto; font-weight: 400; }
        .prod-funnel { list-style: none; margin: 0 0 10px; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 10px; counter-reset: step; }
        .prod-funnel li { position: relative; min-width: 0; }
        .prod-step { display: flex; flex-direction: column; gap: 4px; padding: 10px 12px; border: 1px solid var(--line); border-radius: 8px; background: var(--field);
            color: var(--text); text-decoration: none; height: 100%; box-sizing: border-box; }
        .prod-step:hover { border-color: var(--accent); }
        .prod-step b { font-size: 18px; line-height: 1.1; }
        .prod-step .stage { align-self: flex-start; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .prod-late { font-size: 12px; color: var(--bad); }
        .prod-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 14px; }
        .prod-col { min-width: 0; }
        .prod-orders { list-style: none; margin: 8px 0 0; padding: 0; }
        .prod-orders a { display: grid; grid-template-columns: minmax(0, 1fr) 90px 40px auto; align-items: center; gap: 8px; padding: 6px 2px;
            border-bottom: 1px solid var(--line); color: var(--text); text-decoration: none; }
        .prod-orders li:last-child a { border-bottom: 0; }
        .prod-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .prod-bar { height: 6px; border-radius: 3px; background: var(--line); overflow: hidden; }
        .prod-bar span { display: block; height: 100%; background: var(--accent); }
        .prod-pct { text-align: right; font-variant-numeric: tabular-nums; }
        .prod-shift { display: flex; flex-direction: column; gap: 2px; padding: 10px 12px; margin-bottom: 8px; border: 1px solid var(--line); border-radius: 8px;
            color: var(--text); text-decoration: none; }
        .prod-shift b { font-size: 17px; }
        .neg { color: var(--bad); }
        /* Аудит 12.10.2026: на телефоне название этапа переносится, а не обрезается («Оплачен — в производ…»). */
        @@media (max-width: 599px) { .prod-step .stage { white-space: normal; overflow: visible; } }
        @@media (max-width: 599px) { .prod-funnel { grid-template-columns: 1fr 1fr; } .prod-orders a { grid-template-columns: minmax(0, 1fr) 60px 36px; } .prod-orders a > :last-child:not(.prod-pct) { display: none; } }
        .attention { list-style: none; margin: 0; padding: 0; }
        .attention li a { display: flex; align-items: center; gap: 10px; padding: 7px 4px; border-bottom: 1px solid var(--line); color: var(--text); text-decoration: none; }
        .attention li:last-child a { border-bottom: 0; }
        .attention li a:hover { background: var(--field); }
        .att-mark { flex: none; width: 22px; height: 22px; border-radius: 50%; display: grid; place-items: center; font-weight: 700; font-size: 12px; }
        .attention .todo .att-mark { background: var(--warn-bg); color: var(--warn-text); }
        .attention .done .att-mark { background: var(--ok-bg); color: var(--ok-text); }
        .att-text { flex: 1; display: flex; flex-direction: column; min-width: 0; }
        .att-text .muted { font-size: 11px; }
        .att-count { text-align: right; font-weight: 600; font-variant-numeric: tabular-nums; display: flex; flex-direction: column; }
        .attention .done .att-count { color: var(--muted); font-weight: 400; }
        .att-count .muted { font-size: 11px; font-weight: 400; }
        .share { height: 4px; background: var(--raised); border-radius: 2px; margin-top: 4px; overflow: hidden; }
        .share span { display: block; height: 100%; background: var(--sec-crm); }
        .mini-stats { display: grid; grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); gap: 8px; }
        .mini-stats a { display: flex; flex-direction: column; padding: 8px 10px; border: 1px solid var(--line); border-radius: 6px; color: var(--text); text-decoration: none; }
        .mini-stats a:hover { border-color: var(--accent); }
        .mini-stats b { font-size: 18px; font-variant-numeric: tabular-nums; }
        .mini-stats > span { display: flex; flex-direction: column; padding: 8px 10px; border: 1px solid var(--line); border-radius: 6px; }
        .mini-stats span span, .mini-stats a span { font-size: 11px; color: var(--muted); }
        .mini-stats > span.neg b { color: var(--bad); }
        .charts-title { font-size: 13px; margin: 4px 0 6px; color: var(--muted); font-weight: 600; }
        .charts { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 8px; margin-bottom: 14px; }
        .chart { display: flex; flex-direction: column; gap: 2px; padding: 10px 12px; border: 1px solid var(--line); border-radius: 6px; background: var(--surface-2); color: inherit; text-decoration: none; }
        .chart:hover { border-color: var(--accent); }
        .chart-head { display: flex; justify-content: space-between; gap: 6px; }
        .chart-total { font-size: 16px; font-weight: 600; font-variant-numeric: tabular-nums; }
        .chart-change { font-size: 11px; font-variant-numeric: tabular-nums; }
        .chart-change.up { color: var(--good); }
        .chart-change.down { color: var(--bad); }
        .chart svg { width: 100%; height: 70px; display: block; margin-top: 4px; }
        .chart-line { fill: none; stroke: var(--accent); stroke-width: 2; vector-effect: non-scaling-stroke; stroke-linejoin: round; }
        .chart-area { fill: var(--accent-wash); stroke: none; }
        .chart-hit { fill: transparent; }
        .chart-hit:hover { fill: var(--hover-wash); }
        .chart-axis { display: flex; justify-content: space-between; font-size: 10px; color: var(--muted-2); font-variant-numeric: tabular-nums; }
        @@media (max-width: 599px) { .charts { grid-template-columns: 1fr 1fr; } .chart { padding: 8px; } .chart-total { font-size: 15px; } .chart svg { height: 48px; } .chart-axis span:nth-child(2) { display: none; } }
        .dash-cols { display: grid; grid-template-columns: minmax(240px, 1fr) minmax(320px, 2fr); gap: 12px; align-items: start; }
        .dash-box { min-width: 0; overflow-x: auto; border: 1px solid var(--line); border-radius: 6px; background: var(--surface); padding: 10px 12px; }
        .readiness { display: flex; align-items: center; gap: 10px; text-decoration: none; color: var(--text-2); margin: 6px 0; }
        .readiness .bar { flex: 0 1 240px; height: 6px; background: var(--line); border-radius: 3px; overflow: hidden; }
        .readiness .bar span { display: block; height: 100%; background: var(--accent); }
        @@media (max-width: 899px) { .dash-cols { grid-template-columns: 1fr; } .nav-collapse { display: none; } }

        /* Планшет и телефон: меню сворачивается в кнопку и прилипает к верху, страница получает всю ширину. */
        @@media (max-width: 899px) {
            .shell { flex-direction: column; flex-wrap: nowrap; }
            .side { flex: none; position: sticky; top: 0; z-index: 10; background: var(--bg); border-right: 0; border-bottom: 1px solid var(--line); padding: 8px 12px; }
            .side { height: auto; overflow: visible; display: block; }
            .side > .nav-body { overflow: visible; }
            .side-foot { display: none; }
            .side-head { margin: 0; }
            .menu-toggle { display: inline-block; }
            .nav-body { display: none; max-height: calc(100vh - 64px); overflow-y: auto; padding-top: 8px; }
            .nav-body.open { display: block; }
            /* Открытое меню — во всю высоту экрана (dvh учитывает строку адреса браузера) и прокручивается само:
               прокрутка не «протекает» на страницу (overscroll-behavior), а страница под меню заблокирована. */
            .side:has(> .nav-body.open) { position: fixed; inset: 0 0 auto 0; z-index: 30; display: flex; flex-direction: column; height: 100vh; height: 100dvh; box-sizing: border-box; }
            .side > .nav-body.open { flex: 1 1 auto; min-height: 0; max-height: none; overflow-y: auto; overscroll-behavior: contain; -webkit-overflow-scrolling: touch; padding-bottom: env(safe-area-inset-bottom, 0px); }
            html:has(.nav-body.open), body:has(.nav-body.open) { overflow: hidden; overscroll-behavior: none; }
            .main { flex: 1 1 auto; padding: 12px 10px; }
            h1 { font-size: 18px; }
        }

        /* Телефон (D114: компактно по умолчанию): поля ввода — 16px, иначе iOS увеличивает страницу при вводе; текст и кнопки — 14px,
           высота касания 38px. Крупнее — «Размер интерфейса» в профиле. */
        @@media (max-width: 599px) {
            body { font-size: 14px; }
            input, select, textarea { font-size: 16px; min-height: 38px; padding: 6px 10px; box-sizing: border-box; }
            button, a.button { font-size: 14px; min-height: 38px; padding: 6px 12px; box-sizing: border-box; }
            .inline-form { flex-direction: column; align-items: stretch; }
            .inline-form label, .inline-form input, .inline-form select { width: 100%; }
            .inline-form input[size] { width: 100%; }
            input[type=checkbox], .inline-form input[type=checkbox] { width: 22px; height: 22px; min-height: 0; flex: none; }
            .actions > *, .page-head > button, .page-head > a.button { flex: 1 1 100%; text-align: center; }
            .row-actions button { min-height: 34px; }
            .confirm { flex: 1 1 100%; } .confirm button { flex: 1 1 0; }
            dl.facts { grid-template-columns: 1fr; gap: 2px; }
            dl.facts dd { margin-bottom: 8px; }
            .card { margin: 4vh auto; }

            /* Таблицы-списки становятся карточками: подпись столбца берётся из заголовка таблицы (скрипт ниже). */
            .scroll table:not(.matrix) thead { display: none; }
            .scroll table:not(.matrix), .scroll table:not(.matrix) tbody { display: block; }
            .scroll table:not(.matrix) tr { display: block; border: 1px solid var(--line); border-radius: 8px; padding: 4px 10px; margin-bottom: 6px; background: var(--surface-2); }
            .scroll table:not(.matrix) td { display: flex; justify-content: space-between; gap: 12px; border: 0; padding: 3px 0; text-align: right; overflow-wrap: anywhere; }
            .scroll table:not(.matrix) td[data-label]::before { content: attr(data-label); color: var(--muted); text-align: left; flex: 0 0 40%; }
            .scroll table:not(.matrix) td:not([data-label]) { justify-content: flex-start; text-align: left; }
            .scroll table:not(.matrix) td:empty { display: none; }
            /* Приоритетные столбцы: второстепенные (th.opt) скрыты, строка раскрывается по нажатию «Подробнее». */
            .scroll table:not(.matrix) td[data-opt] { display: none; }
            .scroll table:not(.matrix) tr[data-open] td[data-opt] { display: flex; }
            .scroll table:not(.matrix) tr[data-has-opt] { cursor: pointer; }
            .scroll table:not(.matrix) tr[data-has-opt]::after { content: "@CssText("Подробнее") ▾"; display: block; padding-top: 6px; color: var(--accent); font-size: 14px; }
            .scroll table:not(.matrix) tr[data-has-opt][data-open]::after { content: "@CssText("Свернуть") ▴"; }
        }

        /* Колонка страницы: панель быстрого доступа сверху, затем содержимое. */
        .main-col { flex: 999 1 600px; min-width: 0; display: flex; flex-direction: column; }
        .main-col > .main { flex: 1 1 auto; }
        .topbar { position: sticky; top: 0; z-index: 20; display: flex; justify-content: flex-end; align-items: center; box-sizing: border-box; height: 57px; padding: 0 24px; border-bottom: 1px solid var(--line); background: var(--bg); }
        .quickbar { display: flex; align-items: center; gap: 6px; flex-wrap: nowrap; }
        .quick-pinned { display: flex; align-items: center; gap: 4px; flex-wrap: wrap; justify-content: flex-end; }
        .quick-btn { display: inline-flex; align-items: center; gap: 6px; min-height: 40px; min-width: 40px; padding: 6px 10px; border-radius: 8px;
                     background: transparent; color: var(--text-2); font-weight: 400; border: 1px solid transparent; text-decoration: none; position: relative; }
        .quick-btn:hover, .quick-btn.active { background: var(--accent-soft); color: var(--text); }
        .tool-icon { font-size: 17px; line-height: 1; width: 1.2em; text-align: center; }
        .quick-btn .quick-label { font-size: 14px; }
        /* Верхняя строка — только значки (названия — в подсказке): ровные квадратные кнопки. */
        .quick-pinned .quick-btn { justify-content: center; width: 36px; height: 36px; min-height: 36px; min-width: 36px; padding: 0; }
        .quick-pinned .quick-btn .badge { position: absolute; top: -2px; right: -4px; }
        .quick-sep { width: 1px; height: 22px; background: var(--line); margin: 0 6px; }
        /* Отдельное окно инструмента (калькулятор): поверх страницы, не модальное, перетаскивается за заголовок. */
        .float-win { position: fixed; right: 24px; bottom: 24px; z-index: 60; width: 288px; background: var(--surface); border: 1px solid var(--line-strong); border-radius: 10px;
                     box-shadow: 0 12px 32px var(--shadow); color: var(--text); outline: none; }
        .float-win:focus-visible, .float-win:focus-within { border-color: var(--accent); }
        .float-head { display: flex; align-items: center; justify-content: space-between; padding: 8px 10px; cursor: move; user-select: none;
                      border-bottom: 1px solid var(--line); font-weight: 600; font-size: 13px; touch-action: none; }
        .float-head span { display: inline-flex; align-items: center; gap: 6px; }
        .float-close { background: transparent; border: 0; color: var(--muted); padding: 4px; min-height: 0; cursor: pointer; border-radius: 4px; }
        .float-close:hover { background: var(--line); color: var(--text); }
        .calc-display { padding: 10px 12px 6px; text-align: right; min-height: 64px; }
        .calc-expr { font-size: 12px; color: var(--muted-2); min-height: 16px; overflow-wrap: anywhere; }
        .calc-main { font-size: 26px; font-weight: 600; overflow-wrap: anywhere; }
        .calc-main.calc-error { font-size: 13px; font-weight: 400; color: var(--bad-text); }
        .calc-preview { font-size: 13px; color: var(--muted); }
        .calc-pad { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; padding: 6px 12px 10px; }
        .calc-key { height: 40px; min-height: 40px; padding: 0; font-size: 16px; background: var(--raised-3); color: var(--text); border: 0; border-radius: 6px; font-weight: 500; }
        .calc-key:hover { background: var(--raised-hover); }
        .calc-key.calc-op { background: var(--accent-soft); color: var(--ok-text); }
        .calc-key.calc-fn { color: var(--text-2); background: var(--raised-2); }
        .calc-key.calc-eq { grid-column: 1 / -1; background: var(--accent); color: var(--on-accent); font-weight: 700; }
        .calc-foot { display: flex; justify-content: space-between; align-items: center; padding: 0 12px 8px; font-size: 11px; }
        .calc-history { list-style: none; margin: 0; padding: 6px 12px 10px; border-top: 1px solid var(--line); font-size: 12px; max-height: 120px; overflow-y: auto; }
        .calc-history li { padding: 2px 0; text-align: right; }
        .badge { display: inline-block; min-width: 18px; padding: 0 5px; border-radius: 999px; background: var(--warn-text); color: var(--bg); font-size: 11px; font-weight: 700; line-height: 18px; text-align: center; }
        .icon-svg { flex: none; display: block; }
        .menu .badge { margin-left: auto; }
        .profile { display: inline-flex; align-items: center; gap: 10px; background: transparent; color: var(--text); padding: 4px 8px; font-weight: 400; border-left: 1px solid var(--line); border-radius: 0; margin-left: 6px; text-align: left; }
        .avatar { display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 50%; background: var(--ok-bg); color: var(--ok-text); font-weight: 700; font-size: 14px; flex: none; }
        .profile-text { display: flex; flex-direction: column; line-height: 1.25; max-width: 220px; }
        .profile-name { font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .profile-sub { font-size: 12px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .menu-anchor { position: relative; }
        .menu { position: absolute; top: calc(100% + 6px); left: 0; z-index: 70; min-width: 240px; max-height: 70vh; overflow-y: auto; padding: 6px; border-radius: 10px;
                background: var(--surface-2); border: 1px solid var(--line-strong); box-shadow: 0 12px 32px var(--shadow); display: flex; flex-direction: column; }
        .menu-right { left: auto; right: 0; }
        .menu-wide { min-width: 280px; }
        .menu .menu-item, .menu a[role=menuitem] { display: flex; align-items: center; gap: 10px; width: 100%; min-height: 40px; padding: 8px 10px; border-radius: 6px;
                background: transparent; color: var(--text); font-weight: 400; text-decoration: none; text-align: left; box-sizing: border-box; }
        .menu .menu-item:hover, .menu a[role=menuitem]:hover { background: var(--accent-soft); }
        .menu .menu-item.disabled { color: var(--muted-2); cursor: default; }
        .menu .menu-item.disabled:hover { background: transparent; }
        .menu .quick-label { position: static !important; width: auto !important; height: auto !important; clip: auto !important; }
        .menu-caption { font-size: 12px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted-2); padding: 8px 10px 4px; }
        .menu-info { display: flex; flex-direction: column; gap: 2px; padding: 8px 10px 10px; border-bottom: 1px solid var(--line); margin-bottom: 4px; }
        .menu form { margin: 0; }
        .menu-backdrop { position: fixed; inset: 0; z-index: 65; }
        .quickbar .menu-anchor { z-index: 66; }
        /* D801 (сессия 5): верхняя панель без скрытых значков — поиск слева, инструменты с подписями, блок пользователя справа. */
        .topbar { height: auto; min-height: 57px; padding-top: 6px; padding-bottom: 6px; }
        .topbar .quickbar { width: 100%; gap: 10px; }
        .topbar .profile-text { max-width: 150px; }
        .topbar .profile { margin-left: 0; padding-left: 10px; }
        .topbar .quick-pinned { flex: 1 1 auto; justify-content: flex-end; flex-wrap: wrap; gap: 2px; row-gap: 4px; }
        .quick-search { display: inline-flex; align-items: center; gap: 8px; height: 36px; min-width: 170px; padding: 0 10px; margin-right: auto;
                        border: 1px solid var(--line-strong); border-radius: 8px; background: var(--field); color: var(--muted); font-weight: 400; }
        .quick-search:hover, .quick-search.active { border-color: var(--accent); color: var(--text); }
        .quick-search kbd { margin-left: auto; font: 11px/1.6 inherit; padding: 0 5px; border: 1px solid var(--line); border-radius: 4px; color: var(--muted-2); }
        .quick-pinned .quick-btn.labeled { width: auto; padding: 0 8px; gap: 5px; }
        .quick-text { font-size: 13px; white-space: nowrap; }
        /* D806: «Создать» — главная кнопка панели; подписи значков — на широком экране, уже — значок с подсказкой и aria-label. */
        .quick-btn.quick-create { background: var(--accent); color: #fff; border-color: transparent; }
        .quick-btn.quick-create:hover, .quick-btn.quick-create[aria-expanded=true] { background: var(--accent); color: #fff; filter: brightness(1.08); }
        .quick-create .plus { font-size: 18px; line-height: 1; font-weight: 600; }
        .topbar .quick-search { margin-right: 0; }
        .topbar .quick-pinned > .menu-anchor:has(.quick-create) { margin-right: auto; }
        @@media (max-width: 1499px) { .topbar .quick-pinned .quick-btn.labeled:not(.quick-create) .quick-text { display: none; }
            .topbar .quick-pinned .quick-btn.labeled:not(.quick-create) { width: 36px; padding: 0; justify-content: center; } }
        .profile .caret { font-size: 10px; color: var(--muted); }
        /* D802: меню пользователя — шапка, действия, оформление, «Выйти» всегда видна внизу. */
        .menu.profile-menu { min-width: 380px; max-width: calc(100vw - 16px); max-height: calc(100vh - 72px); max-height: calc(100dvh - 72px); padding: 0; }
        .pm-head { display: flex; gap: 12px; align-items: center; padding: 14px 14px 12px; border-bottom: 1px solid var(--line); }
        .avatar.avatar-lg { width: 44px; height: 44px; font-size: 16px; }
        .pm-who { display: flex; flex-direction: column; min-width: 0; line-height: 1.35; }
        .pm-who .small { font-size: 12px; }
        .pm-actions { padding: 6px; border-bottom: 1px solid var(--line); }
        .pm-row { display: flex; flex-direction: column; gap: 4px; padding: 4px 12px 6px; }
        .pm-label { font-size: 12px; color: var(--muted); }
        .pm-row .segmented { display: flex; width: 100%; align-self: stretch; }
        .pm-row .segmented .chip { flex: 1 1 0; border: 0; border-radius: 0; margin: 0; min-height: 32px; padding: 4px 6px; color: var(--text);
                                   background: transparent; cursor: pointer; white-space: nowrap; text-align: center; }
        .pm-row .segmented .chip + .chip { border-left: 1px solid var(--line); }
        .pm-row .segmented .chip.added { background: var(--accent-soft); font-weight: 600; }
        .pm-logout { position: sticky; bottom: 0; margin-top: 10px; padding: 10px 12px; background: var(--surface-2); border-top: 1px solid var(--line); }
        .pm-logout button { width: 100%; }
        /* D807: рабочий день одной строкой внизу меню. */
        .sf-day > summary { display: flex; align-items: center; gap: 6px; cursor: pointer; list-style: none; font-size: 12.5px; min-height: 28px; }
        .sf-day > summary::-webkit-details-marker { display: none; }
        .sf-day-line { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .sf-meter.sf-meter-inline { flex: 0 0 36px; margin: 0 0 0 auto; }
        .sf-day[open] > summary { margin-bottom: 6px; }
        /* D800: открытое меню на телефоне — во весь экран, помощник его не перекрывает. */
        body:has(.nav-body.open) knit-assistant { display: none; }
        /* D805: поиск, избранное и «Все в разделе» в меню; страница раздела; нижняя панель телефона. */
        .nav-search { display: flex; align-items: center; gap: 8px; width: 100%; margin: 0 0 6px; padding: 6px 10px; border: 1px solid var(--line);
                      border-radius: 6px; background: var(--field); color: var(--muted); font-weight: 400; text-align: left; }
        .nav-search:hover { border-color: var(--accent); color: var(--text); }
        .nav-search kbd { margin-left: auto; font-size: 10px; padding: 0 4px; border: 1px solid var(--line); border-radius: 4px; color: var(--muted-2); white-space: nowrap; }
        .shell.narrow .nav-search { justify-content: center; padding: 8px 0; }
        .nav-favorites { margin: 0 0 6px; }
        .nav-favorites .nav-section { padding-left: 10px; }
        .side .nav-favorites a { display: flex; align-items: center; gap: 8px; padding: 4px 10px; font-size: 13px; }
        .side .nav-favorites a .icon-svg { color: var(--warn-text); flex: none; }
        .shell.narrow .nav-favorites a { justify-content: center; }
        .side .nav-items a.nav-all { color: var(--accent-text, var(--accent)); font-size: 12.5px; }
        .crumbs { font-size: 13px; color: var(--muted); margin-bottom: 4px; } .crumbs a { color: var(--muted); }
        .section-hub { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 12px; align-items: start; }
        .section-card h2 { font-size: 15px; margin: 0 0 8px; }
        .section-card ul.plain li a { display: flex; align-items: center; min-height: 36px; padding: 2px 4px; border-radius: 6px; text-decoration: none; }
        .section-card ul.plain li a:hover { background: var(--accent-soft); }
        .bottom-nav { display: none; }
        @@media (max-width: 899px) {
            .bottom-nav { display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; position: fixed; left: 0; right: 0; bottom: 0; z-index: 40;
                          padding-bottom: env(safe-area-inset-bottom, 0px); background: var(--bg); border-top: 1px solid var(--line-strong); }
            .bottom-nav a, .bottom-nav button { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; min-height: 56px;
                          padding: 4px 2px; font-size: 11px; font-weight: 500; color: var(--muted); text-decoration: none; background: none; border: 0; border-radius: 0; }
            .bottom-nav a.active, .bottom-nav button.active { color: var(--accent-text, var(--accent)); }
            .bottom-nav span { max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
            .menu-toggle { display: none !important; }
            .side:has(> .nav-body.open) .menu-toggle { display: inline-block !important; } /* «Закрыть» вверху открытого меню */
            .side:has(> .nav-body.open) .side-head .quickbar { display: none; } /* при открытом меню в строке логотипа только «Закрыть» — иначе она не помещается */
            main.main { padding-bottom: 80px; }
            body:has(knit-assistant) main.main { padding-bottom: 160px; }
            body knit-assistant { --knit-bottom: 72px; } /* выше нижней панели; общее правило ниже по файлу не должно перебить */
            .side > .nav-body.open { padding-bottom: calc(64px + env(safe-area-inset-bottom, 0px)); }
        }
        @@media print { .bottom-nav { display: none !important; } }
        @@media (max-width: 599px) { .menu.profile-menu { position: fixed; left: 8px; right: 8px; top: 60px; min-width: 0; }
            .pm-row .segmented { flex-wrap: wrap; } .pm-row .segmented .chip { flex-basis: 45%; } }
        .side-tools { display: none; }

        /* Панель инструмента. */
        .drawer { position: fixed; top: 57px; right: 0; bottom: 0; z-index: 50; width: min(440px, 100vw); display: flex; flex-direction: column;
                  background: var(--surface); border-left: 1px solid var(--line-strong); box-shadow: -12px 0 32px var(--shadow-2);
                  transform: translateX(105%); transition: transform .18s ease-out; visibility: hidden; }
        .drawer.open { transform: none; visibility: visible; }
        @@media (prefers-reduced-motion: reduce) { .drawer { transition: none; } }
        .drawer-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 16px; border-bottom: 1px solid var(--line); }
        .drawer-head h2 { margin: 0; font-size: 18px; }
        .drawer-body { flex: 1 1 auto; overflow-y: auto; padding: 16px; overscroll-behavior: contain; }
        .drawer-body h3 { font-size: 15px; margin: 18px 0 8px; }
        button.icon { min-width: 40px; min-height: 40px; padding: 6px 10px; }
        .tool-form { display: flex; flex-direction: column; gap: 10px; margin: 0 0 12px; }
        .tool-form label { display: flex; flex-direction: column; gap: 6px; color: var(--text-2); }
        .tool-form label.inline { flex-direction: row; }
        .tool-row { display: flex; gap: 10px; flex-wrap: wrap; align-items: flex-end; }
        .tool-row label { flex: 1 1 120px; }
        textarea { font: inherit; padding: 10px 12px; border-radius: 6px; border: 1px solid var(--line-strong); background: var(--field); color: var(--text); resize: vertical; }
        ul.plain { list-style: none; padding: 0; margin: 0 0 12px; }
        .link-list li { display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 6px 0; border-bottom: 1px solid var(--raised-3); flex-wrap: wrap; }
        .calc-keys { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; }
        .calc-keys button { min-height: 48px; font-size: 18px; }
        .calc-result { display: flex; flex-wrap: wrap; align-items: baseline; gap: 10px; padding: 12px; margin: 12px 0; border-radius: 8px; background: var(--accent-soft-2); }
        .calc-result b { font-size: 24px; }
        .cal-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; text-transform: capitalize; }
        .cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; }
        .cal-dow { text-align: center; font-size: 12px; color: var(--muted-2); }
        .cal-day { position: relative; min-height: 40px; padding: 4px; border-radius: 6px; background: var(--field); color: var(--text); font-weight: 400; }
        .cal-day.other { color: var(--faint-2); }
        .cal-day.today { border: 1px solid var(--accent); }
        .cal-day.selected { background: var(--accent); color: var(--on-accent); font-weight: 700; }
        .cal-dot { position: absolute; bottom: 4px; left: 50%; width: 5px; height: 5px; margin-left: -2px; border-radius: 50%; background: var(--warn-text); }
        .cal-dot.bday { left: auto; right: 5px; margin-left: 0; background: var(--sec-crm); }
        .cal-day.holiday { color: var(--bad); font-weight: 600; }
        .cal-day.holiday.selected { color: var(--on-accent); }
        .cal-event { margin: 2px 0 6px; padding: 4px 8px; border-radius: 4px; background: var(--field); font-size: 13px; }
        .cal-event.holiday { border-left: 3px solid var(--bad); }
        .cal-event.bday { border-left: 3px solid var(--sec-crm); }
        .task-note { display: block; white-space: pre-wrap; font-size: 12px; }
        .task-list { list-style: none; padding: 0; margin: 0 0 12px; }
        .task-list li { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 10px; padding: 8px 0; border-bottom: 1px solid var(--raised-3); }
        .task-list li > label { flex: 1 1 60%; }
        .task-list li.done span:first-of-type { text-decoration: line-through; color: var(--muted-2); }
        .tabs { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 12px; } /* перенос на телефоне: без горизонтальной прокрутки страницы */
        /* D103: теги как метки Finder. */
        .tag-picker { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin: 6px 0 10px; position: relative; }
        .tag-chip { display: inline-flex; align-items: center; gap: 5px; padding: 2px 4px 2px 8px; border-radius: 999px; background: var(--field); font-size: 13px; }
        .tag-chip a { color: inherit; text-decoration: none; }
        .tag-dot { display: inline-block; width: 10px; height: 10px; border-radius: 50%; flex: none; }
        .tag-dot.hollow { border: 1.5px solid var(--muted-2); box-sizing: border-box; }
        .tag-dot.big { width: 20px; height: 20px; padding: 0; min-height: 0; border: 2px solid transparent; cursor: pointer; }
        .tag-dot.big.selected { outline: 2px solid var(--accent); outline-offset: 2px; }
        .tag-x { background: none; border: 0; padding: 0 4px; min-height: 0; color: var(--muted-2); font-size: 15px; line-height: 1; cursor: pointer; }
        .tag-add { padding: 2px 10px; min-height: 0; border-radius: 999px; font-size: 13px; background: transparent; color: var(--muted); border: 1px dashed var(--line-strong); }
        .tag-pop { position: absolute; top: 100%; left: 0; z-index: 30; width: min(300px, 90vw); display: flex; flex-direction: column; gap: 4px;
                   padding: 10px; border-radius: 10px; background: var(--raised); border: 1px solid var(--line-strong); box-shadow: 0 8px 24px rgba(0,0,0,.25); }
        .tag-option { display: flex; align-items: center; gap: 8px; background: none; border: 0; color: inherit; text-align: left; padding: 6px 8px; min-height: 0; border-radius: 6px; }
        .tag-option:hover { background: var(--field); }
        .tag-colors { display: flex; gap: 6px; flex-wrap: wrap; padding: 4px 0; }
        .tag-dots { display: inline-flex; gap: 2px; margin-left: 6px; vertical-align: middle; }
        .tag-dots .tag-dot { width: 8px; height: 8px; }
        .nav-tags { list-style: none; margin: 0; padding: 0 0 0 4px; }
        /* D107: обсуждение документа. */
        .discussion { margin-top: 28px; max-width: 900px; }
        .discussion h2 { font-size: 15px; display: flex; gap: 8px; align-items: baseline; }
        .comments { list-style: none; margin: 0 0 12px; padding: 0; display: flex; flex-direction: column; gap: 12px; }
        .comment { display: flex; gap: 10px; align-items: flex-start; }
        .comment .avatar { flex: none; width: 32px; height: 32px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center;
                           font-size: 12px; font-weight: 600; background: var(--accent-soft); color: var(--text); }
        .comment.mine .avatar { background: color-mix(in srgb, var(--accent) 30%, transparent); }
        .comment-body { flex: 1 1 auto; min-width: 0; padding: 8px 12px; border-radius: 10px; background: var(--field); }
        .comment.deleted .comment-body { background: transparent; border: 1px dashed var(--line); }
        .comment-head { display: flex; gap: 8px; align-items: baseline; flex-wrap: wrap; margin-bottom: 2px; }
        .comment-text { white-space: pre-wrap; overflow-wrap: anywhere; }
        .comment-mentions { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 4px; }
        .mention { display: inline-flex; align-items: center; gap: 2px; padding: 1px 8px; border-radius: 999px; font-size: 12px; background: var(--accent-soft); color: var(--accent); }
        .comment-actions { display: flex; gap: 12px; margin-top: 4px; font-size: 12px; }
        .composer textarea { width: 100%; box-sizing: border-box; resize: vertical; min-height: 56px; }
        .composer-bar { display: flex; justify-content: space-between; gap: 8px; margin-top: 6px; flex-wrap: wrap; }
        .nav-tags a { display: flex; align-items: center; gap: 8px; padding: 4px 10px; font-size: 13px; color: var(--muted); text-decoration: none; border-radius: 6px; }
        .side .nav-tags a { padding: 4px 10px 4px 32px; color: var(--text-2); }
        .side .nav-tags a:hover, .side .nav-tags a.active { background: var(--field); color: var(--text); }
        .side a.nav-group-head { padding: 6px 10px; }
        .note-list { list-style: none; padding: 0; }
        .note-list li { padding: 10px 0; border-bottom: 1px solid var(--raised-3); }
        .note-text { white-space: pre-wrap; overflow-wrap: anywhere; margin-bottom: 6px; }
        .notice { padding: 10px 12px; border-radius: 8px; background: var(--field); margin-bottom: 8px; border-left: 3px solid var(--line-strong); }
        .notice.action { border-left-color: var(--accent); }
        .notice.warning { border-left-color: var(--warn-text); }
        .archive-ask p { margin: 0; } .archive-ask ul { margin: 6px 0 10px; padding-left: 20px; }
        .notice-list .notice { display: flex; align-items: flex-start; gap: 8px; }
        .notice button.link { text-align: left; color: var(--text); flex: 1; }
        .notice button.dismiss { background: none; border: 0; color: var(--muted); padding: 0 4px; min-height: 0; cursor: pointer; }
        .notice button.dismiss:hover { color: var(--text); }
        .chat { display: flex; flex-direction: column; gap: 8px; margin: 12px 0; }
        .chat-msg { max-width: 92%; padding: 10px 12px; border-radius: 10px; }
        .chat-msg.user { align-self: flex-end; background: var(--ok-bg); }
        .chat-msg.bot { align-self: flex-start; background: var(--field); }
        .chat-text { white-space: pre-wrap; overflow-wrap: anywhere; }
        .chat-links { display: flex; flex-direction: column; gap: 4px; margin-top: 8px; }
        .kb-answer p { margin: 0 0 8px; line-height: 1.5; overflow-wrap: anywhere; }
        .kb-open { display: flex; flex-wrap: wrap; gap: 6px; margin: 8px 0; }
        .kb-open a.button { white-space: normal; text-align: left; }
        .kb-sources { margin-top: 6px; overflow-wrap: anywhere; }
        .weather { padding: 14px; border-radius: 10px; background: var(--field); margin: 12px 0; }
        .weather-temp { font-size: 32px; font-weight: 700; }
        .ticket { padding: 10px 0; border-bottom: 1px solid var(--raised-3); display: flex; flex-direction: column; gap: 4px; }
        .ticket-text, .ticket-answer { white-space: pre-wrap; overflow-wrap: anywhere; }
        .ticket-answer { padding: 8px 10px; border-radius: 6px; background: var(--accent-soft-2); }
        .pin-list { padding: 0; list-style: none; margin: 0 0 12px; }
        .pin-list li { display: flex; align-items: center; gap: 6px; padding: 6px 0; border-bottom: 1px solid var(--raised-3); }
        .pin-list li.pin-more .pin-title { color: var(--muted); }
        .pin-icon { width: 28px; display: inline-flex; justify-content: center; }
        .pin-title { flex: 1 1 auto; min-width: 0; }
        .help-article p, .help-current p { line-height: 1.5; }

        /* Клавиатура: видимый фокус на всех элементах управления. */
        :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
        /* Сенсорный экран: цели нажатия не меньше 44 px (D801, требование владельца 13.10; было 36 px по D114). */
        @@media (pointer: coarse) { button, a.button, select, input:not([type=checkbox]):not([type=radio]), .quick-btn, .side a,
            .nav-group-head, .nav-single { min-height: 44px; }
            .side a, .nav-group-head, .nav-single { display: flex; align-items: center; padding-top: 6px; padding-bottom: 6px; } }
        /* D800: меню на телефоне и узком планшете — пункт 44 px при любом указателе (меню открывается во весь экран). */
        @@media (max-width: 899px) { .side .nav-items a, .side .nav-group-head, .side .nav-single { min-height: 44px; display: flex; align-items: center; }
            .side .nav-items a { padding-left: 36px; font-size: 14px; } }
        /* Большие мониторы: крупнее шрифт и поля, таблицы во всю ширину. */
        @@media (min-width: 1600px) { .main { padding: 24px 36px; } .topbar { padding: 0 36px; } .side { flex-basis: 248px; } }

        @@media (max-width: 899px) {
            .topbar { display: none; }
            .side-head { gap: 8px; }
            .side-head .logo { flex: 1 1 auto; }
            .side-tools { display: block; }
            .quickbar.compact .profile { border-left: 0; margin-left: 0; padding: 2px; }
            .quickbar.compact .quick-btn { border: 1px solid var(--line-strong); }
            /* D806: на телефоне число непрочитанных — меткой в углу значка, а не рядом (иначе панель шире 390 px). */
            .quickbar.compact .quick-btn { justify-content: center; padding: 0; width: 40px; }
            .quickbar.compact .quick-btn .badge { position: absolute; top: -6px; right: -6px; min-width: 18px; padding: 0 4px; font-size: 11px; line-height: 18px; }
            .drawer { top: auto; left: 0; width: 100vw; z-index: 80; height: 88vh; height: 88dvh; border-left: 0; border-top: 1px solid var(--line-strong); border-radius: 14px 14px 0 0;
                      transform: translateY(105%); box-shadow: 0 -12px 32px var(--shadow); }
            .drawer.open { transform: none; }
        }
        @@media (max-width: 420px) { .quickbar.compact .quick-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); } }
        /* Телефон боком: мало высоты — меню не прилипает, шторка во всю высоту. */
        @@media (max-height: 500px) and (orientation: landscape) {
            .side { position: static; }
            .drawer { height: 100vh; height: 100dvh; border-radius: 0; }
        }
        /* D114: размер интерфейса — «Компактно» (по умолчанию, правила выше), «Обычно» (крупные цели касания и 16px на телефоне),
           «Крупно» (ещё и крупнее текст на компьютере). Выбор — в профиле, хранится на этом устройстве (атрибут data-density). */
        :root[data-density="normal"] .kpi-value, :root[data-density="large"] .kpi-value { font-size: 24px; }
        :root[data-density="normal"] .chart-large svg, :root[data-density="large"] .chart-large svg { height: 110px; }
        :root[data-density="normal"] .quick-action, :root[data-density="large"] .quick-action { min-height: 44px; padding: 8px 12px; }
        @@media (pointer: coarse) {
            :root[data-density="normal"] :is(button, a.button, select, input:not([type=checkbox]), .quick-btn, .side a),
            :root[data-density="large"] :is(button, a.button, select, input:not([type=checkbox]), .quick-btn, .side a) { min-height: 44px; }
            :root[data-density="normal"] :is(.side a, .nav-group-head, .nav-single), :root[data-density="large"] :is(.side a, .nav-group-head, .nav-single) { min-height: 44px; }
        }
        @@media (max-width: 599px) {
            :root[data-density="normal"] body, :root[data-density="large"] body { font-size: 16px; }
            :root[data-density="normal"] :is(input, select, textarea, button, a.button),
            :root[data-density="large"] :is(input, select, textarea, button, a.button) { font-size: 16px; min-height: 44px; padding: 8px 12px; }
            :root[data-density="normal"] .scroll table:not(.matrix) td, :root[data-density="large"] .scroll table:not(.matrix) td { padding: 6px 0; }
        }
        @@media (min-width: 600px) {
            :root[data-density="normal"] body { font-size: 14px; }
            :root[data-density="normal"] :is(input, select, textarea) { padding: 6px 10px; font-size: 14px; }
            :root[data-density="normal"] :is(button, a.button) { padding: 6px 12px; font-size: 14px; }
            :root[data-density="normal"] :is(th, td) { padding: 6px 10px; }
            :root[data-density="large"] body { font-size: 15px; line-height: 1.45; }
            :root[data-density="large"] h1 { font-size: 22px; }
            :root[data-density="large"] h2 { font-size: 16px; }
            :root[data-density="large"] :is(input, select, textarea) { padding: 8px 12px; font-size: 15px; }
            :root[data-density="large"] :is(button, a.button) { padding: 8px 14px; font-size: 15px; }
            :root[data-density="large"] :is(th, td) { padding: 8px 12px; }
            :root[data-density="large"] .side a { padding: 9px 12px; }
        }
        .assistant-head { display: flex; align-items: center; gap: 10px; margin-bottom: 6px; }
        .assistant-head img { width: 43px; height: 64px; object-fit: cover; object-position: 50% 0; border-radius: 8px; background: var(--field);
            transform-origin: 50% 97.222%; animation: knit-idle 4.8s ease-in-out infinite; }
        @@keyframes knit-idle { 0%, 100% { transform: rotate(0) scale(1); } 25% { transform: rotate(.18deg) scale(1.003); } 50% { transform: rotate(0) scale(1.006); } 75% { transform: rotate(-.18deg) scale(1.003); } }
        @@media (prefers-reduced-motion: reduce) { .assistant-head img { animation: none; } }
        .chat-who { margin-bottom: 2px; }
        /* D116: персонаж помощника — не мешает панели инструментов и печати. */
        knit-assistant { --knit-right: 16px; --knit-bottom: 16px; --knit-z: 60; --knit-accent: var(--accent); }
        body:has(.drawer.open) knit-assistant, body:has(.float-win) knit-assistant { display: none; }
        @@media print { knit-assistant { display: none; } }
        /* Аудит 12.10.2026: персонаж помощника закрывал кнопки и плитки внизу экрана — под ним всегда остаётся свободное место. */
        body:has(knit-assistant) main.main { padding-bottom: 104px; }
        /* Аудит 12.10.2026: необработанная ошибка вкладки — сообщение и «Перезагрузить» вместо застывшего экрана (Blazor показывает блок сам). */
        #blazor-error-ui { display: none; position: fixed; left: 0; right: 0; bottom: 0; z-index: 1000; padding: 12px 16px;
            background: var(--bad-bg-2, #fde8e8); color: var(--text, #111); border-top: 1px solid var(--bad-line, #e0a0a0);
            box-shadow: 0 -2px 8px rgba(0,0,0,.15); font-size: 15px; }
        #blazor-error-ui .reload { font-weight: 600; margin-left: 8px; }
        /* D803: заставка до подключения схемы (без предварительной отрисовки). */
        .kn-boot { position: fixed; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px;
                   background: var(--bg); color: var(--muted); font-size: 14px; z-index: 5; }
        .kn-boot-logo { font-size: 28px; font-weight: 600; color: var(--text); } .kn-boot-logo b { color: var(--accent); font-weight: 600; }
        .kn-boot-bar { width: 160px; height: 3px; border-radius: 2px; background: linear-gradient(90deg, var(--accent) 0 40%, var(--line) 40%);
                       background-size: 250% 100%; animation: kn-boot 1.2s linear infinite; }
        @@keyframes kn-boot { from { background-position: 100% 0; } to { background-position: -150% 0; } }
        @@media (prefers-reduced-motion: reduce) { .kn-boot-bar { animation: none; } }
        /* Пока схема не подключилась, за заставкой идут только теги скриптов; первое отрисованное содержимое скрывает её. */
        .kn-boot:has(+ :not(script)) { display: none; }
        @@media print { #blazor-error-ui { display: none !important; } }
    </style>
    <HeadOutlet @rendermode="PageRenderMode" />
</head>
<body>
    @* Заставка при открытии (раз в день): вязаная «K» и счётчик процентов; логика — js/intro.js. *@
    <div id="kn-intro" class="kn-intro" hidden role="dialog" aria-modal="true" aria-label="knitERP">
        <video muted playsinline preload="auto" aria-hidden="true">
            <source src="media/intro.webm" type="video/webm" />
            <source src="media/intro.mp4" type="video/mp4" />
        </video>
        <div class="kn-intro-count" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
            <div><span class="kn-intro-num">0</span><span class="kn-intro-pct">%</span></div>
            <div class="kn-intro-bar"><span></span></div>
            <div class="kn-intro-brand">knit<b>ERP</b></div>
        </div>
    </div>
    <div id="blazor-error-ui" role="alert">
        @L("Произошла ошибка, страница перестала отвечать. Введённые и не сохранённые данные могли не сохраниться.")
        <a href="" class="reload">@L("Перезагрузить")</a>
    </div>
    @if (PageRenderMode is not null)
    {
        @* D803: заставка до подключения схемы Blazor; скрывается, как только появилась оболочка программы (.shell). *@
        <div id="kn-boot" class="kn-boot" role="status" aria-live="polite"><span class="kn-boot-logo">knit<b>ERP</b></span><span class="kn-boot-bar"></span><span>@L("Загрузка…")</span></div>
    }
    <Routes @rendermode="PageRenderMode" />
    <script src="_framework/blazor.web.js"></script>
    <script src="js/kniterp.js"></script>
    <script src="knit-mascot/web/knit-assistant.js"></script>
    <script src="js/intro.js"></script>
</body>
</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // Страницы входа работают без интерактивности: cookie выдаётся только в обычном HTTP-ответе.
    // D803 (сессия 5, дополнение 13.10): без предварительной отрисовки. Раньше сервер отдавал готовую страницу, а после
    // подключения схемы рисовал её заново: главная «мигала» (содержимое → «Загрузка…» → содержимое), а введённое в первые
    // секунды терялось при перерисовке. Теперь до подключения — заставка #kn-boot, поля появляются уже рабочими.
    private static readonly IComponentRenderMode Interactive = new InteractiveServerRenderMode(prerender: false);

    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? Interactive : null;
}
