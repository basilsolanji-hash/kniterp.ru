<!DOCTYPE html>
<html lang="@CurrentCode">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>knitERP</title>
    <link rel="icon" type="image/png" sizes="32x32" href="img/icon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="img/icon-192.png" />
    <link rel="apple-touch-icon" href="img/icon-180.png" />
    <link rel="manifest" href="manifest.json" />
    <meta name="theme-color" content="#1E1E20" />
    <script src="js/theme.js"></script>
    <style>
        /* Тема (D73): переменные цветов. По умолчанию — тёмная; светлая — выбор в профиле или «как в системе».
           Тема ставится атрибутом data-theme на html до отрисовки (js/theme.js), поэтому страница не мигает. */
        :root {
            color-scheme: dark;
            --bg: #1A1A1C;
            --surface: #1E1E21;
            --surface-2: #202023;
            --surface-3: #1F1F22;
            --surface-3b: #222226;
            --field: #232326;
            --raised: #26262A;
            --raised-2: #252528;
            --raised-3: #2A2A2E;
            --raised-hover: #34343A;
            --line: #2E2E33;
            --line-strong: #3A3A40;
            --text: #ECECEE;
            --text-2: #C8C8CE;
            --muted: #A6A6AE;
            --muted-2: #8A8A92;
            --faint: #6E6E76;
            --faint-2: #6A6A72;
            --accent: #2BA89A;
            --on-accent: #0E1413;
            --ok-bg: #1E3A35;
            --ok-text: #8FE0D3;
            --accent-text-strong: #CDEFE9;
            --accent-soft: #22302E;
            --accent-soft-2: #1A2B28;
            --accent-line: #2B5E56;
            --warn-text: #F0CF7A;
            --warn-bg: #3D341C;
            --warn-line: #6B5A2A;
            --bad-text: #F2A79C;
            --bad-bg: #43231F;
            --bad-line: #5A2E2E;
            --bad-bg-2: #2C1A1A;
            --bad: #E57A6E;
            --good: #5CC48A;
            --shadow: rgba(0,0,0,.45);
            --shadow-2: rgba(0,0,0,.4);
            --hover-wash: rgba(255, 255, 255, .06);
            --accent-wash: rgba(43, 168, 154, .15);
            --sec-sales: #3987E5;
            --sec-purchases: #D95926;
            --sec-crm: #9085E9;
            --sec-warehouse: #199E70;
            --sec-production: #C98500;
            --sec-dev: #D9739A; /* D700: «Разработка» */
            --sec-reports: #D55181;
            --sec-catalogs: #3FA34D;
            --sec-settings: #8A8A92;
            --sec-home: #2BA89A; --sec-discussions: #2BA89A;
            --sec-money: #B8892B;
        }
        :root[data-theme="light"] {
            color-scheme: light;
            --bg: #F3F4F6;
            --surface: #FFFFFF;
            --surface-2: #FFFFFF;
            --surface-3: #F8F9FB;
            --surface-3b: #F6F7F9;
            --field: #FFFFFF;
            --raised: #F0F2F5;
            --raised-2: #EEF0F3;
            --raised-3: #E9ECF0;
            --raised-hover: #E1E5EA;
            --line: #DDE1E6;
            --line-strong: #C3C9D1;
            --text: #1B1F24;
            --text-2: #39404A;
            --muted: #56606B;
            --muted-2: #66707B;
            --faint: #8C949E;
            --faint-2: #8C949E;
            --accent: #1A7F74;
            --on-accent: #FFFFFF;
            --ok-bg: #DCF2EE;
            --ok-text: #0F6A60;
            --accent-text-strong: #0D5A52;
            --accent-soft: #E3F3F0;
            --accent-soft-2: #ECF7F5;
            --accent-line: #9FD6CD;
            --warn-text: #865C00;
            --warn-bg: #FBEFD0;
            --warn-line: #E3C46A;
            --bad-text: #B0261C;
            --bad-bg: #FBE2DE;
            --bad-line: #EBB0A8;
            --bad-bg-2: #FDEEEC;
            --bad: #C0392B;
            --good: #1E8E4E;
            --shadow: rgba(15, 23, 42, .18);
            --shadow-2: rgba(15, 23, 42, .15);
            --hover-wash: rgba(15, 23, 42, .05);
            --accent-wash: rgba(26, 127, 116, .12);
            --sec-sales: #2A78D6;
            --sec-purchases: #EB6834;
            --sec-crm: #6250D6;
            --sec-warehouse: #1BAF7A;
            --sec-production: #B07A00;
            --sec-dev: #B8456F;
            --sec-reports: #C9457A;
            --sec-catalogs: #008300;
            --sec-settings: #66707B;
            --sec-home: #1A7F74; --sec-discussions: #1A7F74;
            --sec-money: #B8892B;
        }
        @@media (prefers-color-scheme: light) {
            :root[data-theme="auto"] {
                color-scheme: light;
            --bg: #F3F4F6;
            --surface: #FFFFFF;
            --surface-2: #FFFFFF;
            --surface-3: #F8F9FB;
            --surface-3b: #F6F7F9;
            --field: #FFFFFF;
            --raised: #F0F2F5;
            --raised-2: #EEF0F3;
            --raised-3: #E9ECF0;
            --raised-hover: #E1E5EA;
            --line: #DDE1E6;
            --line-strong: #C3C9D1;
            --text: #1B1F24;
            --text-2: #39404A;
            --muted: #56606B;
            --muted-2: #66707B;
            --faint: #8C949E;
            --faint-2: #8C949E;
            --accent: #1A7F74;
            --on-accent: #FFFFFF;
            --ok-bg: #DCF2EE;
            --ok-text: #0F6A60;
            --accent-text-strong: #0D5A52;
            --accent-soft: #E3F3F0;
            --accent-soft-2: #ECF7F5;
            --accent-line: #9FD6CD;
            --warn-text: #865C00;
            --warn-bg: #FBEFD0;
            --warn-line: #E3C46A;
            --bad-text: #B0261C;
            --bad-bg: #FBE2DE;
            --bad-line: #EBB0A8;
            --bad-bg-2: #FDEEEC;
            --bad: #C0392B;
            --good: #1E8E4E;
            --shadow: rgba(15, 23, 42, .18);
            --shadow-2: rgba(15, 23, 42, .15);
            --hover-wash: rgba(15, 23, 42, .05);
            --accent-wash: rgba(26, 127, 116, .12);
            --sec-sales: #2A78D6;
            --sec-purchases: #EB6834;
            --sec-crm: #6250D6;
            --sec-warehouse: #1BAF7A;
            --sec-production: #B07A00;
            --sec-dev: #B8456F;
            --sec-reports: #C9457A;
            --sec-catalogs: #008300;
            --sec-settings: #66707B;
            --sec-home: #1A7F74; --sec-discussions: #1A7F74;
            --sec-money: #B8892B;
            }
        }
        :root { color-scheme: dark; }
        body { margin: 0; background: var(--bg); color: var(--text); font-family: system-ui, sans-serif; font-size: 15px; }
        a { color: var(--accent); }
        .shell { display: flex; flex-wrap: wrap; min-height: 100vh; }
        .side { flex: 1 1 200px; padding: 16px; border-right: 1px solid var(--line); }
        .side a { display: block; padding: 10px 12px; text-decoration: none; color: var(--text-2); border-radius: 6px; }
        .side a.active { background: var(--accent-soft); color: var(--text); }
        .session { margin: 24px 12px 0; padding-top: 16px; border-top: 1px solid var(--line); font-size: 13px; }
        .main { flex: 999 1 600px; min-width: 0; padding: 24px; }
        table { border-collapse: collapse; width: 100%; }
        th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--line); }
        .muted { color: var(--muted); }
        .error { border: 1px solid var(--bad-line); background: var(--bad-bg-2); padding: 12px; border-radius: 8px; }
        .card { max-width: 420px; margin: 10vh auto; padding: 0 16px; }
        .card form { display: flex; flex-direction: column; gap: 12px; margin-top: 16px; }
        .card label { display: flex; flex-direction: column; gap: 6px; color: var(--text-2); }
        input { font: inherit; padding: 10px 12px; border-radius: 6px; border: 1px solid var(--line-strong); background: var(--field); color: var(--text); }
        button { font: inherit; padding: 10px 14px; border-radius: 6px; border: 0; background: var(--accent); color: var(--on-accent); font-weight: 600; cursor: pointer; }
        button.link { background: none; color: var(--accent); padding: 0; font-weight: 400; }
        .key { font-family: ui-monospace, monospace; letter-spacing: 1px; word-break: break-all; }
        .qr { background: #fff; padding: 12px; border-radius: 8px; width: 200px; height: 200px; }
        h2 { font-size: 18px; margin: 0 0 8px; }
        .page-head { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; justify-content: space-between; }
        .scroll { overflow-x: auto; }
        .tag { display: inline-block; font-size: 12px; padding: 2px 8px; border-radius: 999px; background: var(--line); color: var(--text-2); margin-left: 6px; }
        .tag.ok { background: var(--ok-bg); color: var(--ok-text); margin-left: 0; }
        /* D124: письмо с приглашением отправлено. */
        .invite-sent { background: var(--ok-bg); color: var(--ok-text); padding: 8px 12px; border-radius: 6px; margin: 8px 0; }
        .invite-panel .actions { flex-wrap: wrap; }
        /* D125: анкета сотрудника по ссылке (без входа) и проверка в карточке. */
        .employee-data-form fieldset { border: 1px solid var(--line); border-radius: 8px; padding: 12px; margin: 0; display: flex; flex-direction: column; gap: 10px; min-width: 0; }
        .employee-data-form legend { font-weight: 600; padding: 0 4px; }
        .employee-data-form input[type=file] { max-width: 100%; }
        .employee-data-form details { border: 1px solid var(--line); border-radius: 8px; padding: 8px 12px; }
        .employee-data-form summary { cursor: pointer; }
        .card label.consent-check { flex-direction: row; align-items: flex-start; gap: 8px; color: var(--text); }
        .consent-check input { margin-top: 3px; flex: none; }
        .data-compare td { overflow-wrap: anywhere; }
        .data-compare .differs { font-weight: 600; }
        .tag.warn { background: var(--warn-bg); color: var(--warn-text); margin-left: 0; }
        .tag.bad { background: var(--bad-bg); color: var(--bad-text); margin-left: 0; }
        .panel { border: 1px solid var(--line); background: var(--surface-2); border-radius: 10px; padding: 16px; margin: 16px 0; }
        .panel form, .panel .grid { display: flex; flex-direction: column; gap: 12px; }
        .panel label { display: flex; flex-direction: column; gap: 6px; color: var(--text-2); }
        /* Замечание 12.10.2026 «на всех экранах пустая площадь»: таблицы — на всю ширину, колонки форм делят ширину панели поровну
           (от 200 px), а не стоят узкой полосой слева. Короткие поля (числа, даты) по-прежнему узкие. */
        @@media (min-width: 700px) { table.compact td, table.compact th { padding-right: 24px; } }
        @@media (min-width: 700px) {
            .panel .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); column-gap: 16px; }
            .panel .grid input[inputmode=decimal], .panel .grid input[inputmode=numeric], .panel .grid input[type=date],
            .panel .grid input[type=time], .panel .grid input[type=number] { max-width: 170px; }
            .panel .grid label.inline { align-self: end; }
            .panel form > .actions, .panel .actions { justify-content: flex-start; }
        }
        select { font: inherit; padding: 10px 12px; border-radius: 6px; border: 1px solid var(--line-strong); background: var(--field); color: var(--text); }
        button.secondary { background: var(--line); color: var(--text); font-weight: 400; }
        button.danger { background: var(--bad); color: #fff; }
        .confirm { display: inline-flex; align-items: center; gap: 6px; flex-wrap: wrap; padding: 2px 6px; border-radius: 6px; background: var(--bad-bg-2); }
        .confirm-q { font-size: 13px; color: var(--bad-text); }
        button:disabled { opacity: .5; cursor: default; }
        .actions, .row-actions { display: flex; flex-wrap: wrap; gap: 8px; }
        .row-actions button { padding: 6px 10px; font-size: 13px; }
        .pager { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; margin: 12px 0; }
        .diff { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; }
        .diff > div { display: flex; flex-wrap: wrap; gap: 6px; align-content: flex-start; }
        .diff > div > .muted { width: 100%; }
        .chip { font-size: 13px; padding: 4px 10px; border-radius: 6px; background: var(--line); }
        .chip.added { background: var(--ok-bg); color: var(--accent-text-strong); }
        .lang-row { display: flex; flex-wrap: wrap; gap: 6px; padding: 2px 10px 8px; }
        .lang-row .chip { border: 0; color: var(--text); font-weight: 400; cursor: pointer; min-height: 32px; }
        .lang-row .chip.added { color: var(--accent-text-strong); }
        .lang-links { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 20px; font-size: 14px; }
        .flash { display: flex; justify-content: space-between; gap: 12px; align-items: center; border: 1px solid var(--accent-line); background: var(--accent-soft-2); padding: 10px 14px; border-radius: 8px; margin: 12px 0; }
        /* Поля формы, отключённые до подключения интерактивности: ввод до этого момента терялся бы. */
        fieldset.until-interactive { border: 0; padding: 0; margin: 0; min-width: 0; display: contents; }
        a.button { display: inline-block; padding: 10px 14px; border-radius: 6px; background: var(--accent); color: var(--on-accent); font-weight: 600; text-decoration: none; }
        a.button.secondary { background: var(--line); color: var(--text); font-weight: 400; }
        details.panel > summary { cursor: pointer; font-weight: 600; }
        .totals { display: flex; flex-wrap: wrap; gap: 16px; margin: 12px 0; }
        .totals .bad { color: var(--bad-text); }
        .codes { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 8px 24px; padding-left: 24px; font-size: 18px; }
        .checklist { list-style: none; padding: 0; margin: 16px 0; display: flex; flex-direction: column; gap: 8px; }
        .checklist li { display: flex; gap: 12px; align-items: center; border: 1px solid var(--line); background: var(--surface-2); border-radius: 10px; padding: 12px 14px; }
        .checklist li > div { flex: 1; min-width: 0; }
        .checklist .mark { flex: none; width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center; font-weight: 700; background: var(--line); }
        .checklist .done .mark { background: var(--ok-bg); color: var(--ok-text); }
        .checklist .todo { border-color: var(--bad-line); }
        .checklist .todo .mark { background: var(--bad-bg); color: var(--bad-text); }
        .checklist .manual .mark { background: var(--warn-bg); color: var(--warn-text); }
        .flash.error { border-color: var(--bad-line); background: var(--bad-bg-2); }
        .flash.warn { border-color: color-mix(in srgb, var(--warn-text) 45%, transparent); background: var(--warn-bg); color: var(--warn-text); }
        .load-error { flex-wrap: wrap; }
        .pack-count { display: inline-flex; gap: 4px; align-items: center; } .pack-count input { width: 4em; }
        .denied { border: 1px solid var(--bad-line); background: var(--bad-bg-2); padding: 20px; border-radius: 10px; }
        .denied h1 { font-size: 22px; margin: 8px 0; }
        .denied-code { font-weight: 700; color: var(--bad-text); }
        .legend { display: flex; flex-wrap: wrap; gap: 16px; margin: 12px 0; color: var(--text-2); }
        .matrix th.mine, .matrix td.mine { background: var(--ok-bg); }
        .inline-form { display: flex; flex-wrap: wrap; gap: 8px 12px; align-items: flex-end; margin: 12px 0; }
        .inline-form label { display: flex; flex-direction: column; gap: 6px; color: var(--text-2); }
        label.inline { display: inline-flex; flex-direction: row; gap: 8px; align-items: center; color: var(--text-2); }
        tr.archived td { color: var(--muted-2); }
        .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
        .matrix td:not(:first-child), .matrix th:not(:first-child) { text-align: center; }
        .side-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin: 4px 12px 16px; }
        .logo { font-weight: 600; font-size: 18px; }
        .menu-toggle { display: none; }
        .nav-section { margin: 14px 12px 4px; font-size: 12px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted-2); }
        .side a { padding-top: 7px; padding-bottom: 7px; }
        .num { text-align: right; white-space: nowrap; }
        tr.short td { color: var(--bad-text); }
        dl.facts { display: grid; grid-template-columns: max-content 1fr; gap: 8px 16px; margin: 12px 0; max-width: 720px; }
        dl.facts dt { color: var(--muted); }
        dl.facts dd { margin: 0; overflow-wrap: anywhere; }
        /* Карточка (номенклатура и др.): на широком экране разделы в две колонки, широкие (.wide) — во всю ширину. */
        @@media (min-width: 1400px) {
            .card-flow { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 24px; align-items: start; }
            .card-flow > .wide { grid-column: 1 / -1; }
            .card-flow > .card-sec > h2:first-child { margin-top: 12px !important; }
        }
        .card-sec { min-width: 0; }
        /* D338: заголовок столбца с сортировкой — кнопка, но выглядит как заголовок; фокус клавиатуры виден. */
        th > .th-sort { background: none; border: 0; padding: 0; color: inherit; font: inherit; cursor: pointer; text-align: inherit; }
        th > .th-sort:hover { color: var(--text); }
        .columns-menu { margin: 0 0 6px; }
        .columns-menu > summary { cursor: pointer; color: var(--text-2); width: max-content; }
        .columns-menu > .panel { display: flex; flex-wrap: wrap; gap: 6px 16px; align-items: center; }
        /* Поле выбора файла не шире экрана (на 390 px подпись «Загрузить строки из Excel» с полем давала прокрутку вбок). */
        input[type=file] { max-width: 100%; min-width: 0; }
        label.inline:has(> input[type=file]) { flex-wrap: wrap; max-width: 100%; min-width: 0; }
        @@media (min-width: 1400px) { dl.facts { max-width: none; grid-template-columns: repeat(3, max-content minmax(0, 1fr)); } }

        /* Компактный вид (замечание пользователя: «всё очень крупно, нет фокуса на данных»): мелкий шрифт и отступы,
           плотные таблицы, видимый фокус клавиатуры. Телефон ниже получает крупные поля и кнопки обратно. */
        body { font-size: 13px; line-height: 1.4; }
        h1 { font-size: 19px; margin: 0 0 8px; font-weight: 600; }
        h2 { font-size: 14px; margin: 0 0 6px; font-weight: 600; }
        .main { padding: 12px 18px; }
        input, select { padding: 4px 8px; border-radius: 4px; font-size: 13px; }
        button, a.button { padding: 5px 10px; border-radius: 4px; font-size: 13px; }
        th, td { padding: 4px 8px; }
        th { font-weight: 500; font-size: 12px; color: var(--muted); background: var(--surface-3); position: sticky; top: 0; z-index: 1; }
        tbody tr:hover td { background: var(--surface-3b); }
        .num { font-variant-numeric: tabular-nums; }
        .panel { padding: 10px 12px; margin: 8px 0; border-radius: 6px; }
        .panel form, .panel .grid { gap: 8px; }
        .panel label, .inline-form label { gap: 3px; font-size: 12px; }
        /* Флажок с подписью в одну строку (label.check — как label.inline): галочка перед текстом, а не над ним. */
        label.check, .panel label.check, .inline-form label.check { display: flex; flex-direction: row; align-items: center; gap: 8px; color: var(--text-2); }
        label.check input[type=checkbox] { width: auto; flex: none; margin: 0; }
        .inline-form { gap: 6px 10px; margin: 8px 0; }
        .flash, .error { padding: 6px 10px; margin: 8px 0; border-radius: 4px; }
        .tag { font-size: 11px; padding: 1px 6px; }
        p { margin: 6px 0; }
        dl.facts { gap: 4px 14px; margin: 8px 0; }
        /* D1109 (сессия «Продажи», жалоба владельца на пустые площади): на широком экране реквизиты — пары «подпись — значение»
           в несколько колонок на всю ширину, а не узкой колонкой слева. */
        @@media (min-width: 900px) {
            dl.facts { max-width: none; grid-template-columns: repeat(auto-fill, 136px minmax(200px, 1fr)); column-gap: 14px; }
            dl.facts dt { overflow-wrap: anywhere; }
        }
        :focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
        input:focus, select:focus, textarea:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-wash); }
        /* Поля понятнее цветом: обязательное — полоска цвета акцента слева, ошибка — красная рамка, только чтение — фон тише. */
        input:required, select:required, textarea:required { border-left: 3px solid var(--accent); }
        input[aria-invalid="true"], select[aria-invalid="true"], .invalid, input.invalid { border-color: var(--bad) !important; box-shadow: 0 0 0 3px var(--bad-bg); }
        input:disabled, select:disabled, textarea:disabled, input[readonly] { background: var(--raised); color: var(--muted); }
        input[type=number], input[inputmode=decimal], input[inputmode=numeric] { font-variant-numeric: tabular-nums; }
        label { color: var(--muted); }
        label > input, label > select, label > textarea { color: var(--text); }
        /* Разделы меню: значок своим цветом, выбранный пункт — полоска цвета раздела. */
        .nav-group-head .icon-svg, .nav-single .icon-svg { color: var(--sec, var(--text-2)); }
        .nav-items a.active { box-shadow: inset 3px 0 0 var(--sec, var(--accent)); }
        .tag.info { background: color-mix(in srgb, var(--sec-sales) 18%, transparent); color: var(--text); margin-left: 0; }
        /* Низ меню: срочные задачи, рабочий день, обучение и поддержка, пользователь. */
        .side-foot { margin-top: auto; padding: 8px 2px 4px; border-top: 1px solid var(--line); display: flex; flex-direction: column; gap: 8px; }
        .sf-block { background: var(--surface-2); border: 1px solid var(--line); border-radius: 8px; padding: 8px 10px; font-size: 12px; }
        .sf-head { display: flex; justify-content: space-between; align-items: center; gap: 6px; margin-bottom: 6px; color: var(--text-2); font-weight: 600; }
        .sf-head > span:first-child { display: inline-flex; align-items: center; gap: 5px; white-space: nowrap; }
        .sf-head .muted { white-space: nowrap; }
        .side-foot .profile-text { min-width: 0; }
        .side-foot .profile-name, .side-foot .profile-sub { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 140px; }
        .sf-head .muted { font-weight: 400; }
        .sf-urgent { border-color: var(--warn-line); }
        .sf-urgent .sf-head .icon-svg { color: var(--warn-text); }
        .sf-urgent ul { list-style: none; margin: 0; padding: 0; }
        .sf-urgent li { display: flex; justify-content: space-between; gap: 6px; padding: 2px 0; }
        .sf-urgent li .link { text-align: left; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 140px; color: var(--text); }
        .sf-urgent li.overdue .sf-when { color: var(--bad-text); font-weight: 600; }
        .sf-when { color: var(--muted); font-variant-numeric: tabular-nums; flex: none; }
        .sf-all { font-size: 11px; margin-top: 4px; }
        .sf-meter { height: 6px; border-radius: 3px; background: var(--accent-soft); overflow: hidden; margin: 2px 0 6px; }
        .sf-meter span { display: block; height: 100%; background: var(--accent); border-radius: 3px; }
        .sf-row { display: flex; justify-content: space-between; gap: 6px; padding: 1px 0; font-variant-numeric: tabular-nums; }
        .sf-links { display: flex; flex-direction: column; gap: 2px; }
        .sf-link { display: flex; align-items: center; gap: 8px; background: none; border: 0; color: var(--text-2); padding: 6px 10px; border-radius: 4px;
                   font-size: 13px; text-align: left; min-height: 0; font-weight: 400; cursor: pointer; }
        .sf-link:hover { background: var(--field); color: var(--text); }
        .side-foot .profile-anchor .profile { width: 100%; justify-content: flex-start; }
        .menu.menu-up { top: auto; bottom: calc(100% + 6px); left: 0; right: auto; }
        .shell.narrow .side-foot .sf-link { justify-content: center; padding: 8px 0; }

        /* Меню: разделы сворачиваются, раскрыт текущий; колонку можно сузить до значков. */
        .side { flex: 0 0 232px; padding: 10px 8px; box-sizing: border-box; display: flex; flex-direction: column;
                position: sticky; top: 0; height: 100vh; overflow: hidden; }
        .side > .nav-body { flex: 1 1 auto; min-height: 0; overflow-y: auto; }
        .main-col { flex: 1 1 0; }
        .side-head { margin: 2px 8px 10px; }
        .side a { padding: 4px 10px 4px 32px; border-radius: 4px; font-size: 13px; }
        .side a.nav-single { padding-left: 10px; }
        .nav-single, .nav-group-head { display: flex !important; align-items: center; gap: 8px; }
        .nav-group-head { width: 100%; background: none; color: var(--text-2); font-weight: 500; padding: 6px 10px; text-align: left; border-radius: 4px; }
        .nav-group-head:hover, .side a:hover { background: var(--field); }
        .nav-group.open > .nav-group-head { color: var(--text); }
        .nav-group-head .caret { margin-left: auto; font-size: 10px; transition: transform .15s; transform: rotate(-90deg); }
        .nav-group.open > .nav-group-head .caret { transform: none; }
        .nav-items { margin: 0 0 6px; }
        /* D800: подзаголовок внутри раздела меню («Документы», «Цены», «Отчёты»). */
        .nav-section { display: block; padding: 8px 10px 2px 32px; font-size: 11px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; color: var(--muted-2); }
        .shell.narrow .nav-section { display: none; }
        .learn article { border-bottom: 1px solid var(--line); padding: 10px 0; max-width: 860px; }
        .learn article h2 { font-size: 15px; }
        .nav-collapse { margin: 12px 10px 0; background: none; color: var(--muted-2); padding: 2px 6px; }
        .shell.narrow .side { flex-basis: 52px; }
        .shell.narrow .nav-text, .shell.narrow .caret, .shell.narrow .nav-items { display: none; }
        .shell.narrow .nav-group-head, .shell.narrow .nav-single { justify-content: center; padding: 8px 0; }

        /* Главный экран: плитки показателей, месяц склада, последние документы. */
        .tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 8px; margin: 10px 0 14px; }
        .tile { display: flex; flex-direction: column; gap: 2px; padding: 10px 12px; border: 1px solid var(--line); border-radius: 6px; background: var(--surface-2);
                color: var(--text); text-decoration: none; }
        .tile:hover { border-color: var(--accent); }
        .tile.warn { border-color: var(--warn-line); }
        .tile-title { font-size: 12px; color: var(--muted); }
        .tile-value { font-size: 24px; font-weight: 600; font-variant-numeric: tabular-nums; }
        .tile.warn .tile-value { color: var(--warn-text); }
        .warn-text { color: var(--warn-text); }
        tfoot td { border-top: 1px solid var(--line-strong); border-bottom: 0; }
        .tile-hint { font-size: 11px; color: var(--muted-2); }
        /* Этапы заказов (D75): цветная метка — точка и подложка цвета этапа; текст — обычным цветом, читается в обеих темах. */
        .stage { --st: var(--muted-2); display: inline-flex; align-items: center; gap: 6px; padding: 2px 8px 2px 6px; border-radius: 999px; font-size: 12px;
                 background: color-mix(in srgb, var(--st) 18%, transparent); color: var(--text); white-space: nowrap; }
        .stage::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--st); flex: none; }
        .stage-gray { --st: var(--sec-settings); } .stage-blue { --st: var(--sec-sales); } .stage-teal { --st: var(--sec-warehouse); }
        .stage-green { --st: var(--sec-catalogs); } .stage-yellow { --st: var(--sec-production); } .stage-orange { --st: var(--sec-purchases); }
        .stage-red { --st: var(--bad); } .stage-magenta { --st: var(--sec-reports); } .stage-violet { --st: var(--sec-crm); }
        .stage-none { --st: var(--faint); color: var(--muted); }
        .stage-pick { display: flex; align-items: center; gap: 8px; }
        .stage-pick label { display: flex; align-items: center; gap: 6px; }
        .stage-select { border-left: 4px solid var(--st, var(--line-strong)) !important; font-weight: 500; }
        .cell-short { background: color-mix(in srgb, var(--bad) 18%, transparent); color: var(--bad-text); font-weight: 600; }
        .money-debt { color: var(--bad-text); font-weight: 600; }
        .inn-fill { display: flex; gap: 6px; align-items: center; }
        /* Заставка (D80): фон как у ролика, видео по центру, счётчик — крупные тонкие цифры и тонкая полоса. */
        .kn-intro { position: fixed; inset: 0; z-index: 2147483000; background: #19191B; display: flex; flex-direction: column;
                    align-items: center; justify-content: center; gap: 8px; cursor: pointer; opacity: 1; transition: opacity .3s ease; }
        .kn-intro[hidden] { display: none !important; }
        .kn-intro video { width: min(62vmin, 460px); height: auto; aspect-ratio: 1; object-fit: cover; opacity: 0; transition: opacity .25s ease;
                         -webkit-mask-image: radial-gradient(circle, #000 58%, transparent 71%); mask-image: radial-gradient(circle, #000 58%, transparent 71%); }
        .kn-intro.kn-intro-on video { opacity: 1; }
        .kn-intro-count { width: min(62vmin, 460px); display: flex; flex-direction: column; align-items: center; gap: 10px;
                          font-family: Inter, system-ui, sans-serif; color: #F2F2F3; }
        .kn-intro-num { font-size: clamp(40px, 9vmin, 72px); font-weight: 200; letter-spacing: -2px; font-variant-numeric: tabular-nums; }
        .kn-intro-pct { font-size: clamp(16px, 3vmin, 24px); font-weight: 300; color: #2ED3C6; margin-left: 4px; }
        .kn-intro-bar { width: 100%; height: 2px; background: rgba(255,255,255,.08); border-radius: 2px; overflow: hidden; }
        .kn-intro-bar span { display: block; height: 100%; width: 0; background: linear-gradient(90deg, #2ED3C6, #8FF0E8);
                             box-shadow: 0 0 12px rgba(46,211,198,.6); }
        .kn-intro-brand { font-size: 13px; letter-spacing: 6px; text-transform: uppercase; color: #8A8A91; }
        .kn-intro-brand b { color: #2ED3C6; font-weight: 600; }
        .kn-intro.kn-intro-out { opacity: 0; pointer-events: none; }
        @@media (prefers-reduced-motion: reduce) { .kn-intro { display: none !important; } }
        /* Логотип в меню — ссылка на главный экран. */
        a.logo { display: inline-flex; align-items: center; gap: 8px; color: var(--text); text-decoration: none; }
        a.logo img { width: 28px; height: 28px; border-radius: 7px; }
        /* D108: логотип у левого края, как пункты меню; без отступа ссылок меню. */
        .side a.logo { padding: 4px 10px; font-size: 17px; font-weight: 600; letter-spacing: -.01em; }
        .side a.logo:hover { background: transparent; }
        .logo-mark { flex: none; display: block; }
        .shell.narrow .side-head a.logo { display: inline-flex; }
        .shell.narrow .side-head a.logo .logo-text { display: none; }
        .catalog-layout { display: grid; grid-template-columns: 1fr; gap: 16px; }
        @@media (min-width: 900px) { .catalog-layout { grid-template-columns: 230px minmax(0, 1fr); } }
        .group-tree { display: flex; flex-direction: column; gap: 2px; border: 1px solid var(--line); border-radius: 8px; padding: 6px; align-self: start;
                      max-height: 70vh; overflow-y: auto; background: var(--surface, transparent); }
        .group-tree .link { text-align: left; padding: 5px 8px; border-radius: 6px; color: var(--text); text-decoration: none; }
        .group-tree .link.active { background: color-mix(in srgb, var(--sec-catalogs) 18%, transparent); font-weight: 600; }
        .barcode { font-family: ui-monospace, monospace; letter-spacing: .5px; }
        .inn-fill input { flex: 1; min-width: 0; }
        .inn-fill button { white-space: nowrap; }
        section.legal-entity { margin-bottom: 16px; }
        section.legal-entity.archived { opacity: .7; }
        .money-advance { color: var(--good); font-weight: 600; }
        @@media (min-width: 700px) { .panel .grid label.wide { grid-column: 1 / -1; } .panel .grid label.wide input { max-width: 536px; } }
        .reserve-toggle { display: inline-flex; align-items: center; gap: 6px; margin: 8px 0; color: var(--text); }
        .cell-good { background: color-mix(in srgb, var(--good) 16%, transparent); }
        .cell-part { background: color-mix(in srgb, var(--warn-text) 14%, transparent); }
        table.orders td { white-space: nowrap; }
        /* Главный экран (D74): шапка, плитки показателей, графики, «требует внимания», должники, мини-цифры. */
        .dash-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; flex-wrap: wrap; margin-bottom: 14px; }
        .dash-head h1 { margin: 0 0 2px; font-size: 20px; }
        .dash-head .readiness { margin: 0; }
        .section-title { font-size: 13px; margin: 18px 0 8px; color: var(--muted); font-weight: 600; text-transform: none; }
        .kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px; }
        .kpi { position: relative; display: flex; flex-direction: column; gap: 3px; padding: 12px 14px 10px 16px; border: 1px solid var(--line); border-radius: 8px;
               background: var(--surface-2); color: var(--text); text-decoration: none; overflow: hidden; }
        .kpi::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: var(--kpi, var(--accent)); }
        .kpi:hover { border-color: var(--kpi, var(--accent)); }
        .kpi-label { font-size: 12px; color: var(--muted); }
        .kpi-value { font-size: 20px; font-weight: 600; letter-spacing: -.01em; }
        .kpi-delta { font-size: 12px; }
        .kpi-delta.good { color: var(--good); }
        .kpi-delta.bad { color: var(--bad); }
        .kpi-hint { font-size: 11px; color: var(--muted-2); }
        .kpi-spark { width: 100%; height: 26px; margin-top: 2px; }
        .kpi-spark polyline { fill: none; stroke: var(--kpi, var(--accent)); stroke-width: 2; vector-effect: non-scaling-stroke; stroke-linejoin: round; }
        /* D114: динамика наверху главного — четыре графика в ряд на широком экране, по два на планшете. */
        .charts-large { grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); margin-bottom: 4px; }
        .chart-plot { position: relative; display: block; padding-left: 52px; }
        .chart-y { position: absolute; left: 0; top: 0; bottom: 0; width: 48px; display: flex; flex-direction: column; justify-content: space-between;
                   font-size: 10px; color: var(--muted-2); text-align: right; font-variant-numeric: tabular-nums; }
        .chart-large svg { height: 72px; }
        .chart-grid { stroke: var(--line); stroke-width: 1; vector-effect: non-scaling-stroke; }
        .chart-base { stroke: var(--line-strong); stroke-width: 1; vector-effect: non-scaling-stroke; }
        .chart-large .chart-axis { padding-left: 52px; }
        .dash-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 12px; margin-top: 14px; align-items: start; }
        /* Аудит 12.10.2026: на телефоне мелкие значки-ссылки и ссылки в строке — зона нажатия не меньше 32 px. */
        details.fold-phone > summary { display: none; }
        @@media (max-width: 599px) { details.fold-phone > summary { display: inline-flex; align-items: center; min-height: 36px; padding: 4px 12px;
            margin: 4px 0; border: 1px solid var(--line); border-radius: 6px; cursor: pointer; font-size: 14px; } }
        .icon-link { display: inline-flex; align-items: center; justify-content: center; min-width: 32px; min-height: 32px; text-decoration: none; }
        @@media (max-width: 599px) { .dash-box a, .crm-kpi a, .doc-actions a { display: inline-block; min-height: 32px; line-height: 32px; } }
        button:disabled { cursor: not-allowed; }
        .dash-box h2 { font-size: 14px; margin: 0 0 8px; display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; }
        /* D108: главный экран — 12 колонок; блоки занимают продуманную ширину, пустоты заполняются (dense). */
        .dash-head, .dash-blocks, .dash-setup { max-width: 1760px; }
        .dash-blocks { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); grid-auto-flow: row dense; gap: 12px; align-items: start; }
        .dash-blocks > * { grid-column: span 12; min-width: 0; }
        .dash-blocks > .span-3 { grid-column: span 3; }
        .dash-blocks > .span-4 { grid-column: span 4; }
        .dash-blocks > .span-6 { grid-column: span 6; }
        .dash-blocks > .span-8 { grid-column: span 8; }
        .dash-blocks > .wide { grid-column: 1 / -1; }
        .span-8 .attention { columns: 2 300px; column-gap: 28px; }
        .dash-blocks > .wide .attention { columns: 3 280px; column-gap: 28px; }
        .money-box h2 { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
        .money-box h2 .money-total { font-size: 16px; }
        .money-box h2 a { margin-left: auto; font-weight: 400; }
        .money-entity { display: flex; justify-content: space-between; gap: 12px; margin: 10px 0 6px; font-size: 13px; color: var(--text-2); }
        .money-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 8px; }
        .money-card { display: flex; flex-direction: column; gap: 4px; padding: 10px 12px; border: 1px solid var(--line); border-radius: 8px; background: var(--field); min-width: 0; }
        .money-card .tag { align-self: flex-start; }
        .money-card .money-name { font-size: 13px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .money-card b { font-size: 15px; font-variant-numeric: tabular-nums; }
        .attention li { break-inside: avoid; }
        @@media (max-width: 1279px) {
            .dash-blocks > .span-3, .dash-blocks > .span-4, .dash-blocks > .span-6 { grid-column: span 6; }
            .dash-blocks > .span-8 { grid-column: span 12; }
        }
        @@media (max-width: 899px) { .dash-blocks > .span-3, .dash-blocks > .span-4, .dash-blocks > .span-6, .dash-blocks > .span-8 { grid-column: span 12; } }
        .quick-actions { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 8px; }
        @@media (max-width: 599px) { .quick-actions { grid-template-columns: 1fr 1fr; } .quick-actions .quick-action { font-size: 12.5px; padding: 6px 8px; gap: 8px; } }
        .quick-action { display: flex; align-items: center; gap: 10px; min-height: 38px; padding: 6px 10px; border: 1px solid var(--line); border-radius: 8px;
                        background: var(--raised); color: var(--text); text-decoration: none; font-size: 13px; font-weight: 500; text-align: left; }
        .quick-action:hover { border-color: var(--sec, var(--accent)); background: var(--field); }
        .quick-action .qa-icon { display: inline-flex; align-items: center; justify-content: center; width: 30px; height: 30px; border-radius: 7px; flex: none;
                                 color: var(--sec, var(--accent)); background: color-mix(in srgb, var(--sec, var(--accent)) 14%, transparent); }

        .dash-blocks .section-title { margin-top: 0; }
        .dash-tools { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
        .dash-setup { margin-bottom: 12px; max-width: 520px; }
        .dash-setup ul { list-style: none; margin: 0 0 8px; padding: 0; }
        .dash-setup li { display: flex; justify-content: space-between; align-items: center; gap: 8px; padding: 3px 0; border-bottom: 1px solid var(--line); }
        .item-head { display: flex; gap: 16px; align-items: flex-start; flex-wrap: wrap; }
        .item-main-photo { width: 180px; height: 180px; object-fit: cover; border-radius: 8px; border: 1px solid var(--line); background: var(--field); }
        .photo-strip { display: flex; gap: 10px; flex-wrap: wrap; margin: 6px 0 10px; }
        .photo-strip figure { margin: 0; width: 120px; }
        .photo-strip img { width: 120px; height: 120px; object-fit: cover; border-radius: 6px; border: 1px solid var(--line); display: block; }
        .photo-strip figcaption { display: flex; gap: 4px; align-items: center; margin-top: 4px; }
        .file-pick { display: inline-flex; flex-direction: column; gap: 4px; }
        .item-thumb { width: 32px; height: 32px; object-fit: cover; border-radius: 4px; vertical-align: middle; margin-right: 6px; }
        /* D320: подсказка (похожие позиции и т. п.) — не ошибка. */
        .hint.warn { background: var(--warn-bg); color: var(--warn-text); border: 1px solid var(--warn-line); border-radius: 6px; padding: 6px 10px; font-size: 13px; }
        .hint.warn a { color: inherit; margin-left: 6px; }
        /* D318: выбор позиций в списке и панель массового изменения. */
        th.select-col, td.select-col { width: 28px; padding-right: 0; }
        .bulk-bar { margin: 8px 0; } .bulk-bar .grid { grid-template-columns: minmax(140px, auto) minmax(0, 1fr); align-items: center; }
        /* D316: конструктор этикеток — шаблоны, редактор и предпросмотр; на узком экране — друг под другом. */
        .label-designer { display: grid; gap: 16px; grid-template-columns: 1fr; }
        @@media (min-width: 1100px) { .label-designer { grid-template-columns: 260px minmax(0, 1fr) minmax(0, 420px); align-items: start; } }
        .label-designer fieldset { min-width: 0; } .label-designer .row-actions { flex-wrap: nowrap; }
        .label-designer > * { min-width: 0; } .label-designer select, .label-designer input { max-width: 100%; }
        .label-designer .plain-list { list-style: none; padding: 0; margin: 0 0 12px; display: grid; gap: 6px; }
        .label-zoom { max-width: 100%; overflow: hidden; margin: 8px 0; }
        /* D316: этикетка по шаблону — одинаково на экране конструктора и при печати. */
        .item-label { box-sizing: border-box; background: #fff; color: #000; font-family: Arial, sans-serif; line-height: 1.15; overflow: hidden; display: flex; flex-direction: column; gap: 0.4mm; outline: 1px dashed #bbb; }
        .item-label .lb-line { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .item-label .lb-line.wrap { white-space: normal; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; }
        .item-label .lb-bars { margin-top: auto; }
