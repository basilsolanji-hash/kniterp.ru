<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>KnitErp.Infrastructure</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\KnitErp.Application\KnitErp.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ClosedXML" />
    <!-- Официальный SDK Anthropic: ИИ-помощник (включается ключом в настройках, по умолчанию выключен). -->
    <PackageReference Include="Anthropic" />
    <PackageReference Include="MailKit" />
    <!-- D1123 (продажи): PDF счёта, УПД и заказа для писем клиенту; QR оплаты по ГОСТ Р 56042 в PDF. -->
    <PackageReference Include="PDFsharp-MigraDoc" />
    <PackageReference Include="QRCoder" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <!-- Ключи защиты cookie хранятся в базе, зашифрованные мастер-ключом. -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <!-- Только для команды dotnet ef: в сборку приложения не попадает. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Design тянет через MSBuild уязвимую 9.0.0 (GHSA-23rf-6693-g89p и др.): закрепляем исправленную. -->
    <PackageReference Include="System.Security.Cryptography.Xml" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- D1123: шрифт DejaVu Sans (свободная лицензия Bitstream Vera / DejaVu) — кириллица в PDF без системных шрифтов. -->
    <EmbeddedResource Include="Documents\Fonts\*.ttf" />
  </ItemGroup>
</Project>
